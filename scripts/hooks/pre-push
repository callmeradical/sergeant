#!/usr/bin/env bash
# pre-push — Run the drain and notification test suites in Docker before every push.
#
# Installed by: mise run install
# Source:       scripts/hooks/pre-push
#
# Runs `mise run test:docker:drain` and `mise run test:docker:notification`,
# each executing in two isolated Docker containers (Debian system Bash + Alpine
# Bash 3.2).
#
# To skip in an emergency:
#   git push --no-verify
#
# To reinstall after cloning:
#   mise run install

set -euo pipefail

# git runs pre-push with the working directory set to the root of the worktree
# being pushed, so ask git which tree that is.
#
# Resolving from this script's own location instead selects the wrong tree: the
# hook is installed as a symlink into the main checkout's scripts/ directory,
# and .git/hooks is shared by every linked worktree. A path-relative resolution
# therefore always picks the main checkout, so the gate reports on a tree nobody
# is pushing -- passing while broken code ships, and failing while a fix ships.
REPO_DIR="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [[ -z "$REPO_DIR" ]]; then
  REPO_DIR="$(cd "$(dirname "$0")/../.." && pwd)"
fi

# Resolve mise — try PATH first, then common install locations.
MISE=""
for candidate in mise "$HOME/.local/bin/mise" "$HOME/.cargo/bin/mise"; do
  if command -v "$candidate" >/dev/null 2>&1; then
    MISE="$candidate"
    break
  fi
done

if [[ -z "$MISE" ]]; then
  printf 'pre-push: mise not found — cannot run drain test suite.\n' >&2
  printf 'Install mise (https://mise.jdx.dev) or run git push --no-verify to skip.\n' >&2
  exit 1
fi

if ! command -v docker >/dev/null 2>&1; then
  printf 'pre-push: docker not found — cannot run drain test suite.\n' >&2
  printf 'Install Docker or run git push --no-verify to skip.\n' >&2
  exit 1
fi

printf 'pre-push: running drain and notification test suites (git push --no-verify to skip)...\n'
printf 'pre-push: validating %s\n' "$REPO_DIR"
# Pass the tree explicitly as well as via --cd.  --cd alone was not enough: the
# task re-derived the tree from "${MISE_PROJECT_ROOT:-.}", and MISE_PROJECT_ROOT
# is empty in practice, so it fell back to `.` and gated the main checkout instead
# of the worktree being pushed (td-85b6bf).  The resolution above is correct; this
# makes the task honour it instead of guessing again.
SGT_TEST_REPO_DIR="$REPO_DIR" "$MISE" run --cd "$REPO_DIR" test:docker:drain
SGT_TEST_REPO_DIR="$REPO_DIR" "$MISE" run --cd "$REPO_DIR" test:docker:notification
