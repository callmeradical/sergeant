#!/usr/bin/env bash
# pre-push — Run targeted test suites in Docker before each push.
#
# Installed by: mise run install
# Source:       scripts/hooks/pre-push
#
# Always runs:
#   mise run test:docker:drain   — drain state contract (fast, always-on)
#
# Runs only when notification-delivery code changes:
#   mise run test:docker:notification — full handshake suite including
#     sgt-session-resume end-to-end (requires real tmux, slower)
#
# Notification suite is triggered when any of these paths appear in the push:
#   bin/sgt-interactive-worker, bin/_sgt-harness.sh, bin/_sgt-lib.sh,
#   bin/sgt-session-resume, bin/_sgt-response-lock.sh,
#   tests/run-notification-tests.sh, tests/sgt-notification-*,
#   tests/sgt-session-resume-notification-*, tests/sgt-harness-test.sh,
#   tests/sgt-worker-handshake-test.sh, tests/sgt-worker-readiness-test.sh,
#   tests/sgt-lease-*-test.sh
#
# To skip in an emergency:
#   git push --no-verify
#
# To reinstall after cloning:
#   mise run install

set -euo pipefail

# git runs pre-push with the working directory set to the root of the worktree
# being pushed, so ask git which tree that is.
REPO_DIR="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [[ -z "$REPO_DIR" ]]; then
  REPO_DIR="$(cd "$(dirname "$0")/../.." && pwd)"
fi

# Resolve mise — try PATH first, then common install locations.
MISE=""
for candidate in mise "$HOME/.local/bin/mise" "$HOME/.cargo/bin/mise"; do
  if command -v "$candidate" >/dev/null 2>&1; then
    MISE="$candidate"
    break
  fi
done

if [[ -z "$MISE" ]]; then
  printf 'pre-push: mise not found — cannot run test suites.\n' >&2
  printf 'Install mise (https://mise.jdx.dev) or run git push --no-verify to skip.\n' >&2
  exit 1
fi

if ! command -v docker >/dev/null 2>&1; then
  printf 'pre-push: docker not found — cannot run test suites.\n' >&2
  printf 'Install Docker or run git push --no-verify to skip.\n' >&2
  exit 1
fi

# ── Determine changed files from pushed refs ───────────────────────────────────
# git passes pushed ref info on stdin: "<local_ref> <local_sha> <remote_ref> <remote_sha>"
# Consume stdin now; nothing downstream needs it.
_EMPTY_TREE="4b825dc642cb6eb9a060e54bf8d69288fbee4904"
_changed_files=""
while IFS=' ' read -r _local_ref _local_sha _remote_ref _remote_sha; do
  # Deletion push — no files to examine.
  [[ "$_local_sha" =~ ^0+$ ]] && continue
  # New branch — diff against empty tree (treat as all files changed).
  [[ "$_remote_sha" =~ ^0+$ ]] && _remote_sha="$_EMPTY_TREE"
  _files="$(git diff --name-only "$_remote_sha" "$_local_sha" 2>/dev/null || true)"
  _changed_files="${_changed_files}${_files}"$'\n'
done

# Returns 0 if any changed file is relevant to the notification delivery suite.
_touches_notification() {
  printf '%s\n' "$_changed_files" | grep -qE \
    '(bin/sgt-interactive-worker|bin/_sgt-harness\.sh|bin/_sgt-lib\.sh|bin/sgt-session-resume|bin/_sgt-response-lock\.sh|tests/run-notification-tests\.sh|tests/sgt-notification-|tests/sgt-session-resume-notification-|tests/sgt-harness-test\.sh|tests/sgt-worker-handshake-test\.sh|tests/sgt-worker-readiness-test\.sh|tests/sgt-lease-.*-test\.sh)'
}

# ── Always: drain suite ────────────────────────────────────────────────────────
printf 'pre-push: running drain test suite (git push --no-verify to skip)...\n'
printf 'pre-push: validating %s\n' "$REPO_DIR"
SGT_TEST_REPO_DIR="$REPO_DIR" "$MISE" run --cd "$REPO_DIR" test:docker:drain

# ── Conditional: notification suite ───────────────────────────────────────────
if _touches_notification || [[ -z "$_changed_files" ]]; then
  printf 'pre-push: notification-relevant files changed — running notification suite...\n'
  SGT_TEST_REPO_DIR="$REPO_DIR" "$MISE" run --cd "$REPO_DIR" test:docker:notification
else
  printf 'pre-push: no notification-relevant files changed — skipping notification suite.\n'
fi
