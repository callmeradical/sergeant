#!/usr/bin/env python3
"""Execute the exact preflighted review-router distribution snapshot."""

import hashlib
import json
import os
import re
import shlex
import stat
import subprocess
import sys
import tempfile


RUNTIME_FILES = (
    "sgt-review-findings",
    "_sgt-lib.sh",
    "_sgt-response-lock.sh",
    "_sgt-review-axes.sh",
    "_sgt-bash-version.sh",
    "_sgt-process-identity.sh",
    "_sgt-drain.sh",
    "_sgt-process.sh",
    "_sgt-response-lock-transition.py",
    "_sgt-process-token.py",
    "sgt-notify",
    "sgt-callback",
)


def die(message):
    print("ERROR: " + message, file=sys.stderr)
    raise SystemExit(2)


def strict_json(raw, label):
    def closed_object(pairs):
        result = {}
        for key, value in pairs:
            if key in result:
                raise ValueError("duplicate key: " + key)
            result[key] = value
        return result

    try:
        return json.loads(raw.decode("utf-8", "strict"), object_pairs_hook=closed_object)
    except (UnicodeDecodeError, json.JSONDecodeError, ValueError) as error:
        die("invalid %s: %s" % (label, error))


def read_regular(path):
    flags = os.O_RDONLY
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    fd = os.open(path, flags)
    try:
        before = os.fstat(fd)
        if not stat.S_ISREG(before.st_mode):
            raise OSError("not a regular file")
        chunks = []
        while True:
            chunk = os.read(fd, 65536)
            if not chunk:
                break
            chunks.append(chunk)
        after = os.fstat(fd)
        if (before.st_dev, before.st_ino, before.st_size, before.st_mtime_ns) != (
            after.st_dev, after.st_ino, after.st_size, after.st_mtime_ns
        ):
            raise OSError("file changed while read")
        return before, b"".join(chunks)
    finally:
        os.close(fd)


def snapshot_identity(router_path, snapshot_dir=None):
    router_dir = os.path.dirname(router_path)
    runtime = hashlib.sha256()
    router_info = None
    router_bytes = None
    for name in RUNTIME_FILES:
        path = router_path if name == "sgt-review-findings" else os.path.join(router_dir, name)
        runtime.update(name.encode("utf-8") + b"\0")
        info, content = read_regular(path)
        runtime.update(hashlib.sha256(content).digest())
        if name == "sgt-review-findings":
            router_info, router_bytes = info, content
        if snapshot_dir is not None:
            destination = os.path.join(snapshot_dir, name)
            with open(destination, "xb") as stream:
                stream.write(content)
            os.chmod(destination, stat.S_IMODE(info.st_mode))
    if router_info is None:
        raise OSError("review router is unavailable")
    router_digest = hashlib.sha256(router_bytes).hexdigest()
    identity = "%s:%s:%s:%s" % (
        router_info.st_dev,
        router_info.st_ino,
        router_digest,
        runtime.hexdigest(),
    )
    current = os.stat(router_path, follow_symlinks=False)
    if not stat.S_ISREG(current.st_mode) or (
        current.st_dev, current.st_ino
    ) != (router_info.st_dev, router_info.st_ino):
        raise OSError("review router path changed after verification")
    return identity


def route_context(args):
    if len(args) < 2:
        return None
    context = {"project": args[0], "repo": args[1]}
    options = args[2:]
    while options:
        if len(options) < 2 or not options[0].startswith("--"):
            return None
        context[options[0][2:].replace("-", "_")] = options[1]
        options = options[2:]
    required = {
        "input", "axis", "source", "branch", "head_sha", "parent_task",
        "task_id", "worktree",
    }
    return context if required.issubset(context) else None


def clean_text(value, limit):
    if not isinstance(value, str):
        raise ValueError("finding field is not text")
    value = " ".join(value.split())
    value = re.sub(
        r"(?i)((?:password|token|secret|credential|api[_-]?key)\s*[:=]\s*)([^\s,;]+)",
        r"\1[REDACTED]", value,
    )
    value = re.sub(r"(?i)\b(?:bearer|basic)\s+[^\s,;]+", "[REDACTED AUTH]", value)
    value = re.sub(r"\bgh[pousr]_[A-Za-z0-9_]{20,}\b", "[REDACTED]", value)
    value = re.sub(r"\b(?:AKIA|ASIA)[A-Z0-9]{16}\b", "[REDACTED]", value)
    value = re.sub(r"(?i)(https?://)[^\s/@:]+:[^\s/@]+@", r"\1[REDACTED]@", value)
    return value[:limit]


def retain_runtime_mismatch(reason, args, values, expected_contract):
    context = route_context(args)
    if context is None or not os.path.isdir(context["worktree"]):
        return
    worktree = context["worktree"]
    artifact = None
    try:
        with open(context["input"], "rb") as stream:
            document = strict_json(stream.read(), "review artifact")
        if not isinstance(document, dict) or set(document) != {"findings"}:
            raise ValueError("top-level review schema")
        aliases = expected_contract["severity_aliases"]
        allowed = {
            "id", "severity", "disposition", "summary", "evidence", "paths",
            "acceptance_criteria", "recommendation",
        }
        records = []
        for finding in document["findings"]:
            if not isinstance(finding, dict) or set(finding) != allowed:
                raise ValueError("finding schema")
            finding_id = clean_text(finding["id"], 120)
            if not re.fullmatch(r"[A-Za-z0-9._-]+", finding_id):
                raise ValueError("finding id")
            reported = finding["severity"]
            if reported not in aliases:
                raise ValueError("finding severity")
            disposition = finding["disposition"]
            if disposition not in {"actionable", "cosmetic", "false-positive"}:
                raise ValueError("finding disposition")
            paths = finding["paths"]
            if not isinstance(paths, list) or not all(isinstance(path, str) for path in paths):
                raise ValueError("finding paths")
            severity = aliases[reported]
            summary = clean_text(finding["summary"], 240)
            evidence = clean_text(finding["evidence"], 1000)
            joined_paths = ", ".join(clean_text(path, 240) for path in paths) or "not provided"
            acceptance = clean_text(finding["acceptance_criteria"], 1000)
            recommendation = clean_text(finding["recommendation"], 500)
            if not all((summary, evidence, acceptance, recommendation)):
                raise ValueError("empty finding field")
            digest = hashlib.sha256("\0".join((
                severity, summary, evidence, joined_paths, acceptance, recommendation,
            )).encode()).hexdigest()[:32]
            reported_value = "" if reported == severity else reported
            records.append((finding_id, severity, disposition, summary, evidence,
                            joined_paths, acceptance, recommendation, digest, reported_value))
        if records:
            root = os.path.join(worktree, ".sergeant-review-artifacts")
            os.makedirs(root, exist_ok=True)
            artifact = os.path.join(root, context["axis"] + "-" + context["source"])
            if os.path.exists(artifact):
                raise ValueError("retained artifact already exists")
            staging = tempfile.mkdtemp(prefix=".staging.", dir=root)
            with open(os.path.join(staging, "findings"), "xb") as stream:
                for record in records:
                    for field in record:
                        stream.write(field.encode() + b"\0")
            meta = {
                "project": context["project"], "repo": context["repo"],
                "axis": context["axis"], "source": context["source"],
                "branch": context["branch"], "head_sha": context["head_sha"],
                "parent_task": context["parent_task"], "task_id": context["task_id"],
                "router_executable": values["--router"],
                "router_identity": values["--identity"],
                "router_capabilities": values["--capabilities-file"],
                "router_launcher": os.path.realpath(sys.argv[0]),
            }
            with open(os.path.join(staging, "meta"), "x", encoding="utf-8") as stream:
                for key, value in meta.items():
                    if "\n" in value or "\r" in value:
                        raise ValueError("invalid route metadata")
                    stream.write("%s=%s\n" % (key, value))
            os.rename(staging, artifact)
    except (OSError, KeyError, TypeError, ValueError):
        artifact = None

    retry = "No review body was retained."
    if artifact:
        retry_args = [
            os.path.realpath(sys.argv[0]), "--router", values["--router"],
            "--identity", values["--identity"], "--capabilities-file",
            values["--capabilities-file"], "--", context["project"], context["repo"],
            "--retry", artifact, "--worktree", worktree,
        ]
        retry = "Sanitized findings retained at %s. Retry with: %s" % (
            artifact, shlex.join(retry_args),
        )
    generation_path = os.path.join(worktree, ".sergeant-gate-generation")
    try:
        with open(generation_path, encoding="utf-8") as stream:
            generation = int(stream.read().strip()) + 1
    except (OSError, ValueError):
        generation = 1
    message = "Review finding routing failed. Reason: %s. %s" % (reason, retry)
    for name, content in (
        (".sergeant-message", message + "\n"),
        (".sergeant-gate-generation", str(generation) + "\n"),
        (".sergeant-status", "blocked\n"),
    ):
        temporary = os.path.join(worktree, name + ".launcher-tmp")
        with open(temporary, "w", encoding="utf-8") as stream:
            stream.write(content)
        os.replace(temporary, os.path.join(worktree, name))


def runtime_die(message, args, values, expected_contract):
    retain_runtime_mismatch(message, args, values, expected_contract)
    die(message)


def main():
    args = sys.argv[1:]
    values = {}
    while args and args[0] != "--":
        option = args.pop(0)
        if option not in ("--router", "--identity", "--capabilities-file") or not args:
            die("invalid review-router launcher arguments")
        values[option] = args.pop(0)
    if not args or args.pop(0) != "--" or not args:
        die("review-router launcher requires route arguments after --")
    if set(values) != {"--router", "--identity", "--capabilities-file"}:
        die("review-router launcher requires router, identity, and capabilities evidence")

    router = values["--router"]
    if not os.path.isabs(router):
        die("review router path is not absolute")
    try:
        with open(values["--capabilities-file"], "rb") as stream:
            expected_contract_raw = stream.read()
    except OSError as error:
        die("could not read pinned review-router contract: %s" % error)
    expected_contract = strict_json(expected_contract_raw, "pinned review-router contract")

    try:
        with tempfile.TemporaryDirectory(prefix="sgt-review-router-") as snapshot:
            actual_identity = snapshot_identity(router, snapshot)
            if actual_identity != values["--identity"]:
                runtime_die("review-router executable identity mismatch: required %s, installed %s" % (
                    values["--identity"], actual_identity
                ), args, values, expected_contract)
            snapshot_router = os.path.join(snapshot, "sgt-review-findings")
            capability = subprocess.run(
                [snapshot_router, "--capabilities"],
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                check=False,
            )
            if capability.returncode != 0:
                runtime_die("pinned review router capability probe failed", args, values, expected_contract)
            actual_contract = strict_json(capability.stdout, "runtime review-router contract")
            if actual_contract != expected_contract:
                runtime_die("runtime review-router contract differs from preflight evidence", args, values, expected_contract)
            env = os.environ.copy()
            env["SGT_REVIEW_ROUTER_PIN_EXECUTABLE"] = router
            env["SGT_REVIEW_ROUTER_PIN_IDENTITY"] = values["--identity"]
            env["SGT_REVIEW_ROUTER_PIN_CAPABILITIES"] = values["--capabilities-file"]
            env["SGT_REVIEW_ROUTER_PIN_LAUNCHER"] = os.path.realpath(sys.argv[0])
            completed = subprocess.run([snapshot_router] + args, env=env, check=False)
            return completed.returncode
    except OSError as error:
        runtime_die("could not bind pinned review-router distribution: %s" % error,
                    args, values, expected_contract)


if __name__ == "__main__":
    raise SystemExit(main())
