#!/usr/bin/env bash
# sgt-watch - Monitor a dispatched fleet and report outcomes.

set -euo pipefail

_sgt_watch_real_dir() {
  local src="$1" target dir _link _i=0
  target="$src"
  while [[ -L "$target" && $_i -lt 20 ]]; do
    _link="$(readlink "$target" 2>/dev/null || true)"
    [[ -n "$_link" ]] || break
    if [[ "$_link" == /* ]]; then target="$_link"; else target="$(dirname "$target")/$_link"; fi
    _i=$(( _i + 1 ))
  done
  dir="$(dirname "$target")"
  (cd "$dir" && pwd -P)
}
SCRIPT_DIR="$(_sgt_watch_real_dir "${BASH_SOURCE[0]}")"
unset -f _sgt_watch_real_dir
# shellcheck source=bin/_sgt-lib.sh
source "$SCRIPT_DIR/_sgt-lib.sh"
# shellcheck source=bin/_sgt-response-lock.sh
source "$SCRIPT_DIR/_sgt-response-lock.sh"
FLEET_DIR="${SERGEANT_FLEET:-$FLEET_DIR}"
POLL_INTERVAL="${SERGEANT_WATCH_INTERVAL:-5}"

# Support both orderings:
#   sgt-watch <task-id> --background   (spec-canonical)
#   sgt-watch --background <task-id>   (flag-first, consistent with --list/--sync)
if [[ "${1:-}" == "--background" || "${2:-}" == "--background" ]]; then
  if [[ "${1:-}" == "--background" ]]; then
    [[ $# -ge 2 ]] || _die "Usage: sgt-watch <task-id> --background"
    TASK_ID="$2"
  else
    TASK_ID="$1"
  fi
  TASK_DIR="$FLEET_DIR/$TASK_ID"
  [[ -d "$TASK_DIR" ]] || _die "Task not found: $TASK_ID (looked in $FLEET_DIR)"
  _sgt_background_watch "$TASK_ID" "$TASK_DIR"
  exit 0
fi

# ── Bounded read-only snapshot ────────────────────────────────────────────────
#
#   sgt-watch --snapshot
#   sgt-watch --snapshot <task-id>
#   sgt-watch --snapshot <task-id> --repo <repo>
#
# Answers exactly one narrow question — "is Sergeant verifiably doing work right
# now?" — as constant-size versioned JSON.  --list renders every retained record
# for humans and embeds free-form brief text, and --sync/--sync-all mutate
# lifecycle state, so neither is usable by a coordinator or bridge that needs a
# side-effect-free observation.
#
# Strictly read-only: this branch runs before any reconciliation, never writes,
# and deliberately avoids _pane_is_supervisor because that migrates legacy
# pane_identity files as a side effect.
#
# `busy: true` requires ALL of a stable active status, an exact live Sergeant
# worker identity, and recent progress attributable to that pane.  Every other
# outcome is `busy: null`.  Version 1 never emits `busy: false`: absence of a
# verified witness is not proof of idleness.
#
# `basis` is a closed allowlist of exactly two values, so an unknown condition
# maps to the null basis instead of inventing one.
_SGT_SNAPSHOT_SCHEMA='sergeant.watch-status/v1'

# _snapshot_scope_id_is_valid: bound the only caller-supplied values that reach
# the output, which is what keeps the document constant-size.
_snapshot_scope_id_is_valid() {
  [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]]
}

# _snapshot_pane_is_verified_worker <pane> <repo_dir>
# Read-only exact identity match against the recorded worker pane.
_snapshot_pane_is_verified_worker() {
  local pane="$1" repo_dir="$2" actual expected observed_pane observed_dead
  [[ -n "$pane" ]] || return 1
  command -v tmux >/dev/null 2>&1 || return 1
  actual="$(_sgt_pane_identity "$pane" 2>/dev/null || true)"
  [[ -n "$actual" ]] || return 1
  # pane_dead|pane_id|pane_pid|pane_created|pane_start_command.  `display-message
  # -t <gone>` falls back to the default target, so the pane id is compared.
  observed_dead="${actual%%|*}"
  observed_pane="${actual#*|}"
  observed_pane="${observed_pane%%|*}"
  [[ "$observed_dead" == "0" && "$observed_pane" == "$pane" ]] || return 1
  expected="$(cat "$repo_dir/pane_identity" 2>/dev/null || true)"
  [[ -n "$expected" && "$expected" == "$actual" ]]
}

# _snapshot_repo_is_active_witness <repo_dir>
_snapshot_repo_is_active_witness() {
  local repo_dir="$1" status pane recent now last_event pane_activity
  [[ -d "$repo_dir" ]] || return 1
  status="$(cat "$repo_dir/status" 2>/dev/null | tr -d '\n' || true)"
  # in_progress is the only status that claims work is happening.  Terminal,
  # waiting and unreconciled states are never a witness.
  [[ "$status" == "in_progress" ]] || return 1
  pane="$(cat "$repo_dir/pane" 2>/dev/null | tr -d '\n' || true)"
  _snapshot_pane_is_verified_worker "$pane" "$repo_dir" || return 1

  recent="${SERGEANT_SNAPSHOT_RECENT_SECONDS:-300}"
  [[ "$recent" =~ ^[0-9]+$ ]] || recent=300
  now="$(date +%s)"
  [[ "$now" =~ ^[0-9]+$ ]] || return 1
  last_event="$(cat "$repo_dir/progress_ts" 2>/dev/null | tr -d '\n' || true)"
  [[ "$last_event" =~ ^[1-9][0-9]*$ ]] || last_event=0
  pane_activity="$(tmux display-message -p -t "$pane" '#{pane_activity}' 2>/dev/null || true)"
  if [[ "$pane_activity" =~ ^[1-9][0-9]*$ ]] && (( pane_activity > last_event )); then
    last_event="$pane_activity"
  fi
  (( last_event > 0 && now >= last_event && now - last_event <= recent ))
}

_snapshot_emit() {
  local kind="$1" task_id="$2" repo="$3" busy="$4" basis="$5"
  local task_field repo_field
  if [[ -n "$task_id" ]]; then task_field="\"$task_id\""; else task_field='null'; fi
  if [[ -n "$repo" ]]; then repo_field="\"$repo\""; else repo_field='null'; fi
  printf '{"schema":"%s","observed_at":"%s","scope":{"kind":"%s","task_id":%s,"repo":%s},"busy":%s,"basis":"%s"}\n' \
    "$_SGT_SNAPSHOT_SCHEMA" \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    "$kind" "$task_field" "$repo_field" "$busy" "$basis"
}

if [[ "${1:-}" == "--snapshot" ]]; then
  snapshot_task=""
  snapshot_repo=""
  snapshot_task_given=0
  shift
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --repo)
        [[ -n "${2:-}" ]] || _die "--repo requires a repository name"
        snapshot_repo="$2"
        shift 2
        ;;
      -*) _die "Unknown option for --snapshot: $1" ;;
      *)
        (( snapshot_task_given == 0 )) || \
          _die "Usage: sgt-watch --snapshot [<task-id>] [--repo <repo>]"
        snapshot_task="$1"
        snapshot_task_given=1
        shift
        ;;
    esac
  done
  # Validate before observing anything, so a malformed scope can never reach the
  # output and can never make the document unbounded.
  if (( snapshot_task_given == 1 )); then
    _snapshot_scope_id_is_valid "$snapshot_task" || \
      _die "Invalid task ID for --snapshot: $snapshot_task"
  fi
  if [[ -n "$snapshot_repo" ]]; then
    [[ -n "$snapshot_task" ]] || _die "--repo requires a task ID"
    _snapshot_scope_id_is_valid "$snapshot_repo" || \
      _die "Invalid repo for --snapshot: $snapshot_repo"
  fi

  if [[ -n "$snapshot_repo" ]]; then
    snapshot_kind="repo"
  elif [[ -n "$snapshot_task" ]]; then
    snapshot_kind="task"
  else
    snapshot_kind="fleet"
  fi

  snapshot_busy="null"
  snapshot_basis="no_verified_active_witness"
  if [[ -n "$snapshot_repo" ]]; then
    if _snapshot_repo_is_active_witness "$FLEET_DIR/$snapshot_task/$snapshot_repo"; then
      snapshot_busy="true"
      snapshot_basis="verified_active_witness"
    fi
  elif [[ -n "$snapshot_task" ]]; then
    if [[ -d "$FLEET_DIR/$snapshot_task" ]]; then
      for snapshot_repo_dir in "$FLEET_DIR/$snapshot_task"/*/; do
        [[ -d "$snapshot_repo_dir" ]] || continue
        if _snapshot_repo_is_active_witness "${snapshot_repo_dir%/}"; then
          snapshot_busy="true"
          snapshot_basis="verified_active_witness"
          break
        fi
      done
    fi
  elif [[ -d "$FLEET_DIR" ]]; then
    for snapshot_task_dir in "$FLEET_DIR"/*/; do
      [[ -d "$snapshot_task_dir" ]] || continue
      for snapshot_repo_dir in "$snapshot_task_dir"*/; do
        [[ -d "$snapshot_repo_dir" ]] || continue
        if _snapshot_repo_is_active_witness "${snapshot_repo_dir%/}"; then
          snapshot_busy="true"
          snapshot_basis="verified_active_witness"
          break 2
        fi
      done
    done
  fi

  _snapshot_emit "$snapshot_kind" "$snapshot_task" "$snapshot_repo" \
    "$snapshot_busy" "$snapshot_basis"
  exit 0
fi

if [[ "${1:-}" == "--list" ]]; then
  if [[ ! -d "$FLEET_DIR" ]] || [[ -z "$(ls -A "$FLEET_DIR" 2>/dev/null)" ]]; then
    echo "No tasks found in $FLEET_DIR"
    exit 0
  fi
  # Retained records include terminal ones, so this heading must not claim they
  # are active.  Use --snapshot for a machine-readable activity observation.
  echo "Fleet tasks (retained records, including terminal):"
  echo ""
  for task_dir in "$FLEET_DIR"/*/; do
    task_id="$(basename "$task_dir")"
    started="$(cat "$task_dir/started" 2>/dev/null || echo "unknown")"
    brief="$(grep '^Brief:' "$task_dir/brief.md" 2>/dev/null | sed 's/^Brief: *//' | cut -c1-60 || echo "")"
    notify_event="$(sed -n 's/^event=//p' "$task_dir/notify" 2>/dev/null || true)"
    # Count repo statuses
    total=0; done_count=0; failed_count=0; in_progress=0; needs_input=0; blocked=0; orphaned=0; waiting=0; drained=0
    for repo_dir in "$task_dir"/*/; do
      [[ -d "$repo_dir" ]] || continue
      total=$((total + 1))
      s="$(cat "$repo_dir/status" 2>/dev/null || echo "unknown")"
      case "$s" in
        done)        done_count=$((done_count + 1)) ;;
        failed*)     failed_count=$((failed_count + 1)) ;;
        in_progress) in_progress=$((in_progress + 1)) ;;
        needs_input) needs_input=$((needs_input + 1)) ;;
        blocked)     blocked=$((blocked + 1)) ;;
        waiting)     waiting=$((waiting + 1)) ;;
        orphaned)    orphaned=$((orphaned + 1)) ;;
        drained)     drained=$((drained + 1)) ;;
      esac
    done
    echo "  $task_id"
    echo "    brief:   $brief"
    echo "    started: $started"
    [[ -z "$notify_event" ]] || echo "    notify:  $notify_event"
    echo "    repos:   $total total — $done_count done, $in_progress in-progress, $needs_input needs-input, $blocked blocked, $waiting waiting, $drained drained, $orphaned orphaned, $failed_count failed"
    echo ""
  done
  exit 0
fi

_pane_is_supervisor() {
  local pane="$1"
  local repo_dir="${2%/}"
  local actual agent command created expected_command pane_id pane_pid remainder worktree

  if [[ -s "$repo_dir/pane_identity" ]]; then
    _sgt_pane_identity_matches "$pane" "$repo_dir"
    return
  fi

  actual="$(_sgt_pane_identity "$pane")" || return 1
  remainder="${actual#*|}"
  pane_id="${remainder%%|*}"
  remainder="${remainder#*|}"
  pane_pid="${remainder%%|*}"
  remainder="${remainder#*|}"
  created="${remainder%%|*}"
  command="${remainder#*|}"
  worktree="$(cat "$repo_dir/worktree" 2>/dev/null || true)"
  agent="$(cat "$repo_dir/agent" 2>/dev/null || true)"
  expected_command="$(_sgt_worker_command \
    "$SCRIPT_DIR/sgt-interactive-worker" "$repo_dir" "$worktree" "$agent")"
  [[ "${actual%%|*}" == 0 && "$pane_id" == "$pane" &&
     "$pane_pid" =~ ^[1-9][0-9]*$ && "$created" =~ ^[1-9][0-9]*$ &&
     -n "$worktree" && -n "$agent" && "$command" == "$expected_command" ]] || return 1

  printf '%s\n' "$actual" > "$repo_dir/pane_identity_migration.tmp.$$" || return 1
  mv "$repo_dir/pane_identity_migration.tmp.$$" "$repo_dir/pane_identity_migration" || return 1
  printf '%s\n' "$actual" > "$repo_dir/pane_identity.tmp.$$" || return 1
  mv "$repo_dir/pane_identity.tmp.$$" "$repo_dir/pane_identity" || return 1
}

# _sgt_dagr_advance — if the fleet task has dagr tracking files, call
# "dagr run step-done/step-fail" to advance the associated DAG run.
_sgt_dagr_advance() {
  local repo_dir="$1" wt_status="$2"
  local dagr_run_id dagr_stage_id
  dagr_run_id="$(cat "$repo_dir/dagr_run_id" 2>/dev/null || true)"
  dagr_stage_id="$(cat "$repo_dir/dagr_stage_id" 2>/dev/null || true)"
  [[ -n "$dagr_run_id" && -n "$dagr_stage_id" ]] || return 0
  command -v dagr >/dev/null 2>&1 || return 0
  if [[ "$wt_status" == "done" ]]; then
    dagr run step-done "$dagr_run_id" "$dagr_stage_id" --result "done" 2>/dev/null || true
  else
    dagr run step-done "$dagr_run_id" "$dagr_stage_id" --result "$wt_status" 2>/dev/null || true
  fi
}

# _recycle_evidence_covers <repo_dir> <identity>
#
# 0 when the recorded recycle evidence names this exact pane identity.
#
# worker_recycled used to be a permanent task-level marker: any non-empty content
# meant "already recycled", it was stamped merely because the recorded pane was
# absent, and nothing ever cleared or rebound it.  A relaunch that rewrote
# pane/pane_identity therefore permanently suppressed recycling of every later
# pane.  Binding the evidence to the exact identity makes it answer the only
# question that matters — "has THIS pane been retired?" — and makes an empty or
# malformed marker prove nothing.
_recycle_evidence_covers() {
  local repo_dir="$1" identity="$2" process_group="$3"
  [[ -n "$identity" ]] || return 1
  [[ -s "$repo_dir/worker_recycled" ]] || return 1
  grep -Fqx "identity=$identity" "$repo_dir/worker_recycled" 2>/dev/null &&
    grep -Fqx "process_group=$process_group" "$repo_dir/worker_recycled" 2>/dev/null &&
    grep -Fqx 'outcome=process_group_stopped' "$repo_dir/worker_recycled" 2>/dev/null
}

# _record_recycle_evidence <repo_dir> <pane> <identity> <outcome>
# Rebind the current evidence and append to the append-only history so no earlier
# recycling is ever lost.
_record_recycle_evidence() {
  local repo_dir="$1" pane="$2" identity="$3" process_group="$4" stamp temporary
  stamp="$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || true)"
  temporary="$repo_dir/worker_recycled.tmp.$$"
  {
    printf 'pane=%s\n' "$pane"
    printf 'identity=%s\n' "$identity"
    printf 'process_group=%s\n' "$process_group"
    printf 'outcome=process_group_stopped\n'
    printf 'recycled_at=%s\n' "$stamp"
  } > "$temporary" || { rm -f "$temporary"; return 1; }
  mv "$temporary" "$repo_dir/worker_recycled" || { rm -f "$temporary"; return 1; }
  printf '%s\t%s\t%s\t%s\n' "$stamp" "$pane" "$identity" "$process_group" \
    >> "$repo_dir/worker_recycled_log" 2>/dev/null || true
}

_load_or_record_recycle_phase() {
  local repo_dir="$1" identity="$2" process_group="$3" session_id="$4" temporary pid start members=""
  if [[ -s "$repo_dir/worker_recycle_phase" ]]; then
    grep -Fqx 'version=1' "$repo_dir/worker_recycle_phase" || return 1
    grep -Fqx "identity=$identity" "$repo_dir/worker_recycle_phase" || return 1
    grep -Fqx "process_group=$process_group" "$repo_dir/worker_recycle_phase" || return 1
    grep -Fqx "session_id=$session_id" "$repo_dir/worker_recycle_phase" || return 1
    return 0
  fi
  for pid in $(_worker_session_pids "$session_id"); do
    start="$(ps -o lstart= -p "$pid" 2>/dev/null | sed 's/^ *//;s/ *$//' || true)"
    [[ -n "$start" ]] || continue
    members+="$pid|$start"$'\n'
  done
  kill -0 "$session_id" 2>/dev/null || return 1
  temporary="$repo_dir/worker_recycle_phase.tmp.$$"
  {
    printf 'version=1\n'
    printf 'identity=%s\n' "$identity"
    printf 'process_group=%s\n' "$process_group"
    printf 'session_id=%s\n' "$session_id"
    printf 'phase=retiring\n'
    while IFS= read -r member; do
      if [[ -n "$member" ]]; then
        printf 'member=%s\n' "$member"
      fi
    done <<< "$members"
    true
  } > "$temporary" || { rm -f "$temporary"; return 1; }
  mv "$temporary" "$repo_dir/worker_recycle_phase" || {
    rm -f "$temporary"
    return 1
  }
}

_worker_session_pids() {
  ps -axo pid=,sid= 2>/dev/null | awk -v sid="$1" '$2 == sid { print $1 }'
}

_terminal_worker_process_group() {
  local repo_dir="$1" identity="$2"
  local pane_fields pane_pid recorded_pid recorded_pgid recorded_sid recorded_start actual_start actual_pgid actual_sid

  recorded_pid="$(cat "$repo_dir/worker_pid" 2>/dev/null || true)"
  recorded_pgid="$(cat "$repo_dir/worker_process_group" 2>/dev/null || true)"
  recorded_start="$(cat "$repo_dir/worker_process_start" 2>/dev/null || true)"
  recorded_sid="$(cat "$repo_dir/worker_session_id" 2>/dev/null || true)"
  if [[ -z "$recorded_pid" || -z "$recorded_pgid" || -z "$recorded_sid" || -z "$recorded_start" ]]; then
    return 2
  fi
  [[ "$recorded_pid" =~ ^[1-9][0-9]*$ && \
    "$recorded_pgid" =~ ^[1-9][0-9]*$ && "$recorded_sid" =~ ^[1-9][0-9]*$ && -n "$recorded_start" ]] || return 1
  pane_fields="${identity#*|}"
  pane_fields="${pane_fields#*|}"
  pane_pid="${pane_fields%%|*}"
  [[ "$pane_pid" == "$recorded_pid" && "$recorded_pid" == "$recorded_pgid" && "$recorded_pid" == "$recorded_sid" ]] || return 1
  if kill -0 "$recorded_pid" 2>/dev/null; then
    actual_start="$(ps -o lstart= -p "$recorded_pid" 2>/dev/null | sed 's/^ *//;s/ *$//' || true)"
    actual_pgid="$(ps -o pgid= -p "$recorded_pid" 2>/dev/null | tr -d ' ' || true)"
    actual_sid="$(ps -o sid= -p "$recorded_pid" 2>/dev/null | tr -d ' ' || true)"
    [[ "$actual_start" == "$recorded_start" && "$actual_pgid" == "$recorded_pgid" && "$actual_sid" == "$recorded_sid" ]] || return 1
  fi
  printf '%s|%s\n' "$recorded_pgid" "$recorded_sid"
}

_stop_terminal_worker_process_group() {
  local process_group="$1" session_id="$2" live_pids pid
  [[ -n "$process_group" ]] || return 0
  live_pids="$(_worker_session_pids "$session_id")"
  for pid in $live_pids; do kill -TERM "$pid" 2>/dev/null || true; done
  for _ in $(seq 1 10); do
    live_pids="$(_worker_session_pids "$session_id")"
    [[ -z "$live_pids" ]] && return 0
    sleep 0.05
  done
  live_pids="$(_worker_session_pids "$session_id")"
  for pid in $live_pids; do
    kill -KILL "$pid" 2>/dev/null || true
  done
  for _ in $(seq 1 20); do
    live_pids="$(_worker_session_pids "$session_id")"
    [[ -z "$live_pids" ]] && return 0
    sleep 0.05
  done
  return 1
}

_clear_terminal_recycle_diagnostic() {
  local repo_dir="$1" diagnostic
  diagnostic="$(cat "$repo_dir/diagnostic" 2>/dev/null || true)"
  case "$diagnostic" in
    terminal\ worker\ process*|injected\ interruption\ after\ terminal\ pane\ kill)
      rm -f "$repo_dir/diagnostic"
      ;;
  esac
}

_recycle_terminal_worker() {
  local repo_dir="$1"
  local pane pane_id worktree_path identity process_identity process_group session_id process_status prior_diagnostic

  # Settle the accepted action lease before the pane is taken away.  Recycling
  # used to stop the only process that could ever publish completion, which is
  # how a completed turn became permanently unrecoverable: sgt-respond and
  # sgt-recover then both refused the lease as prior-supervisor-owned.
  worktree_path="$(cat "$repo_dir/worktree" 2>/dev/null || true)"
  if [[ -n "$worktree_path" && -d "$worktree_path" ]]; then
    _SGT_RESPONSE_LOCK_DIR=""
    _sgt_finalize_action_lease "$repo_dir" "$worktree_path" "terminal_recycle" || true
  fi

  pane="$(cat "$repo_dir/pane" 2>/dev/null || true)"
  if [[ -z "$pane" ]]; then
    prior_diagnostic="$(cat "$repo_dir/diagnostic" 2>/dev/null || true)"
    {
      [[ -z "$prior_diagnostic" ]] || printf '%s\n' "$prior_diagnostic"
      printf 'terminal worker has no recorded pane; process retirement is unproven\n'
    } > "$repo_dir/diagnostic"
    return 1
  fi
  identity="$(_sgt_read_owned_file "$repo_dir/pane_identity" 2>/dev/null || true)"
  if [[ -z "$identity" ]]; then
    printf 'terminal worker process provenance is incomplete; refusing recycle: %s\n' \
      "$pane" > "$repo_dir/diagnostic"
    return 1
  fi
  if process_identity="$(_terminal_worker_process_group "$repo_dir" "$identity")"; then
    process_group="${process_identity%%|*}"
    session_id="${process_identity##*|}"
  else
    process_status=$?
    if [[ "$process_status" -eq 2 ]]; then
      printf 'terminal worker process provenance is incomplete; refusing recycle: %s\n' \
        "$pane" > "$repo_dir/diagnostic"
    else
      printf 'terminal worker process identity does not match; refusing recycle: %s\n' \
        "$pane" > "$repo_dir/diagnostic"
    fi
    return 1
  fi
  # Already retired this exact pane and process group: nothing to do.
  _recycle_evidence_covers "$repo_dir" "$identity" "$process_group" && return 0
  if ! _load_or_record_recycle_phase "$repo_dir" "$identity" "$process_group" "$session_id"; then
    printf 'terminal worker retirement phase could not be established safely: %s\n' \
      "$pane" > "$repo_dir/diagnostic"
    return 1
  fi

  if ! command -v tmux >/dev/null 2>&1; then
    printf 'terminal worker could not be recycled because tmux is unavailable\n' > "$repo_dir/diagnostic"
    return 1
  fi
  # `display-message -t <gone>` silently falls back to the default target, so the
  # returned pane id must be compared rather than the exit status trusted.
  pane_id="$(tmux display-message -p -t "$pane" '#{pane_id}' 2>/dev/null || true)"
  if [[ "$pane_id" != "$pane" ]]; then
    if ! _stop_terminal_worker_process_group "$process_group" "$session_id"; then
      printf 'terminal worker process group did not stop: %s\n' \
        "$process_group" > "$repo_dir/diagnostic"
      return 1
    fi
    _record_recycle_evidence "$repo_dir" "$pane" "$identity" "$process_group" || return 1
    rm -f "$repo_dir/worker_recycle_phase"
    _clear_terminal_recycle_diagnostic "$repo_dir"
    return 0
  fi
  if ! _pane_is_supervisor "$pane" "$repo_dir"; then
    # Write a diagnostic that names a supported next step (issue #203).
    # sgt-cleanup retires the record without killing an unrelated pane.
    local _task_id _repo_name
    _task_id="$(basename "$(dirname "$repo_dir")")"
    _repo_name="$(basename "$repo_dir")"
    printf 'terminal worker pane identity does not match; refusing recycle (pane: %s). Run: sgt-cleanup %s\n' \
      "$pane" "$_task_id" > "$repo_dir/diagnostic"
    return 1
  fi
  if ! tmux kill-pane -t "$pane" 2>/dev/null ||
     [[ "$(tmux display-message -p -t "$pane" '#{pane_id}' 2>/dev/null || true)" == "$pane" ]]; then
    printf 'failed to recycle terminal worker pane: %s\n' "$pane" > "$repo_dir/diagnostic"
    return 1
  fi
  if [[ "${SGT_WATCH_RECYCLE_FAIL_POINT:-}" == "after-pane-kill" ]]; then
    printf 'injected interruption after terminal pane kill\n' > "$repo_dir/diagnostic"
    return 1
  fi
  if ! _stop_terminal_worker_process_group "$process_group" "$session_id"; then
    printf 'terminal worker process group did not stop: %s\n' \
      "$process_group" > "$repo_dir/diagnostic"
    return 1
  fi
  _record_recycle_evidence "$repo_dir" "$pane" "$identity" "$process_group" || return 1
  rm -f "$repo_dir/worker_recycle_phase"
  _clear_terminal_recycle_diagnostic "$repo_dir"
  return 0
}

_dispatch_is_expired() {
  local repo_dir="$1"
  local grace now started

  grace="${SERGEANT_DISPATCH_GRACE_SECONDS:-300}"
  [[ "$grace" =~ ^[0-9]+$ ]] || _die "SERGEANT_DISPATCH_GRACE_SECONDS must be a non-negative integer"
  started="$(cat "$repo_dir/dispatch_started" 2>/dev/null || true)"
  if [[ ! "$started" =~ ^[0-9]+$ ]]; then
    started="$(stat -c %Y "$repo_dir/status" 2>/dev/null || stat -f %m "$repo_dir/status" 2>/dev/null || true)"
  fi
  [[ "$started" =~ ^[0-9]+$ ]] || return 1
  now="$(date +%s)"
  (( now >= started && now - started >= grace ))
}

# _clear_stall_diagnostic: remove the stall diagnostic if and only if the
# current diagnostic is an owned stall diagnostic. Never removes other
# diagnostics (orphan, dispatch failure, etc.).
_clear_stall_diagnostic() {
  local repo_dir="$1" existing
  existing="$(cat "$repo_dir/diagnostic" 2>/dev/null || true)"
  if [[ "$existing" == "live worker stalled:"* ]]; then
    rm -f "$repo_dir/diagnostic"
  fi
}

# _classify_stalled_worker: detect a live-but-idle in_progress worker.
# Progress evidence: tmux pane_activity timestamp (any terminal output from the agent,
# including tool calls and long-running commands) takes precedence over progress_ts.
# progress_ts (written by sgt-interactive-worker at startup and on sentinel-file changes)
# acts as a secondary fallback when pane_activity is unavailable or stale.
# Sets a nonterminal stall diagnostic; never changes status.
# Rewrites diagnostic only when stall state changes or elapsed bucket advances
# (SERGEANT_STALL_DIAG_BUCKET, default 60s) to prevent noisy watch redraws every sync.
_classify_stalled_worker() {
  local repo_dir="$1" worktree="$2"
  local grace now last_event elapsed pane_for_activity pane_activity
  local was_stalled existing_elapsed existing bucket

  grace="${SERGEANT_STALL_GRACE_SECONDS:-300}"
  [[ "$grace" =~ ^[0-9]+$ ]] || return 0

  now="${SERGEANT_STALL_NOW:-$(date +%s)}"

  # Primary evidence: progress_ts written by sgt-interactive-worker.
  last_event="$(cat "$repo_dir/progress_ts" 2>/dev/null || true)"
  [[ "$last_event" =~ ^[0-9]+$ ]] || last_event=0

  # Supplement with tmux pane activity timestamp: tracks any agent output to the
  # terminal (tool calls, streamed continuations, long-running commands). This is
  # the authoritative liveness signal — pgrep-based child checks would incorrectly
  # treat sgt-interactive-worker's own delivery loop as meaningful activity.
  pane_for_activity="$(cat "$repo_dir/pane" 2>/dev/null || true)"
  if [[ -n "$pane_for_activity" ]] && command -v tmux >/dev/null 2>&1; then
    pane_activity="$(tmux display-message -p -t "$pane_for_activity" '#{pane_activity}' 2>/dev/null || true)"
    if [[ "$pane_activity" =~ ^[0-9]+$ ]] && (( pane_activity > last_event )); then
      last_event="$pane_activity"
    fi
  fi

  # Final fallback: mtime of .sergeant-status when no timestamped evidence exists.
  if (( last_event == 0 )) && [[ -f "$worktree/.sergeant-status" ]]; then
    last_event="$(stat -c %Y "$worktree/.sergeant-status" 2>/dev/null || \
                  stat -f %m "$worktree/.sergeant-status" 2>/dev/null || true)"
  fi
  [[ "$last_event" =~ ^[1-9][0-9]*$ ]] || return 0

  if (( now >= last_event && now - last_event >= grace )); then
    elapsed=$(( now - last_event ))

    # Only rewrite the diagnostic when the stall is newly detected or the elapsed
    # bucket changes — avoids a full watch redraw on every sync-interval tick.
    was_stalled=false
    existing_elapsed=0
    existing="$(cat "$repo_dir/diagnostic" 2>/dev/null || true)"
    if [[ "$existing" == "live worker stalled:"* ]]; then
      was_stalled=true
      existing_elapsed="$(printf '%s' "$existing" | grep -oE 'for [0-9]+s' | grep -oE '[0-9]+' | head -1 || true)"
      [[ "$existing_elapsed" =~ ^[0-9]+$ ]] || existing_elapsed=0
    fi

    bucket="${SERGEANT_STALL_DIAG_BUCKET:-60}"
    [[ "$bucket" =~ ^[1-9][0-9]*$ ]] || bucket=60

    if ! $was_stalled || (( elapsed / bucket != existing_elapsed / bucket )); then
      printf 'live worker stalled: no progress for %ds (grace=%ds); last event at epoch %s\n' \
        "$elapsed" "$grace" "$last_event" > "$repo_dir/diagnostic"
    fi
  else
    _clear_stall_diagnostic "$repo_dir"
  fi
}

# _committed_work_log: emit a one-line-per-commit log of work committed above
# the dispatch base in the recorded worktree.  Uses initial_sha when present
# (written by sgt-dispatch).  Returns empty string when no committed work is
# detected, when initial_sha is absent (pre-existing fleet state), or when
# git is unavailable.
_committed_work_log() {
  local repo_dir="$1"
  local worktree_path initial_sha log_output
  worktree_path="$(cat "$repo_dir/worktree" 2>/dev/null || true)"
  [[ -n "$worktree_path" && -d "$worktree_path" ]] || return 0
  command -v git >/dev/null 2>&1 || return 0
  initial_sha="$(cat "$repo_dir/initial_sha" 2>/dev/null || true)"
  if [[ -n "$initial_sha" ]]; then
    log_output="$(git -C "$worktree_path" log --oneline "${initial_sha}..HEAD" 2>/dev/null || true)"
  else
    # Fallback for fleet states predating initial_sha: show commits not in the
    # upstream tracking branch (if configured).  Suppresses output silently
    # when no upstream is set.
    log_output="$(git -C "$worktree_path" log --oneline HEAD --not "@{u}" 2>/dev/null || true)"
  fi
  printf '%s' "${log_output:-}"
}

_reconcile_incomplete_dispatch() {
  local repo_dir="$1"
  local pane

  pane="$(cat "$repo_dir/pane" 2>/dev/null || true)"
  if _dispatch_is_expired "$repo_dir"; then
    if [[ -z "$pane" ]] || { command -v tmux >/dev/null 2>&1 &&
         ! _pane_is_supervisor "$pane" "$repo_dir"; }; then
      local committed_log
      committed_log="$(_committed_work_log "$repo_dir")"
      if [[ -n "$committed_log" ]]; then
        # The dispatch was interrupted after committing work.  Surface the
        # commits so the coordinator can reconcile before re-dispatching.
        printf 'failed: dispatch incomplete: committed work present; reconcile before re-dispatch\n' \
          > "$repo_dir/status"
        {
          printf 'dispatch interrupted after committed work in worktree; reconcile branch before recovery\n'
          printf '%s\n' "$committed_log"
        } > "$repo_dir/diagnostic"
      else
        printf 'failed: dispatch incomplete: no worktree or owned live pane\n' > "$repo_dir/status"
        printf 'dispatch never acquired a worktree or owned live pane\n' > "$repo_dir/diagnostic"
      fi
    fi
  fi
}

_sync_task() {
  local task_id="$1"
  local task_dir="$FLEET_DIR/$task_id"
  local recycle_failed=false
  [[ -d "$task_dir" ]] || _die "Task not found: $task_id (looked in $FLEET_DIR)"

  for repo_dir in "$task_dir"/*/; do
    [[ -d "$repo_dir" ]] || continue
    local worktree wt_status fleet_status pane
    fleet_status="$(cat "$repo_dir/status" 2>/dev/null || echo "")"
    worktree="$(cat "$repo_dir/worktree" 2>/dev/null || echo "")"
    if [[ -z "$worktree" || ! -d "$worktree" ]]; then
      if [[ "$fleet_status" == "dispatched" ]]; then
        _reconcile_incomplete_dispatch "$repo_dir"
      elif [[ "$fleet_status" == "in_progress" ]]; then
        printf 'orphaned\n' > "$repo_dir/status"
        printf 'in-progress worker recorded worktree is unavailable; reconcile preserved branch and handoff before recovery\n' > "$repo_dir/diagnostic"
      fi
      case "$fleet_status" in
        done|failed:*|drained)
          if ! _recycle_terminal_worker "$repo_dir"; then
            printf 'WARNING: terminal worker was not recycled: %s\n' "$repo_dir" >&2
            recycle_failed=true
          fi
          ;;
      esac
      continue
    fi

    if [[ -f "$worktree/.sergeant-status" ]]; then
      wt_status="$(tr -d '\n' < "$worktree/.sergeant-status")"
      if [[ "$wt_status" != "$fleet_status" ]]; then
        echo "$wt_status" > "$repo_dir/status"
      fi
    else
      wt_status="${fleet_status:-in_progress}"
      if [[ "$wt_status" == "dispatched" ]]; then
        _reconcile_incomplete_dispatch "$repo_dir"
        wt_status="$(cat "$repo_dir/status" 2>/dev/null || echo "$wt_status")"
      fi
    fi

    case "$wt_status" in
      done|failed:*)
        if [[ -f "$worktree/.sergeant-result" ]]; then
          cp "$worktree/.sergeant-result" "$repo_dir/result" 2>/dev/null || true
        else
          rm -f "$repo_dir/result"
        fi
        ;;
      *) rm -f "$repo_dir/result" ;;
    esac

    if [[ -f "$worktree/.sergeant-message" ]]; then
      cp "$worktree/.sergeant-message" "$repo_dir/message" 2>/dev/null || true
    else
      rm -f "$repo_dir/message"
    fi

    if [[ "$wt_status" == "done" && ! -s "$worktree/.sergeant-result" ]]; then
      printf 'orphaned\n' > "$worktree/.sergeant-status"
      printf 'orphaned\n' > "$repo_dir/status"
      printf 'terminal status done requires result\n' > "$repo_dir/diagnostic"
      "$SCRIPT_DIR/sgt-td-memory" handoff "$repo_dir" "$worktree" || true
      continue
    fi

    # Recycle every safely terminal state.  `drained` was recognised throughout
    # sgt-watch but never recycled, so a cooperatively drained worker kept its
    # pane and its agent process indefinitely.  Nonterminal and unreconciled
    # states — in_progress, needs_input, blocked, waiting, orphaned — are
    # deliberately excluded: they are resumable and must fail closed.
    case "$wt_status" in
      done|failed:*|drained)
        if ! _recycle_terminal_worker "$repo_dir"; then
          # Emit a warning with a supported recovery command so the operator
          # knows the exact next step (issue #203).
          local _warn_task _warn_repo _warn_recycle_diagnostic
          _warn_task="$(basename "$(dirname "$repo_dir")")"
          _warn_repo="$(basename "$repo_dir")"
          _warn_recycle_diagnostic="$(cat "$repo_dir/diagnostic" 2>/dev/null || true)"
          printf 'WARNING: terminal worker was not recycled: %s/%s\n' \
            "$_warn_task" "$_warn_repo" >&2
          if [[ -n "$_warn_recycle_diagnostic" ]]; then
            printf '  reason: %s\n' "$_warn_recycle_diagnostic" >&2
          fi
          printf '  to retire manually: sgt-cleanup %s\n' "$_warn_task" >&2
          printf '  to inspect state:   sgt-watch %s --snapshot\n' "$_warn_task" >&2
          recycle_failed=true
        fi
        ;;
    esac

    case "$wt_status" in
      done|failed:*)
        # If this fleet task is part of a dagr run, advance the DAG
        _sgt_dagr_advance "$repo_dir" "$wt_status"
        ;;
    esac

    case "$wt_status" in
      in_progress)
        pane="$(cat "$repo_dir/pane" 2>/dev/null || true)"
        if [[ -z "$pane" ]]; then
          printf 'orphaned\n' > "$worktree/.sergeant-status"
          printf 'orphaned\n' > "$repo_dir/status"
          printf 'in-progress worker has no recorded worker pane; resume with sgt-respond\n' > "$repo_dir/diagnostic"
          "$SCRIPT_DIR/sgt-td-memory" handoff "$repo_dir" "$worktree" || true
        elif command -v tmux >/dev/null 2>&1 && ! _pane_is_supervisor "$pane" "$repo_dir"; then
          printf 'orphaned\n' > "$worktree/.sergeant-status"
          printf 'orphaned\n' > "$repo_dir/status"
          printf 'recorded pane %s is dead or is not the expected worker supervisor; resume with sgt-respond\n' "$pane" > "$repo_dir/diagnostic"
          "$SCRIPT_DIR/sgt-td-memory" handoff "$repo_dir" "$worktree" || true
        else
          # Pane is live — classify for stall based on progress evidence
          _classify_stalled_worker "$repo_dir" "$worktree"
        fi
        ;;
      *)
        # Clear owned stall diagnostics when status transitions out of in_progress
        _clear_stall_diagnostic "$repo_dir"
        ;;
    esac
  done

  if [[ -e "$task_dir/.callbacks/origin.json" || -L "$task_dir/.callbacks/origin.json" ]]; then
    "$SCRIPT_DIR/sgt-callback" sync "$task_id"
  fi
  $recycle_failed && return 1
  return 0
}

if [[ "${1:-}" == "--sync-all" ]]; then
  task_count=0
  sync_failed=false
  if [[ -d "$FLEET_DIR" ]]; then
    for task_dir in "$FLEET_DIR"/*/; do
      [[ -d "$task_dir" ]] || continue
      if ! _sync_task "$(basename "$task_dir")"; then
        sync_failed=true
      fi
      task_count=$((task_count + 1))
    done
  fi
  printf 'Reconciled %s fleet tasks.\n' "$task_count"
  $sync_failed && exit 1
  exit 0
fi

if [[ "${1:-}" == "--sync" ]]; then
  [[ $# -ge 2 ]] || _die "Usage: sgt-watch --sync <task-id>"
  _sync_task "$2"
  exit 0
fi

[[ $# -ge 1 ]] || _die "Usage: sgt-watch <task-id> | --list | --sync <task-id> | --sync-all"
TASK_ID="$1"
TASK_DIR="$FLEET_DIR/$TASK_ID"
[[ -d "$TASK_DIR" ]] || _die "Task not found: $TASK_ID (looked in $FLEET_DIR)"

brief_line="$(grep '^Brief:' "$TASK_DIR/brief.md" 2>/dev/null | sed 's/^Brief: *//' || echo "$TASK_ID")"
echo "=== sgt-watch: $brief_line ==="
echo "task: $TASK_ID"
echo "fleet: $TASK_DIR"
echo "polling every ${POLL_INTERVAL}s — Ctrl-C to detach"
echo ""

_print_status() {
  local task_dir="$1"
  local all_terminal=true
  local any_failed=false

  for repo_dir in "$task_dir"/*/; do
    [[ -d "$repo_dir" ]] || continue
    repo_name="$(basename "$repo_dir")"
    status="$(cat "$repo_dir/status" 2>/dev/null || echo "unknown")"
    result="$(cat "$repo_dir/result" 2>/dev/null || echo "")"
    message="$(cat "$repo_dir/message" 2>/dev/null || echo "")"
    diagnostic="$(cat "$repo_dir/diagnostic" 2>/dev/null || echo "")"
    stage="$(cat "$repo_dir/stage" 2>/dev/null || echo "implementation")"
    validation_status="$(cat "$repo_dir/validation_status" 2>/dev/null || echo "")"

    case "$status" in
      done)                  icon="✓" ;;
      drained)               icon="⊘" ;;
      failed*|orphaned)      icon="✗"; any_failed=true ;;
      needs_input)           icon="?"; all_terminal=false ;;
      blocked)               icon="!"; all_terminal=false ;;
      waiting)               icon="⏸"; all_terminal=false ;;
      in_progress|dispatched) icon="…"; all_terminal=false ;;
      *)                     icon="·"; all_terminal=false ;;
    esac

    printf "  %s  %-20s  %s  [stage=%s" "$icon" "$repo_name" "$status" "$stage"
    [[ -z "$validation_status" ]] || printf " validation=%s" "$validation_status"
    printf "]\n"
    [[ -z "$result" ]] || printf "       %-20s  → %s\n" "" "$result"
    if [[ -n "$message" ]]; then
      while IFS= read -r line; do printf "       %-20s  %s\n" "" "$line"; done <<< "$message"
    fi
    if [[ -n "$diagnostic" ]]; then
      while IFS= read -r line; do printf "       %-20s  %s\n" "" "$line"; done <<< "$diagnostic"
    fi
  done

  echo ""
  $any_failed && return 2
  $all_terminal && return 0
  return 1
}

LAST_SNAPSHOT=""
HAVE_SNAPSHOT=false
while true; do
  _sync_task "$TASK_ID"
  current_snapshot=""
  notify_marker="$(cat "$TASK_DIR/notify" 2>/dev/null || true)"
  current_snapshot+="notify:$notify_marker "
  for repo_dir in "$TASK_DIR"/*/; do
    [[ -d "$repo_dir" ]] || continue
    repo_name="$(basename "$repo_dir")"
    status="$(cat "$repo_dir/status" 2>/dev/null || echo "unknown")"
    message="$(cat "$repo_dir/message" 2>/dev/null || echo "")"
    diagnostic="$(cat "$repo_dir/diagnostic" 2>/dev/null || echo "")"
    stage="$(cat "$repo_dir/stage" 2>/dev/null || echo "implementation")"
    validation_status="$(cat "$repo_dir/validation_status" 2>/dev/null || echo "")"
    current_snapshot+="$repo_name:$status:$stage:$validation_status:$message:$diagnostic "
  done

  if ! $HAVE_SNAPSHOT || [[ "$LAST_SNAPSHOT" != "$current_snapshot" ]]; then
    LAST_SNAPSHOT="$current_snapshot"
    HAVE_SNAPSHOT=true
    date '+%H:%M:%S'
    if _print_status "$TASK_DIR"; then
      echo "All repos done."
      echo ""
      any_results=false
      for repo_dir in "$TASK_DIR"/*/; do
        result="$(cat "$repo_dir/result" 2>/dev/null || echo "")"
        if [[ -n "$result" ]]; then
          echo "  $(basename "$repo_dir"): $result"
          any_results=true
        fi
      done
      $any_results && echo ""
      exit 0
    else
      print_status=$?
      if [[ "$print_status" -eq 2 ]]; then
        echo "Fleet finished with failures."
        exit 1
      fi
    fi
  fi
  sleep "$POLL_INTERVAL"
done
