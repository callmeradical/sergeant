#!/usr/bin/env bash
# sgt-undrain — Remove a drain record for a project or globally.
#
# Usage:
#   sgt-undrain --global
#   sgt-undrain <project>
#
# Removing the drain explicitly restores admission for that scope.
# Idempotent: undrain when not drained exits 0.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=bin/_sgt-drain.sh
source "$SCRIPT_DIR/_sgt-drain.sh"

# ── Parse args ────────────────────────────────────────────────────────────────

GLOBAL=false
TARGET=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --global)
      GLOBAL=true
      shift
      ;;
    -*)
      printf 'ERROR: unknown option: %s\n' "$1" >&2
      exit 1
      ;;
    *)
      if [[ -z "$TARGET" ]]; then
        TARGET="$1"
        shift
      else
        printf 'ERROR: unexpected argument: %s\n' "$1" >&2
        exit 1
      fi
      ;;
  esac
done

# ── Remove drain ──────────────────────────────────────────────────────────────

if $GLOBAL; then
  [[ -z "$TARGET" ]] || { printf 'ERROR: --global and <project> are mutually exclusive\n' >&2; exit 1; }
  _sgt_drain_remove_global
  printf 'global drain cleared\n'
  exit 0
fi

if [[ -n "$TARGET" ]]; then
  [[ "$TARGET" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || \
    { printf 'ERROR: invalid project name: %s\n' "$TARGET" >&2; exit 1; }
  _sgt_drain_remove_project "$TARGET"
  printf '%s drain cleared\n' "$TARGET"
  exit 0
fi

printf 'ERROR: specify --global or a project name\n' >&2
exit 1
