#!/usr/bin/env bash
# sgt-msg-list — List messages in a project inbox (human-readable)
#
# Usage:
#   sgt-msg-list <project> [--all] [--agent <agent>]
#
# Options:
#   --all           Show all messages including read ones (default: unread only)
#   --agent <agent> Filter to messages for a specific agent (also includes broadcast)
#
# Output: formatted table with id, from, to, sent_at, read, body preview
# Exit:   0

set -euo pipefail

_die() { echo "error: $*" >&2; exit 1; }

[[ $# -lt 1 ]] && _die "Usage: sgt-msg-list <project> [--all] [--agent <agent>]"

PROJECT="$1"; shift

SHOW_ALL=0
AGENT=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --all)   SHOW_ALL=1; shift ;;
    --agent) AGENT="$2"; shift 2 ;;
    *) _die "Unknown flag: $1" ;;
  esac
done

DB_DIR="${SERGEANT_MSG_DB_DIR:-$HOME/.sergeant/messages}"
DB="$DB_DIR/${PROJECT}.db"

if [[ ! -f "$DB" ]]; then
  echo "(no messages database for project: $PROJECT)"
  exit 0
fi

UNREAD_CLAUSE=""
[[ $SHOW_ALL -eq 0 ]] && UNREAD_CLAUSE="AND read_at IS NULL"

AGENT_CLAUSE=""
[[ -n "$AGENT" ]] && AGENT_CLAUSE="AND (to_agent='${AGENT}' OR to_agent='broadcast')"

printf "%-16s  %-14s  %-14s  %-20s  %-4s  %s\n" "ID" "FROM" "TO" "SENT_AT" "READ" "BODY"
printf "%-16s  %-14s  %-14s  %-20s  %-4s  %s\n" "----------------" "--------------" "--------------" "--------------------" "----" "----"

sqlite3 "$DB" > /dev/null 2>&1 "PRAGMA journal_mode=WAL;" || true
sqlite3 -cmd ".timeout 1000" "$DB" -separator $'\t' \
  "SELECT id, from_agent, to_agent, sent_at, CASE WHEN read_at IS NULL THEN 'no' ELSE 'yes' END, substr(body,1,60)
   FROM messages
   WHERE 1=1 ${UNREAD_CLAUSE} ${AGENT_CLAUSE}
   ORDER BY sent_at ASC;" \
| while IFS=$'\t' read -r id from to sent_at read body; do
    printf "%-16s  %-14s  %-14s  %-20s  %-4s  %s\n" "$id" "$from" "$to" "$sent_at" "$read" "$body"
  done
