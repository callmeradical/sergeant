#!/usr/bin/env bash
# sgt-uninstall — Remove everything this checkout installed.
#
# Usage:
#   sgt-uninstall [--hooks-only]
#
#   --hooks-only   Remove only this repository's git hooks, keeping the command
#                  links. Used by `mise run uninstall:hooks`.
#
# Environment:
#   SGT_INSTALL_DIR   Directory holding the command links (default ~/.local/bin)
#
# The inverse of bin/sgt-install: it removes command links and git hooks, but
# only while they still point at a file in this checkout. A real file, or a link
# to another checkout or to a user's own command, is left untouched and reported.
#
# The sweep is driven by the target directory rather than only by the current
# manifest, so a link left behind by a command that a later version renamed or
# removed is still cleaned up.

set -euo pipefail

# Resolved with parameter expansion rather than the repo's usual
# $(dirname "${BASH_SOURCE[0]}") idiom: this command runs before the toolchain
# exists and its tests exercise it on a deliberately minimal PATH, where an
# external dirname may be absent.
_self="${BASH_SOURCE[0]}"
case "$_self" in
  */*) SCRIPT_DIR="$(cd "${_self%/*}" && pwd)" ;;
  *) SCRIPT_DIR="$(pwd)" ;;
esac
# shellcheck source=_sgt-install-manifest.sh
source "$SCRIPT_DIR/_sgt-install-manifest.sh"

ROOT_DIR="$(_sgt_install_script_root "$_self")"
TARGET_DIR="$(_sgt_install_target_dir)"

hooks_only=false
while (($#)); do
  case "$1" in
    --hooks-only) hooks_only=true ;;
    *) printf 'sgt-uninstall: unknown option: %s\nUsage: sgt-uninstall [--hooks-only]\n' "$1" >&2; exit 2 ;;
  esac
  shift
done

removed=0
kept=0

managed_globs="$(_sgt_install_managed_globs)" || exit 1
deprecated_links="$(_sgt_install_deprecated_links "$ROOT_DIR" "$TARGET_DIR")" || exit 1

if ! "$hooks_only"; then
  # Sweep every name this checkout claims, not just the ones it currently ships.
  while IFS= read -r pattern; do
    [[ -n "$pattern" ]] || continue
    for target in "$TARGET_DIR"/$pattern; do
      [[ -L "$target" ]] || continue
      if _sgt_install_link_points_into "$target" "$ROOT_DIR"; then
        rm "$target"
        printf '  removed: %s\n' "$target"
        removed=$((removed + 1))
      else
        printf '  kept (not owned by this checkout): %s\n' "$target"
        kept=$((kept + 1))
      fi
    done
  done <<< "$managed_globs"

  # Deprecated links this checkout may still own are cleaned up here too, so an
  # uninstall does not leave an oc-inject link behind.
  while IFS= read -r deprecated_entry; do
    [[ -n "$deprecated_entry" ]] || continue
    deprecated_link="${deprecated_entry%%::*}"
    owned_target="${deprecated_entry##*::}"
    [[ -L "$deprecated_link" ]] || continue
    [[ "$(_sgt_install_resolve_link "$deprecated_link")" == "$owned_target" ]] || continue
    rm "$deprecated_link"
    printf '  removed: %s\n' "$deprecated_link"
    removed=$((removed + 1))
  done <<< "$deprecated_links"
fi

# Remove the git hooks sgt-install created, so uninstall really is its inverse.
hooks_src="$ROOT_DIR/scripts/hooks"
if hooks_dst="$(_sgt_install_hooks_dir "$ROOT_DIR")"; then
  if [[ -d "$hooks_src" && -d "$hooks_dst" ]]; then
    for hook in "$hooks_src"/*; do
      [[ -f "$hook" ]] || continue
      hook_target="$hooks_dst/${hook##*/}"
      [[ -L "$hook_target" ]] || continue
      if [[ "$(_sgt_install_resolve_link "$hook_target")" == "$hook" ]]; then
        rm "$hook_target"
        printf '  removed hook: %s\n' "$hook_target"
        removed=$((removed + 1))
      else
        printf '  kept hook (not owned by this checkout): %s\n' "$hook_target"
        kept=$((kept + 1))
      fi
    done
  fi
fi

printf '\nRemoved %d entries installed from %s\n' "$removed" "$ROOT_DIR"
printf 'Kept %d entries owned by something else\n' "$kept"
