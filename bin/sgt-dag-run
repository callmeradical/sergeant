#!/usr/bin/env bash
# sgt-dag-run — Create and start a dagr run from a Sergeant project's DAG definition.
#
# Reads the `dag:` block from ~/.config/sergeant/<project>.yaml, creates the
# DAG in dagr if it doesn't exist, starts a run, and dispatches all initially
# ready stages via sgt-dispatch.
#
# Usage:
#   sgt-dag-run <project>
#   sgt-dag-run <project> --dry-run
#
# Project YAML dag block format:
#   dag:
#     name: my-workflow
#     stages:
#       - name: foundation
#         td: td-abc123          # optional: use a td task for the brief
#         repos: [sergeant]      # repos to dispatch to
#         brief: "Fix the thing" # optional: explicit brief (overrides td)
#       - name: phase-two
#         td: td-def456
#         repos: [sergeant]
#         after: [foundation]    # stage dependencies
#
# The stage hook calls sgt-dispatch and writes dagr tracking files into the
# fleet state so sgt-watch can auto-advance the DAG when tasks complete.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/_sgt-lib.sh"

[[ $# -ge 1 ]] || _die "Usage: sgt-dag-run <project> [--dry-run]"

PROJECT="$1"
DRY_RUN=false
[[ "${2:-}" == "--dry-run" ]] && DRY_RUN=true

command -v dagr >/dev/null 2>&1 || _die "dagr is not installed (optional dependency).
  Install: go install github.com/callmeradical/dagr/cmd/dagr@latest
  Docs:    https://github.com/callmeradical/dagr
  All other Sergeant commands work without dagr."
command -v yq >/dev/null 2>&1    || _die "yq is required to parse project YAML"

CONFIG_FILE="${SERGEANT_CONFIG:-$HOME/.config/sergeant}/${PROJECT}.yaml"
[[ -f "$CONFIG_FILE" ]] || _die "Project config not found: $CONFIG_FILE"

# Read dag block
DAG_NAME="$(yq '.dag.name // ""' "$CONFIG_FILE" | tr -d '\n')"
[[ -n "$DAG_NAME" ]] || _die "No 'dag.name' in $CONFIG_FILE"

STAGE_COUNT="$(yq '.dag.stages | length' "$CONFIG_FILE" | tr -d '\n')"
[[ "${STAGE_COUNT:-0}" -gt 0 ]] || _die "No stages defined in dag block of $CONFIG_FILE"

printf 'sgt-dag-run: project=%s dag=%s stages=%s\n' "$PROJECT" "$DAG_NAME" "$STAGE_COUNT"

if $DRY_RUN; then
  printf '  [dry-run] would create/update dag %q with %s stages\n' "$DAG_NAME" "$STAGE_COUNT"
fi

# ── Create DAG if it doesn't exist ────────────────────────────────────────────

DAG_DESC="$(yq '.dag.description // ""' "$CONFIG_FILE" | tr -d '\n')"
if ! $DRY_RUN; then
  # Create or verify dag exists — dagr returns error on duplicate, ignore it
  dagr dag create "$DAG_NAME" --description "$DAG_DESC" 2>/dev/null || true
fi

# ── Create/verify stages ──────────────────────────────────────────────────────

for i in $(seq 0 $((STAGE_COUNT - 1))); do
  stage_name="$(yq ".dag.stages[$i].name" "$CONFIG_FILE" | tr -d '\n')"
  stage_brief="$(yq ".dag.stages[$i].brief // \"\"" "$CONFIG_FILE" | tr -d '\n')"
  stage_td="$(yq ".dag.stages[$i].td // \"\"" "$CONFIG_FILE" | tr -d '\n')"
  stage_repos="$(yq ".dag.stages[$i].repos // [] | join(\",\")" "$CONFIG_FILE" | tr -d '\n')"
  stage_after="$(yq ".dag.stages[$i].after // [] | join(\",\")" "$CONFIG_FILE" | tr -d '\n')"

  # Build the hook command
  dispatch_args="$PROJECT"
  if [[ -n "$stage_td" ]]; then
    dispatch_args+=" --td $stage_td"
  fi
  if [[ -n "$stage_repos" ]]; then
    dispatch_args+=" --repos $stage_repos"
  fi
  if [[ -n "$stage_brief" && -z "$stage_td" ]]; then
    dispatch_args+=" \"$stage_brief\""
  fi

  # Hook: dispatch the stage and write dagr tracking files into the fleet state
  hook="${SCRIPT_DIR}/sgt-dag-dispatch-hook $dispatch_args"

  if $DRY_RUN; then
    printf '  [dry-run] stage %q after=[%s] hook: %s\n' "$stage_name" "$stage_after" "$hook"
    continue
  fi

  # Add stage (ignore error if already exists)
  add_args=("$DAG_NAME" "$stage_name" --hook "$hook")
  [[ -n "$stage_after" ]] && add_args+=(--depends-on "$stage_after")
  dagr stage add "${add_args[@]}" 2>/dev/null || true
done

$DRY_RUN && exit 0

# ── Start the run ─────────────────────────────────────────────────────────────

printf 'sgt-dag-run: starting run for dag %q...\n' "$DAG_NAME"
RUN_OUTPUT="$(dagr run start "$DAG_NAME")"
printf '%s\n' "$RUN_OUTPUT"

RUN_ID="$(printf '%s\n' "$RUN_OUTPUT" | grep -oE '[0-9a-f-]{36}'| head -1 || true)"
if [[ -z "$RUN_ID" ]]; then
  # Try extracting ULID format
  RUN_ID="$(printf '%s\n' "$RUN_OUTPUT" | awk '/started run/{print $3}' | head -1)"
fi

printf 'sgt-dag-run: run started — use "dagr run watch %s" to monitor\n' "${RUN_ID:-<run-id>}"
