#!/usr/bin/env bash
# sgt-graphify — Run graphify across all repos in a project, publishing atomically
#
# Reads graphify.output from the project YAML, extracts each configured repo,
# and merges the results into one project graph.
#
# Publication is atomic: concurrent readers observe either the complete old
# output or the complete new output throughout the run — never a partial or
# missing state.  The publish directory is placed via _publish_parent_for_output
# so the final rename never crosses filesystem boundaries.
#
# Usage: sgt-graphify <project>

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=_sgt-lib.sh
source "$SCRIPT_DIR/_sgt-lib.sh"

_require_graphify() {
  command -v graphify &>/dev/null || _die "graphify is required. See graphify documentation to install."
}

_python_is_supported() {
  local candidate="$1"
  [[ -n "$candidate" && -x "$candidate" ]] || return 1
  "$candidate" -c 'import sys; raise SystemExit(0 if sys.version_info[0] == 3 else 1)' >/dev/null 2>&1
}

_require_python_runtime() {
  local candidate=""
  local graphify_bin=""
  local shebang=""
  local words=()
  local idx

  # Prefer Graphify's own interpreter so source rewriting follows the same
  # runtime constraints even if a different `python` appears earlier on PATH.
  graphify_bin="$(command -v graphify 2>/dev/null || true)"
  if [[ -n "$graphify_bin" && -r "$graphify_bin" ]]; then
    IFS= read -r shebang < "$graphify_bin" || true
    if [[ "$shebang" == '#!'* ]]; then
      read -r -a words <<< "${shebang#\#!}"
      if [[ ${#words[@]} -gt 0 ]]; then
        if [[ "${words[0]}" == */env ]]; then
          for ((idx=1; idx<${#words[@]}; idx++)); do
            [[ "${words[$idx]}" == -* ]] && continue
            if candidate="$(command -v "${words[$idx]}" 2>/dev/null)"; then
              if _python_is_supported "$candidate"; then
                GRAPHIFY_PYTHON="$candidate"
                return
              fi
            fi
          done
        elif _python_is_supported "${words[0]}"; then
          GRAPHIFY_PYTHON="${words[0]}"
          return
        fi
      fi
    fi
  fi

  if candidate="$(command -v python3 2>/dev/null)"; then
    if _python_is_supported "$candidate"; then
      GRAPHIFY_PYTHON="$candidate"
      return
    fi
  fi
  if candidate="$(command -v python 2>/dev/null)"; then
    if _python_is_supported "$candidate"; then
      GRAPHIFY_PYTHON="$candidate"
      return
    fi
  fi

  _die "python3 or python is required to rewrite merged Graphify sources"
}

_trim_trailing_slashes() {
  local path="$1"
  while [[ "$path" != "/" && "$path" == */ ]]; do
    path="${path%/}"
  done
  printf '%s\n' "$path"
}

_resolve_normalized_path() {
  _trim_trailing_slashes "$(_resolve_path "$1")"
}

# Resolve all symlink components in a path, including parent directories.
# Works even when the leaf component does not yet exist: resolves the deepest
# existing directory prefix with cd + pwd -P, then appends remaining path
# components unchanged.  Requires no external tools beyond bash.
_canonicalize_path() {
  local p="$1"
  local parent leaf resolved_parent
  if [[ -d "$p" ]]; then
    (cd "$p" && pwd -P)
    return
  fi
  parent="$(dirname "$p")"
  leaf="${p##*/}"
  if [[ "$parent" == "$p" ]]; then
    # Reached the filesystem root; cannot recurse further.
    printf '%s\n' "$p"
    return
  fi
  resolved_parent="$(_canonicalize_path "$parent")"
  printf '%s/%s\n' "$resolved_parent" "$leaf"
}

# Return the canonical location of a path entry: resolve all symlinks in the
# parent directory chain but do NOT follow the final component.  This gives the
# real directory that contains the entry, so a symlink that lives inside a repo
# (e.g. api/graphify-out -> external) is still detected as being inside the repo
# even though its canonical target is elsewhere.
_location_canonical() {
  local p="$1"
  printf '%s/%s\n' "$(_canonicalize_path "$(dirname "$p")")" "${p##*/}"
}

_path_is_within() {
  local candidate="$1"
  local root="$2"
  [[ "$candidate" == "$root" || "$candidate" == "$root/"* ]]
}

[[ $# -ge 1 ]] || _die "Usage: sgt-graphify <project>"
PROJECT="$1"
CONFIG_FILE="$SERGEANT_CONFIG/$PROJECT.yaml"
[[ -f "$CONFIG_FILE" ]] || _die "Project not found: $PROJECT (looked for $CONFIG_FILE)"
_require_yq
_require_graphify
_require_python_runtime

configured_output="$(yq '.graphify.output // ""' "$CONFIG_FILE")"
if [[ -z "$configured_output" || "$configured_output" == "null" ]]; then
  _die "No graphify.output configured in $CONFIG_FILE"
fi
configured_output="$(_resolve_normalized_path "$configured_output")"
if [[ -L "$configured_output" && ! -d "$configured_output" ]]; then
  _die "graphify.output is a broken directory symlink: $configured_output"
fi
graphify_output="$(_canonicalize_path "$configured_output")"

repo_count="$(yq '.repos | length' "$CONFIG_FILE")"
ALL_REPO_PATHS=()
for ((i=0; i<repo_count; i++)); do
  ALL_REPO_PATHS+=("$(_canonicalize_path "$(_resolve_normalized_path "$(yq ".repos[$i].path" "$CONFIG_FILE")")")")
done

_path_is_in_source_repo() {
  local candidate="$1"
  local repo_path=""
  for repo_path in "${ALL_REPO_PATHS[@]}"; do
    if _path_is_within "$candidate" "$repo_path"; then
      return 0
    fi
  done
  return 1
}

_publish_parent_for_output() {
  local candidate="$1"
  local parent=""
  while _path_is_in_source_repo "$candidate"; do
    parent="$(dirname "$candidate")"
    [[ "$parent" != "$candidate" ]] || break
    candidate="$parent"
  done
  printf '%s\n' "$candidate"
}

# Build include_groups list for filtering (bash 3 compatible)
INCLUDE_GROUPS=""
if yq '.graphify.include_groups // []' "$CONFIG_FILE" 2>/dev/null | grep -q '[^][]'; then
  INCLUDE_GROUPS="$(yq '.graphify.include_groups[]' "$CONFIG_FILE" 2>/dev/null | tr '\n' ',' | sed 's/,$//')"
fi

_in_include_groups() {
  local group="$1"
  [[ -z "$INCLUDE_GROUPS" ]] && return 0  # no filter → include all
  [[ -z "$group" || "$group" == "null" ]] && return 1
  echo ",$INCLUDE_GROUPS," | grep -q ",${group},"
}

echo "=== sgt-graphify: $PROJECT ==="
echo "output: $configured_output"
echo ""

output_parent="$(dirname "$graphify_output")"
mkdir -p "$output_parent"
run_root="$(mktemp -d "${TMPDIR:-/tmp}/sgt-graphify.XXXXXX")"

# ── Publication state ─────────────────────────────────────────────────────────
# publish_root: temp dir for the staged publish copy (set after build).
# old_backup:   path of the old output moved aside; restored on failure.
# tmp_sym:      temp symlink created during atomic symlink swap; removed on failure.
# new_backing_dir: new backing dir for symlink swap; removed on failure.
publish_root=""
published=0
old_backup=""
tmp_sym=""
new_backing_dir=""

_restore_old_output() {
  # Called on failure before exit: if we moved the old output away and
  # haven't yet published the new one, put the old output back.
  [[ $published -eq 1 ]] && return 0
  [[ -z "$old_backup" ]] && return 0
  [[ -e "$old_backup" || -L "$old_backup" ]] || return 0
  if [[ ! -e "$configured_output" && ! -L "$configured_output" ]]; then
    mv "$old_backup" "$configured_output" || true
  fi
}

_cleanup() {
  local status=$?
  trap - EXIT
  _restore_old_output
  # Clean up leftover temp symlink if atomic rename didn't happen.
  if [[ -n "$tmp_sym" && -e "$tmp_sym" ]]; then rm -f "$tmp_sym"; fi
  # Clean up new backing dir if symlink swap failed or was never attempted.
  if [[ $published -eq 0 && -n "$new_backing_dir" && -e "$new_backing_dir" ]]; then
    rm -rf "$new_backing_dir"
  fi
  if [[ -n "$publish_root" ]]; then
    rm -rf "$publish_root"
  fi
  rm -rf "$run_root"
  # Only remove old_backup on success.  On failure it may still be the live
  # backing directory for a symlink-configured output (removing it would leave
  # a dangling symlink at configured_output).
  if [[ $published -eq 1 && -n "$old_backup" ]]; then rm -rf "$old_backup" 2>/dev/null; fi
  exit "$status"
}
trap _cleanup EXIT
stage_root="$run_root/project"
stage_output="$stage_root/graphify-out"
mkdir -p "$stage_output" "$run_root/repos" "$run_root/manifests" "$run_root/sources"

TAR_EXCLUDE_ARGS=()
while IFS= read -r pattern; do
  [[ -n "$pattern" && "$pattern" != "null" ]] || continue
  TAR_EXCLUDE_ARGS+=("--exclude=$pattern")
done < <(yq '.graphify.exclude_patterns[]' "$CONFIG_FILE" 2>/dev/null || true)

GRAPH_PATHS=()
MANIFEST_PARTS=()
INCLUDED_REPOS=()
FAILED_REPOS=()
SOURCE_ROOT_REPOS=()
SOURCE_ROOT_PATHS=()

_prefix_graph_sources() {
  local repo_name="$1"
  local input_graph="$2"
  local output_graph="$3"
  REPO_NAME="$repo_name" INPUT_GRAPH="$input_graph" OUTPUT_GRAPH="$output_graph" "$GRAPHIFY_PYTHON" - <<'PY'
import json
import os
from pathlib import Path

repo_name = os.environ["REPO_NAME"]
input_graph = Path(os.environ["INPUT_GRAPH"])
output_graph = Path(os.environ["OUTPUT_GRAPH"])

def prefix_value(value):
    if isinstance(value, str) and value and not Path(value).is_absolute():
        return f"{repo_name}/{value}"
    return value

def rewrite(payload):
    if isinstance(payload, dict):
        updated = {}
        for key, value in payload.items():
            if key == "source_file":
                updated[key] = prefix_value(value)
            elif key == "source_files" and isinstance(value, list):
                updated[key] = [prefix_value(item) for item in value]
            else:
                updated[key] = rewrite(value)
        return updated
    if isinstance(payload, list):
        return [rewrite(item) for item in payload]
    return payload

with input_graph.open(encoding="utf-8") as fh:
    payload = json.load(fh)

output_graph.write_text(json.dumps(rewrite(payload), indent=2) + "\n", encoding="utf-8")
PY
}

_write_graphify_root() {
  local source_root="$stage_output/.graphify_sources"
  # Use configured_output (the user-facing path) so .graphify_root stays valid
  # even after a symlink-based atomic publication replaces the backing directory.
  local final_source_root="$configured_output/.graphify_sources"
  local idx
  mkdir -p "$source_root"
  for ((idx=0; idx<${#SOURCE_ROOT_REPOS[@]}; idx++)); do
    ln -s "${SOURCE_ROOT_PATHS[$idx]}" "$source_root/${SOURCE_ROOT_REPOS[$idx]}"
  done
  printf '%s\n' "$final_source_root" > "$stage_output/.graphify_root"
}

_extract_repo() {
  local path="$1"
  local repo_root="$2"
  local repo_name="$3"
  local scan_root="$path"
  local should_stage=0
  local output_path=""
  local output_relative=""
  # Build the set of output paths to check for containment within this repo.
  # Use the location-canonical form (parent resolved, final component kept as-is)
  # so that a symlink entry inside the repo (e.g. api/graphify-out -> external)
  # is still detected, and so that symlinked parent directories of the output
  # also canonicalize to the real repo path for correct matching.
  local _output_loc
  _output_loc="$(_location_canonical "$configured_output")"
  local output_paths=("$_output_loc")
  local tar_exclude_args=("${TAR_EXCLUDE_ARGS[@]}")
  # Also include the fully canonical form (follows all symlinks) in case the
  # canonical target itself falls inside a repo.
  if [[ "$graphify_output" != "$_output_loc" ]]; then
    output_paths+=("$graphify_output")
  fi
  if [[ ${#tar_exclude_args[@]} -gt 0 ]]; then
    should_stage=1
  fi
  for output_path in "${output_paths[@]}"; do
    if [[ "$output_path" == "$path" ]]; then
      echo "graphify.output must not replace source repository $path" >&2
      return 1
    elif [[ "$output_path" == "$path/"* ]]; then
      output_relative="${output_path#"$path/"}"
      tar_exclude_args+=(
        "--exclude=$output_relative"
        "--exclude=$output_relative/**"
        "--exclude=./$output_relative"
        "--exclude=./$output_relative/**"
      )
      should_stage=1
    fi
  done
  if [[ $should_stage -eq 1 ]]; then
    # Stage outside the repo whenever exclusions apply so current Graphify CLIs
    # never re-ingest filtered paths or a published graph nested in source.
    scan_root="$run_root/sources/$repo_name"
    mkdir -p "$scan_root"
    tar -C "$path" "${tar_exclude_args[@]}" -cf - . | tar -C "$scan_root" -xf -
  fi
  # When no supported LLM API key is available, pass --code-only so graphify
  # indexes code via local AST without attempting semantic (LLM) extraction.
  # Without this flag, graphify aborts the entire run when it encounters
  # doc/paper/image files and no key is set (issue #86).
  local extract_extra_args=()
  if [[ -z "${ANTHROPIC_API_KEY:-}" && \
        -z "${OPENAI_API_KEY:-}" && \
        -z "${GEMINI_API_KEY:-}" && \
        -z "${KIMI_API_KEY:-}" && \
        -z "${DEEPSEEK_API_KEY:-}" && \
        -z "${OPENROUTER_API_KEY:-}" ]]; then
    extract_extra_args+=("--code-only")
  fi
  graphify extract "$scan_root" --out "$repo_root" "${extract_extra_args[@]}"
}

for ((i=0; i<repo_count; i++)); do
  repo_name="$(yq ".repos[$i].name" "$CONFIG_FILE")"
  raw_path="$(yq ".repos[$i].path" "$CONFIG_FILE")"
  path="$(_canonicalize_path "$(_resolve_normalized_path "$raw_path")")"
  group="$(yq ".repos[$i].group // \"\"" "$CONFIG_FILE")"

  if ! _in_include_groups "$group"; then
    echo "--- $repo_name (skipped — not in include_groups) ---"
    continue
  fi

  INCLUDED_REPOS+=("$repo_name")

  if [[ ! "$repo_name" =~ ^[A-Za-z0-9._-]+$ || "$repo_name" == "." || "$repo_name" == ".." ]]; then
    echo "--- $repo_name ---"
    echo "  ERROR: repos[].name \"$repo_name\" must match [A-Za-z0-9._-]+; rename it in $CONFIG_FILE"
    FAILED_REPOS+=("$repo_name")
    continue
  fi

  if [[ ! -d "$path" ]]; then
    echo "--- $repo_name ---"
    echo "  ERROR: repository is not cloned at $path"
    FAILED_REPOS+=("$repo_name")
    continue
  fi

  echo "--- $repo_name ---"
  echo "  path: $path"
  repo_root="$run_root/repos/$repo_name"
  if _extract_repo "$path" "$repo_root" "$repo_name" 2>&1 | sed 's/^/  /'; then
    repo_output="$repo_root/graphify-out"
    if [[ ! -s "$repo_output/graph.json" || ! -s "$repo_output/manifest.json" ]]; then
      echo "  ERROR: graphify did not produce graph.json and manifest.json for $repo_name"
      FAILED_REPOS+=("$repo_name")
    else
      prefixed_graph="$repo_root/graphify-out/prefixed-graph.json"
      _prefix_graph_sources "$repo_name" "$repo_output/graph.json" "$prefixed_graph"
      GRAPH_PATHS+=("$prefixed_graph")
      manifest_part="$run_root/manifests/$repo_name.json"
      REPO_NAME="$repo_name" yq -o=json \
        'with_entries(.key = strenv(REPO_NAME) + "/" + .key)' \
        "$repo_output/manifest.json" > "$manifest_part"
      MANIFEST_PARTS+=("$manifest_part")
      SOURCE_ROOT_REPOS+=("$repo_name")
      SOURCE_ROOT_PATHS+=("$path")
    fi
  else
    echo "  ERROR: graphify extraction failed for $repo_name"
    FAILED_REPOS+=("$repo_name")
  fi
  echo ""
done

if [[ ${#INCLUDED_REPOS[@]} -eq 0 ]]; then
  _die "No repositories matched graphify.include_groups"
fi

if [[ ${#FAILED_REPOS[@]} -gt 0 ]]; then
  echo "ERROR: graphify failed for repositories: ${FAILED_REPOS[*]}" >&2
  exit 1
fi

if [[ ${#GRAPH_PATHS[@]} -eq 1 ]]; then
  cp "${GRAPH_PATHS[0]}" "$stage_output/graph.json"
elif ! graphify merge-graphs "${GRAPH_PATHS[@]}" --out "$stage_output/graph.json" 2>&1 | sed 's/^/  /'; then
  echo "ERROR: graph merge failed for repositories: ${INCLUDED_REPOS[*]}" >&2
  exit 1
fi

# yq, not the shell, expands $item.
# shellcheck disable=SC2016
if ! yq ea -o=json '. as $item ireduce ({}; . * $item)' \
  "${MANIFEST_PARTS[@]}" > "$stage_output/manifest.json"; then
  echo "ERROR: manifest merge failed for repositories: ${INCLUDED_REPOS[*]}" >&2
  exit 1
fi

if ! graphify cluster-only "$stage_root" --graph "$stage_output/graph.json" \
  --no-label --no-viz 2>&1 | sed 's/^/  /'; then
  echo "ERROR: report generation failed for repositories: ${INCLUDED_REPOS[*]}" >&2
  exit 1
fi

for artifact in graph.json manifest.json GRAPH_REPORT.md; do
  if [[ ! -s "$stage_output/$artifact" ]]; then
    echo "ERROR: project graph is missing $artifact after processing repositories: ${INCLUDED_REPOS[*]}" >&2
    exit 1
  fi
done

_write_graphify_root

# Keep user-facing graph extensions that are not regenerated by this command.
for preserved_dir in wiki memory; do
  if [[ -d "$graphify_output/$preserved_dir" ]]; then
    cp -R "$graphify_output/$preserved_dir" "$stage_output/$preserved_dir"
  fi
done

# ── Atomic publication ────────────────────────────────────────────────────────
#
# Copy the staged output into a publish directory that lives outside any source
# repo (via _publish_parent_for_output) so the final rename never crosses a
# filesystem boundary.
publish_root="$(mktemp -d "$(_publish_parent_for_output "$output_parent")"/.sgt-graphify.publish.XXXXXX)"
publish_dir="$publish_root/graphify-out"
mkdir -p "$publish_dir"
tar -C "$stage_output" -cf - . | tar -C "$publish_dir" -xf -

publish_parent="$(dirname "$configured_output")"

echo "=== done: publishing ==="
echo ""

# No prior output: simple rename into place.
if [[ ! -e "$configured_output" && ! -L "$configured_output" ]]; then
  mv "$publish_dir" "$configured_output"
  published=1

# Symlink whose entry is inside a source repo: write into the symlink target
# (following the symlink) via directory replacement, leaving the symlink itself
# unchanged.  The target may be outside all source repos (the typical case for
# an in-repo graphify-out symlink pointing to an external store).
elif [[ -L "$configured_output" ]] && _path_is_in_source_repo "$(_location_canonical "$configured_output")"; then
  # graphify_output is already the canonical target path.
  old_backup="$(mktemp -u "$(dirname "$graphify_output")/.sgt-graphify-old.XXXXXX")"
  mv "$graphify_output" "$old_backup"
  if ! mv "$publish_dir" "$graphify_output"; then
    mv "$old_backup" "$graphify_output" || true
    old_backup=""
    _die "Could not publish project graph to $configured_output"
  fi
  published=1
  rm -rf "$old_backup"
  old_backup=""

# Symlink outside source repos: atomically replace the symlink via a temporary
# symlink rename.  mv -T (GNU coreutils) calls rename(2) directly so it
# replaces the symlink in one atomic operation rather than following it to the
# backing directory.
elif [[ -L "$configured_output" ]]; then
  old_link_target="$(readlink "$configured_output")"
  # Resolve to absolute path so cleanup can remove it unambiguously.
  if [[ "$old_link_target" == /* ]]; then
    old_backup="$old_link_target"
  else
    old_backup="$publish_parent/$old_link_target"
  fi

  # Move the publish dir to a stable location in the same parent directory as
  # configured_output so the relative symlink target remains valid after rename.
  new_backing_dir="$publish_parent/.sgt-graphify-live.$$"
  mv "$publish_dir" "$new_backing_dir"

  # Create a temp symlink pointing at the basename of the new backing dir.
  tmp_sym="$publish_parent/.sgt-graphify-nextsym.$$"
  ln -sfn "$(basename "$new_backing_dir")" "$tmp_sym"
  # Atomically replace the old symlink.
  if ! mv -T "$tmp_sym" "$configured_output"; then
    rm -f "$tmp_sym"
    tmp_sym=""
    _die "Could not publish project graph to $configured_output"
  fi
  tmp_sym=""       # moved into place; _cleanup must not delete it
  published=1
  new_backing_dir=""  # now the live backing dir; _cleanup must not delete it

  # Remove the old backing directory now that the symlink is live.
  rm -rf "$old_backup" 2>/dev/null || true
  old_backup=""    # already removed; prevent double-removal in _cleanup

# Regular directory: brief double rename.
# The window between the two renames is one rename(2) syscall long.
else
  old_backup="$(mktemp -u "$output_parent/.sgt-graphify-old.XXXXXX")"
  mv "$configured_output" "$old_backup"
  if ! mv "$publish_dir" "$configured_output"; then
    # Restore the old output and let _cleanup clean the publish_root.
    mv "$old_backup" "$configured_output" || true
    old_backup=""
    _die "Could not publish project graph to $configured_output"
  fi
  published=1

  # Remove the old output now that the new one is live.
  rm -rf "$old_backup"
  old_backup=""
fi

echo "Graph report available at: $configured_output/GRAPH_REPORT.md"
