#!/usr/bin/env bash
# sgt-td-list — Show td tasks across all repos in a project
#
# Queries each repo's td database and prints a unified view.
# Requires td to be installed and initialized in each repo.
#
# Usage:
#   sgt-td-list <project>                    # open tasks across all repos
#   sgt-td-list <project> --all              # all non-closed statuses
#   sgt-td-list <project> --status open      # specific status
#   sgt-td-list <project> --priority P1      # filter by priority
#   sgt-td-list <project> --repos smith,smith-app  # specific repos only
#   sgt-td-list <project> --json             # machine-readable output
#
# Exit status:
#   0  the report covers every requested repo completely
#   1  the invocation or environment is unusable (nothing was reported)
#   2  the report is incomplete: a repo was unreadable or a cap withheld tasks
#      (details on stderr; stdout still holds everything that could be read)
#
# Task limits:
#   `td list` defaults to `--limit 50`, which silently truncates any repo with a
#   larger backlog.  sgt-td-list therefore always passes an explicit limit and
#   escalates it until td returns a complete answer.  A caller-supplied --limit
#   always wins.  Any residual truncation is reported on stderr, never hidden.
#
#   SGT_TD_LIST_LIMIT      initial per-repo limit (default 1000)
#   SGT_TD_LIST_MAX_LIMIT  escalation ceiling     (default 100000)
#
#   An initial limit above the ceiling is clamped to the ceiling; completeness
#   is unaffected, and a repo that reaches the ceiling still warns on stderr.
#
# Status filter:
#   The default view is `--filter status=open`, which is printed in the header
#   and therefore explicit.  It excludes non-closed work in in_progress,
#   blocked and in_review; use --all for every non-closed task.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=_sgt-lib.sh
source "$SCRIPT_DIR/_sgt-lib.sh"

_require_td() {
  command -v td &>/dev/null || _die "td is required. See your td installation."
}

_require_python3() {
  # Every read parses, counts and renders JSON through python3, so a missing
  # interpreter must fail once and loudly instead of once per repo.
  command -v python3 &>/dev/null || _die "python3 is required."
}

[[ $# -ge 1 ]] || _die "Usage: sgt-td-list <project> [options]"
PROJECT="$1"; shift

CONFIG_FILE="$SERGEANT_CONFIG/$PROJECT.yaml"
[[ -f "$CONFIG_FILE" ]] || _die "Project not found: $PROJECT"
_require_yq
_require_td
_require_python3

# ── Parse options ─────────────────────────────────────────────────────────────

STATUS_FILTER="open"
PRIORITY_FILTER=""
REPOS_ARG=""
JSON_OUT=false
TD_ALL=false
EXTRA_FLAGS=()

_need_value() { [[ $# -ge 2 ]] || _die "$1 requires a value"; }

while [[ $# -gt 0 ]]; do
  case "$1" in
    --all)           TD_ALL=true;            shift   ;;
    --status)        _need_value "$@"; STATUS_FILTER="$2";   shift 2 ;;
    --priority)      _need_value "$@"; PRIORITY_FILTER="$2"; shift 2 ;;
    --repos)         _need_value "$@"; REPOS_ARG="$2";       shift 2 ;;
    --json)          JSON_OUT=true;          shift   ;;
    *)               EXTRA_FLAGS+=("$1");    shift   ;;
  esac
done

# Build td filter expression
TD_FILTER=""
if ! $TD_ALL && [[ -n "$STATUS_FILTER" ]]; then
  TD_FILTER="status=$STATUS_FILTER"
fi
if [[ -n "$PRIORITY_FILTER" ]]; then
  if [[ -n "$TD_FILTER" ]]; then
    TD_FILTER="$TD_FILTER AND priority=$PRIORITY_FILTER"
  else
    TD_FILTER="priority=$PRIORITY_FILTER"
  fi
fi

# ── Temporary workspace ───────────────────────────────────────────────────────
# One workspace for every mode, cleaned up on any exit, so an interrupted run
# leaves nothing behind and a broken TMPDIR fails once instead of being blamed
# on td.

WORK="$(mktemp -d "${TMPDIR:-/tmp}/sgt-td-list.XXXXXX" 2>/dev/null)" \
  || _die "cannot create a temporary directory in ${TMPDIR:-/tmp}"
trap 'rm -rf "$WORK"' EXIT INT TERM HUP
TD_ERR_FILE="$WORK/td-stderr"

# ── Incompleteness tracking ───────────────────────────────────────────────────
# Warnings alone are invisible to a machine consumer reading stdout, so anything
# that withholds tasks also has to change the exit status.

# Every repo is read inside a command substitution, so a shell variable set
# while warning would be discarded with the subshell.  The marker is a file.
_mark_incomplete() { : > "$WORK/incomplete" 2>/dev/null || true; }
_report_incomplete() { [[ -e "$WORK/incomplete" ]]; }

_truncation_warn() {
  # _truncation_warn <repo> <proven-lower-bound> <cap-description>
  # Never claims an exact total: the cap is what stops us from knowing it.
  _mark_incomplete
  printf 'WARNING: %s: results truncated by %s; at least %s task(s) exist, so this report is incomplete\n' \
    "$1" "$3" "$2" >&2
}

_unreadable_warn() {
  # _unreadable_warn <repo> <reason>
  _mark_incomplete
  printf 'WARNING: %s: %s; its tasks are missing from this report\n' "$1" "$2" >&2
}

# ── Task limits ───────────────────────────────────────────────────────────────
# td list caps results at 50 by default.  Never rely on that default: pass an
# explicit limit and escalate it until the repo is reported completely, so
# per-repo counts and the grand total are true.

TD_LIST_LIMIT="${SGT_TD_LIST_LIMIT:-1000}"
TD_LIST_MAX_LIMIT="${SGT_TD_LIST_MAX_LIMIT:-100000}"

_is_positive_int() { [[ "$1" =~ ^[1-9][0-9]*$ ]]; }

_is_positive_int "$TD_LIST_LIMIT" \
  || _die "SGT_TD_LIST_LIMIT must be a positive integer, got: $TD_LIST_LIMIT"
_is_positive_int "$TD_LIST_MAX_LIMIT" \
  || _die "SGT_TD_LIST_MAX_LIMIT must be a positive integer, got: $TD_LIST_MAX_LIMIT"
[[ "$TD_LIST_LIMIT" -le "$TD_LIST_MAX_LIMIT" ]] || TD_LIST_LIMIT="$TD_LIST_MAX_LIMIT"

# A --limit / -n passed through by the caller always wins over our default, so
# never supplement one — not even a malformed one, which td must reject itself.
USER_LIMIT=""
USER_LIMIT_SET=false
if [[ "${#EXTRA_FLAGS[@]}" -gt 0 ]]; then
  for ((i=0; i<${#EXTRA_FLAGS[@]}; i++)); do
    case "${EXTRA_FLAGS[$i]}" in
      --limit|-n)  USER_LIMIT_SET=true; USER_LIMIT="${EXTRA_FLAGS[$((i+1))]:-}" ;;
      --limit=*)   USER_LIMIT_SET=true; USER_LIMIT="${EXTRA_FLAGS[$i]#--limit=}" ;;
      -n[0-9]*)    USER_LIMIT_SET=true; USER_LIMIT="${EXTRA_FLAGS[$i]#-n}" ;;
    esac
  done
fi

# ── Repo resolution ───────────────────────────────────────────────────────────
# Resolve every configured name→path pair once, as data.  Interpolating a repo
# name into a yq expression lets a crafted name select a different repo's path.

# Names and paths are read as two index-aligned lists, so no delimiter has to
# survive a repo name (yq's @tsv would CSV-quote a name containing a quote).
REPO_NAMES="$WORK/repo-names"
REPO_PATHS="$WORK/repo-paths"
yq -r '[.repos[]?.name] | .[]' "$CONFIG_FILE" > "$REPO_NAMES" \
  || _die "cannot read repo names from $CONFIG_FILE"
yq -r '[.repos[]?.path] | .[]' "$CONFIG_FILE" > "$REPO_PATHS" \
  || _die "cannot read repo paths from $CONFIG_FILE"
[[ -s "$REPO_NAMES" ]] || _die "project $PROJECT declares no repos in $CONFIG_FILE"

_repo_path_for() {
  # _repo_path_for <repo_name> → absolute repo path; 1 when the name is unknown
  local rname="$1" idx=0 name path
  while IFS= read -r name; do
    idx=$((idx + 1))
    [[ "$name" == "$rname" ]] || continue
    path="$(sed -n "${idx}p" "$REPO_PATHS")"
    [[ -n "$path" && "$path" != "null" ]] || return 1
    _resolve_path "$path"
    return 0
  done < "$REPO_NAMES"
  return 1
}

# ── Reading one repo ──────────────────────────────────────────────────────────
# Payloads are two lines.  _td_list_once emits "<total> <published>\n<json>";
# _td_list_tasks narrows that to the public "<published>\n<json>" contract.

_payload_head() { printf '%s' "${1%%$'\n'*}"; }
_payload_json() { printf '%s' "${1#*$'\n'}"; }
_payload_count() { _payload_head "$1"; }

_td_list_once() {
  # _td_list_once <repo_name> <keep|-1> <repo_path> [td flags...]
  #   → "<total returned> <published>\n<json>"
  #
  # Flags after <repo_path> are appended last so they beat anything in
  # EXTRA_FLAGS; that is what lets a single read decide truncation.
  # <keep> trims the published rows without hiding the returned total.
  #
  # Returns 1 when this repo's tasks could not be read, after warning: a repo
  # dropped without a word is exactly how a backlog gets under-reported.  A
  # missing td database is the one expected silent skip.
  local rname="$1" keep="$2" repo_path="$3"
  local code detail head kind message payload raw status=0 parse_status=0 td_err
  shift 3

  : > "$TD_ERR_FILE"
  raw="$(td list --json --work-dir "$repo_path" \
    ${TD_FILTER:+--filter "$TD_FILTER"} \
    "${EXTRA_FLAGS[@]+"${EXTRA_FLAGS[@]}"}" \
    "$@" 2>"$TD_ERR_FILE")" || status=$?
  # Bound the borrowed text: an operator's stderr is not a place for megabytes.
  td_err="$(sed "s/$(printf '\033')\[[0-9;]*m//g" "$TD_ERR_FILE" | head -1 || true)"
  td_err="${td_err:0:200}"

  # td answers a successful query with a JSON array of task objects and a failed
  # one with a JSON error object, so raw stdout is never a task array on faith.
  payload="$(printf '%s' "$raw" | python3 -c "
import sys, json
keep = int(sys.argv[1])
try:
    data = json.load(sys.stdin)
except Exception:
    data = None
if isinstance(data, list) and all(isinstance(t, dict) for t in data):
    tasks = data if keep < 0 else data[:keep]
    sys.stdout.write('ok %d %d\n%s' % (len(data), len(tasks), json.dumps(tasks)))
else:
    code = message = ''
    if isinstance(data, dict):
        err = data.get('error')
        if isinstance(err, dict):
            code = str(err.get('code') or 'error')
            message = ' '.join(str(err.get('message') or '').split())
        elif err:
            code = 'error'
    sys.stdout.write('err %s %s\n[]' % (code or 'unparsable', message))
" "$keep")" || parse_status=$?

  head="$(_payload_head "$payload")"
  kind="${head%% *}"
  detail="${head#* }"

  if [[ "$parse_status" -eq 0 && "$kind" == "ok" ]]; then
    if [[ "$detail" =~ ^[0-9]+\ [0-9]+$ ]]; then
      if [[ "$status" -ne 0 ]]; then
        _unreadable_warn "$rname" \
          "td list exited $status after producing output${td_err:+ ($td_err)}"
        printf '0 0\n[]'
        return 1
      fi
      printf '%s\n%s' "$detail" "$(_payload_json "$payload")"
      return 0
    fi
  fi

  code="${detail%% *}"
  message="${detail#* }"
  [[ "$message" != "$code" ]] || message=""

  # td reports both "no database here" and "this database is unusable" as
  # database_error, so only the absent-database message may be skipped quietly.
  if [[ "$parse_status" -eq 0 && "$kind" == "err" && "$code" == "database_error" ]]; then
    case "$message" in
      *"database not found"*|*"run 'td init'"*)
        printf '0 0\n[]'
        return 0
        ;;
    esac
  fi

  if [[ "$parse_status" -ne 0 ]]; then
    _unreadable_warn "$rname" "could not parse td output (python3 exited $parse_status)"
  elif [[ "$status" -eq 0 ]]; then
    _unreadable_warn "$rname" \
      "td list returned output that is not a task array${code:+ [$code]}${message:+: $message}"
  else
    _unreadable_warn "$rname" \
      "td list failed (exit $status)${message:+: $message}${message:+}${td_err:+ ($td_err)}"
  fi
  printf '0 0\n[]'
  return 1
}

_td_list_tasks() {
  # _td_list_tasks <repo_name> <repo_path> → "<published>\n<json>"
  #
  # Asks for one more task than it is willing to publish, so a single response
  # proves whether anything was withheld.  Returns 1 for an unreadable repo.
  local rname="$1" repo_path="$2"
  local head limit payload published total

  if $USER_LIMIT_SET; then
    if _is_positive_int "$USER_LIMIT"; then
      # One request, one snapshot: ask for the caller's limit plus one row and
      # publish only what the caller asked for.
      payload="$(_td_list_once "$rname" "$USER_LIMIT" "$repo_path" \
        --limit "$((USER_LIMIT + 1))")" || return 1
      head="$(_payload_head "$payload")"
      total="${head%% *}"
      published="${head#* }"
      [[ "$total" -le "$USER_LIMIT" ]] \
        || _truncation_warn "$rname" "$total" "the requested --limit $USER_LIMIT"
    else
      # A limit td interprets itself (0 means td's own default, negative means
      # unlimited) or a malformed one: forward it untouched, then re-read one
      # row past what came back to see whether anything was withheld.
      payload="$(_td_list_once "$rname" -1 "$repo_path")" || return 1
      head="$(_payload_head "$payload")"
      published="${head#* }"
      if [[ "$published" -gt 0 ]]; then
        local probe probe_total
        if probe="$(_td_list_once "$rname" -1 "$repo_path" \
              --limit "$((published + 1))")"; then
          probe_total="$(_payload_head "$probe")"
          probe_total="${probe_total%% *}"
          [[ "$probe_total" -le "$published" ]] \
            || _truncation_warn "$rname" "$probe_total" \
                 "the requested --limit $USER_LIMIT (a re-read found more)"
        fi
      fi
    fi
    printf '%s\n%s' "$published" "$(_payload_json "$payload")"
    return 0
  fi

  limit="$TD_LIST_LIMIT"
  while :; do
    payload="$(_td_list_once "$rname" -1 "$repo_path" --limit "$((limit + 1))")" || return 1
    head="$(_payload_head "$payload")"
    total="${head%% *}"
    if [[ "$total" -le "$limit" ]]; then
      printf '%s\n%s' "$total" "$(_payload_json "$payload")"
      return 0
    fi
    if [[ "$limit" -ge "$TD_LIST_MAX_LIMIT" ]]; then
      _truncation_warn "$rname" "$total" \
        "the SGT_TD_LIST_MAX_LIMIT ceiling of $TD_LIST_MAX_LIMIT (raise it to see the rest)"
      printf '%s\n%s' "$total" "$(_payload_json "$payload")"
      return 0
    fi
    limit=$((limit * 2))
    [[ "$limit" -le "$TD_LIST_MAX_LIMIT" ]] || limit="$TD_LIST_MAX_LIMIT"
  done
}

_repo_payload() {
  # _repo_payload <repo_name> <named-explicitly> → "<published>\n<json>"
  # Returns 1 when the repo contributes nothing.  A repo the caller named by
  # hand is never dropped in silence; one merely configured but not cloned is.
  local rname="$1" named="$2" repo_path

  if ! repo_path="$(_repo_path_for "$rname")"; then
    ! $named || _unreadable_warn "$rname" "not configured in $PROJECT.yaml"
    return 1
  fi
  if ! _sgt_is_git_repo "$repo_path"; then
    ! $named || _unreadable_warn "$rname" "not a git checkout at $repo_path"
    return 1
  fi
  _td_list_tasks "$rname" "$repo_path"
}

# ── Resolve target repos ───────────────────────────────────────────────────────

TARGET_REPOS=()
REPOS_NAMED=false

if [[ -n "$REPOS_ARG" ]]; then
  REPOS_NAMED=true
  IFS=',' read -ra TARGET_REPOS <<< "$REPOS_ARG"
else
  while IFS= read -r map_name; do
    [[ -n "$map_name" ]] && TARGET_REPOS+=("$map_name")
  done < "$REPO_NAMES"
fi

# ── Collect tasks per repo ────────────────────────────────────────────────────

if $JSON_OUT; then
  # JSON mode: emit one array of tasks, each tagged with its repo.
  # Per-repo payloads are staged on disk and merged in a single pass: shell
  # string concatenation cannot round-trip JSON safely, and a failed merge must
  # be loud rather than degrade to an empty array.
  JSON_STAGE="$WORK/stage"
  mkdir -p "$JSON_STAGE"

  stage_idx=0
  for rname in "${TARGET_REPOS[@]}"; do
    if [[ -z "$rname" ]]; then
      _unreadable_warn "(empty)" "empty --repos entry"
      continue
    fi

    payload="$(_repo_payload "$rname" "$REPOS_NAMED")" || continue

    [[ "$(_payload_count "$payload")" -eq 0 ]] && continue

    stage_idx=$((stage_idx + 1))
    _payload_json "$payload" > "$JSON_STAGE/$stage_idx.tasks"
    printf '%s\n' "$rname"   > "$JSON_STAGE/$stage_idx.repo"
  done

  python3 -c '
import json, sys
from pathlib import Path

stage = Path(sys.argv[1])
merged = []
for tasks_file in sorted(stage.glob("*.tasks"), key=lambda p: int(p.stem)):
    repo = stage.joinpath(tasks_file.stem + ".repo").read_text().strip()
    for task in json.loads(tasks_file.read_text()):
        task["_repo"] = repo
        merged.append(task)
merged.sort(key=lambda t: (t.get("priority") or "P9", t.get("_repo") or ""))
print(json.dumps(merged, indent=2))
' "$JSON_STAGE" || _die "failed to merge td task JSON for project $PROJECT"
  ! _report_incomplete || exit 2
  exit 0
fi

# ── Human-readable output ─────────────────────────────────────────────────────

echo "=== $PROJECT tasks$([ -n "$TD_FILTER" ] && echo " [$TD_FILTER]" || true) ==="
echo ""

total=0

for rname in "${TARGET_REPOS[@]}"; do
  if [[ -z "$rname" ]]; then
    _unreadable_warn "(empty)" "empty --repos entry"
    continue
  fi

  # Repos with no td database report zero tasks and are skipped
  payload="$(_repo_payload "$rname" "$REPOS_NAMED")" || continue
  count="$(_payload_count "$payload")"
  [[ "$count" -eq 0 ]] && continue

  # Render before publishing the header and the total: a count with no rows
  # under it is a partial report dressed up as a complete one.
  if ! rows="$(_payload_json "$payload" | python3 -c "
import sys, json
tasks = json.load(sys.stdin)
# Sort by priority then status
order = {'P0':0,'P1':1,'P2':2,'P3':3,'P4':4}
tasks.sort(key=lambda t: (order.get(t.get('priority','P4'), 4), t.get('title','')))
for t in tasks:
    tid    = t.get('id','?')
    title  = t.get('title','')[:65]
    prio   = t.get('priority','')
    status = t.get('status','')
    print(f'   {tid}  [{prio}]  {status:<12}  {title}')
" 2>"$TD_ERR_FILE")"; then
    _unreadable_warn "$rname" \
      "failed to render its $count task(s) ($(head -1 "$TD_ERR_FILE" | cut -c1-120))"
    continue
  fi

  total=$((total + count))
  echo "── $rname ($count)"
  printf '%s\n' "$rows"

  echo ""
done

if [[ $total -eq 0 ]]; then
  echo "No tasks found."
else
  echo "$total task(s) total"
fi

if _report_incomplete; then
  echo "report incomplete: see the warnings on stderr"
  exit 2
fi
