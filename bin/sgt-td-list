#!/usr/bin/env bash
# sgt-td-list — Show td tasks across all repos in a project
#
# Queries each repo's td database and prints a unified view.
# Requires td to be installed and initialized in each repo.
#
# Usage:
#   sgt-td-list <project>                    # every non-closed task, all repos
#   sgt-td-list <project> --status open      # narrow to one status
#   sgt-td-list <project> --priority P1      # filter by priority
#   sgt-td-list <project> --repos smith,smith-app  # specific repos only
#   sgt-td-list <project> --json             # machine-readable output
#   sgt-td-list <project> --all              # accepted; the default already
#                                            # covers every non-closed status
#
# Exit status:
#   0  the report covers every requested repo that is checked out, completely
#   1  the invocation or environment is unusable (nothing was reported)
#   2  the report is incomplete: a repo was unreadable or a cap withheld tasks
#      (details on stderr; stdout still holds everything that could be read)
#
#   A repo configured in the project but not cloned yet is skipped quietly and
#   does not affect the exit status; `sgt-status <project>` shows what is
#   missing and `sgt-sync <project>` clones it.  A repo named explicitly with
#   --repos is never skipped quietly.
#
# Task limits:
#   `td list` defaults to `--limit 50`, which silently truncates any repo with a
#   larger backlog.  sgt-td-list therefore always passes an explicit limit and
#   escalates it until td returns a complete answer.  A caller-supplied --limit
#   always wins.  Any residual truncation is reported on stderr, never hidden.
#
#   SGT_TD_LIST_LIMIT      initial per-repo limit (default 1000)
#   SGT_TD_LIST_MAX_LIMIT  escalation ceiling     (default 100000)
#
#   An initial limit above the ceiling is clamped to the ceiling; completeness
#   is unaffected, and a repo that reaches the ceiling still warns on stderr.
#
# Status filter:
#   The default view is every non-closed task: open, in_progress, in_review and
#   blocked, including deferred ones.  td's own default hides deferred tasks and
#   `td list --deferred` returns only those, so each repo is read twice and the
#   two answers are merged.  A narrower view is opt-in through --status, and the
#   active view is always named in the human header.
#
#   Narrowing uses td's own -s/-p flags.  td applies its closed-and-deferred
#   exclusion to those but not to `--filter`, so `--filter priority=P2` answers
#   with closed tasks while `-p P2` does not.  A caller-supplied `--filter`
#   therefore governs which statuses appear, and the header says so rather than
#   claiming a non-closed view the query does not deliver.
#
#   Before 2026-08, the default narrowed to status=open, which hid in_progress,
#   in_review and blocked work — and any repo whose tasks were all non-open —
#   from a report whose whole job is a truthful backlog.  `--all` is still
#   accepted and still means every non-closed status, which is now the default.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=_sgt-lib.sh
source "$SCRIPT_DIR/_sgt-lib.sh"

_require_td() {
  command -v td &>/dev/null || _die "td is required. See your td installation."
}

_require_python3() {
  # Every read parses, counts and renders JSON through python3, so a missing
  # interpreter must fail once and loudly instead of once per repo.
  command -v python3 &>/dev/null || _die "python3 is required."
}

[[ $# -ge 1 ]] || _die "Usage: sgt-td-list <project> [options]"
PROJECT="$1"; shift

CONFIG_FILE="$SERGEANT_CONFIG/$PROJECT.yaml"
[[ -f "$CONFIG_FILE" ]] || _die "Project not found: $PROJECT"
_require_yq
_require_td
_require_python3

# ── Parse options ─────────────────────────────────────────────────────────────

STATUS_FILTER=""
PRIORITY_FILTER=""
REPOS_ARG=""
JSON_OUT=false
TD_ALL=false
EXTRA_FLAGS=()

_need_value() { [[ $# -ge 2 ]] || _die "$1 requires a value"; }

while [[ $# -gt 0 ]]; do
  case "$1" in
    --all)           TD_ALL=true;            shift   ;;
    --status)        _need_value "$@"; STATUS_FILTER="$2";   shift 2 ;;
    --priority)      _need_value "$@"; PRIORITY_FILTER="$2"; shift 2 ;;
    --repos)         _need_value "$@"; REPOS_ARG="$2";       shift 2 ;;
    --json)          JSON_OUT=true;          shift   ;;
    *)               EXTRA_FLAGS+=("$1");    shift   ;;
  esac
done

# --all used to silently discard an explicit --status.  Say so instead.
if $TD_ALL && [[ -n "$STATUS_FILTER" ]]; then
  _die "--all and --status are mutually exclusive: --all is every non-closed status, which is the default"
fi

# Narrow with td's own -s/-p flags, never with a hand-built --filter expression.
# td applies its closed-and-deferred exclusion to the native flags but NOT to
# --filter, so `--filter priority=P2` answers with closed tasks while `-p P2`
# does not.  The native flags are also the only ones --deferred honours.
TD_NARROW_ARGS=()
if [[ -n "$STATUS_FILTER" ]]; then
  TD_NARROW_ARGS[${#TD_NARROW_ARGS[@]}]="-s"
  TD_NARROW_ARGS[${#TD_NARROW_ARGS[@]}]="$STATUS_FILTER"
fi
if [[ -n "$PRIORITY_FILTER" ]]; then
  TD_NARROW_ARGS[${#TD_NARROW_ARGS[@]}]="-p"
  TD_NARROW_ARGS[${#TD_NARROW_ARGS[@]}]="$PRIORITY_FILTER"
fi

# A caller's own --filter expression bypasses td's exclusions entirely, so that
# view is governed by the caller's TDQ and may contain closed or deferred tasks.
# It also needs no second read, because td already answers with deferred rows.
CALLER_FILTER=false
if [[ "${#EXTRA_FLAGS[@]}" -gt 0 ]]; then
  for ((i=0; i<${#EXTRA_FLAGS[@]}; i++)); do
    case "${EXTRA_FLAGS[$i]}" in
      --filter|-f|--filter=*|-f*) CALLER_FILTER=true ;;
    esac
  done
fi
INCLUDE_DEFERRED=true
$CALLER_FILTER && INCLUDE_DEFERRED=false

# What the reader is actually looking at, stated rather than implied.
if [[ -n "$STATUS_FILTER" && -n "$PRIORITY_FILTER" ]]; then
  VIEW_LABEL="status=$STATUS_FILTER AND priority=$PRIORITY_FILTER"
elif [[ -n "$STATUS_FILTER" ]]; then
  VIEW_LABEL="status=$STATUS_FILTER"
elif [[ -n "$PRIORITY_FILTER" ]]; then
  VIEW_LABEL="all non-closed AND priority=$PRIORITY_FILTER"
else
  VIEW_LABEL="all non-closed"
fi
if $CALLER_FILTER; then
  # Never claim td's exclusions for a query that does not apply them.
  VIEW_LABEL="$VIEW_LABEL; caller --filter governs which statuses appear"
fi

# ── Temporary workspace ───────────────────────────────────────────────────────
# One workspace for every mode, cleaned up on any exit, so an interrupted run
# leaves nothing behind and a broken TMPDIR fails once instead of being blamed
# on td.

WORK="$(mktemp -d "${TMPDIR:-/tmp}/sgt-td-list.XXXXXX" 2>/dev/null)" \
  || _die "cannot create a temporary directory in ${TMPDIR:-/tmp}"
# EXIT only, as everywhere else in bin/: a signal then terminates the shell and
# this trap still runs exactly once.  Trapping the signals themselves would let
# the run continue over a workspace it had just deleted.
trap 'rm -rf "$WORK"' EXIT
TD_ERR_FILE="$WORK/td-stderr"
# The workspace carries the incompleteness marker, so prove it is writable now
# rather than discovering it while trying to report a problem.
: > "$WORK/.probe" 2>/dev/null || _die "temporary directory $WORK is not writable"
rm -f "$WORK/.probe"

# ── Incompleteness tracking ───────────────────────────────────────────────────
# Warnings alone are invisible to a machine consumer reading stdout, so anything
# that withholds tasks also has to change the exit status.

# Every repo is read inside a command substitution, so a shell variable set
# while warning would be discarded with the subshell.  The marker is a file.
# The redirection is ordered so 2>/dev/null is installed before the write that
# might fail; the warning itself is always printed first, so a marker that
# cannot be written still leaves the operator a visible reason.
_mark_incomplete() { : 2>/dev/null > "$WORK/incomplete" || true; }
_report_incomplete() { [[ -e "$WORK/incomplete" ]]; }

_truncation_warn() {
  # _truncation_warn <repo> <exact-total> <cap-description>
  # Used where the repo was read completely and only the published rows were
  # capped, so the total is known.
  printf 'WARNING: %s: results truncated by %s; %s task(s) exist, so this report is incomplete\n' \
    "$1" "$3" "$2" >&2
  _mark_incomplete
}

_ceiling_warn() {
  # _ceiling_warn <repo> <proven-lower-bound> <cap-description>
  # Used at the escalation ceiling, which is the one cap that stops us from
  # learning the true total, so the message claims only what was proven.
  printf 'WARNING: %s: results truncated by %s; at least %s task(s) exist, so this report is incomplete\n' \
    "$1" "$3" "$2" >&2
  _mark_incomplete
}

_unreadable_warn() {
  # _unreadable_warn <repo> <reason>
  printf 'WARNING: %s: %s; its tasks are missing from this report\n' "$1" "$2" >&2
  _mark_incomplete
}

# ── Task limits ───────────────────────────────────────────────────────────────
# td list caps results at 50 by default.  Never rely on that default: pass an
# explicit limit and escalate it until the repo is reported completely, so
# per-repo counts and the grand total are true.

TD_LIST_LIMIT="${SGT_TD_LIST_LIMIT:-1000}"
TD_LIST_MAX_LIMIT="${SGT_TD_LIST_MAX_LIMIT:-100000}"

_is_positive_int() { [[ "$1" =~ ^[1-9][0-9]*$ ]]; }

_is_positive_int "$TD_LIST_LIMIT" \
  || _die "SGT_TD_LIST_LIMIT must be a positive integer, got: $TD_LIST_LIMIT"
_is_positive_int "$TD_LIST_MAX_LIMIT" \
  || _die "SGT_TD_LIST_MAX_LIMIT must be a positive integer, got: $TD_LIST_MAX_LIMIT"
[[ "$TD_LIST_LIMIT" -le "$TD_LIST_MAX_LIMIT" ]] || TD_LIST_LIMIT="$TD_LIST_MAX_LIMIT"

# A --limit / -n passed through by the caller always wins over our default, so
# never supplement one — not even a malformed one, which td must reject itself.
USER_LIMIT=""
USER_LIMIT_SET=false
if [[ "${#EXTRA_FLAGS[@]}" -gt 0 ]]; then
  for ((i=0; i<${#EXTRA_FLAGS[@]}; i++)); do
    case "${EXTRA_FLAGS[$i]}" in
      --limit|-n)  USER_LIMIT_SET=true; USER_LIMIT="${EXTRA_FLAGS[$((i+1))]:-}" ;;
      --limit=*)   USER_LIMIT_SET=true; USER_LIMIT="${EXTRA_FLAGS[$i]#--limit=}" ;;
      -n=*)        USER_LIMIT_SET=true; USER_LIMIT="${EXTRA_FLAGS[$i]#-n=}" ;;
      -n[0-9]*)    USER_LIMIT_SET=true; USER_LIMIT="${EXTRA_FLAGS[$i]#-n}" ;;
    esac
  done
fi

# ── Repo resolution ───────────────────────────────────────────────────────────
# Resolve every configured name→path pair once, as data.  Interpolating a repo
# name into a yq expression lets a crafted name select a different repo's path.

# name/path pairs are staged NUL-delimited, so nothing in a repo name — quotes,
# yq operators, spaces, even a newline — can be mistaken for a delimiter or for
# part of a yq expression.
REPO_MAP="$WORK/repos.nul"
yq -o=json '[.repos[]? | {"name": .name, "path": .path}]' "$CONFIG_FILE" \
  | python3 -c '
import json, sys
for repo in json.load(sys.stdin) or []:
    name = repo.get("name")
    path = repo.get("path")
    sys.stdout.write("%s\0%s\0" % ("" if name is None else name,
                                    "" if path is None else path))
' > "$REPO_MAP" || _die "cannot read repos from $CONFIG_FILE"
[[ -s "$REPO_MAP" ]] || _die "project $PROJECT declares no repos in $CONFIG_FILE"

_repo_path_for() {
  # _repo_path_for <repo_name> → absolute repo path
  #   1  the name is not configured
  #   2  the name is configured with no usable path
  local rname="$1" name path
  while IFS= read -r -d '' name && IFS= read -r -d '' path; do
    [[ "$name" == "$rname" ]] || continue
    [[ -n "$path" && "$path" != "null" ]] || return 2
    _resolve_path "$path"
    return 0
  done < "$REPO_MAP"
  return 1
}

# ── Reading one repo ──────────────────────────────────────────────────────────
# Payloads are two lines.  _td_list_once emits "<total> <published>\n<json>";
# _td_list_tasks narrows that to the public "<published>\n<json>" contract.

_payload_head() { printf '%s' "${1%%$'\n'*}"; }
_payload_json() { printf '%s' "${1#*$'\n'}"; }

_td_list_once() {
  # _td_list_once <repo_name> <keep|-1> <repo_path> [td flags...]
  #   → "<total returned> <published>\n<json>"
  #
  # Flags after <repo_path> are appended last so they beat anything in
  # EXTRA_FLAGS; that is what lets a single read decide truncation.
  # <keep> trims the published rows without hiding the returned total.
  #
  # Returns 1 when this repo's tasks could not be read, after warning: a repo
  # dropped without a word is exactly how a backlog gets under-reported.  A
  # missing td database is the one expected silent skip.
  local rname="$1" keep="$2" repo_path="$3"
  local code detail head kind message payload raw status=0 parse_status=0 td_err
  shift 3

  : > "$TD_ERR_FILE"
  raw="$(td list --json --work-dir "$repo_path" \
    "${TD_NARROW_ARGS[@]+"${TD_NARROW_ARGS[@]}"}" \
    "${EXTRA_FLAGS[@]+"${EXTRA_FLAGS[@]}"}" \
    "$@" 2>"$TD_ERR_FILE")" || status=$?
  # Bound the borrowed text: an operator's stderr is not a place for megabytes.
  # Prefer td's own error line: cobra prints its usage banner first for a flag
  # error, and "(Usage:)" is not a reason anyone can act on.
  td_err="$(sed "s/$(printf '\033')\[[0-9;]*m//g" "$TD_ERR_FILE" \
    | grep -m1 -E '^(ERROR|Error|error)' || true)"
  if [[ -z "$td_err" ]]; then
    td_err="$(sed "s/$(printf '\033')\[[0-9;]*m//g" "$TD_ERR_FILE" \
      | grep -m1 -v -E '^[[:space:]]*(Usage:|Flags:|Aliases:|Global Flags:|)$' || true)"
  fi
  td_err="${td_err:0:200}"

  # td answers a successful query with a JSON array of task objects and a failed
  # one with a JSON error object, so raw stdout is never a task array on faith.
  payload="$(printf '%s' "$raw" | python3 -c "
import sys, json
keep = int(sys.argv[1])
try:
    data = json.load(sys.stdin)
except Exception:
    data = None
if isinstance(data, list) and all(isinstance(t, dict) for t in data):
    tasks = data if keep < 0 else data[:keep]
    sys.stdout.write('ok %d %d\n%s' % (len(data), len(tasks), json.dumps(tasks)))
else:
    code = message = ''
    if isinstance(data, dict):
        err = data.get('error')
        if isinstance(err, dict):
            code = str(err.get('code') or 'error')
            message = ' '.join(str(err.get('message') or '').split())
        elif err:
            code = 'error'
    sys.stdout.write('err %s %s\n[]' % (code or 'unparsable', message))
" "$keep")" || parse_status=$?

  head="$(_payload_head "$payload")"
  kind="${head%% *}"
  detail="${head#* }"

  if [[ "$parse_status" -eq 0 && "$kind" == "ok" ]]; then
    if [[ "$detail" =~ ^[0-9]+\ [0-9]+$ ]]; then
      if [[ "$status" -ne 0 ]]; then
        _unreadable_warn "$rname" \
          "td list exited $status after producing output${td_err:+ ($td_err)}"
        printf '0 0\n[]'
        return 1
      fi
      printf '%s\n%s' "$detail" "$(_payload_json "$payload")"
      return 0
    fi
  fi

  code="${detail%% *}"
  message="${detail#* }"
  [[ "$message" != "$code" ]] || message=""

  # td reports both "no database here" and "this database is unusable" as
  # database_error, so only the absent-database message may be skipped quietly.
  if [[ "$parse_status" -eq 0 && "$kind" == "err" && "$code" == "database_error" ]]; then
    case "$message" in
      *"database not found"*|*"run 'td init'"*)
        printf '0 0\n[]'
        return 0
        ;;
    esac
  fi

  if [[ "$parse_status" -ne 0 ]]; then
    _unreadable_warn "$rname" "could not parse td output (python3 exited $parse_status)"
  elif [[ "$status" -eq 0 ]]; then
    _unreadable_warn "$rname" \
      "td list returned output that is not a task array${code:+ [$code]}${message:+: $message}"
  else
    _unreadable_warn "$rname" \
      "td list failed (exit $status)${message:+: $message}${td_err:+ ($td_err)}"
  fi
  printf '0 0\n[]'
  return 1
}

_merge_reads() {
  # _merge_reads <base-json> <deferred-json> → "<total>\n<json>"
  # Both answers are already narrowed by td (-s/-p are honoured with --deferred),
  # so this only unions them and drops any task seen twice.
  printf '%s\n%s' "$1" "$2" | python3 -c "
import sys, json

raw = sys.stdin.read().split('\n', 1)
base = json.loads(raw[0])
deferred = json.loads(raw[1]) if len(raw) > 1 and raw[1].strip() else []

merged = list(base)
seen = set(task.get('id') for task in base)
for task in deferred:
    if task.get('id') in seen:
        continue
    seen.add(task.get('id'))
    merged.append(task)
sys.stdout.write('%d\n%s' % (len(merged), json.dumps(merged)))
"
}

_td_read_complete() {
  # _td_read_complete <repo_name> <repo_path> [td flags...] → "<total>\n<json>"
  #   0  the repo was read completely
  #   2  the escalation ceiling stopped the read (already warned)
  #   1  the repo is unreadable (already warned)
  #
  # Asks for one more task than it is willing to accept, so a short response
  # proves the answer is complete.
  local rname="$1" repo_path="$2"
  local head keep limit payload published total
  shift 2

  limit="$TD_LIST_LIMIT"
  while :; do
    # At the ceiling, publish exactly the ceiling: a returned extra row is then
    # proof that tasks were withheld rather than a hint.
    keep=-1
    [[ "$limit" -lt "$TD_LIST_MAX_LIMIT" ]] || keep="$TD_LIST_MAX_LIMIT"
    payload="$(_td_list_once "$rname" "$keep" "$repo_path" "$@" --limit "$((limit + 1))")" || return 1
    head="$(_payload_head "$payload")"
    total="${head%% *}"
    published="${head#* }"
    if [[ "$total" -le "$limit" ]]; then
      printf '%s\n%s' "$total" "$(_payload_json "$payload")"
      return 0
    fi
    if [[ "$limit" -ge "$TD_LIST_MAX_LIMIT" ]]; then
      _ceiling_warn "$rname" "$total" \
        "the SGT_TD_LIST_MAX_LIMIT ceiling of $TD_LIST_MAX_LIMIT (raise it to see the rest)"
      printf '%s\n%s' "$published" "$(_payload_json "$payload")"
      return 2
    fi
    limit=$((limit * 2))
    [[ "$limit" -le "$TD_LIST_MAX_LIMIT" ]] || limit="$TD_LIST_MAX_LIMIT"
  done
}

_td_list_tasks() {
  # _td_list_tasks <repo_name> <repo_path> → "<published>\n<json>"
  #
  # The complete non-closed set is td's default answer merged with td's deferred
  # answer, because td will not return both at once.  A caller limit caps what is
  # published, never what is read, so the truncation warning can name the exact
  # total instead of a lower bound.
  local rname="$1" repo_path="$2"
  local base capped=false deferred="[]" head json payload published read_status=0 total

  if $USER_LIMIT_SET && ! _is_positive_int "$USER_LIMIT"; then
    # A limit only td can interpret: forward it untouched, once per half of the
    # repo, so a caller's `--limit -1` (td's unlimited idiom) still gets its
    # deferred tasks.  `--limit 0` is td asking td for its own default cap, which
    # is the silent truncation this command exists to prevent, so say so.
    local raw_base raw_deferred="[]" raw_defer_payload
    payload="$(_td_list_once "$rname" -1 "$repo_path")" || return 1
    raw_base="$(_payload_json "$payload")"
    if $INCLUDE_DEFERRED; then
      if raw_defer_payload="$(_td_list_once "$rname" -1 "$repo_path" --deferred)"; then
        raw_deferred="$(_payload_json "$raw_defer_payload")"
      fi
    fi
    payload="$(_merge_reads "$raw_base" "$raw_deferred")" || {
      _unreadable_warn "$rname" "could not merge its td reads"
      return 1
    }
    published="$(_payload_head "$payload")"
    if [[ "$USER_LIMIT" == "0" && "$published" -gt 0 ]]; then
      printf 'WARNING: %s: --limit 0 leaves td to apply its own default limit, so these %s task(s) may be truncated; pass a positive --limit or none at all\n' \
        "$rname" "$published" >&2
      _mark_incomplete
    fi
    printf '%s\n%s' "$published" "$(_payload_json "$payload")"
    return 0
  fi

  base="$(_td_read_complete "$rname" "$repo_path")" || read_status=$?
  [[ "$read_status" -ne 1 ]] || return 1
  [[ "$read_status" -ne 2 ]] || capped=true

  if $INCLUDE_DEFERRED && ! $capped; then
    # td hides deferred tasks from its default answer and returns them only from
    # a --deferred query, which honours -s/-p, so the two answers are merged.
    local deferred_payload deferred_status=0
    deferred_payload="$(_td_read_complete "$rname" "$repo_path" --deferred)" || deferred_status=$?
    if [[ "$deferred_status" -eq 0 ]]; then
      deferred="$(_payload_json "$deferred_payload")"
    elif [[ "$deferred_status" -eq 2 ]]; then
      capped=true
      deferred="$(_payload_json "$deferred_payload")"
    fi
    # deferred_status 1 already warned and marked the report incomplete.
  fi

  payload="$(_merge_reads "$(_payload_json "$base")" "$deferred")" || {
    _unreadable_warn "$rname" "could not merge its td reads"
    return 1
  }
  head="$(_payload_head "$payload")"
  total="$head"
  json="$(_payload_json "$payload")"

  if $USER_LIMIT_SET && [[ "$total" -gt "$USER_LIMIT" ]]; then
    # The whole repo was read, so the caller's cap only limits what is printed
    # and the exact total is known.
    $capped || _truncation_warn "$rname" "$total" "the requested --limit $USER_LIMIT"
    json="$(printf '%s' "$json" | python3 -c "
import sys, json
sys.stdout.write(json.dumps(json.load(sys.stdin)[:int(sys.argv[1])]))
" "$USER_LIMIT")" || {
      _unreadable_warn "$rname" "could not apply the requested --limit $USER_LIMIT"
      return 1
    }
    total="$USER_LIMIT"
  fi

  printf '%s\n%s' "$total" "$json"
  return 0
}

_repo_payload() {
  # _repo_payload <repo_name> <named-explicitly> → "<published>\n<json>"
  # Returns 1 when the repo contributes nothing.  Malformed configuration and a
  # repo the caller named by hand are always reported; a repo that is merely
  # configured and not cloned yet is the one quiet skip.
  local rname="$1" named="$2" repo_path resolve_status=0

  repo_path="$(_repo_path_for "$rname")" || resolve_status=$?
  if [[ "$resolve_status" -eq 2 ]]; then
    _unreadable_warn "$rname" "configured in $PROJECT.yaml with no path"
    return 1
  fi
  if [[ "$resolve_status" -ne 0 ]]; then
    ! $named || _unreadable_warn "$rname" "not configured in $PROJECT.yaml"
    return 1
  fi
  if ! _sgt_is_git_repo "$repo_path"; then
    if $named; then
      _unreadable_warn "$rname" "not a git checkout at $repo_path"
    else
      # Not cloned yet is an expected state, but a whole repo missing from a
      # backlog should never be invisible.  Informational, so the exit status
      # still reflects only what could not be read.
      printf 'note: %s: not cloned at %s; run sgt-sync %s to include it\n' \
        "$rname" "$repo_path" "$PROJECT" >&2
    fi
    return 1
  fi
  _td_list_tasks "$rname" "$repo_path"
}

# ── Resolve target repos ───────────────────────────────────────────────────────

TARGET_REPOS=()
REPOS_NAMED=false

if [[ -n "$REPOS_ARG" ]]; then
  REPOS_NAMED=true
  IFS=',' read -ra TARGET_REPOS <<< "$REPOS_ARG"
else
  while IFS= read -r -d '' map_name && IFS= read -r -d '' _; do
    if [[ -z "$map_name" ]]; then
      _unreadable_warn "(unnamed)" "a repo in $PROJECT.yaml has no name"
      continue
    fi
    TARGET_REPOS+=("$map_name")
  done < "$REPO_MAP"
fi

# A repo reached twice — a repeated --repos element or two YAML entries sharing a
# name — would be counted twice in the per-repo listing and in the grand total.
SEEN_REPOS=()
DEDUPED_REPOS=()
for rname in "${TARGET_REPOS[@]+"${TARGET_REPOS[@]}"}"; do
  duplicate=false
  for seen in "${SEEN_REPOS[@]+"${SEEN_REPOS[@]}"}"; do
    [[ "$seen" == "$rname" ]] && { duplicate=true; break; }
  done
  if $duplicate; then
    printf 'WARNING: %s: named more than once; counted once\n' "$rname" >&2
    continue
  fi
  SEEN_REPOS+=("$rname")
  DEDUPED_REPOS+=("$rname")
done
TARGET_REPOS=("${DEDUPED_REPOS[@]+"${DEDUPED_REPOS[@]}"}")

# An empty list must not trip `set -u` on Bash 3.2, and must not masquerade as
# a complete report of nothing.
if [[ "${#TARGET_REPOS[@]}" -eq 0 ]]; then
  _die "no usable repos to read for project $PROJECT"
fi

# ── Collect tasks per repo ────────────────────────────────────────────────────

if $JSON_OUT; then
  # JSON mode: emit one array of tasks, each tagged with its repo.
  # Per-repo payloads are staged on disk and merged in a single pass: shell
  # string concatenation cannot round-trip JSON safely, and a failed merge must
  # be loud rather than degrade to an empty array.
  JSON_STAGE="$WORK/stage"
  mkdir -p "$JSON_STAGE"

  stage_idx=0
  for rname in "${TARGET_REPOS[@]+"${TARGET_REPOS[@]}"}"; do
    if [[ -z "$rname" ]]; then
      _unreadable_warn "(empty)" "empty --repos entry"
      continue
    fi

    payload="$(_repo_payload "$rname" "$REPOS_NAMED")" || continue

    [[ "$(_payload_head "$payload")" -eq 0 ]] && continue

    stage_idx=$((stage_idx + 1))
    _payload_json "$payload" > "$JSON_STAGE/$stage_idx.tasks"
    printf '%s\n' "$rname"   > "$JSON_STAGE/$stage_idx.repo"
  done

  # stdout stays a pure task array, so the view that produced it is named on
  # stderr.  Only a narrowed view needs saying: the default is complete.
  if [[ "$VIEW_LABEL" != "all non-closed" ]]; then
    printf 'note: %s: reporting [%s]; pass no filter for every non-closed task\n' \
      "$PROJECT" "$VIEW_LABEL" >&2
  fi

  python3 -c '
import json, sys
from pathlib import Path

stage = Path(sys.argv[1])
merged = []
for tasks_file in sorted(stage.glob("*.tasks"), key=lambda p: int(p.stem)):
    repo = stage.joinpath(tasks_file.stem + ".repo").read_text().strip()
    for task in json.loads(tasks_file.read_text()):
        task["_repo"] = repo
        merged.append(task)
merged.sort(key=lambda t: (t.get("priority") or "P9", t.get("_repo") or ""))
print(json.dumps(merged, indent=2))
' "$JSON_STAGE" || _die "failed to merge td task JSON for project $PROJECT"
  ! _report_incomplete || exit 2
  exit 0
fi

# ── Human-readable output ─────────────────────────────────────────────────────

echo "=== $PROJECT tasks [$VIEW_LABEL] ==="
echo ""

total=0

for rname in "${TARGET_REPOS[@]+"${TARGET_REPOS[@]}"}"; do
  if [[ -z "$rname" ]]; then
    _unreadable_warn "(empty)" "empty --repos entry"
    continue
  fi

  # Repos with no td database report zero tasks and are skipped
  payload="$(_repo_payload "$rname" "$REPOS_NAMED")" || continue
  count="$(_payload_head "$payload")"
  [[ "$count" -eq 0 ]] && continue

  # Render before publishing the header and the total: a count with no rows
  # under it is a partial report dressed up as a complete one.
  if ! rows="$(_payload_json "$payload" | python3 -c "
import sys, json
tasks = json.load(sys.stdin)
# Sort by priority then status
order = {'P0':0,'P1':1,'P2':2,'P3':3,'P4':4}
tasks.sort(key=lambda t: (order.get(t.get('priority','P4'), 4), t.get('title','')))
for t in tasks:
    tid    = t.get('id','?')
    title  = t.get('title','')[:65]
    prio   = t.get('priority','')
    status = t.get('status','')
    print(f'   {tid}  [{prio}]  {status:<12}  {title}')
" 2>"$TD_ERR_FILE")"; then
    _unreadable_warn "$rname" \
      "failed to render its $count task(s) ($(head -1 "$TD_ERR_FILE" | cut -c1-120))"
    continue
  fi

  total=$((total + count))
  echo "── $rname ($count)"
  printf '%s\n' "$rows"

  echo ""
done

if [[ $total -eq 0 ]]; then
  echo "No tasks found."
else
  echo "$total task(s) total"
fi

if _report_incomplete; then
  echo "report incomplete: see the warnings on stderr"
  exit 2
fi
