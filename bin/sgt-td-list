#!/usr/bin/env bash
# sgt-td-list — Show td tasks across all repos in a project
#
# Queries each repo's td database and prints a unified view.
# Requires td to be installed and initialized in each repo.
#
# Usage:
#   sgt-td-list <project>                    # open tasks across all repos
#   sgt-td-list <project> --all              # all statuses
#   sgt-td-list <project> --status open      # specific status
#   sgt-td-list <project> --priority P1      # filter by priority
#   sgt-td-list <project> --repos smith,smith-app  # specific repos only
#   sgt-td-list <project> --json             # machine-readable output
#
# Task limits:
#   `td list` defaults to `--limit 50`, which silently truncates any repo with a
#   larger backlog.  sgt-td-list therefore always passes an explicit limit and
#   escalates it until td returns a complete answer.  A user-supplied --limit
#   always wins.  Any residual truncation is reported on stderr, never hidden.
#
#   SGT_TD_LIST_LIMIT      initial per-repo limit (default 1000)
#   SGT_TD_LIST_MAX_LIMIT  escalation ceiling     (default 100000)
#
#   An initial limit above the ceiling is clamped to the ceiling; completeness
#   is unaffected, and a repo that reaches the ceiling still warns on stderr.
#
# Status filter:
#   The default view is `--filter status=open`, which is printed in the header
#   and therefore explicit.  It excludes non-closed work in in_progress,
#   blocked and in_review; use --all for every non-closed task.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=_sgt-lib.sh
source "$SCRIPT_DIR/_sgt-lib.sh"

_require_td() {
  command -v td &>/dev/null || _die "td is required. See your td installation."
}

[[ $# -ge 1 ]] || _die "Usage: sgt-td-list <project> [options]"
PROJECT="$1"; shift

CONFIG_FILE="$SERGEANT_CONFIG/$PROJECT.yaml"
[[ -f "$CONFIG_FILE" ]] || _die "Project not found: $PROJECT"
_require_yq
_require_td

# ── Parse options ─────────────────────────────────────────────────────────────

STATUS_FILTER="open"
PRIORITY_FILTER=""
REPOS_ARG=""
JSON_OUT=false
TD_ALL=false
EXTRA_FLAGS=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --all)           TD_ALL=true;            shift   ;;
    --status)        STATUS_FILTER="$2";     shift 2 ;;
    --priority)      PRIORITY_FILTER="$2";   shift 2 ;;
    --repos)         REPOS_ARG="$2";         shift 2 ;;
    --json)          JSON_OUT=true;          shift   ;;
    *)               EXTRA_FLAGS+=("$1");    shift   ;;
  esac
done

# Build td filter expression
TD_FILTER=""
if ! $TD_ALL && [[ -n "$STATUS_FILTER" ]]; then
  TD_FILTER="status=$STATUS_FILTER"
fi
if [[ -n "$PRIORITY_FILTER" ]]; then
  if [[ -n "$TD_FILTER" ]]; then
    TD_FILTER="$TD_FILTER AND priority=$PRIORITY_FILTER"
  else
    TD_FILTER="priority=$PRIORITY_FILTER"
  fi
fi

# ── Task limits ───────────────────────────────────────────────────────────────
# td list caps results at 50 by default.  Never rely on that default: pass an
# explicit limit and escalate it until the repo is reported completely, so
# per-repo counts and the grand total are true.

TD_LIST_LIMIT="${SGT_TD_LIST_LIMIT:-1000}"
TD_LIST_MAX_LIMIT="${SGT_TD_LIST_MAX_LIMIT:-100000}"

_is_positive_int() { [[ "$1" =~ ^[1-9][0-9]*$ ]]; }

_is_positive_int "$TD_LIST_LIMIT" \
  || _die "SGT_TD_LIST_LIMIT must be a positive integer, got: $TD_LIST_LIMIT"
_is_positive_int "$TD_LIST_MAX_LIMIT" \
  || _die "SGT_TD_LIST_MAX_LIMIT must be a positive integer, got: $TD_LIST_MAX_LIMIT"
[[ "$TD_LIST_LIMIT" -le "$TD_LIST_MAX_LIMIT" ]] || TD_LIST_LIMIT="$TD_LIST_MAX_LIMIT"

# A --limit / -n passed through by the caller always wins over our default, so
# never supplement one — not even a malformed one, which td must reject itself.
USER_LIMIT=""
USER_LIMIT_SET=false
if [[ "${#EXTRA_FLAGS[@]}" -gt 0 ]]; then
  for ((i=0; i<${#EXTRA_FLAGS[@]}; i++)); do
    case "${EXTRA_FLAGS[$i]}" in
      --limit|-n)  USER_LIMIT_SET=true; USER_LIMIT="${EXTRA_FLAGS[$((i+1))]:-}" ;;
      --limit=*)   USER_LIMIT_SET=true; USER_LIMIT="${EXTRA_FLAGS[$i]#--limit=}" ;;
      -n[0-9]*)    USER_LIMIT_SET=true; USER_LIMIT="${EXTRA_FLAGS[$i]#-n}" ;;
    esac
  done
fi

_truncation_warn() {
  # _truncation_warn <repo> <proven-lower-bound> <cap-description>
  # Never claims an exact total: the cap is what stops us from knowing it.
  printf 'WARNING: %s: results truncated by %s; at least %s task(s) exist, so this report is incomplete\n' \
    "$1" "$3" "$2" >&2
}

_unreadable_warn() {
  # _unreadable_warn <repo> <reason>
  printf 'WARNING: %s: %s; its tasks are missing from this report\n' "$1" "$2" >&2
}

# Task payloads are passed around as two lines — "<count>\n<compact json>" —
# so one Python process per repo covers parsing, validation and counting.
_payload_count() { printf '%s' "${1%%$'\n'*}"; }
_payload_json()  { printf '%s' "${1#*$'\n'}"; }

_td_list_once() {
  # _td_list_once <repo_name> <repo_path> [td flags...] → "<count>\n<json>"
  #
  # Flags after <repo_path> are appended last so they beat anything in
  # EXTRA_FLAGS; that is what makes the truncation probe below authoritative.
  #
  # Returns 1 when this repo's tasks could not be read, after warning: a repo
  # dropped without a word is exactly how a backlog gets under-reported.  A
  # repo with no td database is the one expected silent skip.
  local rname="$1" repo_path="$2"
  local count err_file kind payload raw status=0 parse_status=0 td_err
  shift 2

  err_file="$(mktemp "${TMPDIR:-/tmp}/sgt-td-list.XXXXXX")"
  raw="$(td list --json --work-dir "$repo_path" \
    ${TD_FILTER:+--filter "$TD_FILTER"} \
    "${EXTRA_FLAGS[@]+"${EXTRA_FLAGS[@]}"}" \
    "$@" 2>"$err_file")" || status=$?
  td_err="$(sed "s/$(printf '\033')\[[0-9;]*m//g" "$err_file" 2>/dev/null | head -1)"
  rm -f "$err_file"

  # td answers a successful query with a JSON array and a failed one with a
  # JSON error object, so raw stdout is never safe to treat as a task array.
  payload="$(printf '%s' "$raw" | python3 -c "
import sys, json
try:
    data = json.load(sys.stdin)
except Exception:
    data = None
if isinstance(data, list):
    sys.stdout.write('ok %d\n%s' % (len(data), json.dumps(data)))
else:
    code = ''
    if isinstance(data, dict):
        err = data.get('error')
        if isinstance(err, dict):
            code = str(err.get('code') or 'error')
        elif err:
            code = 'error'
    sys.stdout.write('err %s\n[]' % code)
")" || parse_status=$?

  kind="$(_payload_count "$payload")"   # first line: "ok <count>" or "err <code>"
  count="${kind#* }"
  case "$kind" in
    "ok "*)
      if [[ "$count" =~ ^[0-9]+$ ]]; then
        if [[ "$status" -ne 0 ]]; then
          _unreadable_warn "$rname" "td list exited $status after partial output${td_err:+ ($td_err)}"
          printf '0\n[]'
          return 1
        fi
        printf '%s\n%s' "$count" "$(_payload_json "$payload")"
        return 0
      fi
      ;;
    "err database_error"*)
      # td is not initialized in this repo: an expected, documented skip.
      printf '0\n[]'
      return 0
      ;;
  esac

  if [[ "$parse_status" -ne 0 ]]; then
    _unreadable_warn "$rname" "could not parse td output (python3 exited $parse_status)"
  else
    _unreadable_warn "$rname" "td list failed (exit $status)${td_err:+: $td_err}"
  fi
  printf '0\n[]'
  return 1
}

_td_list_tasks() {
  # _td_list_tasks <repo_name> <repo_path> → complete "<count>\n<json>" payload.
  #
  # Asks for one more task than it is willing to accept: a short answer proves
  # the repo was reported completely.  Returns 1 when the repo is unreadable.
  local rname="$1" repo_path="$2"
  local count limit payload probe probe_count

  if $USER_LIMIT_SET; then
    # The caller's limit wins untouched, so no default is added to this call.
    payload="$(_td_list_once "$rname" "$repo_path")" || return 1
    count="$(_payload_count "$payload")"
    if _is_positive_int "$USER_LIMIT" && [[ "$count" -ge "$USER_LIMIT" ]]; then
      # One extra row is all it takes to tell a cap from a coincidence.
      probe="$(_td_list_once "$rname" "$repo_path" --limit "$((USER_LIMIT + 1))")" || probe=""
      if [[ -n "$probe" ]]; then
        probe_count="$(_payload_count "$probe")"
        [[ "$probe_count" -le "$USER_LIMIT" ]] \
          || _truncation_warn "$rname" "$probe_count" "the requested --limit $USER_LIMIT"
      fi
    fi
    printf '%s' "$payload"
    return 0
  fi

  limit="$TD_LIST_LIMIT"
  while :; do
    payload="$(_td_list_once "$rname" "$repo_path" --limit "$((limit + 1))")" || return 1
    count="$(_payload_count "$payload")"
    [[ "$count" -gt "$limit" ]] || { printf '%s' "$payload"; return 0; }
    if [[ "$limit" -ge "$TD_LIST_MAX_LIMIT" ]]; then
      _truncation_warn "$rname" "$count" \
        "the SGT_TD_LIST_MAX_LIMIT ceiling of $TD_LIST_MAX_LIMIT (raise it to see the rest)"
      printf '%s' "$payload"
      return 0
    fi
    limit=$((limit * 2))
    [[ "$limit" -le "$TD_LIST_MAX_LIMIT" ]] || limit="$TD_LIST_MAX_LIMIT"
  done
}

_repo_path_for() {
  # _repo_path_for <repo_name> → absolute repo path; 1 when the name is unknown
  local rname="$1" raw_path
  raw_path="$(yq ".repos[] | select(.name == \"$rname\") | .path" "$CONFIG_FILE" 2>/dev/null || true)"
  [[ -n "$raw_path" && "$raw_path" != "null" ]] || return 1
  _resolve_path "$raw_path"
}

# ── Resolve target repos ───────────────────────────────────────────────────────

repo_count="$(yq '.repos | length' "$CONFIG_FILE")"
TARGET_REPOS=()

if [[ -n "$REPOS_ARG" ]]; then
  IFS=',' read -ra TARGET_REPOS <<< "$REPOS_ARG"
else
  for ((i=0; i<repo_count; i++)); do
    TARGET_REPOS+=("$(yq ".repos[$i].name" "$CONFIG_FILE")")
  done
fi

# ── Collect tasks per repo ────────────────────────────────────────────────────

if $JSON_OUT; then
  # JSON mode: emit one array of tasks, each tagged with its repo.
  # Per-repo payloads are staged on disk and merged in a single pass: shell
  # string concatenation cannot round-trip JSON safely, and a failed merge must
  # be loud rather than degrade to an empty array.
  JSON_STAGE="$(mktemp -d "${TMPDIR:-/tmp}/sgt-td-list.XXXXXX")"
  trap 'rm -rf "$JSON_STAGE"' EXIT

  stage_idx=0
  for rname in "${TARGET_REPOS[@]}"; do
    repo_path="$(_repo_path_for "$rname")" || continue

    [[ -d "$repo_path/.git" ]] || continue

    payload="$(_td_list_tasks "$rname" "$repo_path")" || continue

    [[ "$(_payload_count "$payload")" -eq 0 ]] && continue

    stage_idx=$((stage_idx + 1))
    _payload_json "$payload" > "$JSON_STAGE/$stage_idx.tasks"
    printf '%s\n' "$rname"   > "$JSON_STAGE/$stage_idx.repo"
  done

  python3 -c '
import json, sys
from pathlib import Path

stage = Path(sys.argv[1])
merged = []
for tasks_file in sorted(stage.glob("*.tasks"), key=lambda p: int(p.stem)):
    repo = stage.joinpath(tasks_file.stem + ".repo").read_text().strip()
    for task in json.loads(tasks_file.read_text()):
        task["_repo"] = repo
        merged.append(task)
merged.sort(key=lambda t: (t.get("priority") or "P9", t.get("_repo") or ""))
print(json.dumps(merged, indent=2))
' "$JSON_STAGE" || _die "failed to merge td task JSON for project $PROJECT"
  exit 0
fi

# ── Human-readable output ─────────────────────────────────────────────────────

echo "=== $PROJECT tasks$([ -n "$TD_FILTER" ] && echo " [$TD_FILTER]" || true) ==="
echo ""

total=0

for rname in "${TARGET_REPOS[@]}"; do
  repo_path="$(_repo_path_for "$rname")" || continue

  [[ -d "$repo_path/.git" ]] || continue

  # Repos with no td database report zero tasks and are skipped
  payload="$(_td_list_tasks "$rname" "$repo_path")" || continue
  count="$(_payload_count "$payload")"
  [[ "$count" -eq 0 ]] && continue
  tasks_json="$(_payload_json "$payload")"

  total=$((total + count))
  echo "── $rname ($count)"

  printf '%s' "$tasks_json" | python3 -c "
import sys, json
tasks = json.load(sys.stdin)
# Sort by priority then status
order = {'P0':0,'P1':1,'P2':2,'P3':3,'P4':4}
tasks.sort(key=lambda t: (order.get(t.get('priority','P4'), 4), t.get('title','')))
for t in tasks:
    tid    = t.get('id','?')
    title  = t.get('title','')[:65]
    prio   = t.get('priority','')
    status = t.get('status','')
    print(f'   {tid}  [{prio}]  {status:<12}  {title}')
" || _unreadable_warn "$rname" "failed to render its $count task(s), so the rows above are incomplete"

  echo ""
done

if [[ $total -eq 0 ]]; then
  echo "No tasks found."
else
  echo "$total task(s) total"
fi
