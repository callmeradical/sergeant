#!/usr/bin/env bash
# sgt-dispatch — Dispatch subagents across repos in a project
#
# Creates an isolated git worktree per repo, writes a mission brief into each,
# and spawns an agent in a local tmux window.
#
# Usage:
#   sgt-dispatch <project> "<brief>" [options]
#   sgt-dispatch <project> --td <task-id> [options]   # brief from td task
#
# Options:
#   --repos repo1,repo2,...   Repos to dispatch (required unless --td auto-detects)
#   --td <task-id>            Pull brief and context from a td task
#   --branch <name>           Branch name for all worktrees (default: derived from brief)
#   --adopt-branch            Resume an existing branch that already carries commits
#                             absent from every remote (non-destructive; required to
#                             re-dispatch preserved work in a read-only-upstream repo)
#   --deps "repo1>repo2,..."  Dependency ordering: repo1 must finish before repo2 starts
#   --agent <harness>         Interactive harness: opencode, goose, or claude
#   --model <tuple>           Pin provider/model[:variant] for the worker's harness
#                             (precedence: --model > SERGEANT_MODEL > harness default)
#   --stage <name>            Window stage slug (default: implementation)
#   --coordinator-pane <id>   Bind an explicit tmux pane id as the coordinator
#                             (verified against the live tmux server)
#   --managed-coordinator-pane
#                             Create or select Sergeant's managed coordinator pane
#                             on an already reachable tmux server
#   --intent-file <path>       Canonical structured intent for safety/stateful work
#   --origin-profile <name>    Fixed local callback profile (requires --correlation-id)
#   --correlation-id <id>      Opaque callback request ID (requires --origin-profile)
#   --brief-file <path>        Read the brief from a private UTF-8 file instead of argv
#   --json                     Emit only correlated acceptance JSON on stdout
#   --dry-run                  Print what would happen, don't execute
#
# Examples:
#   sgt-dispatch smith "Add OAuth via Google" --repos smith,smith-app,smith-infra
#   sgt-dispatch smith --td td-a3cf60 --repos smith
#   sgt-dispatch smith --td td-a3cf60   # auto-detects repo from td db

set -euo pipefail

# Resolve the executable and every bootstrap resource without GNU-only
# readlink -f/realpath.  Each symlink hop is made absolute through its physical
# parent before the next hop, so relative links work across installed prefixes.
# The newline-delimited seen set is Bash 3.2 compatible and rejects cycles
# instead of accepting a path after an arbitrary hop limit.
_sgt_dispatch_canonical_file() {
  local target="$1" label="$2" parent physical link seen=""
  while [[ -L "$target" ]]; do
    parent="$(dirname "$target")"
    if ! physical="$(cd -P "$parent" 2>/dev/null && pwd)"; then
      printf 'ERROR: broken bundled resource (%s): %s\n' "$label" "$target" >&2
      return 1
    fi
    target="$physical/$(basename "$target")"
    case "$seen" in
      *$'\n'"$target"$'\n'*)
        printf 'ERROR: cyclic bundled resource (%s): %s\n' "$label" "$target" >&2
        return 1
        ;;
    esac
    seen="$seen"$'\n'"$target"$'\n'
    if ! link="$(readlink "$target" 2>/dev/null)" || [[ -z "$link" ]]; then
      printf 'ERROR: invalid bundled resource symlink (%s): %s\n' "$label" "$target" >&2
      return 1
    fi
    if [[ "$link" == /* ]]; then
      target="$link"
    else
      target="$physical/$link"
    fi
  done

  parent="$(dirname "$target")"
  if ! physical="$(cd -P "$parent" 2>/dev/null && pwd)"; then
    printf 'ERROR: broken bundled resource (%s): %s\n' "$label" "$target" >&2
    return 1
  fi
  target="$physical/$(basename "$target")"
  if [[ ! -f "$target" ]]; then
    printf 'ERROR: broken bundled resource (%s): %s\n' "$label" "$target" >&2
    return 1
  fi
  printf '%s\n' "$target"
}

if ! _SGT_DISPATCH_FILE="$(_sgt_dispatch_canonical_file "${BASH_SOURCE[0]}" sgt-dispatch)"; then
  exit 1
fi
SCRIPT_DIR="$(dirname "$_SGT_DISPATCH_FILE")"
if ! _SGT_DISTRIBUTION_ROOT="$(cd -P "$SCRIPT_DIR/.." 2>/dev/null && pwd)" || \
   [[ "$SCRIPT_DIR" != "$_SGT_DISTRIBUTION_ROOT/bin" ]] || \
   [[ "$(basename "$_SGT_DISPATCH_FILE")" != sgt-dispatch ]]; then
  printf 'ERROR: invalid canonical Sergeant distribution for sgt-dispatch: %s\n' \
    "$_SGT_DISPATCH_FILE" >&2
  exit 1
fi

_sgt_dispatch_bundled_file() {
  local requested="$1" label="$2" canonical
  if ! canonical="$(_sgt_dispatch_canonical_file "$requested" "$label")"; then
    return 1
  fi
  case "$canonical" in
    "$_SGT_DISTRIBUTION_ROOT"/*) printf '%s\n' "$canonical" ;;
    *)
      printf 'ERROR: bundled resource is outside canonical Sergeant distribution (%s): %s\n' \
        "$label" "$canonical" >&2
      return 1
      ;;
  esac
}

# Bootstrap resources are resolved once from the canonical distribution.  This
# fails before config, td, tmux, fleet, or worktree mutation when an installation
# is broken, cyclic, or redirects a bundled file outside its distribution.
if ! _SGT_LIB_FILE="$(_sgt_dispatch_bundled_file "$SCRIPT_DIR/_sgt-lib.sh" _sgt-lib.sh)" || \
   ! _SGT_BASH_VERSION_FILE="$(_sgt_dispatch_bundled_file "$SCRIPT_DIR/_sgt-bash-version.sh" _sgt-bash-version.sh)" || \
   ! _SGT_PROCESS_FILE="$(_sgt_dispatch_bundled_file "$SCRIPT_DIR/_sgt-process.sh" _sgt-process.sh)" || \
   ! _SGT_INTENT_FILE="$(_sgt_dispatch_bundled_file "$SCRIPT_DIR/_sgt-intent.sh" _sgt-intent.sh)" || \
   ! _SGT_DRAIN_FILE="$(_sgt_dispatch_bundled_file "$SCRIPT_DIR/_sgt-drain.sh" _sgt-drain.sh)" || \
   ! _SGT_REVIEW_AXES_FILE="$(_sgt_dispatch_bundled_file "$SCRIPT_DIR/_sgt-review-axes.sh" _sgt-review-axes.sh)" || \
   ! _SGT_REVIEW_ROUTER_LAUNCHER_FILE="$(_sgt_dispatch_bundled_file "$SCRIPT_DIR/sgt-review-router-launch" sgt-review-router-launch)" || \
   ! _BRIEF_TEMPLATE="$(_sgt_dispatch_bundled_file "$_SGT_DISTRIBUTION_ROOT/templates/worker-brief.md" worker-brief.md)"; then
  exit 1
fi

# Source helpers only from private immutable copies opened with O_NOFOLLOW.
# Canonical path validation and shell `source` cannot otherwise be atomic: an
# installed helper path can be replaced between those two operations.
_SGT_BOOTSTRAP_ROOT="$(mktemp -d)" || {
  printf 'ERROR: could not allocate bundled resource bindings\n' >&2
  exit 1
}
chmod 700 "$_SGT_BOOTSTRAP_ROOT" || {
  rm -rf "$_SGT_BOOTSTRAP_ROOT"
  exit 1
}
trap 'rm -rf "$_SGT_BOOTSTRAP_ROOT"' EXIT

_sgt_dispatch_bind_bundled_file() {
  local source_path="$1" bound_path="$2" label="$3"
  if ! python3 - "$source_path" "$bound_path" <<'PY'
import os
import stat
import sys

source_path, bound_path = sys.argv[1:]
read_flags = os.O_RDONLY
if hasattr(os, "O_NOFOLLOW"):
    read_flags |= os.O_NOFOLLOW
source_fd = os.open(source_path, read_flags)
try:
    if not stat.S_ISREG(os.fstat(source_fd).st_mode):
        raise OSError("bundled resource is not a regular file")
    destination_fd = os.open(
        bound_path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600
    )
    try:
        while True:
            chunk = os.read(source_fd, 65536)
            if not chunk:
                break
            view = memoryview(chunk)
            while view:
                written = os.write(destination_fd, view)
                view = view[written:]
        os.fsync(destination_fd)
    finally:
        os.close(destination_fd)
finally:
    os.close(source_fd)
PY
  then
    printf 'ERROR: could not bind bundled resource (%s): %s\n' \
      "$label" "$source_path" >&2
    return 1
  fi
}

_SGT_BOUND_LIB="$_SGT_BOOTSTRAP_ROOT/_sgt-lib.sh"
_SGT_BOUND_BASH_VERSION="$_SGT_BOOTSTRAP_ROOT/_sgt-bash-version.sh"
_SGT_BOUND_PROCESS="$_SGT_BOOTSTRAP_ROOT/_sgt-process.sh"
_SGT_BOUND_INTENT="$_SGT_BOOTSTRAP_ROOT/_sgt-intent.sh"
_SGT_BOUND_DRAIN="$_SGT_BOOTSTRAP_ROOT/_sgt-drain.sh"
_SGT_BOUND_REVIEW_AXES="$_SGT_BOOTSTRAP_ROOT/_sgt-review-axes.sh"
if ! _sgt_dispatch_bind_bundled_file "$_SGT_LIB_FILE" "$_SGT_BOUND_LIB" _sgt-lib.sh || \
   ! _sgt_dispatch_bind_bundled_file "$_SGT_BASH_VERSION_FILE" \
      "$_SGT_BOUND_BASH_VERSION" _sgt-bash-version.sh || \
   ! _sgt_dispatch_bind_bundled_file "$_SGT_PROCESS_FILE" \
      "$_SGT_BOUND_PROCESS" _sgt-process.sh || \
   ! _sgt_dispatch_bind_bundled_file "$_SGT_INTENT_FILE" "$_SGT_BOUND_INTENT" _sgt-intent.sh || \
   ! _sgt_dispatch_bind_bundled_file "$_SGT_DRAIN_FILE" "$_SGT_BOUND_DRAIN" _sgt-drain.sh || \
   ! _sgt_dispatch_bind_bundled_file "$_SGT_REVIEW_AXES_FILE" \
      "$_SGT_BOUND_REVIEW_AXES" _sgt-review-axes.sh; then
  exit 1
fi
# Bind the template's device/inode identity and bytes at the bootstrap
# boundary.  The renderer reopens with O_NOFOLLOW and reads only through that
# verified file descriptor, so a later path replacement cannot redirect it.
if ! _BRIEF_TEMPLATE_ID="$(python3 - "$_BRIEF_TEMPLATE" <<'PY'
import os
import hashlib
import stat
import sys

flags = os.O_RDONLY
if hasattr(os, "O_NOFOLLOW"):
    flags |= os.O_NOFOLLOW
fd = os.open(sys.argv[1], flags)
try:
    info = os.fstat(fd)
    if not stat.S_ISREG(info.st_mode):
        raise OSError("worker brief template is not a regular file")
    digest = hashlib.sha256()
    while True:
        chunk = os.read(fd, 65536)
        if not chunk:
            break
        digest.update(chunk)
    print(f"{info.st_dev}:{info.st_ino}:{digest.hexdigest()}")
finally:
    os.close(fd)
PY
)"; then
  printf 'ERROR: could not bind verified worker brief template: %s\n' \
    "$_BRIEF_TEMPLATE" >&2
  exit 1
fi
# shellcheck source=/dev/null
source "$_SGT_BOUND_LIB"
# Runtime helper executables remain anchored to the canonical distribution;
# only the shell sources above need the private bootstrap directory.
_SGT_LIB_DIR="$SCRIPT_DIR"
# shellcheck source=/dev/null
source "$_SGT_BOUND_INTENT"
# shellcheck source=/dev/null
source "$_SGT_BOUND_DRAIN"
# shellcheck source=/dev/null
source "$_SGT_BOUND_REVIEW_AXES"

# ── Brief template renderer ───────────────────────────────────────────────────
# _sgt_render_brief <output-path> <vars...>
#
# Reads templates/worker-brief.md from the Sergeant repo, substitutes every
# {{PLACEHOLDER}} with the corresponding shell variable, and writes the result
# to <output-path>.  Only the explicitly listed variables are substituted; no
# shell expansion of arbitrary content occurs.  The template is the canonical
# source for brief format changes — edit it instead of this script.
_sgt_render_brief() {
  local output="$1"
  local content review_router_launcher_shell review_router_executable_shell
  local review_router_identity_shell review_router_capabilities_shell
  local review_router_project_shell review_router_repo_shell
  local patsub_replacement_was_set=false
  if shopt -q patsub_replacement 2>/dev/null; then
    patsub_replacement_was_set=true
    shopt -u patsub_replacement
  fi
  if ! content="$(python3 - "$_BRIEF_TEMPLATE" "$_BRIEF_TEMPLATE_ID" <<'PY'
import os
import hashlib
import stat
import sys

flags = os.O_RDONLY
if hasattr(os, "O_NOFOLLOW"):
    flags |= os.O_NOFOLLOW
fd = os.open(sys.argv[1], flags)
try:
    info = os.fstat(fd)
    if not stat.S_ISREG(info.st_mode):
        raise OSError("worker brief template is not a regular file")
    chunks = []
    while True:
        chunk = os.read(fd, 65536)
        if not chunk:
            break
        chunks.append(chunk)
    digest = hashlib.sha256(b"".join(chunks)).hexdigest()
    if f"{info.st_dev}:{info.st_ino}:{digest}" != sys.argv[2]:
        raise OSError("worker brief template identity or bytes changed")
finally:
    os.close(fd)
sys.stdout.buffer.write(b"".join(chunks))
PY
)"; then
    _die "worker brief template unavailable or changed: $_BRIEF_TEMPLATE"
  fi
  # Substitution order: longer tokens first to avoid partial matches.
  content="${content//\{\{TASK_ID\}\}/$TASK_ID}"
  content="${content//\{\{PROJECT\}\}/$PROJECT}"
  content="${content//\{\{REPO_NAME\}\}/$rname}"
  content="${content//\{\{BRANCH\}\}/$BRANCH}"
  content="${content//\{\{WORKTREE_PATH\}\}/$worktree_path}"
  content="${content//\{\{REPO_TASK_DIR\}\}/$repo_task_dir}"
  content="${content//\{\{TD_TASK_LINE\}\}/$td_task_line}"
  content="${content//\{\{BRIEF\}\}/$BRIEF}"
  content="${content//\{\{ROLE_LINE\}\}/$role_line}"
  content="${content//\{\{DEPS_SECTION\}\}/$deps_section}"
  content="${content//\{\{TD_SECTION\}\}/$td_section}"
  content="${content//\{\{MERGED_INSTRUCTIONS\}\}/$merged}"
  content="${content//\{\{INTENT_REVISION\}\}/$INTENT_REVISION}"
  content="${content//\{\{REVIEW_AXIS_LABEL\}\}/$review_axis_label}"
  content="${content//\{\{REVIEW_AXIS_MARKDOWN\}\}/$review_axis_markdown}"
  content="${content//\{\{REVIEW_SEVERITIES\}\}/$(printf '%s' "$SGT_REVIEW_SEVERITIES" | tr ' ' '|')}"
  content="${content//\{\{REVIEW_SEVERITY_ALIAS_TABLE\}\}/$(_sgt_review_severity_alias_table)}"
  content="${content//\{\{REVIEW_AXES_PIPE\}\}/$(printf '%s' "$review_axes" | tr ' ' '|')}"
  printf -v review_router_launcher_shell '%q' "$REVIEW_ROUTER_LAUNCHER"
  printf -v review_router_executable_shell '%q' "$REVIEW_ROUTER_EXECUTABLE"
  printf -v review_router_identity_shell '%q' "$REVIEW_ROUTER_EXECUTABLE_IDENTITY"
  printf -v review_router_capabilities_shell '%q' "$repo_task_dir/review_router_capabilities.json"
  printf -v review_router_project_shell '%q' "$PROJECT"
  printf -v review_router_repo_shell '%q' "$rname"
  content="${content//\{\{REVIEW_ROUTER_LAUNCHER\}\}/$review_router_launcher_shell}"
  content="${content//\{\{REVIEW_ROUTER_EXECUTABLE\}\}/$review_router_executable_shell}"
  content="${content//\{\{REVIEW_ROUTER_IDENTITY\}\}/$review_router_identity_shell}"
  content="${content//\{\{REVIEW_ROUTER_CAPABILITIES\}\}/$review_router_capabilities_shell}"
  content="${content//\{\{REVIEW_ROUTER_PROJECT\}\}/$review_router_project_shell}"
  content="${content//\{\{REVIEW_ROUTER_REPO\}\}/$review_router_repo_shell}"
  printf '%s\n' "$content" > "$output"
  if $patsub_replacement_was_set; then
    shopt -s patsub_replacement
  fi
}

# ── Parse args ───────────────────────────────────────────────────────────────

[[ $# -ge 1 ]] || _die "Usage: sgt-dispatch <project> \"<brief>\" [options]"
PROJECT="$1"; shift

CONFIG_FILE="$SERGEANT_CONFIG/$PROJECT.yaml"
[[ -f "$CONFIG_FILE" ]] || _die "Project not found: $PROJECT (looked for $CONFIG_FILE)"

BRIEF=""
BRIEF_FILE=""
BRIEF_POSITIONAL=false
REPOS_ARG=""
BRANCH_ARG=""
ADOPT_BRANCH=0
DEPS_ARG=""
TD_TASK_ID=""
INTENT_FILE=""
AGENT_OVERRIDE=""
MODEL_ARG=""
COORDINATOR_PANE_ARG=""
MANAGED_COORDINATOR=false
ORIGIN_PROFILE=""
CORRELATION_ID=""
STAGE="implementation"
DRY_RUN=false
JSON_OUTPUT=false

# Brief is optional positional arg (not present when --td is used)
if [[ $# -gt 0 && "${1:0:2}" != "--" ]]; then
  BRIEF="$1"; BRIEF_POSITIONAL=true; shift
fi

while [[ $# -gt 0 ]]; do
  case "$1" in
    --repos)   REPOS_ARG="$2";   shift 2 ;;
    --td)      TD_TASK_ID="$2";  shift 2 ;;
    --branch)  BRANCH_ARG="$2";  shift 2 ;;
    --adopt-branch) ADOPT_BRANCH=1; shift ;;
    --deps)    DEPS_ARG="$2";    shift 2 ;;
    --agent)
      [[ -n "${2:-}" ]] || _die "--agent requires opencode, goose, or claude"
      AGENT_OVERRIDE="$2"
      shift 2
      ;;
    --model)
      [[ -n "${2:-}" ]] || _die "--model requires provider/model or provider/model:variant"
      MODEL_ARG="$2"
      shift 2
      ;;
    --coordinator-pane)
      [[ -n "${2:-}" ]] || _die "--coordinator-pane requires a tmux pane id such as %3"
      COORDINATOR_PANE_ARG="$2"
      shift 2
      ;;
    --managed-coordinator-pane)
      MANAGED_COORDINATOR=true
      shift
      ;;
    --stage)
      [[ -n "${2:-}" ]] || _die "--stage requires a lowercase slug"
      STAGE="$2"
      shift 2
      ;;
    --intent-file)
      [[ -n "${2:-}" ]] || _die "--intent-file requires a path"
      INTENT_FILE="$2"
      shift 2
      ;;
    --origin-profile)
      [[ -n "${2:-}" ]] || _die "--origin-profile requires a profile name"
      ORIGIN_PROFILE="$2"
      shift 2
      ;;
    --correlation-id)
      [[ -n "${2:-}" ]] || _die "--correlation-id requires an opaque request ID"
      CORRELATION_ID="$2"
      shift 2
      ;;
    --brief-file)
      [[ -n "${2:-}" ]] || _die "--brief-file requires a path"
      BRIEF_FILE="$2"
      shift 2
      ;;
    --json) JSON_OUTPUT=true; shift ;;
    --dry-run) DRY_RUN=true;     shift   ;;
    *) _die "Unknown option: $1" ;;
  esac
done

PENDING_TASK_ID=""
if $JSON_OUTPUT; then
  ! $DRY_RUN || _die "--json cannot be combined with --dry-run"
  [[ -n "$ORIGIN_PROFILE" && -n "$CORRELATION_ID" ]] || \
    _die "--json requires --origin-profile and --correlation-id"
  [[ -n "$BRIEF_FILE" && "$BRIEF_POSITIONAL" == false ]] || \
    _die "--json requires --brief-file and rejects positional briefs"
  exec 3>&1
  exec 1>&2
fi

if [[ -n "$BRIEF_FILE" ]]; then
  [[ -z "$BRIEF" ]] || _die "a positional brief and --brief-file cannot be combined"
  if ! BRIEF="$(python3 - "$BRIEF_FILE" <<'PY'
import os
import re
import stat
import sys

path = sys.argv[1]
flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0)
try:
    descriptor = os.open(path, flags)
    try:
        metadata = os.fstat(descriptor)
        if not stat.S_ISREG(metadata.st_mode):
            raise ValueError("not a regular file")
        if metadata.st_uid != os.getuid():
            raise ValueError("not owned by the current user")
        if stat.S_IMODE(metadata.st_mode) != 0o600:
            raise ValueError("mode must be 0600")
        data = os.read(descriptor, 16385)
        if len(data) > 16384 or os.read(descriptor, 1):
            raise ValueError("larger than 16384 bytes")
    finally:
        os.close(descriptor)
    brief = data.decode("utf-8", "strict").rstrip("\n")
    if not brief:
        raise ValueError("empty")
    if any(ord(character) < 32 and character not in "\n\t" for character in brief):
        raise ValueError("contains control characters")
    if "\x60" in brief or re.search(r"[;&|$<>\\]", brief) or re.search(
        r"(?im)^[ \t]*(?:#!|bash\b|sh\b|zsh\b|curl\b|wget\b|ssh\b|sudo\b|env\b|"
        r"rm\b|mv\b|cp\b|chmod\b|chown\b|python[0-9.]*\b|node\b)", brief
    ):
        raise ValueError("contains shell-shaped content")
except (OSError, UnicodeError, ValueError) as error:
    print(f"invalid brief file: {error}", file=sys.stderr)
    raise SystemExit(1)
sys.stdout.write(brief)
PY
)"; then
    _die "could not read --brief-file safely"
  fi
fi

if $JSON_OUTPUT; then
  admission_status=0
  admission_receipt="$("$SCRIPT_DIR/sgt-callback" resolve-admission \
    "$ORIGIN_PROFILE" "$CORRELATION_ID")" || admission_status=$?
  if [[ "$admission_status" -eq 0 ]]; then
    printf '%s\n' "$admission_receipt" >&3
    exit 0
  elif [[ "$admission_status" -eq 3 ]]; then
    PENDING_TASK_ID="$admission_receipt"
    [[ "$PENDING_TASK_ID" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$ ]] || \
      _die "existing correlated admission has invalid pending identity"
  elif [[ "$admission_status" -ne 2 ]]; then
    _die "existing correlated admission is incomplete or invalid"
  fi
fi

[[ -z "$AGENT_OVERRIDE" ]] || AGENT_CMD="$AGENT_OVERRIDE"
[[ "$STAGE" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]] || _die "stage must be a lowercase slug: $STAGE"

# Coordinator pane selection is validated for shape here, before anything talks
# to tmux, so a malformed or argument-injecting value never reaches a tmux call.
if [[ -n "$COORDINATOR_PANE_ARG" ]]; then
  ! $MANAGED_COORDINATOR || \
    _die "--managed-coordinator-pane and --coordinator-pane cannot be combined"
  _sgt_is_tmux_pane_id "$COORDINATOR_PANE_ARG" || \
    _die "--coordinator-pane requires a tmux pane id such as %3: $COORDINATOR_PANE_ARG"
fi

# Resolve the pinned harness tuple. Precedence is explicit and recorded so the
# launch evidence names its own source: an explicit --model beats SERGEANT_MODEL,
# which beats inheriting the ambient harness default. SERGEANT_MODEL is
# orthogonal to SERGEANT_AGENT: the agent selects the harness executable, the
# model pins what that harness runs. Validation happens here, before any intent
# file, td task, worktree, or fleet state exists.
#
# Resolution is EXPLICIT-ONLY by decision, not by omission: there is deliberately
# no project-level or per-repo model default. Adding one expands the project YAML
# schema, which is owned elsewhere, so a project-level default with precedence
# below SERGEANT_MODEL is deferred to its own card (td-bc44c4).
if [[ -n "$MODEL_ARG" ]]; then
  AGENT_MODEL="$MODEL_ARG"
  AGENT_MODEL_SOURCE="flag"
elif [[ -n "${SERGEANT_MODEL:-}" ]]; then
  AGENT_MODEL="$SERGEANT_MODEL"
  AGENT_MODEL_SOURCE="env"
else
  AGENT_MODEL="$SGT_AGENT_MODEL_UNPINNED"
  AGENT_MODEL_SOURCE="unpinned"
fi
# A raw user value must be a real tuple. The unpinned sentinel is internal: it
# is what "no pin was given" resolves to, never something a caller may assert,
# because recording "model=unpinned, source=flag" would misstate provenance.
if [[ "$AGENT_MODEL_SOURCE" != "unpinned" ]]; then
  _sgt_is_agent_model_tuple "$AGENT_MODEL" || \
    _die "$(_sgt_agent_launch_reject_message "$(basename "$AGENT_CMD")" "$AGENT_MODEL" \
      malformed-tuple)"
fi
_sgt_require_agent_model "$(basename "$AGENT_CMD")" "$AGENT_MODEL" "$AGENT_CMD"
if [[ -n "$ORIGIN_PROFILE" || -n "$CORRELATION_ID" ]]; then
  [[ -n "$ORIGIN_PROFILE" && -n "$CORRELATION_ID" ]] || \
    _die "--origin-profile and --correlation-id must be provided together"
  "$SCRIPT_DIR/sgt-callback" validate-origin "$ORIGIN_PROFILE" "$CORRELATION_ID"
fi

# ── Resolve td task (if --td provided) ───────────────────────────────────────

TD_CONTEXT=""
TD_REPO=""

if [[ -n "$TD_TASK_ID" ]]; then
  _require_marcus_td
  _require_yq

  # Find which repo owns this task by trying each repo's td db
  repo_count="$(yq '.repos | length' "$CONFIG_FILE")"
  for ((i=0; i<repo_count; i++)); do
    rname="$(yq ".repos[$i].name" "$CONFIG_FILE")"
    raw_path="$(yq ".repos[$i].path" "$CONFIG_FILE")"
    repo_path="$(_resolve_path "$raw_path")"
    _sgt_is_git_repo "$repo_path" || continue

    task_json="$(td list --json --work-dir "$repo_path" \
      --filter "id=$TD_TASK_ID" 2>/dev/null || echo "[]")"
    count="$(echo "$task_json" | python3 -c "import sys,json; print(len(json.load(sys.stdin)))" 2>/dev/null || echo 0)"

    if [[ "$count" -gt 0 ]]; then
      TD_REPO="$rname"
      # Pull title and description for brief
      td_title="$(echo "$task_json" | python3 -c "
import sys,json; t=json.load(sys.stdin)[0]
print(t.get('title',''))
" 2>/dev/null)"

      # Get full context from td
      TD_CONTEXT="$(td context "$TD_TASK_ID" --work-dir "$repo_path" 2>/dev/null || echo "")"

      # Set brief from td title if not provided
      [[ -z "$BRIEF" ]] && BRIEF="$td_title"

      # Auto-set repos if not specified
      [[ -z "$REPOS_ARG" ]] && REPOS_ARG="$rname"

      break
    fi
  done

  if [[ -z "$TD_REPO" ]]; then
    _die "td task $TD_TASK_ID not found in any repo of project $PROJECT"
  fi

  echo "td task: $TD_TASK_ID in $TD_REPO"
  echo "title:   $BRIEF"
  echo ""
fi

[[ -n "$BRIEF" ]]     || _die "Provide a brief or use --td <task-id>"
[[ -n "$REPOS_ARG" ]] || _die "Must specify --repos. Run 'sgt-context $PROJECT' to see available repos."

TARGET_REPOS=()
IFS=',' read -ra TARGET_REPOS <<< "$REPOS_ARG"

# Correlated admission cannot partially discover an invalid repository after
# td, fleet, worktree, or worker mutation has begun.
if $JSON_OUTPUT; then
  _require_yq
  repo_count="$(yq '.repos | length' "$CONFIG_FILE")"
  for rname in "${TARGET_REPOS[@]}"; do
    found=false
    for ((i=0; i<repo_count; i++)); do
      if [[ "$(yq ".repos[$i].name" "$CONFIG_FILE")" == "$rname" ]]; then
        found=true
        repo_path="$(_resolve_path "$(yq ".repos[$i].path" "$CONFIG_FILE")")"
        break
      fi
    done
    $found || _die "Repo '$rname' not found in project $PROJECT"
    _sgt_is_git_repo "$repo_path" || \
      _die "Correlated admission requires cloned repository '$rname' at $repo_path"
  done
fi

# Resolve the prospective fleet identity and reject preserved/torn capability
# evidence before even selecting or creating a managed coordinator pane.
_rand6() { dd if=/dev/urandom bs=32 count=1 2>/dev/null | od -An -tx1 | tr -d ' \n' | cut -c1-6; }
slug="$(echo "$BRIEF" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '-' | sed 's/^-//;s/-$//' | cut -c1-24 | sed 's/-$//')"
TASK_ID="${PENDING_TASK_ID:-${slug}-$(_rand6)}"
TASK_DIR="$FLEET_DIR/$TASK_ID"
if ! $DRY_RUN; then
  for rname in "${TARGET_REPOS[@]}"; do
    _sgt_worker_process_marker_preflight "$TASK_DIR/$rname" || \
      _die "Dispatch refused: worker process marker evidence is torn"
    _sgt_worker_process_marker_preflight "$TASK_DIR/$rname/validation-process" || \
      _die "Dispatch refused: validation process marker evidence is torn"
  done
fi

_SGT_DISPATCH_TASK_FD=6
SGT_DISPATCH_TASK_LOCKED=false
_release_dispatch_task_lock() {
  if $SGT_DISPATCH_TASK_LOCKED; then
    _sgt_drain_lock_release_fd "$_SGT_DISPATCH_TASK_FD" || true
    SGT_DISPATCH_TASK_LOCKED=false
  fi
}
trap _release_dispatch_task_lock EXIT

_require_yq
_require_git
_require_tmux
# The harness gate runs before any pane is created so an unusable harness never
# leaves a managed coordinator pane behind.
_require_interactive_agent

# All dispatches share a single "sgt" tmux session — each task gets its own
# windows within it. This keeps tmux list-sessions clean.
# Override with SERGEANT_TMUX_SESSION=<name> if you want task-scoped sessions.
SGT_TMUX_SESSION="${SERGEANT_TMUX_SESSION:-sgt}"
TMUX_SESSION="$SGT_TMUX_SESSION"

PRIMARY_PANE_ID=""
PRIMARY_PANE_IDENTITY=""
SGT_MANAGED_COORDINATOR_CREATED="false"

# ── Bind the coordinator pane ────────────────────────────────────────────────
# Sergeant launches and controls every tmux window it owns inside its own
# session ($TMUX_SESSION) and never crosses that boundary.  The ambient
# $TMUX_PANE is therefore never bound, even when dispatch runs from inside tmux.
#
# Why: an agent harness runs sgt-dispatch from a shell inside the human
# operator's interactive session, so binding the ambient pane made the operator's
# own pane the coordinator and notification target.  On 2026-08-14 that recorded
# primary_pane=0:3.0 primary_pane_id=%11 for a live task and injected worker
# notifications as keystrokes into the operator's working pane.  Every other
# fleet record bound a dedicated session, which is what made it a regression
# rather than the design.  See td-eb9942.
#
# Two entry paths, one verification.  An explicit --coordinator-pane identity is
# verified against the live tmux server; otherwise a managed pane is created or
# selected inside $TMUX_SESSION.  The managed pane runs a reader that echoes
# injected lines and never executes them, so a notification can never become a
# shell command in a pane a human shares.
#
# None of this weakens the persistent interactive worker requirement: the worker
# is still launched as an interactive harness session in its own tmux window, and
# every path here fails before any intent file, td task, worktree, or fleet state
# is created.
if [[ -n "$COORDINATOR_PANE_ARG" ]]; then
  PRIMARY_PANE_ID="$COORDINATOR_PANE_ARG"
elif $DRY_RUN; then
  # A dry run reports what would be bound and contacts tmux not at all -- not
  # even to check reachability.  Requiring a live server here would make
  # `--dry-run` fail in exactly the environments it exists to be safe in (CI, a
  # headless shell, a fixture with a minimal tmux stub), and a dry run that needs
  # the resource it promises not to touch is not a dry run.
  echo "[dry-run] would create or select managed coordinator pane in $TMUX_SESSION:$SGT_MANAGED_COORDINATOR_WINDOW"
else
  # Deliberately does not start a server: a coordinator must already be able to
  # reach a live tmux server, so a headless environment fails loudly instead of
  # acquiring a pane nobody can observe.
  tmux list-sessions >/dev/null 2>&1 || \
    _die "sgt-dispatch found no reachable tmux server for its coordinator pane; start tmux first, or pass --coordinator-pane <pane-id>"
  managed_pane_result="$(_sgt_managed_coordinator_pane "$TMUX_SESSION" \
    "$SGT_MANAGED_COORDINATOR_WINDOW")" || \
    _die "sgt-dispatch could not create or select the managed coordinator pane in $TMUX_SESSION:$SGT_MANAGED_COORDINATOR_WINDOW; remove that window if it is not Sergeant's"
  PRIMARY_PANE_ID="${managed_pane_result%% *}"
  SGT_MANAGED_COORDINATOR_CREATED="${managed_pane_result##* }"
fi

# Roll back exactly the managed coordinator window this invocation created, and
# only that one, if the dispatch does not complete.  Selecting an existing window
# records nothing to remove, so a pane Sergeant merely adopted is never killed.
# Installed as an EXIT trap immediately, because several later preflight steps
# (intent preparation, fleet reconciliation, drain admission, td creation, repo
# validation) can still abort after the pane is bound.
_rollback_managed_coordinator_pane() {
  if [[ "${SGT_MANAGED_COORDINATOR_CREATED:-false}" == "true" ]]; then
    SGT_MANAGED_COORDINATOR_CREATED="false"
    tmux kill-window -t "$TMUX_SESSION:=$SGT_MANAGED_COORDINATOR_WINDOW" 2>/dev/null || true
  fi
  _release_dispatch_task_lock
}
trap _rollback_managed_coordinator_pane EXIT

if [[ -n "$PRIMARY_PANE_ID" ]]; then
  PRIMARY_PANE_IDENTITY="$(_sgt_verify_pane_identity "$PRIMARY_PANE_ID")" || \
    _die "sgt-dispatch could not bind exact coordinator pane identity: $PRIMARY_PANE_ID"
fi

INTENT_TMP="$(mktemp)"

# ── Auto-create td tasks when no --td given ───────────────────────────────────
# When we weren't given a specific task ID, create td tasks in each target repo
# now so the work is tracked end-to-end.
#
# We store a map of repo→task_id in a temp file so the brief-writing loop
# can inject the right td task ID per repo.

REPO_TD_MAP="$(mktemp)"
TD_CREATE_STATE_FILE="$(mktemp)"
TD_CREATE_STDERR="$(mktemp)"
TD_CREATE_SUCCESS_FILE="$(mktemp)"
DISPATCH_MUTATIONS_FILE="$(mktemp)"
DISPATCH_SNAPSHOT_ROOT="$(mktemp -d)"
DISPATCH_TASK_DIR_CREATED=false
DISPATCH_SUCCEEDED=false
DISPATCH_ROLLBACK_ERRORS=""
DISPATCH_TD_ROLLBACK_PENDING=false

_dispatch_test_failpoint() {
  [[ "${SGT_TEST_HOOKS:-}" == 1 && \
     "${SGT_DISPATCH_FAIL_POINT:-}" == "$1" ]] || return 0
  kill -"${SGT_DISPATCH_CRASH_SIGNAL:-TERM}" "$$"
}

_dispatch_rollback_error() {
  [[ -z "$DISPATCH_ROLLBACK_ERRORS" ]] || DISPATCH_ROLLBACK_ERRORS+=$'\n'
  DISPATCH_ROLLBACK_ERRORS+="$1"
}

_journal_dispatch_mutation() {
  python3 - "$DISPATCH_MUTATIONS_FILE" "$@" <<'PY'
import os
import sys

path, *fields = sys.argv[1:]
with open(path, "a", encoding="utf-8") as handle:
    handle.write("\t".join(fields) + "\n")
    handle.flush()
    os.fsync(handle.fileno())
directory = os.open(os.path.dirname(path), os.O_RDONLY)
try:
    os.fsync(directory)
finally:
    os.close(directory)
PY
}

_sgt_wait_worker_notification_ack() {
  local pane="$1" repo_dir="$2" notification_id="$3"
  local timeout="${SGT_NOTIFICATION_ACK_TIMEOUT:-60}" attempt=0 nonce token
  local target_dir worktree pane_identity expected_identity
  [[ "$timeout" =~ ^[0-9]+$ ]] || return 1
  worktree="$(cat "$repo_dir/worktree" 2>/dev/null || true)"
  while :; do
    nonce="$(cat "$repo_dir/notification_target" 2>/dev/null || true)"
    [[ "$nonce" =~ ^[a-f0-9]{32}$ ]] || return 1
    token="$notification_id|$nonce"
    target_dir="$repo_dir/notifications/$notification_id/targets/$nonce"
    if [[ "$(cat "$worktree/.sergeant-notification-acks/$nonce" 2>/dev/null || true)" == "$token" ||
          "$(cat "$target_dir/accepted" 2>/dev/null || true)" == "$token" ]]; then
      return 0
    fi
    expected_identity="$(cat "$repo_dir/pane_identity" 2>/dev/null || true)"
    pane_identity="$(_sgt_pane_identity "$pane")" || return 1
    [[ -n "$expected_identity" && "$pane_identity" == "$expected_identity" ]] || return 1
    (( attempt >= timeout * 10 )) && return 1
    attempt=$((attempt + 1))
    sleep 0.1
  done
}

_snapshot_dispatch_worktree() {
  local worktree="$1" snapshot name state
  snapshot="$(mktemp -d "$DISPATCH_SNAPSHOT_ROOT/worktree.XXXXXX")" || return 1
  : > "$snapshot/manifest"
  for name in .sergeant-intent.md .sergeant-brief.md .sergeant-notification \
      .sergeant-notification-ack .sergeant-notification-accept; do
    if [[ -e "$worktree/$name" || -L "$worktree/$name" ]]; then
      cp -pPR "$worktree/$name" "$snapshot/$name" || return 1
      state=present
    else
      state=absent
    fi
    printf '%s\t%s\n' "$state" "$name" >> "$snapshot/manifest"
  done
  printf '%s\n' "$snapshot"
}

_restore_dispatch_worktree() {
  local worktree="$1" snapshot="$2" state name
  [[ -n "$worktree" && "$worktree" != / && -s "$snapshot/manifest" ]] || return 1
  while IFS=$'\t' read -r state name; do
    case "$name" in
      .sergeant-intent.md|.sergeant-brief.md|.sergeant-notification|\
      .sergeant-notification-ack|.sergeant-notification-accept) ;;
      *) return 1 ;;
    esac
    rm -rf "${worktree:?}/${name:?}" || return 1
    if [[ "$state" == present ]]; then
      cp -pPR "$snapshot/$name" "$worktree/$name" || return 1
    elif [[ "$state" != absent ]]; then
      return 1
    fi
  done < "$snapshot/manifest"
}

_persist_dispatch_td_rollback_evidence() {
  local source_file="$1" journal="$TASK_DIR/td-rollback-journal.jsonl"
  local diagnostic="$TASK_DIR/td-rollback-diagnostic"
  DISPATCH_TD_ROLLBACK_PENDING=true
  [[ -d "$TASK_DIR" && ! -L "$TASK_DIR" && -s "$source_file" ]] || return 1
  if ! python3 - "$source_file" "$journal" "$TASK_DIR" <<'PY'
import os
import sys

source, destination, directory = sys.argv[1:]
temporary = destination + f".tmp.{os.getpid()}"
source_fd = os.open(source, os.O_RDONLY)
try:
    destination_fd = os.open(
        temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600
    )
    try:
        while True:
            chunk = os.read(source_fd, 65536)
            if not chunk:
                break
            view = memoryview(chunk)
            while view:
                written = os.write(destination_fd, view)
                view = view[written:]
        os.fsync(destination_fd)
    finally:
        os.close(destination_fd)
finally:
    os.close(source_fd)
os.replace(temporary, destination)
directory_fd = os.open(directory, os.O_RDONLY)
try:
    os.fsync(directory_fd)
finally:
    os.close(directory_fd)
PY
  then
    return 1
  fi
  _sgt_replace_owned_file "$diagnostic" \
    "generated td rollback is incomplete; run: sgt-cleanup $TASK_ID" || return 1
}

_rollback_dispatch_generated_td_tasks() {
  local rollback_state
  # The child fsyncs each creation and its success marker before returning.
  # Those files transfer rollback ownership without a volatile parent flag or
  # a crash window before result-map parsing.
  [[ -s "$TD_CREATE_STATE_FILE" && -s "$TD_CREATE_SUCCESS_FILE" ]] || return 0
  [[ "$(cat "$TD_CREATE_SUCCESS_FILE")" == committed ]] || return 0
  rollback_state="$(mktemp)" || {
    _dispatch_rollback_error "could not allocate generated td rollback state"
    return 1
  }
  if ! python3 - "$TD_CREATE_STATE_FILE" "$TASK_DIR" "$rollback_state" <<'PY'
import json
import os
import sys

source, task_dir, destination = sys.argv[1:]
with open(source, encoding="utf-8") as source_handle, \
     open(destination, "w", encoding="utf-8") as destination_handle:
    for line in source_handle:
        if not line.strip():
            continue
        item = json.loads(line)
        repo_state = os.path.join(task_dir, item["repo"])
        pane_path = os.path.join(repo_state, "pane")
        task_path = os.path.join(repo_state, "td_task")
        if os.path.isfile(pane_path) and os.path.getsize(pane_path) > 0:
            try:
                with open(task_path, encoding="utf-8") as task_handle:
                    if task_handle.read().strip() == item["task_id"]:
                        continue
            except OSError:
                pass
        destination_handle.write(json.dumps(item) + "\n")
    destination_handle.flush()
    os.fsync(destination_handle.fileno())
PY
  then
    _dispatch_rollback_error "could not classify generated td task ownership"
    rm -f "$rollback_state"
    return 1
  fi
  if ! _sgt_td_rollback_state "$rollback_state"; then
    _dispatch_rollback_error "$SGT_TD_ROLLBACK_ERRORS"
    if ! _persist_dispatch_td_rollback_evidence "$rollback_state"; then
      _dispatch_rollback_error "could not preserve generated td rollback evidence"
    fi
    rm -f "$rollback_state"
    return 1
  fi
  rm -f "$rollback_state"
}

_rollback_dispatch_mutations() {
  local repo_path worktree_path branch mutation_kind initial_sha repo_state
  local snapshot changes changed_path current_sha lease_path lease_id lease_holder
  local entry_failed launched_worker=false owned_cleanup_failed=false

  while IFS=$'\t' read -r repo_path worktree_path branch mutation_kind \
      initial_sha repo_state snapshot; do
    [[ -n "$repo_state" ]] || continue
    if [[ -s "$repo_state/pane" ]]; then
      if $JSON_OUTPUT; then
        pane_target="$(cat "$repo_state/pane" 2>/dev/null || true)"
        if ! _sgt_is_tmux_pane_id "$pane_target" || \
           ! tmux kill-pane -t "$pane_target" >/dev/null 2>&1; then
          owned_cleanup_failed=true
          _dispatch_rollback_error "could not retire pre-admission worker: $repo_state"
          continue
        fi
        rm -f "$repo_state/pane"
      else
        launched_worker=true
        continue
      fi
    fi
    entry_failed=false

    case "$mutation_kind" in
      git-pending)
        # A pending record is written before git runs.  Only remove the path if
        # git now recognizes the exact path as this repository's worktree.
        if [[ -d "$worktree_path" && -f "$worktree_path/.git" && ! -L "$worktree_path/.git" ]] && \
           git -C "$repo_path" worktree list --porcelain | \
             grep -qFx "worktree $worktree_path"; then
          changes="$(git -C "$worktree_path" status --porcelain --untracked-files=all 2>/dev/null || true)"
          while IFS= read -r changed_path; do
            [[ -n "$changed_path" ]] || continue
            changed_path="${changed_path#???}"
            case "$changed_path" in
              .sergeant-intent.md|.sergeant-brief.md|.sergeant-notification*|.sergeant-status|.sergeant-result) ;;
              *) entry_failed=true ;;
            esac
          done <<< "$changes"
          if $entry_failed; then
            _dispatch_rollback_error "preserved worktree containing non-Sergeant changes: $worktree_path"
          elif ! git -C "$repo_path" worktree remove --force "$worktree_path" >/dev/null 2>&1; then
            entry_failed=true
            _dispatch_rollback_error "could not remove worktree: $worktree_path"
          fi
        fi
        if ! $entry_failed && [[ "$branch" != - ]]; then
          current_sha="$(git -C "$repo_path" rev-parse "refs/heads/$branch" 2>/dev/null || true)"
          if [[ -n "$current_sha" && "$current_sha" == "$initial_sha" ]]; then
            if ! git -C "$repo_path" branch -D "$branch" >/dev/null 2>&1; then
              entry_failed=true
              _dispatch_rollback_error "could not remove invocation-created branch: $branch"
            fi
          elif [[ -n "$current_sha" ]]; then
            entry_failed=true
            _dispatch_rollback_error "preserved branch with changed commits: $branch"
          fi
        fi
        ;;
      git-reused)
        if ! _restore_dispatch_worktree "$worktree_path" "$snapshot"; then
          entry_failed=true
          _dispatch_rollback_error "could not restore preexisting Sergeant files in: $worktree_path"
        fi
        ;;
      treehouse-pending)
        if [[ -f "$repo_state/treehouse-preserve-evidence" ]]; then
          entry_failed=true
          _dispatch_rollback_error "preserved ambiguous Treehouse evidence: $repo_state"
        elif [[ -f "$repo_state/treehouse-acquisition-return" ]] && \
           [[ "$(cat "$repo_state/treehouse-acquisition-return")" == returned ]]; then
          :
        elif [[ -s "$repo_state/treehouse-acquisition.json" ]]; then
          lease_path="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["path"])' \
            "$repo_state/treehouse-acquisition.json" 2>/dev/null || true)"
          lease_id="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["lease_id"])' \
            "$repo_state/treehouse-acquisition.json" 2>/dev/null || true)"
          lease_holder="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["lease_holder"])' \
            "$repo_state/treehouse-acquisition.json" 2>/dev/null || true)"
          if [[ -z "$lease_path" || -z "$lease_id" || -z "$lease_holder" ]] || \
             ! "$SCRIPT_DIR/_sgt-treehouse-io.py" return "$repo_path" \
               "$repo_state/treehouse-rollback.raw" \
               "$repo_state/treehouse-rollback-receipt.json" "$lease_path" \
               "$lease_id" "$lease_holder"; then
            entry_failed=true
            _dispatch_rollback_error "could not return Treehouse acquisition: $repo_state"
          else
            printf 'returned\n' > "$repo_state/treehouse-acquisition-return"
          fi
        fi
        ;;
    esac
    if $entry_failed; then
      owned_cleanup_failed=true
      case "$repo_state" in
        "$TASK_DIR"/*)
          [[ ! -d "$repo_state" ]] || : > "$repo_state/rollback-preserve-evidence"
          ;;
      esac
    fi
  done < "$DISPATCH_MUTATIONS_FILE"

  # Repository state can exist before its worktree mutation journal (for
  # example, an auth-switch failure).  Sweep every non-live state owned by this
  # invocation unless an exact cleanup failure above requires its evidence.
  for repo_state in "$TASK_DIR"/*; do
    [[ -d "$repo_state" && ! -s "$repo_state/pane" && \
       ! -e "$repo_state/rollback-preserve-evidence" ]] || continue
    case "$repo_state" in
      "$TASK_DIR"/*) rm -rf "$repo_state" ;;
      *)
        owned_cleanup_failed=true
        _dispatch_rollback_error "refused unexpected repository fleet path: $repo_state"
        ;;
    esac
  done

  _rollback_dispatch_generated_td_tasks || true

  if ! $launched_worker && ! $owned_cleanup_failed && \
     ! $DISPATCH_TD_ROLLBACK_PENDING && $DISPATCH_TASK_DIR_CREATED; then
    case "$TASK_DIR" in
      "$FLEET_DIR"/*) rm -rf "$TASK_DIR" ;;
      *) _dispatch_rollback_error "refused unexpected fleet path: $TASK_DIR" ;;
    esac
    DISPATCH_TASK_DIR_CREATED=false
  fi
  [[ -z "$DISPATCH_ROLLBACK_ERRORS" ]] || \
    printf 'ERROR: dispatch rollback incomplete:\n%s\n' "$DISPATCH_ROLLBACK_ERRORS" >&2
}

_cleanup_dispatch_tmps() {
  local dispatch_status=$?
  trap - EXIT HUP INT TERM
  if [[ "$dispatch_status" -ne 0 ]] && ! $DISPATCH_SUCCEEDED; then
    _rollback_dispatch_mutations
  fi
  rm -f "$REPO_TD_MAP" "$TD_CREATE_STATE_FILE" "$TD_CREATE_STDERR" \
    "$TD_CREATE_SUCCESS_FILE" "$DISPATCH_MUTATIONS_FILE" "$INTENT_TMP" \
    "${DEPS_TMP:-}"
  rm -rf "$DISPATCH_SNAPSHOT_ROOT" "$_SGT_BOOTSTRAP_ROOT"
  # This trap replaces the coordinator-pane rollback trap, so it must keep
  # honouring it; the rollback is a no-op once the dispatch has completed.
  _rollback_managed_coordinator_pane
  exit "$dispatch_status"
}
trap _cleanup_dispatch_tmps EXIT
_dispatch_signal() { exit "$1"; }
trap '_dispatch_signal 129' HUP
trap '_dispatch_signal 130' INT
trap '_dispatch_signal 143' TERM

_sgt_intent_prepare "$INTENT_FILE" "$BRIEF" "$INTENT_TMP"
INTENT_REVISION="$(_sgt_intent_revision "$INTENT_TMP")"

_rollback_generated_td_tasks() {
  local failure_message="$1"
  if ! _sgt_td_rollback_state "$TD_CREATE_STATE_FILE"; then
    _die "$failure_message"$'\n'"$SGT_TD_ROLLBACK_ERRORS"
  fi

  : > "$TD_CREATE_STATE_FILE"
  _die "$failure_message"
}

_build_repo_td_map_or_die() {
  local td_results="$1"
  local selected_repos_csv="$2"
  : > "$TD_CREATE_STDERR"
  if ! TD_RESULTS="$td_results" TARGET_REPOS_CSV="$selected_repos_csv" python3 - <<'PY' > "$REPO_TD_MAP" 2>"$TD_CREATE_STDERR"
import json
import os
import sys

selected = [repo for repo in os.environ["TARGET_REPOS_CSV"].split(",") if repo]
seen = set()
seen_task_ids = set()

try:
    results = json.loads(os.environ["TD_RESULTS"])
except json.JSONDecodeError:
    print("failed to inject td task results", file=sys.stderr)
    raise SystemExit(1)

if not isinstance(results, list):
    print("failed to inject td task results", file=sys.stderr)
    raise SystemExit(1)

for item in results:
    if not isinstance(item, dict):
        print("failed to inject td task results", file=sys.stderr)
        raise SystemExit(1)
    repo = item.get("repo")
    task_id = item.get("task_id")
    if not isinstance(repo, str) or not isinstance(task_id, str):
        print("failed to inject td task results", file=sys.stderr)
        raise SystemExit(1)
    if not task_id or any(ch.isspace() for ch in task_id):
        print(f"invalid td task id for repo: {repo}", file=sys.stderr)
        raise SystemExit(1)
    if repo not in selected:
        print(f"unexpected td task result for repo: {repo}", file=sys.stderr)
        raise SystemExit(1)
    if repo in seen:
        print(f"duplicate td task result for repo: {repo}", file=sys.stderr)
        raise SystemExit(1)
    if task_id in seen_task_ids:
        print(f"duplicate td task id: {task_id}", file=sys.stderr)
        raise SystemExit(1)
    seen.add(repo)
    seen_task_ids.add(task_id)
    print(f"{repo} {task_id}")

for repo in selected:
    if repo not in seen:
        print(f"missing td task for selected repo: {repo}", file=sys.stderr)
        raise SystemExit(1)
PY
  then
    local validation_error
    validation_error="$(cat "$TD_CREATE_STDERR")"
    [[ -n "$validation_error" ]] || validation_error="failed to inject td task results"
    _rollback_generated_td_tasks "$validation_error"
  fi
}

# ── Review-router contract preflight (GH #204) ───────────────────────────────
# Resolve the PATH-selected executable exactly as a worker would, canonicalize
# every alias/symlink hop, and validate its closed machine-readable contract.
# Identity is sampled on both sides of the probe so a changed executable cannot
# be persisted as verified evidence.
REVIEW_ROUTER_EXECUTABLE=""
REVIEW_ROUTER_EXECUTABLE_IDENTITY=""
REVIEW_ROUTER_CONTRACT_REVISION=""
REVIEW_ROUTER_CONTRACT=""
REVIEW_ROUTER_LAUNCHER="$_SGT_REVIEW_ROUTER_LAUNCHER_FILE"

_sgt_review_router_executable_identity() {
  python3 - "$1" <<'PY'
import hashlib
import os
import stat
import sys

runtime_files = (
    "sgt-review-findings", "_sgt-lib.sh", "_sgt-response-lock.sh",
    "_sgt-review-axes.sh", "_sgt-bash-version.sh", "_sgt-process-identity.sh",
    "_sgt-drain.sh", "_sgt-process.sh",
    "_sgt-response-lock-transition.py", "_sgt-process-token.py", "sgt-notify",
    "sgt-callback",
)
router = sys.argv[1]
directory = os.path.dirname(router)
runtime = hashlib.sha256()
router_info = None
router_digest = None
for name in runtime_files:
    path = router if name == "sgt-review-findings" else os.path.join(directory, name)
    runtime.update(name.encode() + b"\0")
    flags = os.O_RDONLY
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    fd = os.open(path, flags)
    try:
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode):
            raise OSError("runtime dependency is not a regular file")
        digest = hashlib.sha256()
        while True:
            chunk = os.read(fd, 65536)
            if not chunk:
                break
            digest.update(chunk)
        runtime.update(digest.digest())
        if name == "sgt-review-findings":
            router_info = info
            router_digest = digest.hexdigest()
    finally:
        os.close(fd)
if router_info is None:
    raise OSError("review router is unavailable")
print(f"{router_info.st_dev}:{router_info.st_ino}:{router_digest}:{runtime.hexdigest()}")
PY
}

_sgt_preflight_review_router() {
  local selected before_identity after_identity revision contract_file
  selected="$(command -v sgt-review-findings 2>/dev/null || true)"
  [[ -n "$selected" && "$selected" == */* ]] || \
    _die "review-router preflight: sgt-review-findings is not installed on PATH. Update or reinstall Sergeant."
  REVIEW_ROUTER_EXECUTABLE="$(_sgt_dispatch_canonical_file "$selected" installed-review-router)" || \
    _die "review-router preflight: could not resolve installed sgt-review-findings: $selected"
  [[ -x "$REVIEW_ROUTER_EXECUTABLE" ]] || \
    _die "review-router preflight: installed sgt-review-findings is not executable: $REVIEW_ROUTER_EXECUTABLE"
  before_identity="$(_sgt_review_router_executable_identity "$REVIEW_ROUTER_EXECUTABLE")" || \
    _die "review-router preflight: could not identify installed sgt-review-findings"
  contract_file="$(mktemp)" || _die "review-router preflight: could not allocate contract capture"
  if ! "$REVIEW_ROUTER_EXECUTABLE" --capabilities > "$contract_file" 2>/dev/null; then
    rm -f "$contract_file"
    _die "review-router contract mismatch: installed sgt-review-findings does not expose --capabilities. Update or reinstall Sergeant."
  fi
  after_identity="$(_sgt_review_router_executable_identity "$REVIEW_ROUTER_EXECUTABLE")" || \
    _die "review-router executable changed during preflight: $REVIEW_ROUTER_EXECUTABLE"
  [[ "$after_identity" == "$before_identity" ]] || \
    _die "review-router executable changed during preflight: $REVIEW_ROUTER_EXECUTABLE"

  if ! revision="$(SGT_EXPECTED_SCHEMA="$SGT_REVIEW_ROUTER_CAPABILITIES_SCHEMA" \
    SGT_EXPECTED_CONTRACT_REVISION="$SGT_REVIEW_ROUTER_CONTRACT_REVISION" \
    SGT_EXPECTED_ARTIFACT_REVISION="$SGT_REVIEW_ARTIFACT_SCHEMA_REVISION" \
    SGT_EXPECTED_AXES="$(_sgt_review_axes)" \
    SGT_EXPECTED_SEVERITIES="$SGT_REVIEW_SEVERITIES" \
    SGT_EXPECTED_ALIASES="$SGT_REVIEW_SEVERITY_ALIASES" \
    SGT_EXPECTED_ARGV="$SGT_REVIEW_ROUTER_ARGV" \
      python3 - "$contract_file" <<'PY'
import json
import os
import sys

def closed_object(pairs):
    result = {}
    for key, value in pairs:
        if key in result:
            raise ValueError("duplicate key")
        result[key] = value
    return result

try:
    with open(sys.argv[1], "rb") as stream:
        raw = stream.read().decode("utf-8", "strict")
    doc = json.loads(raw, object_pairs_hook=closed_object)
    expected_keys = {
        "schema", "contract_revision", "artifact_schema_revision", "axes",
        "canonical_severities", "severity_aliases", "argv",
    }
    expected_aliases = dict(
        pair.split("=", 1) for pair in os.environ["SGT_EXPECTED_ALIASES"].split()
    )
    if set(doc) != expected_keys:
        raise ValueError("capability fields")
    if doc["schema"] != os.environ["SGT_EXPECTED_SCHEMA"]:
        raise ValueError("capability schema")
    if doc["contract_revision"] != os.environ["SGT_EXPECTED_CONTRACT_REVISION"]:
        raise ValueError("contract revision")
    if doc["artifact_schema_revision"] != os.environ["SGT_EXPECTED_ARTIFACT_REVISION"]:
        raise ValueError("artifact schema revision")
    if doc["axes"] != os.environ["SGT_EXPECTED_AXES"].split():
        raise ValueError("axes")
    if doc["canonical_severities"] != os.environ["SGT_EXPECTED_SEVERITIES"].split():
        raise ValueError("canonical severities")
    if doc["severity_aliases"] != expected_aliases:
        raise ValueError("severity aliases")
    if doc["argv"] != os.environ["SGT_EXPECTED_ARGV"].split():
        raise ValueError("argv")
except (json.JSONDecodeError, KeyError, TypeError, ValueError):
    raise SystemExit(1)
print(doc["contract_revision"])
PY
)"; then
    rm -f "$contract_file"
    _die "review-router contract mismatch: installed sgt-review-findings cannot honor this dispatch revision. Update or reinstall Sergeant."
  fi
  REVIEW_ROUTER_CONTRACT="$(cat "$contract_file")"
  rm -f "$contract_file"
  REVIEW_ROUTER_EXECUTABLE_IDENTITY="$before_identity"
  REVIEW_ROUTER_CONTRACT_REVISION="$revision"
}
if ! $DRY_RUN; then
  _sgt_preflight_review_router
fi

# The task-identity lock itself is fleet mutation, so it is deliberately
# acquired only after the installed router contract is proven compatible.
if ! $DRY_RUN; then
  _sgt_drain_lock_acquire_fd "$_SGT_DISPATCH_TASK_FD" dispatch-task \
    "$FLEET_DIR/.dispatch-$TASK_ID.lock" || \
    _die "Could not acquire exact dispatch task ownership"
  SGT_DISPATCH_TASK_LOCKED=true
  # A retry may own a durable partial transaction for this exact correlation.
  # Reuse its journal to retire partial workers/worktrees/td state, then replay
  # under the same task ID. Unrelated collisions remain fatal.
  if [[ -e "$TASK_DIR" || -L "$TASK_DIR" ]]; then
    if $JSON_OUTPUT && [[ -n "$PENDING_TASK_ID" && "$TASK_ID" == "$PENDING_TASK_ID" &&
      -d "$TASK_DIR/.dispatch-rollback" && ! -L "$TASK_DIR/.dispatch-rollback" ]]; then
      rm -f "$DISPATCH_MUTATIONS_FILE" "$TD_CREATE_STATE_FILE" \
        "$TD_CREATE_SUCCESS_FILE"
      rm -rf "$DISPATCH_SNAPSHOT_ROOT"
      DISPATCH_MUTATIONS_FILE="$TASK_DIR/.dispatch-rollback/mutations"
      TD_CREATE_STATE_FILE="$TASK_DIR/.dispatch-rollback/td-create-state.jsonl"
      TD_CREATE_SUCCESS_FILE="$TASK_DIR/.dispatch-rollback/td-create-success"
      DISPATCH_SNAPSHOT_ROOT="$TASK_DIR/.dispatch-rollback/snapshots"
      DISPATCH_TASK_DIR_CREATED=true
      _rollback_dispatch_mutations
      [[ -z "$DISPATCH_ROLLBACK_ERRORS" && ! -e "$TASK_DIR" ]] || \
        _die "Could not recover partial correlated admission: $TASK_ID"
      DISPATCH_MUTATIONS_FILE="$(mktemp)"
      TD_CREATE_STATE_FILE="$(mktemp)"
      TD_CREATE_SUCCESS_FILE="$(mktemp)"
      DISPATCH_SNAPSHOT_ROOT="$(mktemp -d)"
      DISPATCH_TASK_DIR_CREATED=false
      DISPATCH_TD_ROLLBACK_PENDING=false
    else
      _die "Dispatch task ID collision after serialized ownership: $TASK_ID"
    fi
  fi
fi

if ! $DRY_RUN; then
  [[ -x "$SCRIPT_DIR/sgt-watch" ]] || _die "sgt-watch is required for fleet reconciliation"
  # The sweep is global fleet hygiene; this dispatch is scoped to one task.
  # sgt-watch returns nonzero when ANY terminal worker anywhere could not be
  # recycled (bin/sgt-watch:1933).  Recyclable terminal states are
  # done|failed:*|drained|force-stopped; of those, sgt-cleanup's status gate
  # accepts only `done` with a result, `failed: <reason>`, and `orphaned` with a
  # closed td task, so a `drained` or `force-stopped` record is recyclable but
  # never cleanable — permanent.  Under `set -e` an unguarded call therefore
  # deadlocks every future dispatch, including dispatches unrelated to the
  # offending records.
  #
  # Continuing is safe for a reason stronger than the states involved: TASK_ID is
  # freshly generated above, its directory is collision-checked under the
  # serialized dispatch-task lock, and every worktree path embeds TASK_ID — so a
  # record the sweep could not recycle is structurally never this dispatch's own
  # task, and nothing downstream depends on the sweep having succeeded.
  #
  # Report the exit status rather than asserting a cause: --sync-all also exits
  # nonzero when sgt-watch itself fails under its own `set -e`, and reporting
  # that as routine unrecycled-worker noise would reproduce exactly the
  # misattribution GH #227 was filed about.
  # Captured with `|| status=$?` rather than read inside `if ! cmd`, where `$?`
  # is the status of the negation (always 0) and not the sweep's.
  _sgt_sweep_status=0
  "$SCRIPT_DIR/sgt-watch" --sync-all >/dev/null || _sgt_sweep_status=$?
  if [[ "$_sgt_sweep_status" -ne 0 ]]; then
    printf 'WARNING: fleet reconciliation exited %s (diagnostics above); continuing with this dispatch.\n' \
      "$_sgt_sweep_status" >&2
  fi
fi

# ── Filesystem device preflight (#236) ───────────────────────────────────────
# Verify that each target repo's expected worktree path lies on the same
# filesystem device as SERGEANT_FLEET before any persistent side effect (td
# task, fleet record, branch, worktree).  sgt-cleanup refuses cross-device
# layouts (#161); catching the mismatch here prevents stuck fleet records that
# cleanup cannot remove.
if ! $DRY_RUN; then
  _pf_fleet_device="$(_path_device "$FLEET_DIR")" || \
    _die "Cannot determine filesystem device of SERGEANT_FLEET ($FLEET_DIR)"
  _pf_repo_count="$(yq '.repos | length' "$CONFIG_FILE")"
  _pf_error_repos=()
  for _pf_rname in "${TARGET_REPOS[@]}"; do
    for ((_pf_i=0; _pf_i<_pf_repo_count; _pf_i++)); do
      [[ "$(yq ".repos[$_pf_i].name" "$CONFIG_FILE")" == "$_pf_rname" ]] && break
    done
    # Guard: if the repo name was not found in the config the inner loop exits
    # with _pf_i == _pf_repo_count.  Skip the device check; the canonical "repo
    # not found" error is emitted by the repo-validation section further below.
    [[ $_pf_i -lt $_pf_repo_count ]] || continue
    _pf_repo_path="$(_resolve_path "$(yq ".repos[$_pf_i].path" "$CONFIG_FILE")")"
    # Treehouse pools may live on a different filesystem from the repo itself.
    # Read the pool root from treehouse.toml; when root is absent or empty the
    # pool lives at $HOME/.treehouse (treehouse default).
    # For plain git-worktree dispatch the destination is a sibling of the repo.
    if [[ -f "$_pf_repo_path/treehouse.toml" ]] && command -v treehouse &>/dev/null; then
      # Parse `root = "..."` or `root = '...'` (TOML allows both quote styles).
      # Strip the key and all surrounding whitespace and quotes with parameter
      # expansion so the result is the bare path value — or empty when root is
      # unset, which treehouse interprets as $HOME (its documented default).
      _pf_th_line="$(grep -m1 '^[[:space:]]*root[[:space:]]*=' \
        "$_pf_repo_path/treehouse.toml" 2>/dev/null || true)"
      _pf_th_root="${_pf_th_line#*=}"
      _pf_th_root="${_pf_th_root#"${_pf_th_root%%[![:space:]]*}"}"
      _pf_th_root="${_pf_th_root%"${_pf_th_root##*[![:space:]]}"}"
      case "$_pf_th_root" in
        '"'*'"') _pf_th_root="${_pf_th_root#'"'}"; _pf_th_root="${_pf_th_root%'"'}" ;;
        "'"*"'") _pf_th_root="${_pf_th_root#"'"}"; _pf_th_root="${_pf_th_root%"'"}" ;;
      esac
      if [[ -z "$_pf_th_root" ]]; then
        _pf_expected_wt="$HOME/.treehouse"
      elif [[ "$_pf_th_root" == /* ]]; then
        _pf_expected_wt="$_pf_th_root/.treehouse"
      else
        _pf_expected_wt="$_pf_repo_path/$_pf_th_root/.treehouse"
      fi
    else
      _pf_expected_wt="$(dirname "$_pf_repo_path")"
    fi
    _pf_wt_device="$(_path_device "$_pf_expected_wt")" || \
      _die "Cannot determine filesystem device of worktree destination for $_pf_rname ($_pf_expected_wt)"
    if [[ "$_pf_fleet_device" != "$_pf_wt_device" ]]; then
      _pf_error_repos+=("$_pf_rname: worktree path $_pf_expected_wt is on a different device than SERGEANT_FLEET ($FLEET_DIR)")
    fi
  done
  if [[ "${#_pf_error_repos[@]}" -gt 0 ]]; then
    _pf_msg="Cross-device layout rejected — set SERGEANT_FLEET to a directory on the same filesystem as the worktrees, or reconfigure the repo paths so they share a device with SERGEANT_FLEET. sgt-cleanup refuses this layout and will leave stuck fleet records (#161):"
    for _pf_e in "${_pf_error_repos[@]}"; do
      _pf_msg+=$'\n'"  $_pf_e"
    done
    # _die exits; no cleanup needed for preflight temporaries.
    _die "$_pf_msg"
  fi
  unset _pf_fleet_device _pf_repo_count _pf_error_repos _pf_rname _pf_i \
    _pf_repo_path _pf_th_root _pf_expected_wt _pf_wt_device
fi

# ── Drain admission check ─────────────────────────────────────────────────────
# Acquire the drain admission lock and hold it through the first side effect
# (td task creation), so that a concurrent drain set either waits until
# admission is committed or wins the lock first and blocks this dispatch.
# Fails closed: malformed, empty, or expired drain records block dispatch.
_SGT_DRAIN_ADMISSION_FD=9
if ! $DRY_RUN; then
  _sgt_drain_lock_acquire_fd "$_SGT_DRAIN_ADMISSION_FD" || \
    _die "cannot acquire drain admission lock"
  if ! _sgt_drain_check_admission_locked "$PROJECT"; then
    _sgt_drain_lock_release_fd "$_SGT_DRAIN_ADMISSION_FD"
    exit 1
  fi
fi

if [[ -z "$TD_TASK_ID" ]] && ! $DRY_RUN; then
  _require_marcus_td
  TD_TITLE="$(python3 - "$BRIEF" <<'PY'
import sys

title = " ".join(sys.argv[1].split())
if len(title) > 200:
    title = title[:197].rstrip() + "..."
print(title)
PY
)"
  echo "Creating td tasks ..."
  : > "$TD_CREATE_STATE_FILE"
  : > "$TD_CREATE_STDERR"
  : > "$TD_CREATE_SUCCESS_FILE"
  if ! td_results="$(SGT_TD_STATE_FILE="$TD_CREATE_STATE_FILE" \
    SGT_TD_SUCCESS_FILE="$TD_CREATE_SUCCESS_FILE" \
    "$SCRIPT_DIR/sgt-td-create" "$PROJECT" "$TD_TITLE" \
    --repos "$REPOS_ARG" \
    --description "$BRIEF" \
    --type task \
    --priority P1 \
    --json 2>"$TD_CREATE_STDERR")"; then
    td_error="$(cat "$TD_CREATE_STDERR")"
    [[ -n "$td_error" ]] || td_error="$td_results"
    _sgt_drain_lock_release_fd "$_SGT_DRAIN_ADMISSION_FD"
    _die "td task creation failed: $td_error"
  fi

  if [[ "${SGT_TEST_HOOKS:-}" == 1 && \
        "${SGT_DISPATCH_FAIL_POINT:-}" == dispatch-td-create-returned ]]; then
    kill -TERM "$$"
  fi

  _build_repo_td_map_or_die "$td_results" "$REPOS_ARG"

  if [[ -s "$REPO_TD_MAP" ]]; then
    while IFS=' ' read -r rname tid; do
      echo "  created $tid in $rname"
    done < "$REPO_TD_MAP"
    echo ""
  fi
fi

# Drain admission lock covers through td task creation.  Release it now that
# the dispatch has committed its first side effect (or no td creation was
# needed because --td was supplied).
if ! $DRY_RUN; then
  _sgt_drain_lock_release_fd "$_SGT_DRAIN_ADMISSION_FD"
fi

# ── Determine branch name ─────────────────────────────────────────────────────

if [[ -n "$BRANCH_ARG" ]]; then
  BRANCH="$BRANCH_ARG"
else
  bslug="$(echo "$BRIEF" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '-' | sed 's/^-//;s/-$//' | cut -c1-40 | sed 's/-$//')"
  # Store regex in variable: Apple Bash 3.2.57 (macOS) cannot parse inline
  # alternation groups in =~ (e.g. ^(feat|fix)-); use a variable instead.
  bslug_re='^(feat|fix|chore|refactor|docs|test)-'
  if [[ "$bslug" =~ $bslug_re ]]; then
    BRANCH="${bslug/-//}"
  else
    BRANCH="feat/$bslug"
  fi
fi

echo ""
echo "=== sgt-dispatch: $PROJECT ==="
echo "brief:   $BRIEF"
echo "task-id: $TASK_ID"
echo "branch:  $BRANCH"
echo ""

# ── Validate repos ────────────────────────────────────────────────────────────

repo_count="$(yq '.repos | length' "$CONFIG_FILE")"

for rname in "${TARGET_REPOS[@]}"; do
  found=false
  for ((i=0; i<repo_count; i++)); do
    n="$(yq ".repos[$i].name" "$CONFIG_FILE")"
    [[ "$n" == "$rname" ]] && found=true && break
  done
  $found || _die "Repo '$rname' not found in project $PROJECT"
done

# ── Parse dependency order ────────────────────────────────────────────────────
# Format: "infra>api,infra>app" → infra must finish before api and app
# Store in a temp file: "<dependent> <prereq>" one per line
# DEPS_TMP is created only when --deps was given; cleanup guard uses ${DEPS_TMP:-}.

if [[ -n "$DEPS_ARG" ]]; then
  DEPS_TMP="$(mktemp)"
  IFS=',' read -ra dep_pairs <<< "$DEPS_ARG"
  for pair in "${dep_pairs[@]}"; do
    prereq="${pair%%>*}"
    dependent="${pair##*>}"
    echo "$dependent $prereq" >> "$DEPS_TMP"
  done
fi

# Look up comma-separated prereqs for a repo
_wait_for() {
  [[ -f "${DEPS_TMP:-}" ]] || return 0
  grep "^$1 " "$DEPS_TMP" 2>/dev/null | awk '{print $2}' | paste -sd ',' - 2>/dev/null || true
}

# ── Capture primary pane (for sgt-notify callbacks) ──────────────────────────

# Resolved against the bound coordinator pane, not the ambient one, so a managed
# or explicitly supplied pane records its own session:window.pane target.
PRIMARY_PANE=""
PRIMARY_PANE="$(tmux display-message -p -t "$PRIMARY_PANE_ID" \
  '#{session_name}:#{window_index}.#{pane_index}' 2>/dev/null || true)"

# ── Create fleet task directory ───────────────────────────────────────────────

if $DRY_RUN; then
  echo "[dry-run] fleet dir: $TASK_DIR"
else
  mkdir "$TASK_DIR"
  DISPATCH_TASK_DIR_CREATED=true
  _sgt_intent_install "$INTENT_TMP" "$TASK_DIR/.sergeant-intent.md"
  printf '%s\n' "$INTENT_REVISION" > "$TASK_DIR/intent_revision"
  printf '%s\n' "$REVIEW_ROUTER_EXECUTABLE" > "$TASK_DIR/review_router_executable"
  printf '%s\n' "$REVIEW_ROUTER_EXECUTABLE_IDENTITY" > "$TASK_DIR/review_router_executable_identity"
  printf '%s\n' "$REVIEW_ROUTER_CONTRACT_REVISION" > "$TASK_DIR/review_router_contract_revision"
  printf '%s\n' "$REVIEW_ROUTER_CONTRACT" > "$TASK_DIR/review_router_capabilities.json"
  printf "Project: %s\nBrief:   %s\nBranch:  %s\nRepos:   %s\n" \
    "$PROJECT" "$BRIEF" "$BRANCH" "${TARGET_REPOS[*]}" > "$TASK_DIR/brief.md"
  [[ -n "$TD_TASK_ID" ]] && echo "$TD_TASK_ID" > "$TASK_DIR/td_task"
  date -u +%Y-%m-%dT%H:%M:%SZ > "$TASK_DIR/started"
  [[ -n "$PRIMARY_PANE" ]] && echo "$PRIMARY_PANE" > "$TASK_DIR/primary_pane"
  if [[ -n "$PRIMARY_PANE_ID" && -n "$PRIMARY_PANE_IDENTITY" ]]; then
    printf '%s\n' "$PRIMARY_PANE_ID" > "$TASK_DIR/primary_pane_id"
    _sgt_replace_owned_file "$TASK_DIR/primary_pane_identity" "$PRIMARY_PANE_IDENTITY"
  fi
  if $JSON_OUTPUT; then
    rollback_dir="$TASK_DIR/.dispatch-rollback"
    mkdir "$rollback_dir"
    mv "$DISPATCH_MUTATIONS_FILE" "$rollback_dir/mutations"
    mv "$TD_CREATE_STATE_FILE" "$rollback_dir/td-create-state.jsonl"
    mv "$TD_CREATE_SUCCESS_FILE" "$rollback_dir/td-create-success"
    rm -rf "$DISPATCH_SNAPSHOT_ROOT"
    mkdir "$rollback_dir/snapshots"
    DISPATCH_MUTATIONS_FILE="$rollback_dir/mutations"
    TD_CREATE_STATE_FILE="$rollback_dir/td-create-state.jsonl"
    TD_CREATE_SUCCESS_FILE="$rollback_dir/td-create-success"
    DISPATCH_SNAPSHOT_ROOT="$rollback_dir/snapshots"
  fi
  if [[ -n "$ORIGIN_PROFILE" ]]; then
    _dispatch_test_failpoint dispatch-before-origin-register
    if $JSON_OUTPUT; then
      origin_register_command=register-admission
    else
      origin_register_command=register
    fi
    "$SCRIPT_DIR/sgt-callback" "$origin_register_command" \
      "$TASK_ID" "$ORIGIN_PROFILE" "$CORRELATION_ID"
    _dispatch_test_failpoint dispatch-after-origin-register
  fi
fi

# ── Create tmux session (local only) ─────────────────────────────────────────

if ! $DRY_RUN; then
  # Create the shared session if it doesn't exist yet; no-op if already running.
  tmux new-session -d -s "$TMUX_SESSION" -n "sergeant" 2>/dev/null || true
  echo "tmux session: $TMUX_SESSION"
  echo ""
fi

# ── Dispatch per repo ─────────────────────────────────────────────────────────

for rname in "${TARGET_REPOS[@]}"; do
  # Find repo index in config
  for ((i=0; i<repo_count; i++)); do
    n="$(yq ".repos[$i].name" "$CONFIG_FILE")"
    [[ "$n" == "$rname" ]] && break
  done

  raw_path="$(yq ".repos[$i].path" "$CONFIG_FILE")"
  repo_path="$(_resolve_path "$raw_path")"
  repo_role="$(yq ".repos[$i].role // \"\"" "$CONFIG_FILE")"
  repo_group="$(yq ".repos[$i].group // \"\"" "$CONFIG_FILE")"

  # ── Resolve gh auth identity (repo → project → global default → no-op) ───
  repo_identity="$(yq ".repos[$i].identity // \"\"" "$CONFIG_FILE")"
  project_identity="$(yq '.identity // ""' "$CONFIG_FILE")"
  resolved_identity=""
  if [[ -n "$repo_identity" && "$repo_identity" != "null" ]]; then
    resolved_identity="$repo_identity"
  elif [[ -n "$project_identity" && "$project_identity" != "null" ]]; then
    resolved_identity="$project_identity"
  elif [[ -n "${SGT_DEFAULT_IDENTITY:-}" ]]; then
    resolved_identity="$SGT_DEFAULT_IDENTITY"
  fi

  echo "--- $rname ---"

  if ! _sgt_is_git_repo "$repo_path"; then
    if $JSON_OUTPUT; then
      _die "Correlated admission requires cloned repository '$rname' at $repo_path"
    fi
    echo "  SKIP: not cloned at $repo_path (run bin/sgt-sync $PROJECT first)"
    echo ""
    continue
  fi

  # ── Resolve merged instructions (defaults → group → repo) ──────────────────

  default_inst="$(yq '.defaults.agent_instructions // ""' "$CONFIG_FILE")"
  group_description=""
  group_inst=""
  if [[ -n "$repo_group" && "$repo_group" != "null" ]]; then
    group_description="$(yq ".groups.\"$repo_group\".description // \"\"" "$CONFIG_FILE")"
    group_inst="$(yq ".groups.\"$repo_group\".agent_instructions // \"\"" "$CONFIG_FILE")"
  fi
  repo_inst="$(yq ".repos[$i].agent_instructions // \"\"" "$CONFIG_FILE")"

  merged=""
  [[ -n "$default_inst" && "$default_inst" != "null" ]] && merged+="$default_inst"$'\n'
  [[ -n "$group_inst"   && "$group_inst"   != "null" ]] && merged+="$group_inst"$'\n'
  [[ -n "$repo_inst"    && "$repo_inst"    != "null" ]] && merged+="$repo_inst"$'\n'

  # ── Resolve dependencies ────────────────────────────────────────────────────

  wait_for="$(_wait_for "$rname")"
  deps_section=""
  if [[ -n "$wait_for" ]]; then
    deps_section="## Dependencies"$'\n\n'
    IFS=',' read -ra prereqs <<< "$wait_for"
    for prereq in "${prereqs[@]}"; do
      prereq_fleet="$TASK_DIR/$prereq"
      deps_section+="Wait for \`$prereq\` to complete before opening your PR."$'\n'
      deps_section+="Check fleet state: \`cat $prereq_fleet/status\`"$'\n'
      deps_section+="(or check worktree directly: \`cat \$(cat $prereq_fleet/worktree)/.sergeant-status\`)"$'\n\n'
    done
  fi

  # ── Determine worktree strategy ────────────────────────────────────────────
  # Prefer treehouse if treehouse.toml exists in the repo (pre-warmed pool).
  # Fall back to plain git worktree add otherwise.

  repo_task_dir="$TASK_DIR/$rname"
  use_treehouse=false
  if [[ -f "$repo_path/treehouse.toml" ]] && command -v treehouse &>/dev/null; then
    use_treehouse=true
  fi

  if $DRY_RUN; then
    [[ -n "$resolved_identity" ]] && echo "  identity: $resolved_identity"
    if $use_treehouse; then
      echo "  worktree: treehouse lease (pool: ~/.treehouse/)"
    else
      echo "  worktree: $(dirname "$repo_path")/${rname}-sgt-${TASK_ID}"
    fi
    echo "  branch:   $BRANCH"
    [[ -n "$wait_for" ]] && echo "  waits for: $wait_for"
    echo ""
    continue
  fi

  # ── Switch gh auth identity (if configured) ──────────────────────────────────
  if [[ -n "$resolved_identity" ]]; then
    _info "switching gh auth to: $resolved_identity"
    if ! auth_switch_output="$(gh auth switch --user "$resolved_identity" 2>&1)"; then
      mkdir -p "$repo_task_dir"
      printf 'failed: gh auth switch --user %s\n' "$resolved_identity" \
        > "$repo_task_dir/status"
      printf 'gh auth switch --user %s failed: %s\n' \
        "$resolved_identity" "$auth_switch_output" > "$repo_task_dir/diagnostic"
      _die "gh auth switch --user $resolved_identity failed: $auth_switch_output"
    fi
  fi

  # ── Acquire worktree ─────────────────────────────────────────────────────────

  mkdir -p "$repo_task_dir"
  _sgt_intent_install "$INTENT_TMP" "$repo_task_dir/.sergeant-intent.md"
  printf '%s\n' "$INTENT_REVISION" > "$repo_task_dir/intent_revision"
  printf '%s\n' "$REVIEW_ROUTER_EXECUTABLE" > "$repo_task_dir/review_router_executable"
  printf '%s\n' "$REVIEW_ROUTER_EXECUTABLE_IDENTITY" > "$repo_task_dir/review_router_executable_identity"
  printf '%s\n' "$REVIEW_ROUTER_CONTRACT_REVISION" > "$repo_task_dir/review_router_contract_revision"
  printf '%s\n' "$REVIEW_ROUTER_CONTRACT" > "$repo_task_dir/review_router_capabilities.json"
  echo "$BRANCH"    > "$repo_task_dir/branch"
  date +%s          > "$repo_task_dir/dispatch_started"
  echo "dispatched" > "$repo_task_dir/status"
  echo "$PROJECT"   > "$repo_task_dir/project"
  [[ -n "$wait_for" ]] && echo "$wait_for" > "$repo_task_dir/wait_for"

  if $use_treehouse; then
    _info "acquiring treehouse lease for $rname ..."
    lease_holder="sgt-${TASK_ID}-${rname}"
    treehouse_raw="$repo_task_dir/treehouse-acquisition.raw"
    treehouse_receipt="$repo_task_dir/treehouse-acquisition-receipt.json"
    treehouse_record="$repo_task_dir/treehouse-acquisition.json"
    treehouse_acquired=false
    [[ ! -e "$treehouse_raw" && ! -e "$treehouse_receipt" && \
      ! -e "$treehouse_record" ]] || \
      _die "treehouse acquisition state already exists for $rname"
    _journal_dispatch_mutation "$repo_path" - - treehouse-pending - \
      "$repo_task_dir" -
    set +e
    "$SCRIPT_DIR/_sgt-treehouse-io.py" get "$repo_path" "$treehouse_raw" \
      "$treehouse_receipt" "$treehouse_record" "$lease_holder"
    treehouse_get_status=$?
    set -e
    if [[ "$treehouse_get_status" -eq 0 ]]; then
      treehouse_acquired=true
      if [[ "${SGT_TEST_HOOKS:-}" == 1 && \
            "${SGT_DISPATCH_FAIL_POINT:-}" == dispatch-treehouse-acquired ]]; then
        kill -TERM "$$"
      fi
    elif [[ "$treehouse_get_status" -eq 11 ]]; then
      use_treehouse=false
      _info "Treehouse reported no allocation — falling back to git worktree"
    else
      if [[ -s "$treehouse_record" ]]; then
        worktree_path="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["path"])' "$treehouse_record")"
        lease_id="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["lease_id"])' "$treehouse_record")"
        if "$SCRIPT_DIR/_sgt-treehouse-io.py" return "$repo_path" \
          "$repo_task_dir/treehouse-acquisition-return.raw" \
          "$repo_task_dir/treehouse-acquisition-return-receipt.json" \
          "$worktree_path" "$lease_id" "$lease_holder"; then
          printf 'returned\n' > "$repo_task_dir/treehouse-acquisition-return"
        else
          printf 'return-failed\n' > "$repo_task_dir/treehouse-acquisition-return"
        fi
      fi
      printf 'preserve\n' > "$repo_task_dir/treehouse-preserve-evidence"
      _die "Treehouse acquisition was ambiguous; fallback blocked and evidence preserved: $treehouse_receipt"
    fi
    if [[ "$treehouse_acquired" == true ]]; then
      worktree_path="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["path"])' "$treehouse_record")"
      lease_id="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["lease_id"])' "$treehouse_record")"
      _info "leased: $worktree_path"
      echo "treehouse"      > "$repo_task_dir/wt_type"
      echo "$lease_holder"  > "$repo_task_dir/wt_holder"
      echo "$lease_id"      > "$repo_task_dir/wt_lease_id"
      # Hold a verified directory descriptor across branch lookup and checkout;
      # path swaps cannot redirect Git into a different repository.
      if ! "$SCRIPT_DIR/_sgt-treehouse-io.py" checkout-branch \
        "$repo_path" "$worktree_path" "$BRANCH" "$treehouse_record"; then
        printf 'failed: treehouse checkout failed\n' > "$repo_task_dir/status"
        if "$SCRIPT_DIR/_sgt-treehouse-io.py" return "$repo_path" \
          "$repo_task_dir/treehouse-acquisition-return.raw" \
          "$repo_task_dir/treehouse-acquisition-return-receipt.json" \
          "$worktree_path" "$lease_id" "$lease_holder"; then
          printf 'returned\n' > "$repo_task_dir/treehouse-acquisition-return"
        else
          printf 'return-failed\n' > "$repo_task_dir/treehouse-acquisition-return"
        fi
        printf 'preserve\n' > "$repo_task_dir/treehouse-preserve-evidence"
        _die "treehouse checkout failed for $rname; acquisition record preserved: $treehouse_record"
      fi
    fi
  fi

  if ! $use_treehouse; then
    worktree_path="$(dirname "$repo_path")/${rname}-sgt-${TASK_ID}"
    echo "git" > "$repo_task_dir/wt_type"
    _info "creating git worktree: $worktree_path"
    if [[ -d "$worktree_path" ]]; then
      _info "already exists — reusing"
      worktree_snapshot="$(_snapshot_dispatch_worktree "$worktree_path")" || \
        _die "could not snapshot preexisting Sergeant files: $worktree_path"
      _journal_dispatch_mutation "$repo_path" "$worktree_path" - git-reused - \
        "$repo_task_dir" "$worktree_snapshot"
    else
      mutation_branch="-"
      if git -C "$repo_path" show-ref --verify --quiet "refs/heads/$BRANCH" 2>/dev/null; then
        # Guard: if the existing branch carries committed work that is not
        # reachable from any remote, a prior interrupted dispatch may have done
        # real work.  Block re-dispatch until the coordinator reconciles, to
        # prevent duplicate or lost effort.
        #
        # Reachability from ANY remote is the test.  Comparing against only
        # "refs/remotes/origin/$BRANCH" used to make this fire for every branch
        # that had never been pushed, which blocked resuming preserved work in
        # any repository the operator cannot push to (td-7f3a9a).
        prior_commits="$(_sgt_branch_unpushed_commits "$repo_path" "$BRANCH")"
        if [[ -n "$prior_commits" && "$ADOPT_BRANCH" -ne 1 ]]; then
          _die "Branch $BRANCH already has committed work not reachable from any remote. Re-run with --adopt-branch to resume it, which checks the branch out at a new worktree and preserves every commit. Commits found:
$prior_commits"
        fi
        if [[ -n "$prior_commits" ]]; then
          _info "adopting existing branch $BRANCH with preserved commits:"
          printf '%s\n' "$prior_commits" | sed 's/^/      /'
        fi
        worktree_initial_sha="$(git -C "$repo_path" rev-parse "refs/heads/$BRANCH")"
        _journal_dispatch_mutation "$repo_path" "$worktree_path" - git-pending \
          "$worktree_initial_sha" "$repo_task_dir" -
        git -C "$repo_path" worktree add "$worktree_path" "$BRANCH" 2>&1 | sed 's/^/    /'
      else
        worktree_initial_sha="$(git -C "$repo_path" rev-parse HEAD)"
        mutation_branch="$BRANCH"
        _journal_dispatch_mutation "$repo_path" "$worktree_path" "$mutation_branch" \
          git-pending "$worktree_initial_sha" "$repo_task_dir" -
        git -C "$repo_path" worktree add -b "$BRANCH" "$worktree_path" 2>&1 | sed 's/^/    /'
      fi
      if [[ "${SGT_TEST_HOOKS:-}" == 1 && \
            "${SGT_DISPATCH_FAIL_POINT:-}" == dispatch-git-worktree-acquired ]]; then
        kill -TERM "$$"
      fi
    fi
  fi

  echo "$worktree_path" > "$repo_task_dir/worktree"
  printf '%s\n' "${resolved_identity:-}" > "$repo_task_dir/identity"
  [[ -f "$worktree_path/.git" && ! -L "$worktree_path/.git" ]] || \
    _die "worktree has no immutable Git pointer: $worktree_path"
  worktree_git_pointer="$(cat "$worktree_path/.git")"
  [[ "$worktree_git_pointer" == "gitdir: "* ]] || \
    _die "worktree Git pointer is malformed: $worktree_path/.git"
  worktree_git_dir="${worktree_git_pointer#gitdir: }"
  if [[ "$worktree_git_dir" != /* ]]; then
    worktree_git_dir="$worktree_path/$worktree_git_dir"
  fi
  worktree_git_dir="$(cd "$worktree_git_dir" 2>/dev/null && pwd -P)" || \
    _die "worktree Git directory is unavailable: $worktree_git_dir"
  printf '%s\n' "$worktree_git_pointer" > "$repo_task_dir/worktree_git_pointer"
  printf '%s\n' "$worktree_git_dir" > "$repo_task_dir/worktree_git_dir"
  # Record the HEAD at dispatch time so workers and the reconcile path can
  # detect committed work added above this base (interrupted fallback guard).
  worktree_initial_sha="$(git -C "$worktree_path" rev-parse HEAD 2>/dev/null || true)"
  [[ -n "$worktree_initial_sha" ]] && printf '%s\n' "$worktree_initial_sha" > "$repo_task_dir/initial_sha"
  _sgt_intent_install "$INTENT_TMP" "$worktree_path/.sergeant-intent.md"

  # ── Write brief ─────────────────────────────────────────────────────────────

  role_line=""
  if [[ -n "$repo_role" && "$repo_role" != "null" ]]; then
    role_line="Role: $repo_role"
  fi

  # Resolve td task ID for this repo:
  # --td flag: use provided ID (only for the owning repo)
  # auto-created: look up from the map
  REPO_TD_TASK_ID=""
  if [[ -n "$TD_TASK_ID" && "$rname" == "$TD_REPO" ]]; then
    REPO_TD_TASK_ID="$TD_TASK_ID"
  elif [[ -f "$REPO_TD_MAP" ]]; then
    REPO_TD_TASK_ID="$(grep "^$rname " "$REPO_TD_MAP" 2>/dev/null | awk '{print $2}' || true)"
  fi

  # Build td section for brief
  td_section=""
  td_task_line=""
  if [[ -n "$REPO_TD_TASK_ID" ]]; then
    # Fetch full context if this came from --td
    repo_td_context=""
    if [[ -n "$TD_CONTEXT" && "$rname" == "$TD_REPO" ]]; then
      repo_td_context="$TD_CONTEXT"
    fi

    td_context_block=""
    if [[ -n "$repo_td_context" ]]; then
      td_context_block="$(printf '\nFull task context:\n%s' "$repo_td_context")"
    fi

    td_section="## Task management

This work is tracked in td as: \`$REPO_TD_TASK_ID\`

At session start:
\`\`\`
td start $REPO_TD_TASK_ID --work-dir .
\`\`\`

Log meaningful progress:
\`\`\`
td log \"message\" --work-dir .
\`\`\`

Before writing .sergeant-status=done, hand off:
\`\`\`
td handoff $REPO_TD_TASK_ID --work-dir .
td review $REPO_TD_TASK_ID --work-dir .
\`\`\`
$td_context_block"
    td_task_line="**td task:** $REPO_TD_TASK_ID"
    # Store td task ID in fleet state
    echo "$REPO_TD_TASK_ID" > "$repo_task_dir/td_task"
  fi

  # Which axes this worker must produce comes from the shared review-axis
  # vocabulary the router validates against, so the generated contract cannot ask
  # for an axis sgt-review-findings refuses to route (td-61a0c8).
  review_axes="$SGT_REVIEW_AXES_REQUIRED"
  review_context="$(printf '%s %s %s %s %s' "$BRIEF" "$repo_role" "$repo_group" "$group_description" "$merged" | tr '[:upper:]' '[:lower:]')"
  # Store regex in variable: Apple Bash 3.2.57 (macOS) cannot parse inline
  # alternation groups in =~ (e.g. (a|b)); use a variable instead.
  review_context_re='(^|[^[:alnum:]])(ui|frontend|front-end|visual|interaction|accessibility|user-facing[[:space:]]+output)([^[:alnum:]]|$)'
  if [[ "$review_context" =~ $review_context_re ]]; then
    review_axes="$review_axes $SGT_REVIEW_AXES_CONDITIONAL"
  fi
  review_axis_count=0
  review_axis_markdown=""
  # shellcheck disable=SC2046  # deliberate word splitting over the axis list
  for review_axis in $review_axes; do
    review_axis_guidance="$(_sgt_review_axis_guidance "$review_axis")" || \
      _die "No reviewer guidance is defined for review axis: $review_axis"
    review_axis_markdown="$review_axis_markdown$review_axis_guidance"$'\n'
    review_axis_count=$((review_axis_count + 1))
  done
  review_axis_label="$(_sgt_review_axis_count_word "$review_axis_count")"

  _sgt_render_brief "$worktree_path/.sergeant-brief.md"

  echo "in_progress" > "$repo_task_dir/status"
  _info "brief written → $worktree_path/.sergeant-brief.md"

  # ── Spawn agent ─────────────────────────────────────────────────────────────

  WINDOW_NAME="${STAGE}-${rname}-${TASK_ID}"
  _info "spawning tmux window '$WINDOW_NAME' in session $TMUX_SESSION"
  printf '%s\n' "$TMUX_SESSION" > "$repo_task_dir/tmux_session"
  printf '%s\n' "$WINDOW_NAME" > "$repo_task_dir/window_name"
  printf '%s\n' "$STAGE" > "$repo_task_dir/stage"
  printf '%s\n' "$AGENT_CMD" > "$repo_task_dir/agent"
  printf '%s\n' "$AGENT_MODEL" > "$repo_task_dir/agent_model"
  printf '%s\n' "$AGENT_MODEL_SOURCE" > "$repo_task_dir/agent_model_source"
  _SGT_DISPATCH_WORKER_FD=7
  if [[ "${SGT_TEST_HOOKS:-}" == 1 && \
    "${SGT_TEST_DISPATCH_BEFORE_LAUNCH_LOCK_BARRIER:-}" == 1 ]]; then
    : > "$repo_task_dir/dispatch-before-launch-lock-ready"
    while [[ ! -e "$repo_task_dir/dispatch-before-launch-lock-release" ]]; do
      sleep 0.01
    done
  fi
  _sgt_drain_lock_acquire_fd "$_SGT_DISPATCH_WORKER_FD" worker-launch \
    "$repo_task_dir/worker-launch.lock" || \
    _die "Could not acquire exact initial worker-launch ownership"
  _sgt_worker_launch_transaction_begin "$repo_task_dir" \
    "$_SGT_DISPATCH_WORKER_FD" || \
    _die "Could not snapshot worker generation before initial launch"
  if [[ "$SGT_DRAIN_LOCK_CONTENDED_LIVE" == true ]]; then
    if _sgt_worker_launch_observed_completion_matches "$repo_task_dir"; then
      _sgt_drain_lock_release_fd "$_SGT_DISPATCH_WORKER_FD" || \
        _die "Could not release converged initial worker-launch ownership"
      _info "verified peer worker-launch transaction completed for $rname"
      echo ""
      continue
    fi
    _die "Initial dispatch observed a launch owner without exact completed mutation evidence"
  fi
  initial_notification_id="$(dd if=/dev/urandom bs=16 count=1 2>/dev/null | od -An -tx1 | tr -d ' \n')"
  _sgt_publish_worker_notification "$repo_task_dir" "$worktree_path" \
    "$initial_notification_id" initial "Read the .sergeant-brief.md file and execute the mission."
  _sgt_prepare_worker_process_marker "$repo_task_dir" || _die "Could not prepare worker process marker"
  if [[ "${SGT_TEST_HOOKS:-}" == 1 && \
    "${SGT_TEST_DISPATCH_LAUNCH_BARRIER:-}" == 1 ]]; then
    : > "$repo_task_dir/dispatch-launch-ready"
    while [[ ! -e "$repo_task_dir/dispatch-launch-release" ]]; do
      sleep 0.01
    done
  fi
  WORKER_RUN_CMD="$(_sgt_worker_command \
    "$SCRIPT_DIR/sgt-interactive-worker" "$repo_task_dir" "$worktree_path" "$AGENT_CMD")"
  if pane_target="$(tmux new-window -P -F '#{pane_id}' -t "$TMUX_SESSION:" \
    -n "$WINDOW_NAME" -c "$worktree_path" "$WORKER_RUN_CMD")"; then
    if [[ -z "$pane_target" ]]; then
      printf 'orphaned\n' > "$repo_task_dir/status"
      printf 'tmux launched no worker pane\n' > "$repo_task_dir/diagnostic"
      "$SCRIPT_DIR/sgt-td-memory" handoff "$repo_task_dir" "$worktree_path" || true
      _die "tmux returned no pane for $rname"
    fi
    printf '%s\n' "$pane_target" > "$repo_task_dir/pane"
    if pane_identity="$(_sgt_pane_identity "$pane_target")" && [[ -n "$pane_identity" ]]; then
      _sgt_replace_owned_file "$repo_task_dir/pane_identity" "$pane_identity" || \
        _die "Could not publish worker pane identity"
      if ! _sgt_notification_target_create "$repo_task_dir" "$initial_notification_id" \
          "$pane_identity" >/dev/null; then
        tmux kill-pane -t "$pane_target" 2>/dev/null || true
        printf 'orphaned\n' > "$repo_task_dir/status"
        printf 'notification target creation race: concurrent dispatch detected\n' > "$repo_task_dir/diagnostic"
        "$SCRIPT_DIR/sgt-td-memory" handoff "$repo_task_dir" "$worktree_path" || true
        _die "notification target race detected for $rname; worker orphaned"
      fi
      _sgt_worker_launch_completion_publish "$repo_task_dir" \
        "$_SGT_DISPATCH_WORKER_FD" || \
        _die "Could not publish completed initial worker launch"
      _sgt_drain_lock_release_fd "$_SGT_DISPATCH_WORKER_FD" || \
        _die "Could not release initial worker-launch ownership"
    else
      tmux kill-pane -t "$pane_target" 2>/dev/null || true
      printf 'orphaned\n' > "$repo_task_dir/status"
      printf 'tmux failed to capture exact worker pane identity\n' > "$repo_task_dir/diagnostic"
      "$SCRIPT_DIR/sgt-td-memory" handoff "$repo_task_dir" "$worktree_path" || true
      _die "tmux failed to capture exact worker pane identity for $rname"
    fi
    if $JSON_OUTPUT; then
      wait_notification_command=_sgt_wait_worker_notification_ack
    else
      wait_notification_command=_sgt_wait_worker_notification
    fi
    if ! "$wait_notification_command" "$pane_target" "$repo_task_dir" "$initial_notification_id"; then
      tmux kill-pane -t "$pane_target" 2>/dev/null || true
      printf 'orphaned\n' > "$repo_task_dir/status"
      printf 'interactive worker did not acknowledge its durable notification\n' > "$repo_task_dir/diagnostic"
      "$SCRIPT_DIR/sgt-td-memory" handoff "$repo_task_dir" "$worktree_path" || true
      _die "interactive worker notification acknowledgement timed out for $rname"
    fi
  else
    printf 'orphaned\n' > "$repo_task_dir/status"
    printf 'tmux failed to launch worker supervisor\n' > "$repo_task_dir/diagnostic"
    "$SCRIPT_DIR/sgt-td-memory" handoff "$repo_task_dir" "$worktree_path" || true
    _die "tmux failed to launch worker supervisor for $rname"
  fi

  if $JSON_OUTPUT && [[ "$rname" == "${TARGET_REPOS[${#TARGET_REPOS[@]}-1]}" ]]; then
    _dispatch_test_failpoint dispatch-after-final-launch
  fi

  echo ""
done

# EXIT rollback is only for incomplete dispatches.  At least one successful
# worker launch is also detected from its durable pane file, but this explicit
# commit marker makes the all-repositories success boundary unambiguous.
if $JSON_OUTPUT; then
  _dispatch_test_failpoint dispatch-before-admission-commit
  "$SCRIPT_DIR/sgt-callback" admit "$TASK_ID"
fi
DISPATCH_SUCCEEDED=true
if $JSON_OUTPUT; then
  _dispatch_test_failpoint dispatch-after-admission-commit
  for rname in "${TARGET_REPOS[@]}"; do
    repo_task_dir="$TASK_DIR/$rname"
    pane_target="$(cat "$repo_task_dir/pane")"
    initial_notification_id="$(cat "$repo_task_dir/notification_id")"
    if ! _sgt_wait_worker_notification "$pane_target" "$repo_task_dir" \
      "$initial_notification_id"; then
      _die "interactive worker notification acknowledgement timed out for $rname"
    fi
  done
  rm -rf "$TASK_DIR/.dispatch-rollback"
fi

# Every repo dispatched: the managed coordinator pane is now owned by live fleet
# state, so the rollback must not remove it.
SGT_MANAGED_COORDINATOR_CREATED="false"

# ── Summary ───────────────────────────────────────────────────────────────────

if ! $DRY_RUN; then
  echo "=== dispatch complete ==="
  echo ""
  echo "Task ID: $TASK_ID"
  echo "Fleet:   $TASK_DIR"
  echo "Observe: tmux attach -t $TMUX_SESSION  (windows: <stage>-<repo>-$TASK_ID)"
  echo "Watch:   bin/sgt-watch $TASK_ID --background"
  echo ""

  # ── Wiki: log the dispatch event ─────────────────────────────────────────
  _wiki_body="## Dispatch

- **Task ID:** \`$TASK_ID\`
- **Project:** $PROJECT
- **Branch:** \`$BRANCH\`
- **Repos:** ${REPOS_ARG:-auto}
- **td task:** ${TD_TASK_ID:+\`$TD_TASK_ID\`}${TD_TASK_ID:-none}
- **Brief:** $BRIEF"

  _sgt_wiki_write \
    "sgt-dispatch: $BRIEF" \
    "activity" \
    "Dispatched $TASK_ID to project $PROJECT" \
    "sergeant,dispatch,$PROJECT" \
    "$_wiki_body"

  if $JSON_OUTPUT; then
    _dispatch_test_failpoint dispatch-before-admission-stdout
    printf '{"status":"accepted","task_id":"%s","correlation_id":"%s"}\n' \
      "$TASK_ID" "$CORRELATION_ID" >&3
    _dispatch_test_failpoint dispatch-after-admission-stdout
  fi
fi
