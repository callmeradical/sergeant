#!/usr/bin/env bash
# sgt-cleanup — Remove worktrees and fleet state for a completed task
#
# Handles both treehouse-leased worktrees (treehouse return) and
# plain git worktrees (git worktree remove).
# Fleet state and the recorded worktree must be on the same filesystem so
# cleanup can preserve and replay terminal evidence atomically.
#
# task-id must be the fleet-owned task directory basename. Cleanup rejects
# paths, traversal tokens, and symlink aliases before touching fleet state.
#
# Usage:
#   sgt-cleanup <task-id>           # remove all worktrees + fleet state
#   sgt-cleanup <task-id> <repo>    # remove one repo's worktree only

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=bin/_sgt-lib.sh
source "$SCRIPT_DIR/_sgt-lib.sh"
# shellcheck source=bin/_sgt-response-lock.sh
source "$SCRIPT_DIR/_sgt-response-lock.sh"

[[ $# -ge 1 ]] || _die "Usage: sgt-cleanup <task-id> [repo]"
TASK_ID="$1"
FILTER_REPO="${2:-}"

case "$TASK_ID" in
  ""|"."|".."|/*|*/*)
    _die "Invalid task ID: $TASK_ID"
    ;;
esac

TASK_DIR="$FLEET_DIR/$TASK_ID"

[[ ! -L "$TASK_DIR" ]] || _die "Invalid task ID: $TASK_ID"

if [[ ! -d "$TASK_DIR" ]]; then
  echo "Task already cleaned up: $TASK_ID"
  exit 0
fi

FLEET_ROOT="$(cd "$FLEET_DIR" && pwd -P)"
TASK_ROOT="$(cd "$TASK_DIR" && pwd -P)"
[[ "$TASK_ROOT" == "$FLEET_ROOT/$TASK_ID" ]] || _die "Invalid task ID: $TASK_ID"

# Marker evidence is a task-wide cleanup admission boundary. Validate both
# namespaces for every repository before callbacks, monitor shutdown, pane
# retirement, response locks, or any other lifecycle mutation.
for _sgt_preflight_repo_dir in "$TASK_DIR"/*/; do
  [[ -d "$_sgt_preflight_repo_dir" ]] || continue
  _sgt_preflight_repo_dir="${_sgt_preflight_repo_dir%/}"
  _sgt_preflight_repo_name="$(basename "$_sgt_preflight_repo_dir")"
  _sgt_worker_process_marker_preflight "$_sgt_preflight_repo_dir" || \
    _die "Cleanup refused: worker process marker evidence is torn: $_sgt_preflight_repo_name"
  _sgt_worker_process_marker_preflight \
    "$_sgt_preflight_repo_dir/validation-process" || \
    _die "Cleanup refused: validation process marker evidence is torn: $_sgt_preflight_repo_name"
done

if [[ -e "$TASK_DIR/.callbacks/origin.json" || -L "$TASK_DIR/.callbacks/origin.json" ]]; then
  "$SCRIPT_DIR/sgt-callback" sync "$TASK_ID"
  if [[ -z "$FILTER_REPO" ]]; then
    "$SCRIPT_DIR/sgt-callback" check-acked "$TASK_ID"
  fi
fi

_worktree_cwd_pids() {
  local worktree="$1"
  local canonical_worktree current_pid error error_file line output path process_pids

  [[ -d "$worktree" ]] || return 0
  canonical_worktree="$(cd "$worktree" && pwd -P)"
  command -v lsof >/dev/null 2>&1 || _die "lsof is required to verify worktree process cleanup"
  process_pids="$(ps -axo pid= | tr -d ' ' || true)"
  [[ -n "$process_pids" ]] || return 0
  error_file="$(mktemp)"
  output="$(lsof -w -S2 -a -d cwd -Fn \
    -p "$(tr '\n' ',' <<< "$process_pids" | sed 's/,$//')" 2> "$error_file" || true)"
  if [[ -s "$error_file" ]]; then
    error="$(cat "$error_file")"
    rm -f "$error_file"
    _die "Failed to inspect process working directories: $error"
  fi
  rm -f "$error_file"
  current_pid=""

  while IFS= read -r line; do
    case "$line" in
      p*)
        current_pid="${line#p}"
        ;;
      n*)
        path="${line#n}"
        if [[ "$path" == "$canonical_worktree" || "$path" == "$canonical_worktree/"* ]]; then
          printf '%s\n' "$current_pid"
        fi
        ;;
    esac
  done <<< "$output"
}

_process_tree_records() {
  local root_pid="$1"
  local child_pid identity

  for child_pid in $(pgrep -P "$root_pid" 2>/dev/null || true); do
    _process_tree_records "$child_pid"
  done
  identity="$(_sgt_process_identity "$root_pid" 2>/dev/null || true)"
  [[ -n "$identity" ]] && printf '%s|%s\n' "$root_pid" "$identity"
}

_recorded_tree_pids() {
  local records="$1"
  local identity pid

  while IFS='|' read -r pid identity; do
    [[ -n "$pid" ]] && printf '%s\n' "$pid"
  done <<< "$records"
}

_live_recorded_tree_pids() {
  local records="$1"
  local current_identity identity pid

  while IFS='|' read -r pid identity; do
    [[ -n "$pid" && -n "$identity" ]] || continue
    current_identity="$(_sgt_process_identity "$pid" 2>/dev/null || true)"
    [[ "$current_identity" == "$identity" ]] && printf '%s\n' "$pid"
  done <<< "$records"
}

_terminate_pids() {
  local pids="$1"
  local signal="${2:-TERM}"
  local pid

  [[ -n "$pids" ]] || return 0
  while IFS= read -r pid; do
    [[ -n "$pid" && "$pid" != "$$" ]] || continue
    kill -"$signal" "$pid" 2>/dev/null || true
  done <<< "$pids"
}

_process_group_pids() {
  local process_group="$1"

  [[ -n "$process_group" ]] || return 0
  pgrep -g "$process_group" 2>/dev/null || true
}

_terminate_process_group() {
  local process_group="$1"
  local signal="${2:-TERM}"

  [[ -n "$process_group" ]] || return 0
  kill -"$signal" -- -"$process_group" 2>/dev/null || true
}

# _recover_escaped_worker_pgid — return the PGID stored in fleet state by
# sgt-interactive-worker at startup, after verifying it is safe to use.
# When the pane has already exited, cleanup has no live process to query for the
# PGID; this function provides it so the caller's TERM/KILL cycle can reach any
# escaped descendants that are still running in that process group.
#
# Safety guards (mirrors _stop_recorded_validation_group):
#   • If the recorded worker PID is still alive, verify its start time matches to
#     rule out PID reuse, then check its PGID matches the recorded value.
#   • If the recorded worker PID is gone but live processes remain in the group,
#     only proceed when the worker was its own process-group leader (the standard
#     configuration for tmux-spawned workers); otherwise refuse with _die so that
#     destructive cleanup is blocked and diagnostics are preserved.
_recover_escaped_worker_pgid() {
  local repo_dir="$1"
  local recorded_pid recorded_pgid recorded_start actual_start actual_pgid live_pids

  recorded_pid="$(cat "$repo_dir/worker_pid" 2>/dev/null || true)"
  recorded_pgid="$(cat "$repo_dir/worker_process_group" 2>/dev/null || true)"
  recorded_start="$(cat "$repo_dir/worker_process_start" 2>/dev/null || true)"
  [[ -n "$recorded_pgid" ]] || return 0

  if kill -0 "$recorded_pid" 2>/dev/null; then
    actual_start="$(_sgt_process_identity "$recorded_pid" 2>/dev/null || true)"
    [[ "$actual_start" == "$recorded_start" ]] || \
      _die "Worker PID was reused; refusing termination of escaped descendants: $recorded_pid"
    actual_pgid="$(ps -o pgid= -p "$recorded_pid" 2>/dev/null | tr -d ' ' || true)"
    [[ "$actual_pgid" == "$recorded_pgid" ]] || \
      _die "Worker process group changed; refusing termination of escaped descendants: $recorded_pid"
  else
    live_pids="$(_process_group_pids "$recorded_pgid")"
    if [[ -n "$live_pids" ]]; then
      [[ "$recorded_pid" == "$recorded_pgid" ]] || \
        _die "Worker pane disappeared with unverified detached descendants in process group $recorded_pgid"
    fi
  fi
  printf '%s\n' "$recorded_pgid"
}

_stop_local_worker() {
  local repo_dir="$1"
  local worktree="$2"
  local pane pane_info pane_dead pane_pid pane_pgid tree_records tree_pids live_tree_pids cwd_pids

  pane="$(cat "$repo_dir/pane" 2>/dev/null || true)"
  tree_records=""
  tree_pids=""

  if [[ -n "$pane" ]]; then
    command -v tmux >/dev/null 2>&1 || _die "tmux is required to terminate recorded worker pane $pane"

    # Require stored pane identity before attempting to kill — fail closed when
    # pane_identity is absent since ownership cannot be verified without it.
    if [[ ! -f "$repo_dir/pane_identity" ]]; then
      echo "  worker pane identity absent; skipping kill: $pane"
      pane_pgid="$(_recover_escaped_worker_pgid "$repo_dir")"
    else
      pane_info="$(_sgt_pane_identity "$pane" || true)"

      if [[ -n "$pane_info" ]]; then
        pane_dead="${pane_info%%|*}"
        pane_info="${pane_info#*|}"
        pane_info="${pane_info#*|}"
        pane_pid="${pane_info%%|*}"

        if [[ "$pane_dead" != "0" ]]; then
          echo "  worker pane already stopped: $pane"
          # Remove the dead pane so it does not linger with remain-on-exit.
          tmux kill-pane -t "$pane" 2>/dev/null || true
          pane_pgid="$(_recover_escaped_worker_pgid "$repo_dir")"
        elif ! _sgt_pane_identity_matches "$pane" "$repo_dir"; then
          echo "  recorded pane no longer belongs to this worker: $pane"
          pane_pgid="$(_recover_escaped_worker_pgid "$repo_dir")"
        else
          tree_records="$(_process_tree_records "$pane_pid")"
          tree_pids="$(_recorded_tree_pids "$tree_records")"
          pane_pgid="$(ps -o pgid= -p "$pane_pid" 2>/dev/null | tr -d ' ' || true)"
          echo "  terminating worker pane: $pane"
          tmux kill-pane -t "$pane" 2>/dev/null || \
            ! tmux display-message -p -t "$pane" '#{pane_id}' >/dev/null 2>&1 || \
            _die "Failed to terminate worker pane $pane"
        fi
      else
        echo "  worker pane already gone: $pane"
        pane_pgid="$(_recover_escaped_worker_pgid "$repo_dir")"
      fi
    fi
  fi

  _terminate_pids "$tree_pids"
  _terminate_process_group "${pane_pgid:-}"

  for _ in $(seq 1 50); do
    live_tree_pids="$(printf '%s\n%s\n' \
      "$(_process_group_pids "${pane_pgid:-}")" \
      "$(_live_recorded_tree_pids "$tree_records")" | sed '/^$/d' | sort -u)"
    [[ -z "$live_tree_pids" ]] && break
    sleep 0.1
  done

  if [[ -n "$live_tree_pids" ]]; then
    _terminate_process_group "${pane_pgid:-}" KILL
    _terminate_pids "$(_live_recorded_tree_pids "$tree_records")" KILL
    for _ in $(seq 1 20); do
      live_tree_pids="$(printf '%s\n%s\n' \
        "$(_process_group_pids "${pane_pgid:-}")" \
        "$(_live_recorded_tree_pids "$tree_records")" | sed '/^$/d' | sort -u)"
      [[ -z "$live_tree_pids" ]] && break
      sleep 0.1
    done
  fi

  [[ -z "$live_tree_pids" ]] || \
    _die "Worker processes did not terminate: $(tr '\n' ' ' <<< "$live_tree_pids")"
  # Process groups and ancestry cannot see a setsid/double-fork escape. Every
  # launched worker generation inherits an unforgeable open marker instead;
  # fleet and marker evidence must remain intact unless pidfd retirement proves
  # all holders are gone.
  _sgt_retire_worker_marker_holders "$repo_dir" "$repo_dir/worker_recycle_phase" || \
    _die "Worker marker holders could not be retired; fleet evidence preserved: $(basename "$repo_dir")"
  cwd_pids="$(_worktree_cwd_pids "$worktree")"
  [[ -z "$cwd_pids" ]] || \
    _die "Other processes still have $worktree as their current directory: $(tr '\n' ' ' <<< "$cwd_pids")"
}

_stop_recorded_validation_group() {
  local recorded_pid="$1" recorded_pgid="$2" recorded_start="$3"
  local actual_start actual_pgid live_pids

  if kill -0 "$recorded_pid" 2>/dev/null; then
    if _sgt_process_identity_record_is_portable "$recorded_start"; then
      _die "Validation owner has no exact process identity; refusing process-group termination: $recorded_pid"
    fi
    actual_start="$(_sgt_process_identity "$recorded_pid" 2>/dev/null || true)"
    [[ "$actual_start" == "$recorded_start" ]] || \
      _die "Validation owner PID was reused; refusing process termination: $recorded_pid"
    actual_pgid="$(ps -o pgid= -p "$recorded_pid" 2>/dev/null | tr -d ' ' || true)"
    [[ "$actual_pgid" == "$recorded_pgid" ]] || \
      _die "Validation owner process group changed; refusing process termination: $recorded_pid"
  else
    live_pids="$(_process_group_pids "$recorded_pgid")"
    [[ -n "$live_pids" ]] || return 0
    if _sgt_process_identity_record_is_portable "$recorded_start"; then
      _die "Validation pane disappeared with portable, unverified descendants in process group $recorded_pgid"
    fi
    [[ "$recorded_pid" == "$recorded_pgid" ]] || \
      _die "Validation pane disappeared with unverified detached descendants in process group $recorded_pgid"
  fi

  _terminate_process_group "$recorded_pgid"
  for _ in $(seq 1 50); do
    live_pids="$(_process_group_pids "$recorded_pgid")"
    [[ -z "$live_pids" ]] && return 0
    sleep 0.1
  done
  _terminate_process_group "$recorded_pgid" KILL
  for _ in $(seq 1 20); do
    live_pids="$(_process_group_pids "$recorded_pgid")"
    [[ -z "$live_pids" ]] && return 0
    sleep 0.1
  done
  _die "Validation processes did not terminate: $(tr '\n' ' ' <<< "$live_pids")"
}

_stop_validation_pane() {
  local repo_dir="$1" pane pane_identity expected_identity pane_info pane_pid pane_pgid
  local tree_records tree_pids live_tree_pids recorded_pid recorded_pgid recorded_start actual_start
  local portable_identity=false
  pane="$(cat "$repo_dir/validation_pane" 2>/dev/null || true)"
  [[ -n "$pane" ]] || return 0
  recorded_pid="$(cat "$repo_dir/validation_pane_pid" 2>/dev/null || true)"
  recorded_pgid="$(cat "$repo_dir/validation_process_group" 2>/dev/null || true)"
  recorded_start="$(cat "$repo_dir/validation_process_start" 2>/dev/null || true)"
  [[ -n "$recorded_pid" && -n "$recorded_pgid" && -n "$recorded_start" ]] || \
    _die "Validation pane ownership provenance is incomplete: $pane"
  _sgt_process_identity_record_is_portable "$recorded_start" && portable_identity=true
  if ! tmux display-message -p -t "$pane" '#{pane_id}' >/dev/null 2>&1; then
    _stop_recorded_validation_group "$recorded_pid" "$recorded_pgid" "$recorded_start"
    return 0
  fi
  if tmux display-message -p -t "$pane" '#{pane_id}' >/dev/null 2>&1; then
    pane_identity="$(_sgt_pane_identity "$pane")"
    expected_identity="$(_sgt_read_owned_file "$repo_dir/validation_pane_identity" \
      2>/dev/null || true)"
    if [[ "${pane_identity%%|*}" != "0" ]]; then
      if [[ "$pane_identity" == "||||" ]]; then
        _stop_recorded_validation_group "$recorded_pid" "$recorded_pgid" "$recorded_start"
        return 0
      fi
      [[ -n "$expected_identity" && "$pane_identity" == "1|${expected_identity#*|}" ]] || \
        _die "Recorded validation pane identity does not match: $pane (expected $expected_identity, actual $pane_identity)"
      _stop_recorded_validation_group "$recorded_pid" "$recorded_pgid" "$recorded_start"
      tmux kill-pane -t "$pane" 2>/dev/null || true
      return 0
    fi
    _sgt_pane_identity_matches "$pane" "$repo_dir" validation_pane_identity || \
      _die "Recorded validation pane identity does not match: $pane"
    pane_info="${pane_identity#*|}"
    pane_info="${pane_info#*|}"
    pane_pid="${pane_info%%|*}"
    [[ "$pane_pid" == "$recorded_pid" ]] || \
      _die "Validation pane PID does not match recorded ownership: $pane_pid"
    if ! $portable_identity; then
      actual_start="$(_sgt_process_identity "$pane_pid" 2>/dev/null || true)"
      [[ "$actual_start" == "$recorded_start" ]] || \
        _die "Validation owner PID was reused; refusing process termination: $recorded_pid"
    fi
    tree_records="$(_process_tree_records "$pane_pid")"
    tree_pids="$(_recorded_tree_pids "$tree_records")"
    pane_pgid="$(ps -o pgid= -p "$pane_pid" 2>/dev/null | tr -d ' ' || true)"
    [[ "$pane_pgid" == "$recorded_pgid" ]] || \
      _die "Validation owner process group changed; refusing process termination: $recorded_pid"
    tmux kill-pane -t "$pane" || _die "Failed to terminate validation pane $pane"
    if $portable_identity; then
      for _ in $(seq 1 70); do
        live_tree_pids="$(_process_group_pids "$recorded_pgid")"
        [[ -z "$live_tree_pids" ]] && return 0
        sleep 0.1
      done
      _die "Portable validation processes remain after exact pane termination: $(tr '\n' ' ' <<< "$live_tree_pids")"
    fi
    _terminate_pids "$tree_pids"
    _terminate_process_group "$pane_pgid"
    for _ in $(seq 1 50); do
      live_tree_pids="$(printf '%s\n%s\n' \
        "$(_process_group_pids "$pane_pgid")" \
        "$(_live_recorded_tree_pids "$tree_records")" | sed '/^$/d' | sort -u)"
      [[ -z "$live_tree_pids" ]] && break
      sleep 0.1
    done
    if [[ -n "$live_tree_pids" ]]; then
      _terminate_process_group "$pane_pgid" KILL
      _terminate_pids "$(_live_recorded_tree_pids "$tree_records")" KILL
    fi
    for _ in $(seq 1 20); do
      live_tree_pids="$(printf '%s\n%s\n' \
        "$(_process_group_pids "$pane_pgid")" \
        "$(_live_recorded_tree_pids "$tree_records")" | sed '/^$/d' | sort -u)"
      [[ -z "$live_tree_pids" ]] && break
      sleep 0.1
    done
    [[ -z "$live_tree_pids" ]] || \
      _die "Validation processes did not terminate: $(tr '\n' ' ' <<< "$live_tree_pids")"
  fi
}

# ── Response handshake retirement ────────────────────────────────────────────
# The two lists below define what "response handshake state" means: they are what
# cleanup refuses to discard, what a retirement archive preserves, and what its
# digests bind.  Keep them in step with sgt-respond and sgt-ack-response.
_RESPONSE_FLEET_STATE="response response_id response_generation response_ack \
response_delivery_unacked response_successor_notification \
response_relaunch_transaction recovery_successor_notification response-archive"
_RESPONSE_WORKTREE_STATE=".sergeant-response .sergeant-response-id \
.sergeant-response-generation .sergeant-response-applied .sergeant-response-ack"

_response_state_names() {
  case "$1" in
    fleet) printf '%s\n' "$_RESPONSE_FLEET_STATE" ;;
    worktree) printf '%s\n' "$_RESPONSE_WORKTREE_STATE" ;;
    *) return 1 ;;
  esac
}

_response_state_present() {
  local name names root="$1"

  names="$(_response_state_names "$2")" || return 1
  for name in $names; do
    [[ -e "$root/$name" || -L "$root/$name" ]] && return 0
  done
  return 1
}

# _named_tree_digest — bind a fixed list of named entries under one root to a
# single digest.  Entries are recorded by _worker_evidence_records under their
# relative names, so the digest binds content and shape rather than the directory
# the state currently lives in: cleanup legitimately replays a worker's handshake
# state from fleet-owned staging once the worktree is gone.  An absent entry is
# recorded as absent; a symlink, an unreadable directory, or anything that is
# neither a regular file nor a directory fails the whole digest, so forged or
# unreadable state can never be recorded as intact evidence.
#
# The record stream is materialised before it is hashed rather than piped, so a
# refused entry rejects the digest through this function's own control flow rather
# than through the process-wide `pipefail`.  _worker_evidence_identity still pipes
# the same stream and so still relies on `pipefail`; unifying the two would change
# nothing about the digests either produces and is left as follow-up.
_named_tree_digest() {
  local digest name names="$2" root="$1" stream

  # A symlinked root would let an identical copy elsewhere stand in for the
  # entries this digest is supposed to bind, so refuse it the same way each entry
  # is refused.  A root that does not exist is legitimate: every entry under it is
  # then recorded as absent.
  [[ ! -L "$root" ]] || return 1
  [[ ! -e "$root" || -d "$root" ]] || return 1
  stream="$(mktemp)" || return 1
  if ! (
    # The collation is deliberately confined to this subshell: only the record
    # stream built here depends on it.
    # shellcheck disable=SC2030
    export LC_ALL=C
    for name in $names; do
      printf 'entry\n%s\n' "$name"
      if [[ -e "$root/$name" || -L "$root/$name" ]]; then
        _worker_evidence_records "$root/$name" "$name" || exit 1
      else
        printf 'absent\n'
      fi
    done
  ) > "$stream"; then
    rm -f "$stream"
    return 1
  fi
  digest="$(git hash-object --stdin < "$stream")" || {
    rm -f "$stream"
    return 1
  }
  rm -f "$stream"
  [[ -n "$digest" ]] || return 1
  printf '%s\n' "$digest"
}

# Binds one side of the handshake state to a single digest.
_response_state_digest() {
  local names root="$1"

  names="$(_response_state_names "$2")" || return 1
  _named_tree_digest "$root" "$names"
}

# _response_owner_provably_dead — succeed only when the worker that owned an
# unfinished response handshake is provably gone, printing the reason on refusal.
#
# Every refusal is fail-closed, including the ones that merely cannot be proven:
#   • fleet state records incomplete worker process provenance.  All three of
#     worker_pid, worker_process_start and worker_process_group are written
#     together by sgt-interactive-worker, so a missing or malformed one means the
#     escaped-descendant check below could not run — the same reason
#     _stop_validation_pane refuses an incomplete validation provenance.
#   • the recorded pane is still live, or is no longer this worker's pane
#   • the recorded PID is alive — the same process, or a reused number
#   • live processes remain in the recorded worker process group
_response_owner_provably_dead() {
  local repo_dir="$1"
  local actual_start expected_identity pane pane_identity recorded_pgid recorded_pid \
    recorded_start

  recorded_pid="$(cat "$repo_dir/worker_pid" 2>/dev/null || true)"
  recorded_start="$(cat "$repo_dir/worker_process_start" 2>/dev/null || true)"
  recorded_pgid="$(cat "$repo_dir/worker_process_group" 2>/dev/null || true)"
  if [[ ! "$recorded_pid" =~ ^[1-9][0-9]*$ || -z "$recorded_start" || \
    ! "$recorded_pgid" =~ ^[1-9][0-9]*$ ]]; then
    printf 'recorded worker process provenance is incomplete\n'
    return 1
  fi
  pane="$(cat "$repo_dir/pane" 2>/dev/null || true)"
  if [[ -n "$pane" ]]; then
    if ! command -v tmux >/dev/null 2>&1; then
      printf 'tmux is required to prove worker pane %s exited\n' "$pane"
      return 1
    fi
    pane_identity="$(_sgt_pane_identity "$pane" 2>/dev/null || true)"
    if [[ -n "$pane_identity" && "$pane_identity" != "||||" ]]; then
      if [[ "${pane_identity%%|*}" == "0" ]]; then
        printf 'recorded worker pane %s is still live\n' "$pane"
        return 1
      fi
      expected_identity="$(_sgt_read_owned_file "$repo_dir/pane_identity" 2>/dev/null || true)"
      if [[ -z "$expected_identity" || "$pane_identity" != "1|${expected_identity#*|}" ]]; then
        printf 'recorded worker pane identity does not match: %s\n' "$pane"
        return 1
      fi
    fi
  fi
  if kill -0 "$recorded_pid" 2>/dev/null; then
    actual_start="$(_sgt_process_identity "$recorded_pid" 2>/dev/null || true)"
    if [[ "$actual_start" == "$recorded_start" ]]; then
      printf 'recorded worker process %s is still alive\n' "$recorded_pid"
    else
      printf 'recorded worker PID %s was reused; the owner cannot be proven dead\n' \
        "$recorded_pid"
    fi
    return 1
  fi
  if [[ -n "$(_process_group_pids "$recorded_pgid")" ]]; then
    printf 'live processes remain in recorded worker process group %s\n' "$recorded_pgid"
    return 1
  fi
}

# Reads one optional fleet-state field.  `cat` is used deliberately: an input
# redirection is applied before `2>/dev/null` takes effect, so the shell would
# report its own "No such file or directory" for every legitimately absent field.
_response_state_field() {
  { cat "$1" 2>/dev/null || true; } | tr -d '\n'
}

# The owner evidence a retirement archive keeps, in the shared key=value field
# format.  Fields fleet state does not record are omitted, never invented, and
# the record is re-derived on every retry so a rewritten provenance file cannot
# launder a live worker into an archived dead one.  `td_status` is the status the
# lookup actually returned, not an assumption about it.
_response_retirement_owner_record() {
  local name repo_dir="$1" td_status="$2" value

  for name in worker_pid worker_process_start worker_process_group pane td_task; do
    value="$(_response_state_field "$repo_dir/$name")"
    [[ -n "$value" ]] || continue
    printf '%s=%s\n' "$name" "$value"
  done
  value="$(_sgt_read_owned_file "$repo_dir/pane_identity" 2>/dev/null | tr -d '\n' || true)"
  [[ -z "$value" ]] || printf 'pane_identity=%s\n' "$value"
  printf 'td_status=%s\n' "$td_status"
}

_response_retirement_manifest() {
  local fields_digest="$4" fleet_digest="$2" repo_dir="$1" value worktree_digest="$3"

  value="$(_response_state_field "$repo_dir/response_id")"
  [[ -z "$value" ]] || printf 'response_id=%s\n' "$value"
  value="$(_response_state_field "$repo_dir/response_generation")"
  [[ -z "$value" ]] || printf 'gate_generation=%s\n' "$value"
  printf 'fleet_state_digest=%s\n' "$fleet_digest"
  printf 'worktree_state_digest=%s\n' "$worktree_digest"
  printf 'archive_fields_digest=%s\n' "$fields_digest"
}

# Publishes the response-archive fields this handshake can actually prove: `body`
# and `proof` are the exact transport and post-application records, and
# `gate_generation`/`applied_status` are read back out of them.  A field with no
# recorded source stays absent — retirement never fabricates one.
#
# A partial handshake that did get as far as an applied proof yields all four
# fields, so shape alone would make the archive indistinguishable from a real
# acknowledgement.  The retired marker is what distinguishes it: it is written
# first, it is covered by archive_fields_digest, and
# _sgt_response_archive_entry_complete refuses any entry carrying it, so these
# fields can never be read as an acknowledgement even if the archive were moved
# into response-archive/<id>.
#
# The fields are bound by archive_fields_digest so a rewritten field is as
# detectable as a rewritten copy, and they carry the same 0600 discipline
# sgt-ack-response applies to the fields of a real archive entry.
_write_response_retirement_fields() {
  local applied_status field generation proof_root="$2" repo_dir="$1" staging="$3"

  printf 'response handshake retired by sgt-cleanup; this is not an acknowledgement\n' \
    > "$staging/$_SGT_RESPONSE_RETIRED_MARKER" || return 1
  if [[ -f "$repo_dir/response" && ! -L "$repo_dir/response" ]]; then
    cp -p "$repo_dir/response" "$staging/body" || return 1
  fi
  generation="$(_response_state_field "$repo_dir/response_generation")"
  if [[ -n "$generation" ]]; then
    printf '%s\n' "$generation" > "$staging/gate_generation" || return 1
  fi
  if [[ -f "$proof_root/.sergeant-response-applied" && \
    ! -L "$proof_root/.sergeant-response-applied" ]]; then
    cp -p "$proof_root/.sergeant-response-applied" "$staging/proof" || return 1
    applied_status="$(_sgt_response_archive_field status "$staging/proof" \
      2>/dev/null || true)"
    if [[ -n "$applied_status" ]]; then
      printf '%s\n' "$applied_status" > "$staging/applied_status" || return 1
    fi
  fi
  for field in $_SGT_RESPONSE_ARCHIVE_FIELDS "$_SGT_RESPONSE_RETIRED_MARKER"; do
    [[ -f "$staging/$field" ]] || continue
    chmod 600 "$staging/$field" || return 1
  done
}

# Binds the shared archive fields published at the archive root, together with the
# marker that keeps them from ever being read as an acknowledgement.
_response_retirement_fields_digest() {
  _named_tree_digest "$1" \
    "$_SGT_RESPONSE_ARCHIVE_FIELDS $_SGT_RESPONSE_RETIRED_MARKER"
}

_copy_response_retirement_state() {
  local destination="$3" name names root="$1" side="$2"

  names="$(_response_state_names "$side")" || return 1
  mkdir -p "$destination" || return 1
  for name in $names; do
    [[ -e "$root/$name" || -L "$root/$name" ]] || continue
    [[ ! -L "$root/$name" ]] || return 1
    cp -pR "$root/$name" "$destination/$name" || return 1
  done
}

_publish_response_retirement() {
  ( umask 077; _publish_response_retirement_staged "$@" )
}

# Publishes the retirement archive.  It lives in fleet state beside the
# `response-archive` entries it shares its field names with, and has that same
# lifetime: it is retained until the task's fleet state is removed, which is what
# makes a retried cleanup converge.  It is deliberately not a durable audit
# record — writing one outside the fleet task would be a new externally published
# state transition, which this work is not authorized to introduce.
#
# Every refusal prints its reason BEFORE rolling back, and returns 3 rather than 1
# when the rollback itself failed, so the caller reports the preserved artifact
# instead of appending a generic handshake refusal to a CRITICAL rollback message.
_publish_response_retirement_staged() {
  local fields_digest fleet_digest="$3" proof_root="$2" repo_dir="$1" \
    td_status="$5" worktree_digest="$4"
  local retirement="$repo_dir/response-retirement" staging

  # A random suffix, as elsewhere in this file: a bare PID would let a staging
  # directory leaked by a killed run refuse cleanup forever once a later run
  # recycled that PID.
  staging="$repo_dir/response-retirement.tmp.$$.$RANDOM.$RANDOM"
  if [[ -e "$staging" || -L "$staging" ]]; then
    printf 'a retirement archive staging directory already exists: %s\n' "$staging"
    return 1
  fi
  if ! mkdir "$staging"; then
    printf 'could not stage the retirement archive: %s\n' "$staging"
    return 1
  fi
  if ! _cleanup_fail_point retirement-record || \
    ! _copy_response_retirement_state "$repo_dir" fleet "$staging/partial/fleet" || \
    ! _copy_response_retirement_state "$proof_root" worktree "$staging/partial/worktree" || \
    ! _write_response_retirement_fields "$repo_dir" "$proof_root" "$staging" || \
    ! _response_retirement_owner_record "$repo_dir" "$td_status" \
      > "$staging/owner" || \
    ! fields_digest="$(_response_retirement_fields_digest "$staging")" || \
    ! _response_retirement_manifest "$repo_dir" "$fleet_digest" "$worktree_digest" \
      "$fields_digest" > "$staging/manifest"; then
    printf 'could not record the partial response state as evidence\n'
    _retirement_rollback "$staging" "retirement archive staging" || return 3
    return 1
  fi
  # Re-bind both sides after copying so a write that lands during the copy is
  # never published as the state that was preserved.
  if [[ "$(_response_state_digest "$repo_dir" fleet 2>/dev/null || true)" != \
      "$fleet_digest" || \
    "$(_response_state_digest "$proof_root" worktree 2>/dev/null || true)" != \
      "$worktree_digest" ]]; then
    printf 'the partial response state changed while it was being archived\n'
    _retirement_rollback "$staging" "changed retirement archive staging" || return 3
    return 1
  fi
  # `mv` into an existing directory moves the source inside it and still reports
  # success, so the destination shape is checked before the rename.
  if ! _cleanup_fail_point retirement-publish || \
    [[ -e "$retirement" || -L "$retirement" ]] || ! mv "$staging" "$retirement"; then
    printf 'could not publish the retirement archive: %s\n' "$retirement"
    _retirement_rollback "$staging" "retirement archive publication" || return 3
    return 1
  fi
  # Past the rename the staging path is gone, so an archive that did not land in
  # the shape a later run will validate has to be rolled back at its published
  # path.  Rolling back the staging path instead would leave an archive no run can
  # accept and none can remove.
  if [[ ! -f "$retirement/manifest" || -L "$retirement/manifest" ]]; then
    printf 'the published retirement archive is malformed: %s\n' "$retirement"
    _retirement_rollback "$retirement" "malformed retirement archive publication" || \
      return 3
    return 1
  fi
}

# Removes one retirement transaction artifact.  Unlike _rollback_remove_path this
# reports through its return status and stdout instead of _die, because every
# retirement caller reads it through a command substitution where _die would only
# exit the substitution and the real refusal reason would be lost.
_retirement_rollback() {
  local context="$2" path="$1"

  [[ -e "$path" || -L "$path" ]] || return 0
  if ! _cleanup_fail_point retirement-stage-rollback-cleanup || \
    ! rm -rf "$path" || [[ -e "$path" || -L "$path" ]]; then
    printf 'CRITICAL: rollback cleanup failed for %s; inspect preserved artifact: %s\n' \
      "$context" "$path"
    return 1
  fi
}

# _validate_response_retirement — a published retirement archive is evidence only
# while it still describes the state it preserved, for the owner it recorded.
_validate_response_retirement() {
  local fleet_digest="$3" proof_root="$2" repo_dir="$1" td_status="$5" \
    worktree_digest="$4"
  local name recorded_fields recorded_fleet recorded_worktree
  local retirement="$repo_dir/response-retirement"

  if [[ ! -d "$retirement" || -L "$retirement" ]]; then
    printf 'the retirement archive is not a directory: %s\n' "$retirement"
    return 1
  fi
  for name in manifest owner; do
    if [[ ! -f "$retirement/$name" || -L "$retirement/$name" ]]; then
      printf 'the retirement archive is incomplete: %s\n' "$retirement/$name"
      return 1
    fi
  done
  # The archived copies must be the directories that were bound, not links to a
  # tree that happens to hash the same.
  for name in partial partial/fleet partial/worktree; do
    if [[ ! -d "$retirement/$name" || -L "$retirement/$name" ]]; then
      printf 'the retirement archive is incomplete: %s\n' "$retirement/$name"
      return 1
    fi
  done
  recorded_fleet="$(_sgt_response_archive_field fleet_state_digest \
    "$retirement/manifest" 2>/dev/null || true)"
  recorded_worktree="$(_sgt_response_archive_field worktree_state_digest \
    "$retirement/manifest" 2>/dev/null || true)"
  recorded_fields="$(_sgt_response_archive_field archive_fields_digest \
    "$retirement/manifest" 2>/dev/null || true)"
  if [[ -z "$recorded_fleet" || -z "$recorded_worktree" || -z "$recorded_fields" ]]; then
    printf 'the retirement archive does not bind the state it preserved\n'
    return 1
  fi
  if [[ "$(_response_state_digest "$retirement/partial/fleet" fleet \
      2>/dev/null || true)" != "$recorded_fleet" || \
    "$(_response_state_digest "$retirement/partial/worktree" worktree \
      2>/dev/null || true)" != "$recorded_worktree" || \
    "$(_response_retirement_fields_digest "$retirement" 2>/dev/null || true)" != \
      "$recorded_fields" ]]; then
    printf 'the retirement archive no longer matches the state it preserved\n'
    return 1
  fi
  # Re-deriving the whole manifest binds every field it records, including the
  # retired response identity and generation, to the state that is there now.
  if [[ "$(_response_retirement_manifest "$repo_dir" "$recorded_fleet" \
    "$recorded_worktree" "$recorded_fields")" != "$(cat "$retirement/manifest")" ]]; then
    printf 'the retired response no longer matches the retirement archive\n'
    return 1
  fi
  if [[ "$(_response_retirement_owner_record "$repo_dir" "$td_status")" != \
    "$(cat "$retirement/owner")" ]]; then
    printf 'the recorded worker no longer matches the retirement archive\n'
    return 1
  fi
  if [[ "$fleet_digest" != "$recorded_fleet" ]]; then
    printf 'the partial response state changed after retirement\n'
    return 1
  fi
  if [[ "$worktree_digest" != "$recorded_worktree" ]]; then
    # Cleanup removes the worker's lifecycle evidence after retirement is
    # published, so a worker side with no handshake artifact left is the expected
    # replay state and the archive holds the preserved copy.  Every other
    # divergence is a different handshake.
    if _response_state_present "$proof_root" worktree; then
      printf 'the partial response state changed after retirement\n'
      return 1
    fi
  fi
}

# _retire_response_state — the only path that accepts an unfinishable response
# handshake, and the only one that may proceed without an acknowledgement.  It
# succeeds only when the owning work is closed AND the recorded worker is
# provably gone, and only once the exact partial state and the owner evidence are
# archived.  Prints the reason for every refusal.
#
# `check` mode writes nothing: the preflight proves eligibility before any
# mutation, and publication happens later under the response lock.
#
# Exit code 2 is reserved for a td lookup that could not be performed, so the
# caller can report an infrastructural failure as itself rather than as a
# handshake that was left incomplete.
_retire_response_state() {
  local mode="$3" proof_root="$2" repo_dir="$1" repo_name="$4"
  local fleet_digest lookup=0 reason state worktree_digest

  state="$(_owning_td_task_state "$repo_dir" "$repo_name")" || lookup=$?
  case "$lookup" in
    0)
      if [[ "$state" != "closed" ]]; then
        printf 'owning td task is %s, not closed\n' "$state"
        return 1
      fi
      ;;
    2)
      printf '%s\n' "$state"
      return 2
      ;;
    *)
      printf 'no owning td task is recorded\n'
      return 1
      ;;
  esac
  if ! reason="$(_response_owner_provably_dead "$repo_dir")"; then
    printf '%s\n' "$reason"
    return 1
  fi
  if ! fleet_digest="$(_response_state_digest "$repo_dir" fleet)" || \
    ! worktree_digest="$(_response_state_digest "$proof_root" worktree)"; then
    printf 'the partial response state cannot be bound as evidence\n'
    return 1
  fi
  if [[ -e "$repo_dir/response-retirement" || -L "$repo_dir/response-retirement" ]]; then
    _validate_response_retirement "$repo_dir" "$proof_root" "$fleet_digest" \
      "$worktree_digest" "$state"
    return
  fi
  [[ "$mode" == "publish" ]] || return 0
  _publish_response_retirement "$repo_dir" "$proof_root" "$fleet_digest" \
    "$worktree_digest" "$state" || return
  # Retiring a handshake without an acknowledgement is a decision an operator has
  # to be able to see in the run log, not only in fleet state this run is about to
  # remove.  On success the single stdout line is the notice, not a refusal.
  reason="$(_response_state_field "$repo_dir/response_id")"
  printf 'retiring unfinishable response handshake: %s response=%s generation=%s owner_pid=%s\n' \
    "$repo_name" "${reason:-none}" \
    "$(_response_state_field "$repo_dir/response_generation")" \
    "$(_response_state_field "$repo_dir/worker_pid")"
}

_require_retired_response_state() {
  local mode="$3" proof_root="$2" repo_dir="$1" repo_name="$4"
  local reason status=0

  reason="$(_retire_response_state "$repo_dir" "$proof_root" "$mode" "$repo_name")" || \
    status=$?
  case "$status" in
    0)
      [[ -z "$reason" ]] || printf '  %s\n' "$reason"
      return 0
      ;;
    # 2: the owning td task could not be looked up.  3: a retirement transaction
    # could not be rolled back.  Both are reported as themselves; only a genuine
    # handshake refusal gets the handshake headline.
    2|3) _die "$reason" ;;
    *) _die "$repo_name has pending or incomplete response acknowledgement${reason:+: $reason}" ;;
  esac
}

# _require_response_cleanup_safe — refuse to retire fleet state while a response
# handshake could still be completed.  Cleanup proceeds only for a handshake that
# left no state, one that is fully acknowledged, or one an explicit retirement has
# preserved as evidence.
_require_response_cleanup_safe() {
  local mode="${3:-check}" repo_dir="$1" worktree="$2"
  local archive repo_name response_generation response_id response_proof_root

  repo_name="$(basename "$repo_dir")"
  response_proof_root="$worktree"
  [[ -n "$response_proof_root" && -d "$response_proof_root" ]] || \
    response_proof_root="$repo_dir/terminal-evidence"

  if [[ -e "$repo_dir/response" || -L "$repo_dir/response" ||
        -e "$response_proof_root/.sergeant-response" || -L "$response_proof_root/.sergeant-response" ||
        -e "$response_proof_root/.sergeant-response-id" || -L "$response_proof_root/.sergeant-response-id" ||
        -e "$response_proof_root/.sergeant-response-generation" || -L "$response_proof_root/.sergeant-response-generation" ||
        -e "$response_proof_root/.sergeant-response-applied" || -L "$response_proof_root/.sergeant-response-applied" ]]; then
    _require_retired_response_state "$repo_dir" "$response_proof_root" "$mode" "$repo_name"
    return 0
  fi

  if [[ ! -e "$repo_dir/response_id" && ! -L "$repo_dir/response_id" &&
        ! -e "$repo_dir/response_generation" && ! -L "$repo_dir/response_generation" &&
        ! -e "$repo_dir/response_ack" && ! -L "$repo_dir/response_ack" &&
        ! -e "$repo_dir/response-archive" && ! -L "$repo_dir/response-archive" &&
        ! -e "$response_proof_root/.sergeant-response-ack" && ! -L "$response_proof_root/.sergeant-response-ack" ]]; then
    return 0
  fi

  response_id="$(cat "$repo_dir/response_id" 2>/dev/null || true)"
  response_generation="$(cat "$repo_dir/response_generation" 2>/dev/null || true)"
  archive="$repo_dir/response-archive/$response_id"
  if [[ "$response_id" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ &&
        "$response_generation" =~ ^[1-9][0-9]*$ &&
        "$(cat "$repo_dir/response_ack" 2>/dev/null || true)" == "$response_id" &&
        "$(cat "$response_proof_root/.sergeant-response-ack" 2>/dev/null || true)" == "$response_id" ]] && \
    _sgt_response_archive_entry_matches "$archive" "$response_id" "$response_generation"; then
    return 0
  fi
  _require_retired_response_state "$repo_dir" "$response_proof_root" "$mode" "$repo_name"
}

# _owning_repository_work_dir — resolve the repository that owns a fleet repo's
# work, for use as the `--work-dir` binding of every td lookup.  Prints the path
# on success and the reason it could not be resolved on failure.
#
# Terminal classification must never depend on the directory cleanup happens to
# run from, so the binding is an owner identity the fleet itself recorded, never a
# path the caller supplied.  Resolution mirrors _validate_retry_owner, which is
# already the file's rule for deciding an owner when the project configuration has
# moved on:
#
#   1. the configured repository root, when the project YAML resolves it;
#   2. otherwise a hard refusal when brief.md names a project whose YAML no longer
#      resolves, exactly as _validate_retry_owner refuses that case;
#   3. otherwise, for a legacy fleet that names no project at all, the owner root a
#      previous cleanup pass already recorded and validated in cleanup-owner.
#
# The recorded worktree is never trusted as the binding on its own: a worktree
# replaced by an unrelated repository would answer the lookup out of a foreign td
# database.  When one is recorded and still present it must belong to the resolved
# owner, so a mismatch fails closed here — before any pane is stopped and before
# any evidence is published — rather than at the removal gate.
_owning_repository_work_dir() {
  local repo_dir="$1" repo_name="$2"
  local owner_identity owner_root recorded_identity worktree

  if ! owner_root="$(_configured_repo_root "$repo_name" 2>/dev/null)"; then
    if _task_project >/dev/null 2>&1; then
      printf 'the configured repository root for %s no longer resolves\n' "$repo_name"
      return 1
    fi
    if [[ "$(sed -n '1p' "$repo_dir/cleanup-owner" 2>/dev/null || true)" != "4" ]]; then
      printf 'no configured or recorded repository root resolves for %s\n' "$repo_name"
      return 1
    fi
    owner_root="$(sed -n '3p' "$repo_dir/cleanup-owner")"
    if [[ -z "$owner_root" ]]; then
      printf 'no configured or recorded repository root resolves for %s\n' "$repo_name"
      return 1
    fi
  fi
  if [[ ! -d "$owner_root" || -L "$owner_root" ]] || \
    [[ "$owner_root" != "$(cd "$owner_root" && pwd -P)" ]] || \
    ! git -C "$owner_root" rev-parse --git-dir >/dev/null 2>&1; then
    printf 'the owning repository is unavailable or aliased for %s: %s\n' \
      "$repo_name" "$owner_root"
    return 1
  fi
  # When a previous pass recorded an owner identity, the repository standing at
  # that path must still be the same repository.  This is the check that makes the
  # binding a verified identity rather than a path, and it covers the case a
  # present-worktree cross-check cannot: a recorded worktree that is gone or moved.
  recorded_identity="$(sed -n '6p' "$repo_dir/cleanup-owner" 2>/dev/null || true)"
  if [[ "$(sed -n '1p' "$repo_dir/cleanup-owner" 2>/dev/null || true)" == "4" && \
    -n "$recorded_identity" ]]; then
    owner_identity="$(_repo_owner_identity "$owner_root" 2>/dev/null || true)"
    if [[ "$owner_identity" != "$recorded_identity" ]]; then
      printf 'the owning repository for %s is no longer the recorded one: %s\n' \
        "$repo_name" "$owner_root"
      return 1
    fi
  fi
  worktree="$(cat "$repo_dir/worktree" 2>/dev/null || true)"
  if [[ -n "$worktree" && -d "$worktree" && ! -L "$worktree" ]] && \
    ! _require_worktree_owner "$owner_root" "$worktree"; then
    printf 'the recorded worktree does not belong to the owning repository %s: %s\n' \
      "$owner_root" "$worktree"
    return 1
  fi
  printf '%s\n' "$owner_root"
}

# _owning_td_task_state — print the status of the td task recorded for a repo's
# fleet state, resolved inside that repo's own owning repository.
#
# Exit codes, with the single stdout line each one produces:
#   0  the resolved td status
#   1  nothing; no td task is recorded for this repo
#   2  a one-line explanation of why the lookup could not be performed
#
# Exit code 2 exists so that an infrastructural failure — a missing repository
# binding, an unreadable td database, unparseable output — is reported as itself
# instead of silently degrading into "the owning task is not closed".  The
# explanation travels on stdout because every caller reads this function through
# a command substitution, where a global could not survive.
_owning_td_task_state() {
  local repo_dir="$1" repo_name="$2"
  local error_file td_error td_json td_status td_task work_dir

  td_task="$(cat "$repo_dir/td_task" 2>/dev/null || true)"
  [[ -n "$td_task" ]] || return 1
  if ! command -v td >/dev/null 2>&1 || ! command -v jq >/dev/null 2>&1; then
    printf 'Cannot read the owning td task %s for %s: td and jq are required\n' \
      "$td_task" "$repo_name"
    return 2
  fi
  if ! work_dir="$(_owning_repository_work_dir "$repo_dir" "$repo_name")"; then
    printf 'Cannot bind the owning repository for %s to resolve %s: %s\n' \
      "$repo_name" "$td_task" "${work_dir:-no repository binding is available}"
    return 2
  fi
  error_file="$(mktemp)"
  if ! td_json="$(td show --format json --work-dir "$work_dir" "$td_task" \
    2> "$error_file")"; then
    td_error="$(tr '\n' ' ' < "$error_file" | cut -c1-200)"
    rm -f "$error_file"
    printf 'Cannot read the owning td task %s for %s in %s: %s\n' \
      "$td_task" "$repo_name" "$work_dir" "${td_error:-td show failed}"
    return 2
  fi
  rm -f "$error_file"
  td_status="$(printf '%s' "$td_json" | jq -r '.status // empty' 2>/dev/null || true)"
  if [[ -z "$td_status" ]]; then
    printf 'Cannot read the owning td task %s for %s in %s: td reported no status\n' \
      "$td_task" "$repo_name" "$work_dir"
    return 2
  fi
  printf '%s\n' "$td_status"
}

# _require_owning_td_task_closed — die unless the recorded td task is closed,
# distinguishing "not closed yet" from "could not be looked up".
_require_owning_td_task_closed() {
  local repo_dir="$1" repo_name="$2" status="$3"
  local lookup=0 state

  state="$(_owning_td_task_state "$repo_dir" "$repo_name")" || lookup=$?
  case "$lookup" in
    0)
      [[ "$state" == "closed" ]] || \
        _die "$repo_name is not terminal: $status; owning td task is $state"
      ;;
    2) _die "$state" ;;
    *) _die "$repo_name is not terminal: $status" ;;
  esac
}


_require_terminal_repos() {
  local cleanup_phase configured_root evidence_dir expected_evidence_identity owner_root owner_type \
    partial_phase removed_phase removing_phase proof_dir repo_dir repo_name \
    restore_after_validation retry_root retry_type status td_closed_orphan worktree \
    treehouse_holder treehouse_lease_id treehouse_returned_phase \
    treehouse_returning_phase treehouse_returning_verified_phase worktree_status wt_type

  for repo_dir in "$TASK_DIR"/*/; do
    [[ -d "$repo_dir" ]] || continue
    repo_dir="${repo_dir%/}"
    repo_name="$(basename "$repo_dir")"
    td_closed_orphan=false
    if [[ -n "$FILTER_REPO" && "$repo_name" != "$FILTER_REPO" ]]; then
      continue
    fi

    status="$(tr -d '\n' < "$repo_dir/status" 2>/dev/null || echo unknown)"
    case "$status" in
      done)
        [[ -s "$repo_dir/result" ]] || \
          _die "$repo_name is not safely terminal: done requires a reconciled result"
        ;;
      failed:\ *[![:space:]]) ;;
      orphaned)
        # Accept orphaned workers whose owning td task is already closed — this
        # covers the post-merge state where the pane exited after the PR merged
        # but before sgt-cleanup ran.  All other orphaned states are rejected.
        # Uncommitted-change safety is enforced by _require_clean_worktrees
        # (called unconditionally below), which satisfies the "no uncommitted
        # worktree commits" guard regardless of worktree presence.
        #
        # When the td task is closed, the worktree .sergeant-status contains the
        # worker's last nonterminal write (e.g. in_progress) — the supervisor set
        # fleet status=orphaned externally.  Skip the worktree/evidence status
        # reconciliation checks below for this case (td_closed_orphan=true).
        _require_owning_td_task_closed "$repo_dir" "$repo_name" "$status"
        td_closed_orphan=true
        ;;
      *) _die "$repo_name is not terminal: $status" ;;
    esac

    worktree="$(cat "$repo_dir/worktree" 2>/dev/null || true)"
    _require_response_cleanup_safe "$repo_dir" "$worktree"
    wt_type="$(cat "$repo_dir/wt_type" 2>/dev/null || echo git)"
    case "$wt_type" in
      git|treehouse) ;;
      *) _die "Unsupported worktree removal type: $repo_name: $wt_type" ;;
    esac
    cleanup_phase="$(cat "$repo_dir/cleanup-phase" 2>/dev/null || true)"
    retry_type="$(sed -n '3p' "$repo_dir/cleanup-phase" 2>/dev/null || true)"
    retry_root="$(sed -n '4p' "$repo_dir/cleanup-phase" 2>/dev/null || true)"
    partial_phase="$(printf 'partial-removal\n%s\n%s\n%s\n' \
      "$worktree" "$retry_type" "$retry_root")"
    removing_phase="$(printf 'removing\n%s\n%s\n%s\n' \
      "$worktree" "$retry_type" "$retry_root")"
    removed_phase="$(printf 'removed\n%s\n%s\n%s\n' \
      "$worktree" "$retry_type" "$retry_root")"
    treehouse_holder=""
    treehouse_lease_id=""
    if [[ "$wt_type" == treehouse ]]; then
      treehouse_holder="$(tr -d '\n' < "$repo_dir/wt_holder" 2>/dev/null || true)"
      treehouse_lease_id="$(
        if [[ -f "$repo_dir/wt_lease_id" && ! -L "$repo_dir/wt_lease_id" ]]; then
          tr -d '\n' < "$repo_dir/wt_lease_id"
        fi
      )"
    fi
    treehouse_returning_phase="$(printf 'returning\n%s\ntreehouse\n%s\n' \
      "$worktree" "$retry_root")"
    treehouse_returning_verified_phase="$(_treehouse_returning_phase \
      "$worktree" "$retry_root" "$treehouse_lease_id" "$treehouse_holder")"
    treehouse_returned_phase="$(_treehouse_returned_phase \
      "$worktree" "$retry_root" "$treehouse_lease_id" "$treehouse_holder")"
    if [[ -n "$worktree" && -d "$worktree" ]]; then
      proof_dir="$worktree"
      restore_after_validation=false
      case "$cleanup_phase" in
        "$removing_phase")
          [[ "$retry_type" == "$wt_type" ]] || \
            _die "Retry worktree type changed: $repo_name"
          _validate_retry_owner "$repo_dir" "$repo_name" "$worktree" \
            "$retry_type" "$retry_root"
          proof_dir="$repo_dir/terminal-evidence"
          restore_after_validation=true
          ;;
        "$treehouse_returning_phase"|"$treehouse_returning_verified_phase"|\
        "$treehouse_returned_phase")
          [[ "$wt_type" == treehouse ]] || \
            _die "Retry worktree type changed: $repo_name"
          _validate_retry_owner "$repo_dir" "$repo_name" "$worktree" \
            treehouse "$retry_root" returned
          proof_dir="$repo_dir/terminal-evidence"
          ;;
        "$partial_phase"|"$removed_phase")
          [[ "$retry_type" == "$wt_type" ]] || \
            _die "Retry worktree type changed: $repo_name"
          _validate_retry_owner "$repo_dir" "$repo_name" "$worktree" \
            "$retry_type" "$retry_root"
          _die "Previously removed worktree reappeared: $repo_name"
          ;;
        $'reconciled-absent\n'"$worktree")
          owner_root="$(sed -n '3p' "$repo_dir/cleanup-owner" 2>/dev/null || true)"
          owner_type="$(sed -n '5p' "$repo_dir/cleanup-owner" 2>/dev/null || true)"
          [[ "$owner_type" == "$wt_type" ]] || \
            _die "Retry worktree type changed: $repo_name"
          _validate_retry_owner "$repo_dir" "$repo_name" "$worktree" \
            "$owner_type" "$owner_root"
          _die "Previously removed worktree reappeared: $repo_name"
          ;;
        $'removing\n'"$worktree")
          _die "Retry owner identity is missing: $repo_name"
          ;;
        "") ;;
        *) _die "Persisted cleanup phase is malformed: $repo_name" ;;
      esac
      # For orphaned workers whose td task is closed, the worker's last
      # .sergeant-status is a nonterminal value (the supervisor sets fleet
      # status=orphaned externally).  Skip the status reconciliation check so
      # that a post-merge orphaned pane can be cleaned up.
      if [[ "$td_closed_orphan" != true ]]; then
        [[ -f "$proof_dir/.sergeant-status" ]] || \
          _die "$repo_name worktree terminal proof is missing"
        worktree_status="$(tr -d '\n' < "$proof_dir/.sergeant-status")"
        [[ "$worktree_status" == "$status" ]] || \
          _die "$repo_name is not reconciled: fleet status $status differs from worktree status $worktree_status"
        if [[ "$status" == "done" ]]; then
          [[ -s "$proof_dir/.sergeant-result" ]] || \
            _die "$repo_name worktree is not safely terminal: done requires a result"
          cmp -s "$repo_dir/result" "$proof_dir/.sergeant-result" || \
            _die "$repo_name worktree result differs from reconciled fleet result"
        fi
      fi

      if [[ -z "$cleanup_phase" ]]; then
        # Verify the configured owner exists when a project config is available;
        # skip for legacy fleets that predate project-config ownership tracking.
        if _task_project >/dev/null 2>&1; then
          configured_root="$(_configured_repo_root "$repo_name")" || \
            _die "Cannot resolve configured cleanup owner: $repo_name"
          _require_worktree_owner "$configured_root" "$worktree" || \
            _die "Worktree does not belong to configured cleanup owner: $repo_name"
        fi
      fi
      if [[ "$restore_after_validation" == true ]]; then
        expected_evidence_identity="$(sed -n '8p' "$repo_dir/cleanup-owner")"
        _restore_worker_evidence "$repo_dir" "$worktree" \
          "$expected_evidence_identity" || \
          _die "Failed to restore persisted worker evidence: $repo_name; inspect preserved evidence: $repo_dir/terminal-evidence; restore artifacts: $repo_dir/restore-evidence.tmp.*; worktree: $worktree"
      fi
    else
      if [[ -z "$worktree" ]]; then
        continue
      fi
      [[ "$cleanup_phase" != $'removing\n'"$worktree" ]] || \
        _die "Retry owner identity is missing: $repo_name"
      if [[ "$cleanup_phase" == $'reconciled-absent\n'"$worktree" ]]; then
        owner_root="$(sed -n '3p' "$repo_dir/cleanup-owner" 2>/dev/null || true)"
        owner_type="$(sed -n '5p' "$repo_dir/cleanup-owner" 2>/dev/null || true)"
        # Orphaned workers do not record cleanup ownership; skip validation for
        # orphaned status when no cleanup-owner exists (post-merge cleanup case).
        if [[ "$status" != "orphaned" || -f "$repo_dir/cleanup-owner" ]]; then
          [[ "$owner_type" == "$wt_type" ]] || \
            _die "Retry worktree type changed: $repo_name"
          _validate_retry_owner "$repo_dir" "$repo_name" "$worktree" \
            "$owner_type" "$owner_root"
        fi
      fi
      if [[ -z "$cleanup_phase" ]]; then
        # No cleanup-phase: either terminal-evidence exists (pre-reconciled from a
        # prior cleanup run or external preservation) or the worktree was externally
        # removed before any cleanup state was recorded — both allow cleanup to proceed.
        evidence_dir="$repo_dir/terminal-evidence"
        # When td_closed_orphan is true, the terminal-evidence .sergeant-status (if
        # it exists from a prior partial cleanup) contains the worker's last
        # nonterminal write, not 'orphaned', so reconciliation is intentionally
        # skipped.  The absent-worktree case has no uncommitted changes to protect,
        # and _require_clean_worktrees enforces that guard unconditionally.
        if [[ -f "$evidence_dir/.sergeant-status" && "$td_closed_orphan" != true ]]; then
          worktree_status="$(tr -d '\n' < "$evidence_dir/.sergeant-status")"
          [[ "$worktree_status" == "$status" ]] ||
            _die "$repo_name cleanup evidence differs from reconciled fleet status"
          if [[ "$status" == "done" ]]; then
            [[ -s "$evidence_dir/.sergeant-result" ]] ||
              _die "$repo_name reconciled cleanup evidence requires a result"
            cmp -s "$repo_dir/result" "$evidence_dir/.sergeant-result" ||
              _die "$repo_name cleanup evidence differs from reconciled fleet result"
          fi
        fi
        # else: no terminal evidence (or orphaned with closed td) — externally removed
        # worktree with terminal fleet state; allow cleanup to proceed (main loop will
        # skip the absent worktree).
      else
        [[ -n "$worktree" && ( \
          ( ( "$cleanup_phase" == "$partial_phase" || \
              "$cleanup_phase" == "$removed_phase" || \
              "$cleanup_phase" == "$removing_phase" ) && \
            "$retry_type" == "$wt_type" && \
            ( "$retry_type" == git || "$retry_type" == treehouse ) && \
            -n "$retry_root" ) || \
          "$cleanup_phase" == $'reconciled-absent\n'"$worktree" || \
          "$cleanup_phase" == "$treehouse_returning_phase" || \
          "$cleanup_phase" == "$treehouse_returning_verified_phase" || \
          "$cleanup_phase" == "$treehouse_returned_phase" \
        ) ]] || \
          _die "$repo_name has no reconciled cleanup phase for its absent worktree"

        # Every persisted removal phase is replay state: validate the persisted
        # owner before proceeding so a reappeared or misidentified worktree is
        # rejected fail-closed before evidence is inspected or a remover runs.
        # removing_phase (without type/root) is rejected earlier at line 558-559
        # so it never reaches this block; removing_phase (with type/root) requires
        # an absent worktree and is handled by the main loop's own owner check.
        if [[ "$cleanup_phase" == "$treehouse_returning_phase" || \
              "$cleanup_phase" == "$treehouse_returning_verified_phase" || \
              "$cleanup_phase" == "$treehouse_returned_phase" ]]; then
          _validate_retry_owner "$repo_dir" "$repo_name" "$worktree" \
            treehouse "$retry_root" returned
        elif [[ "$cleanup_phase" == "$partial_phase" || \
              "$cleanup_phase" == "$removed_phase" ]]; then
          [[ "$retry_type" == "$wt_type" ]] || \
            _die "Retry worktree type changed: $repo_name"
          _validate_retry_owner "$repo_dir" "$repo_name" "$worktree" \
            "$retry_type" "$retry_root"
        fi

        evidence_dir="$repo_dir/terminal-evidence"
        # For orphaned workers with a closed td task, a prior cleanup pass may
        # have staged terminal evidence whose .sergeant-status is the worker's
        # last nonterminal write (not 'orphaned').  When td_closed_orphan is true
        # the evidence file is not required and status/result reconciliation is
        # skipped; the reconciled cleanup phase is sufficient proof.
        [[ -f "$evidence_dir/.sergeant-status" || "$td_closed_orphan" == true ]] ||
          _die "$repo_name reconciled cleanup evidence is missing"
        if [[ "$td_closed_orphan" != true ]]; then
          worktree_status="$(tr -d '\n' < "$evidence_dir/.sergeant-status")"
          [[ "$worktree_status" == "$status" ]] ||
            _die "$repo_name cleanup evidence differs from reconciled fleet status"
          if [[ "$status" == "done" ]]; then
            [[ -s "$evidence_dir/.sergeant-result" ]] ||
              _die "$repo_name reconciled cleanup evidence requires a result"
            cmp -s "$repo_dir/result" "$evidence_dir/.sergeant-result" ||
              _die "$repo_name cleanup evidence differs from reconciled fleet result"
          fi
        fi
      fi
    fi
  done
}

_require_clean_worktrees() {
  local changes cleanup_phase repo_dir repo_name worktree wt_type

  for repo_dir in "$TASK_DIR"/*/; do
    [[ -d "$repo_dir" ]] || continue
    repo_dir="${repo_dir%/}"
    repo_name="$(basename "$repo_dir")"
    if [[ -n "$FILTER_REPO" && "$repo_name" != "$FILTER_REPO" ]]; then
      continue
    fi

    worktree="$(cat "$repo_dir/worktree" 2>/dev/null || true)"
    [[ -n "$worktree" && -d "$worktree" ]] || continue
    wt_type="$(cat "$repo_dir/wt_type" 2>/dev/null || echo git)"
    cleanup_phase="$(sed -n '1p' "$repo_dir/cleanup-phase" 2>/dev/null || true)"
    [[ "$wt_type" != treehouse || "$cleanup_phase" != returned ]] || continue
    git -C "$worktree" rev-parse --is-inside-work-tree >/dev/null 2>&1 || \
      _die "Cannot verify $repo_name worktree before cleanup: $worktree"
    changes="$(git -C "$worktree" status --porcelain --untracked-files=all -- \
      . ':(exclude).sergeant-*')" || \
      _die "Cannot inspect $repo_name worktree before cleanup: $worktree"
    [[ -z "$changes" ]] || \
      _die "$repo_name worktree has uncommitted changes; cleanup refused"
  done
}

_path_device() {
  local device parent path="$1"

  while [[ ! -e "$path" && ! -L "$path" ]]; do
    parent="$(dirname "$path")"
    [[ "$parent" != "$path" ]] || return 1
    path="$parent"
  done

  device="$(stat -c '%d' "$path" 2>/dev/null || \
    stat -f '%d' "$path" 2>/dev/null)" || return 1
  [[ -n "$device" && "$device" != *$'\n'* ]] || return 1
  printf '%s\n' "$device"
}

_same_filesystem_pair() {
  local fleet_device repo_dir="$1" repo_name="$2" worktree="$3" worktree_device

  if ! fleet_device="$(_path_device "$repo_dir")"; then
    CLEANUP_LAYOUT_ERROR="Cannot verify cleanup filesystem layout: $repo_name fleet state"
    return 1
  fi
  if ! worktree_device="$(_path_device "$worktree")"; then
    CLEANUP_LAYOUT_ERROR="Cannot verify cleanup filesystem layout: $repo_name worktree"
    return 1
  fi
  if [[ "$fleet_device" != "$worktree_device" ]]; then
    CLEANUP_LAYOUT_ERROR="Unsupported cleanup layout: fleet state and worktree must be on the same filesystem; move SERGEANT_FLEET or the worktree before retrying: $repo_name"
    return 1
  fi
  CLEANUP_LAYOUT_ERROR=""
}

_require_same_filesystem_pair() {
  _same_filesystem_pair "$@" || _die "$CLEANUP_LAYOUT_ERROR"
}

_require_same_filesystem_layout() {
  local repo_dir repo_name worktree

  for repo_dir in "$TASK_DIR"/*/; do
    [[ -d "$repo_dir" ]] || continue
    repo_dir="${repo_dir%/}"
    repo_name="$(basename "$repo_dir")"
    if [[ -n "$FILTER_REPO" && "$repo_name" != "$FILTER_REPO" ]]; then
      continue
    fi

    worktree="$(cat "$repo_dir/worktree" 2>/dev/null || true)"
    [[ -n "$worktree" ]] || continue
    _require_same_filesystem_pair "$repo_dir" "$repo_name" "$worktree"
  done
}

_stage_worker_evidence() {
  local evidence expected_identity="$3" staged_identity staging_dir="$4" \
    worktree="$2" worker_identity repo_dir="$1"

  _same_filesystem_pair "$repo_dir" "$(basename "$repo_dir")" "$worktree" || \
    return 1
  [[ ! -e "$staging_dir" && ! -L "$staging_dir" ]] || return 1
  mkdir "$staging_dir" || return 1
  for evidence in "$worktree"/.sergeant-*; do
    [[ -e "$evidence" || -L "$evidence" ]] || continue
    if ! cp -pR "$evidence" "$staging_dir/"; then
      _rollback_remove_path "$staging_dir" "terminal evidence staging" \
        evidence-stage-rollback-cleanup
      return 1
    fi
  done
  worker_identity="$(_worker_evidence_identity "$worktree")" || worker_identity=""
  staged_identity="$(_worker_evidence_identity "$staging_dir")" || staged_identity=""
  if [[ -z "$worker_identity" || "$worker_identity" != "$expected_identity" || \
    "$staged_identity" != "$expected_identity" ]]; then
    _rollback_remove_path "$staging_dir" "changed terminal evidence staging" \
      evidence-stage-rollback-cleanup
    return 1
  fi
}

_cleanup_fail_point() {
  case ",${SGT_CLEANUP_FAIL_POINT:-}," in
    *,"$1",*) return 1 ;;
    *) return 0 ;;
  esac
}

_cleanup_mutation_hook() {
  local path="$2" point="$1"

  [[ "${SGT_CLEANUP_MUTATE_POINT:-}" == "$point" ]] || return 0
  [[ -n "$path" ]] || return 1
  printf 'injected lifecycle evidence mutation\n' > "$path"
}

_rollback_remove_path() {
  local context="$2" fail_point="$3" path="$1"

  [[ -e "$path" || -L "$path" ]] || return 0
  _cleanup_fail_point "$fail_point" || \
    _die "CRITICAL: rollback cleanup failed for $context; inspect preserved artifact: $path"
  rm -rf "$path" || \
    _die "CRITICAL: rollback cleanup failed for $context; inspect preserved artifact: $path"
  [[ ! -e "$path" && ! -L "$path" ]] || \
    _die "CRITICAL: rollback cleanup left an artifact for $context: $path"
}

# Usage: _move_worker_evidence_entry <source> <destination>
#
# Moves one evidence entry, in either direction: into the worktree when
# publishing or replaying, and into a fleet-owned backup when rolling back.
# Refuses the destination shapes `mv` cannot replace safely.  `mv` into an
# existing directory moves the source INSIDE it and still reports success, and a
# symlink to a directory does the same through the link, so either would silently
# move lifecycle evidence somewhere it can never be found again; a symlink to a
# non-directory is refused as well rather than replaced in place.  An existing
# regular file is replaced, as it always was: the entry being moved is the
# identity-bound evidence, so it wins over an unbound file that appeared
# underneath it and the caller still converges.
_move_worker_evidence_entry() {
  local destination="$2" source="$1"

  if [[ -L "$destination" || -d "$destination" ]]; then
    printf 'ERROR: worker lifecycle evidence collides with an existing path: %s (moving %s)\n' \
      "$destination" "$source" >&2
    return 1
  fi
  mv "$source" "$destination"
}

_undo_worker_evidence_removal() {
  local backup_dir="$2" name worktree="$1"

  shift 2
  for name in "$@"; do
    _move_worker_evidence_entry "$backup_dir/$name" "$worktree/$name" || \
      _die "Failed to roll back worker evidence removal: $worktree/$name"
  done
  rmdir "$backup_dir" || \
    _die "Failed to remove worker evidence rollback directory: $backup_dir"
}

# Moves the bound lifecycle evidence out of the worktree so the remover can run,
# publishing $LIVE_EVIDENCE_BACKUP for replay.  Returns nonzero for every refusal
# and lets the single caller report it.
_remove_worker_evidence() {
  local backup_dir="$1/live-evidence.tmp.$$" count=0 current_identity evidence \
    expected_identity="$3" name repo_dir="$1" worktree="$2"
  local -a moved=()

  _same_filesystem_pair "$repo_dir" "$(basename "$repo_dir")" "$worktree" || return 1
  [[ ! -e "$backup_dir" && ! -L "$backup_dir" ]] || return 1
  mkdir "$backup_dir" || return 1
  if ! _cleanup_mutation_hook before-live-removal \
    "${SGT_CLEANUP_MUTATE_PATH:-$worktree/.sergeant-status}"; then
    _rollback_remove_path "$backup_dir" "live evidence removal validation" \
      live-removal-rollback-cleanup
    return 1
  fi
  current_identity="$(_worker_evidence_identity "$worktree")" || current_identity=""
  if [[ -z "$expected_identity" || "$current_identity" != "$expected_identity" ]]; then
    _rollback_remove_path "$backup_dir" "live evidence removal validation" \
      live-removal-rollback-cleanup
    return 1
  fi
  for evidence in "$worktree"/.sergeant-*; do
    [[ -e "$evidence" || -L "$evidence" ]] || continue
    ((count += 1))
    if ! _cleanup_fail_point "remove-live-$count" || \
      ! mv "$evidence" "$backup_dir/"; then
      _undo_worker_evidence_removal "$worktree" "$backup_dir" \
        ${moved[@]+"${moved[@]}"}
      return 1
    fi
    moved[${#moved[@]}]="$(basename "$evidence")"
  done
  LIVE_EVIDENCE_BACKUP="$backup_dir"
}

_restore_worker_evidence() {
  local backup_dir count=0 evidence evidence_dir="$1/terminal-evidence" name \
    expected_identity="$3" layout_error persisted_identity publish_count=0 repo_dir="$1" \
    staged_identity staging_dir transaction worktree="$2"
  local -a backed_up=() published=()

  [[ -d "$worktree" && -d "$evidence_dir" ]] || return 0
  _require_same_filesystem_pair "$repo_dir" "$(basename "$repo_dir")" "$worktree"
  _cleanup_mutation_hook before-retry-restore \
    "${SGT_CLEANUP_MUTATE_PATH:-$evidence_dir/.sergeant-status}" || return 1
  persisted_identity="$(_worker_evidence_identity "$evidence_dir")" || return 1
  [[ -n "$expected_identity" && "$persisted_identity" == "$expected_identity" ]] || return 1
  transaction="$repo_dir/restore-evidence.tmp.$$"
  staging_dir="$transaction/staged"
  backup_dir="$transaction/original"
  [[ ! -e "$transaction" && ! -L "$transaction" ]] || return 1
  if ! mkdir -p "$staging_dir" "$backup_dir"; then
    _rollback_remove_path "$transaction" "worker evidence restore setup" \
      restore-rollback-cleanup
    return 1
  fi
  for evidence in "$evidence_dir"/.sergeant-*; do
    [[ -e "$evidence" || -L "$evidence" ]] || continue
    ((count += 1))
    if ! _cleanup_fail_point "restore-copy-$count" || \
      ! cp -pR "$evidence" "$staging_dir/"; then
      _rollback_remove_path "$transaction" "worker evidence restore staging" \
        restore-rollback-cleanup
      return 1
    fi
  done
  _cleanup_mutation_hook after-restore-copy \
    "${SGT_CLEANUP_MUTATE_PATH:-$staging_dir/.sergeant-diagnostic}" || {
    _rollback_remove_path "$transaction" "worker evidence restore staging" \
      restore-rollback-cleanup
    return 1
  }
  persisted_identity="$(_worker_evidence_identity "$evidence_dir")" || persisted_identity=""
  staged_identity="$(_worker_evidence_identity "$staging_dir")" || staged_identity=""
  if [[ -z "$expected_identity" || "$persisted_identity" != "$expected_identity" || \
    "$staged_identity" != "$expected_identity" ]]; then
    _rollback_remove_path "$transaction" "worker evidence restore validation" \
      restore-rollback-cleanup
    return 1
  fi
  if ! _same_filesystem_pair "$repo_dir" "$(basename "$repo_dir")" "$worktree"; then
    layout_error="$CLEANUP_LAYOUT_ERROR"
    _rollback_remove_path "$transaction" "cross-filesystem worker evidence restore" \
      cross-filesystem-rollback-cleanup
    _die "$layout_error"
  fi
  for evidence in "$worktree"/.sergeant-*; do
    [[ -e "$evidence" || -L "$evidence" ]] || continue
    name="$(basename "$evidence")"
    if ! mv "$evidence" "$backup_dir/$name"; then
      for name in ${backed_up[@]+"${backed_up[@]}"}; do
        _move_worker_evidence_entry "$backup_dir/$name" "$worktree/$name" || \
          _die "CRITICAL: worker evidence restore backup failed and rollback failed: $worktree/$name; inspect preserved transaction: $transaction"
      done
      _rollback_remove_path "$transaction" "worker evidence restore backup" \
        restore-rollback-cleanup
      return 1
    fi
    backed_up[${#backed_up[@]}]="$name"
  done
  if ! _same_filesystem_pair "$repo_dir" "$(basename "$repo_dir")" "$worktree"; then
    layout_error="$CLEANUP_LAYOUT_ERROR"
    _restore_cross_filesystem_backup "$worktree" "$backup_dir" || \
      _die "CRITICAL: cross-filesystem restore rollback failed; inspect preserved transaction: $transaction"
    _rollback_remove_path "$transaction" "cross-filesystem worker evidence restore" \
      cross-filesystem-rollback-cleanup
    _die "$layout_error"
  fi
  for evidence in "$staging_dir"/.sergeant-*; do
    [[ -e "$evidence" || -L "$evidence" ]] || continue
    name="$(basename "$evidence")"
    ((publish_count += 1))
    if ! _cleanup_fail_point "restore-publish-$publish_count" || \
      ! _move_worker_evidence_entry "$evidence" "$worktree/$name"; then
      for name in ${published[@]+"${published[@]}"}; do
        _rollback_remove_path "$worktree/$name" \
          "published worker evidence restore" restore-rollback-cleanup
      done
      for name in ${backed_up[@]+"${backed_up[@]}"}; do
        _move_worker_evidence_entry "$backup_dir/$name" "$worktree/$name" || \
          _die "CRITICAL: worker evidence restore publication failed and rollback failed: $worktree/$name; inspect preserved transaction: $transaction"
      done
      _rollback_remove_path "$transaction" "worker evidence restore publication" \
        restore-rollback-cleanup
      return 1
    fi
    published[${#published[@]}]="$name"
  done
  _rollback_remove_path "$transaction" "completed worker evidence restore" \
    restore-cleanup
}

_restore_removed_worker_evidence() {
  local backup_dir="$2" evidence layout_error name repo_dir worktree="$1"
  local -a restored=()

  [[ -d "$worktree" && -d "$backup_dir" ]] || return 0
  repo_dir="$(dirname "$backup_dir")"
  if ! _same_filesystem_pair "$repo_dir" "$(basename "$repo_dir")" "$worktree"; then
    layout_error="$CLEANUP_LAYOUT_ERROR"
    _restore_cross_filesystem_backup "$worktree" "$backup_dir" || \
      _die "CRITICAL: cross-filesystem cleanup rollback failed; inspect preserved backup: $backup_dir"
    _die "$layout_error"
  fi
  for evidence in "$backup_dir"/.sergeant-*; do
    [[ -e "$evidence" || -L "$evidence" ]] || continue
    name="$(basename "$evidence")"
    if ! _move_worker_evidence_entry "$evidence" "$worktree/$name"; then
      for name in ${restored[@]+"${restored[@]}"}; do
        _move_worker_evidence_entry "$worktree/$name" "$backup_dir/$name" || \
          _die "Failed to roll back worker evidence recovery: $worktree/$name"
      done
      return 1
    fi
    restored[${#restored[@]}]="$name"
  done
  rmdir "$backup_dir"
}

_restore_cross_filesystem_backup() {
  local backup_dir="$2" evidence name published_path temp worktree="$1"
  local -a published=() temps=()

  [[ -d "$worktree" && -d "$backup_dir" ]] || return 1
  for evidence in "$backup_dir"/.sergeant-*; do
    [[ -e "$evidence" || -L "$evidence" ]] || continue
    name="$(basename "$evidence")"
    published_path="$worktree/$name"
    temp="$worktree/$name.restore.$$"
    [[ ! -e "$published_path" && ! -L "$published_path" && \
      ! -e "$temp" && ! -L "$temp" ]] || return 1
    temps[${#temps[@]}]="$temp"
    # The absence check above can go stale during a recursive copy of a whole
    # ledger tree, so publication additionally refuses the destination shapes mv
    # cannot replace safely.  That narrows the rename race without closing it; the
    # remaining window is tracked with the shared worktree lock work.
    if ! cp -pR "$evidence" "$temp" || \
      ! _move_worker_evidence_entry "$temp" "$published_path"; then
      for temp in ${temps[@]+"${temps[@]}"}; do
        rm -rf "$temp" || return 1
      done
      for published_path in ${published[@]+"${published[@]}"}; do
        rm -rf "$published_path" || return 1
      done
      return 1
    fi
    published[${#published[@]}]="$published_path"
  done
  rm -rf "$backup_dir" || return 1
  [[ ! -e "$backup_dir" && ! -L "$backup_dir" ]]
}

_rollback_cross_filesystem_initial() {
  local marker="$2" marker_preexisting="$3" repo_dir="$1"

  _rollback_remove_path "$repo_dir/terminal-evidence" \
    "cross-filesystem terminal evidence" cross-filesystem-rollback-cleanup
  _rollback_remove_path "$repo_dir/cleanup-owner" \
    "cross-filesystem cleanup owner" cross-filesystem-rollback-cleanup
  _rollback_remove_path "$repo_dir/cleanup-phase" \
    "cross-filesystem cleanup phase" cross-filesystem-rollback-cleanup
  if [[ "$marker_preexisting" != true ]]; then
    _rollback_remove_path "$marker" \
      "cross-filesystem repository marker" cross-filesystem-rollback-cleanup
  fi
}

_require_remover_same_filesystem() {
  local backup="$4" layout_error marker="$6" marker_preexisting="$7" \
    repo_dir="$1" repo_name="$2" retrying="$5" worktree="$3"

  _same_filesystem_pair "$repo_dir" "$repo_name" "$worktree" && return 0
  layout_error="$CLEANUP_LAYOUT_ERROR"
  _restore_cross_filesystem_backup "$worktree" "$backup" || \
    _die "CRITICAL: cross-filesystem cleanup rollback failed; inspect preserved backup: $backup"
  [[ "$retrying" == true ]] || \
    _rollback_cross_filesystem_initial "$repo_dir" "$marker" "$marker_preexisting"
  _die "$layout_error"
}

_record_cleanup_phase() {
  local actual expected phase="$2" repo_dir="$1" temp worktree="$3"
  shift 3

  _require_same_filesystem_pair "$repo_dir" "$(basename "$repo_dir")" "$worktree"
  temp="$repo_dir/cleanup-phase.tmp.$$"
  [[ ! -e "$temp" && ! -L "$temp" ]] || return 1
  expected="$({
    printf '%s\n%s\n' "$phase" "$worktree"
    [[ $# -eq 0 ]] || printf '%s\n' "$@"
  } | git hash-object --stdin)" || return 1
  if ! _cleanup_fail_point "phase-write-$phase" || ! {
    printf '%s\n%s\n' "$phase" "$worktree"
    [[ $# -eq 0 ]] || printf '%s\n' "$@"
  } > "$temp"; then
    _rollback_remove_path "$temp" "$phase cleanup-phase write" \
      "phase-rollback-$phase"
    return 1
  fi
  [[ -f "$temp" && ! -L "$temp" ]] || {
    _rollback_remove_path "$temp" "$phase cleanup-phase validation" \
      "phase-rollback-$phase"
    return 1
  }
  # --no-filters because $expected is an unfiltered --stdin hash of the same
  # bytes: without it, fleet state living inside a repository with a clean or eol
  # attribute makes the two disagree and this write verification never succeeds.
  actual="$(git hash-object --no-filters "$temp")" || {
    _rollback_remove_path "$temp" "$phase cleanup-phase validation" \
      "phase-rollback-$phase"
    return 1
  }
  if [[ "$actual" != "$expected" ]] || \
    ! _cleanup_fail_point "phase-publish-$phase" || \
    ! mv "$temp" "$repo_dir/cleanup-phase"; then
    _rollback_remove_path "$temp" "$phase cleanup-phase publication" \
      "phase-rollback-$phase"
    return 1
  fi
}

_treehouse_returning_phase() {
  printf 'returning\n%s\ntreehouse\n%s\n%s\n%s\nverified\n' \
    "$1" "$2" "$3" "$4"
}

_treehouse_returned_phase() {
  printf 'returned\n%s\ntreehouse\n%s\n%s\n%s\n' "$1" "$2" "$3" "$4"
}

_treehouse_lease_state() {
  local holder="$4" lease_id="$3" repo_root="$1" status_dir state_file worktree="$2"
  status_dir="$(mktemp -d)" || return 1
  state_file="$status_dir/state.json"

  "$SCRIPT_DIR/_sgt-treehouse-io.py" status "$repo_root" \
    "$status_dir/status.raw" "$status_dir/receipt.json" \
    "$state_file" "$worktree" "$lease_id" "$holder" || {
      rm -rf "$status_dir"
      return 1
    }
  TREEHOUSE_LEASE_STATE="$(python3 -c '
import json, sys
value = json.load(open(sys.argv[1], encoding="utf-8"))
state = value.get("state") if isinstance(value, dict) else None
if state not in ("matched", "different"):
    raise SystemExit(1)
print(state)
' "$state_file")" || {
    rm -rf "$status_dir"
    return 1
  }
  rm -rf "$status_dir"
  [[ "$TREEHOUSE_LEASE_STATE" == matched || \
    "$TREEHOUSE_LEASE_STATE" == different ]]
}

_repo_git_dir() {
  local dir kind="$2" repo_root="$1" top

  [[ -d "$repo_root" && ! -L "$repo_root" && ! -L "$repo_root/.git" ]] || return 1
  top="$(git -C "$repo_root" rev-parse --path-format=absolute --show-toplevel 2>/dev/null)" || \
    return 1
  [[ -n "$top" && "$top" != *$'\n'* && "$top" == "$repo_root" ]] || return 1
  case "$kind" in
    worktree)
      dir="$(git -C "$repo_root" rev-parse --path-format=absolute --git-dir 2>/dev/null)" || \
        return 1
      ;;
    common)
      dir="$(git -C "$repo_root" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || \
        return 1
      ;;
    *) return 1 ;;
  esac
  [[ -n "$dir" && "$dir" != *$'\n'* && -d "$dir" && ! -L "$dir" ]] || return 1
  [[ "$dir" == "$(cd "$dir" && pwd -P)" ]] || return 1
  printf '%s\n' "$dir"
}

_repo_common_instance() {
  local common_dir identity repo_root="$1"

  common_dir="$(_repo_git_dir "$repo_root" common)" || return 1
  identity="$(stat -c '%d:%i' "$common_dir" 2>/dev/null || \
    stat -f '%d:%i' "$common_dir" 2>/dev/null)" || return 1
  printf '%s\n%s\n' "$common_dir" "$identity"
}

_require_worktree_owner() {
  local configured_instance worktree_instance

  configured_instance="$(_repo_common_instance "$1")" || return 1
  worktree_instance="$(_repo_common_instance "$2")" || return 1
  [[ "$configured_instance" == "$worktree_instance" ]]
}

_repo_instance_id() {
  local git_common_dir="$1" marker token tmp

  marker="$git_common_dir/sergeant-instance"
  if [[ ! -e "$marker" && "${2:-}" == "create" ]]; then
    token="$(printf '%s\n%s\n%s\n%s\n' "$git_common_dir" "$$" "$RANDOM" "$(date +%s)" | \
      git hash-object --stdin)" || return 1
    tmp="$(mktemp "$git_common_dir/.sergeant-instance.XXXXXX")" || return 1
    if ! printf '%s\n' "$token" > "$tmp"; then
      _rollback_remove_path "$tmp" "repository instance marker staging" \
        instance-rollback-cleanup
      return 1
    fi
    if ! ln "$tmp" "$marker" 2>/dev/null && [[ ! -f "$marker" ]]; then
      _rollback_remove_path "$tmp" "repository instance marker staging" \
        instance-rollback-cleanup
      return 1
    fi
    _rollback_remove_path "$tmp" "repository instance marker staging" \
      instance-cleanup
  fi
  [[ -f "$marker" && ! -L "$marker" ]] || return 1
  token="$(cat "$marker")" || return 1
  [[ -n "$token" && "$token" != *$'\n'* ]] || return 1
  printf '%s\n' "$token"
}

_repo_metadata_identity() {
  local git_common_dir="$1"

  (
    cd "$git_common_dir" || exit 1
    {
      find . -path ./worktrees -prune -o -path ./objects -prune -o \
        -path ./logs -prune -o -path ./index -prune -o \
        \( -type f -o -type l \) -print
      [[ ! -d objects/info ]] || find objects/info \( -type f -o -type l \) -print
    } | LC_ALL=C sort | while IFS= read -r path; do
      if [[ -L "$path" ]]; then
        printf 'link\n%s\n%s\n' "$path" "$(readlink "$path")"
      else
        printf 'file\n%s\n' "$path"
        git hash-object "$path" || exit 1
      fi
    done
  ) | git hash-object --stdin
}

_repo_per_worktree_metadata_identity() {
  local git_dir="$1" index_path mode="${3:-}" raw_index repo_root="$2" semantic_index

  index_path="$git_dir/index"
  if [[ "$mode" == "exclude-evidence" ]]; then
    [[ ! -L "$index_path" ]] || return 1
    if [[ -e "$index_path" ]]; then
      [[ -f "$index_path" && -r "$index_path" ]] || return 1
      raw_index="$(git hash-object "$index_path")" || return 1
    else
      raw_index="absent"
    fi
  else
    raw_index="not-bound"
  fi
  semantic_index="$(git -C "$repo_root" ls-files --stage -z | \
    git hash-object --stdin)" || return 1

  (
    cd "$git_dir" || exit 1
    printf 'raw-index\n%s\nsemantic-index\n%s\n' "$raw_index" "$semantic_index"
    find . -path ./index -prune -o -path ./logs -prune -o -path ./objects -prune -o \
      -path ./refs -prune -o -path ./worktrees -prune -o \
      \( -type f -o -type l \) -print | LC_ALL=C sort | \
      while IFS= read -r path; do
        if [[ -L "$path" ]]; then
          printf 'link\n%s\n%s\n' "$path" "$(readlink "$path")"
        else
          printf 'file\n%s\n' "$path"
          git hash-object "$path" || exit 1
        fi
      done
  ) | git hash-object --stdin
}

_repo_worktree_identity() {
  local mode="${2:-}" path repo_root="$1"

  (
    if [[ "$mode" == "exclude-evidence" ]]; then
      git -C "$repo_root" diff --no-ext-diff --binary HEAD -- \
        . ':(exclude).sergeant-*' || exit 1
    else
      git -C "$repo_root" diff --no-ext-diff --binary HEAD -- || exit 1
    fi
    while IFS= read -r -d '' path; do
      [[ "$mode" != "exclude-evidence" || "$path" != .sergeant-* ]] || continue
      printf 'untracked\n%s\n' "$path"
      git -C "$repo_root" hash-object "$path" || exit 1
    done < <(git -C "$repo_root" ls-files --others --exclude-standard -z)
  ) | git hash-object --stdin
}

# Emits the record stream for one evidence entry.  Callers must have byte-order
# collation (LC_ALL=C) in effect: the glob expansions below are what order the
# stream, so the identity would otherwise depend on the ambient locale.
#
# The optional second argument is the name the entry is recorded under, defaulting
# to its path.  _worker_evidence_identity relies on that default because its
# stream is persisted in cleanup-owner and replayed across retries, so its shape
# cannot change; _named_tree_digest passes relative labels so its digests survive
# the state being replayed from a different directory.
_worker_evidence_records() {
  local child entry="$1" label="${2:-$1}"

  # Fail closed on symlinks, on anything that is neither a regular file nor a
  # directory, and on names that could forge the record stream.
  [[ ! -L "$entry" && "$label" != *$'\n'* ]] || return 1
  if [[ -f "$entry" ]]; then
    # --no-filters keeps the record a function of raw bytes: the live copy is
    # hashed inside the owning repository, where gitattributes text/eol and clean
    # filters would otherwise apply, while the staged copy is hashed in fleet
    # state outside any repository.  Entry modes are deliberately not bound.
    printf 'file\n%s\n' "$label"
    git hash-object --no-filters "$entry" || return 1
    return 0
  fi
  # An unreadable directory would expand to no children and hash identically to an
  # empty one, so refuse it instead: the `dir` record with no children has to mean
  # a directory that really is empty.
  [[ -d "$entry" && -r "$entry" && -x "$entry" ]] || return 1
  # Normal worker execution publishes notification ledgers and review gates as
  # directories (.sergeant-notification-acks/, .sergeant-review-gates/, ...).
  # Hash them recursively so identity stays stable and tamper-evident.
  printf 'dir\n%s\n' "$label"
  for child in "$entry"/* "$entry"/.[!.]* "$entry"/..?*; do
    [[ -e "$child" || -L "$child" ]] || continue
    _worker_evidence_records "$child" "$label/${child##*/}" || return 1
  done
  printf 'end-dir\n%s\n' "$label"
}

_worker_evidence_identity() {
  local evidence evidence_dir="$1"

  (
    cd "$evidence_dir" || exit 1
    # Byte-order collation keeps glob expansion, and therefore the record
    # stream, deterministic regardless of the caller's locale.  It stays local to
    # this subshell on purpose.
    # shellcheck disable=SC2031
    export LC_ALL=C
    for evidence in .sergeant-*; do
      [[ -e "$evidence" || -L "$evidence" ]] || continue
      _worker_evidence_records "$evidence" || exit 1
    done
  ) | git hash-object --stdin
}

_worker_evidence_present() {
  local evidence

  for evidence in "$1"/.sergeant-*; do
    [[ -e "$evidence" || -L "$evidence" ]] && return 0
  done
  return 1
}

_repo_identity() {
  # Stable identity fields only.  The original implementation hashed all refs
  # (for-each-ref) and the git common-dir metadata tree (which includes the
  # refs/ subtree and FETCH_HEAD).  Both change on every git fetch, causing
  # legitimate retries to be rejected after any routine network operation.
  #
  # Two identity profiles:
  #
  #   Owner repo (mode != "exclude-evidence"):
  #     instance + remote URL + root commits.  Detects moves, aliases, repo
  #     replacement, and cross-project substitution without including any field
  #     that fetch updates.
  #
  #   Worker worktree (mode == "exclude-evidence"):
  #     Adds per-worktree git dir metadata (HEAD, index, config.worktree — all
  #     in .git/worktrees/NAME, unaffected by fetch), worktree HEAD, and the
  #     clean-worktree diff.  Detects HEAD drift, metadata mutations, and
  #     content changes while remaining stable across git fetch.  Tag additions
  #     (refs in the common git dir) are intentionally not included.
  local git_common_dir git_dir head instance mode per_worktree_metadata remote roots state \
    repo_root="$1"
  mode="${2:-}"

  git_dir="$(_repo_git_dir "$repo_root" worktree)" || return 1
  git_common_dir="$(_repo_git_dir "$repo_root" common)" || return 1
  instance="$(stat -c '%d:%i' "$git_dir" 2>/dev/null || \
    stat -f '%d:%i' "$git_dir" 2>/dev/null)" || return 1
  instance="$instance:$(_repo_instance_id "$git_common_dir" "$mode")" || return 1
  remote="$(git -C "$repo_root" config --get remote.origin.url 2>/dev/null || true)"
  roots="$(git -C "$repo_root" rev-list --max-parents=0 --all 2>/dev/null | sort)"
  [[ -n "$roots" ]] || return 1

  if [[ "$mode" == "exclude-evidence" ]]; then
    per_worktree_metadata="$(_repo_per_worktree_metadata_identity \
      "$git_dir" "$repo_root" "$mode")" || return 1
    head="$(cat "$git_dir/HEAD" 2>/dev/null)" || return 1
    state="$(_repo_worktree_identity "$repo_root" "$mode")" || return 1
    printf '%s\n%s\n%s\n%s\n%s\n%s\n' \
      "$instance" "$per_worktree_metadata" "$head" "$remote" "$roots" "$state" | \
      git hash-object --stdin
  else
    printf '%s\n%s\n%s\n' "$instance" "$remote" "$roots" | \
      git hash-object --stdin
  fi
}

_repo_owner_identity() {
  local common_dir common_instance repo_root="$1"

  common_instance="$(_repo_common_instance "$repo_root")" || return 1
  common_dir="${common_instance%%$'\n'*}"
  printf '%s\n%s\n' "$common_instance" \
    "$(_repo_instance_id "$common_dir" "${2:-}")" | \
    git hash-object --stdin
}

_worker_checkout_identity() {
  local config_worktree git_dir git_dir_instance head head_commit index_path raw_index \
    repo_root="$1" semantic_index worktree_state

  git_dir="$(_repo_git_dir "$repo_root" worktree)" || return 1
  git_dir_instance="$(stat -c '%d:%i' "$git_dir" 2>/dev/null || \
    stat -f '%d:%i' "$git_dir" 2>/dev/null)" || return 1
  head="$(cat "$git_dir/HEAD" 2>/dev/null)" || return 1
  head_commit="$(git -C "$repo_root" rev-parse HEAD 2>/dev/null)" || return 1
  index_path="$git_dir/index"
  [[ ! -L "$index_path" ]] || return 1
  if [[ -e "$index_path" ]]; then
    [[ -f "$index_path" && -r "$index_path" ]] || return 1
    raw_index="$(git hash-object "$index_path")" || return 1
  else
    raw_index="absent"
  fi
  semantic_index="$(git -C "$repo_root" ls-files --stage -z | \
    git hash-object --stdin)" || return 1
  index_path="$git_dir/config.worktree"
  [[ ! -L "$index_path" ]] || return 1
  if [[ -e "$index_path" ]]; then
    [[ -f "$index_path" && -r "$index_path" ]] || return 1
    config_worktree="$(git hash-object "$index_path")" || return 1
  else
    config_worktree="absent"
  fi
  worktree_state="$(_repo_worktree_identity "$repo_root" exclude-evidence)" || return 1
  printf '%s\n%s\n%s\n%s\n%s\n%s\n%s\n%s\n' \
    "$git_dir" "$git_dir_instance" "$raw_index" "$semantic_index" \
    "$config_worktree" "$head" "$head_commit" "$worktree_state" | \
    git hash-object --stdin
}

_task_project() {
  local project

  project="$(sed -n 's/^Project:[[:space:]]*//p' "$TASK_DIR/brief.md" 2>/dev/null)" || \
    return 1
  [[ -n "$project" && "$project" != *$'\n'* && "$project" != */* ]] || return 1
  printf '%s\n' "$project"
}

_task_project_or_task_id() {
  _task_project 2>/dev/null || printf '%s\n' "$TASK_ID"
}

_configured_repo_root() {
  local config_file configured_root i project raw_path repo_count repo_name="$1"

  project="$(_task_project_or_task_id)" || return 1
  config_file="$SERGEANT_CONFIG/$project.yaml"
  [[ -f "$config_file" && ! -L "$config_file" ]] || return 1
  _require_yq
  repo_count="$(yq '.repos | length' "$config_file")" || return 1
  raw_path=""
  for ((i=0; i<repo_count; i++)); do
    if [[ "$(yq ".repos[$i].name" "$config_file")" == "$repo_name" ]]; then
      [[ -z "$raw_path" ]] || return 1
      raw_path="$(yq ".repos[$i].path" "$config_file")"
    fi
  done
  [[ -n "$raw_path" && "$raw_path" != "null" ]] || return 1
  configured_root="$(_resolve_path "$raw_path")"
  [[ -d "$configured_root" && ! -L "$configured_root" ]] || return 1
  [[ "$configured_root" == "$(cd "$configured_root" && pwd -P)" ]] || return 1
  printf '%s\n' "$configured_root"
}

_record_cleanup_owner() {
  local evidence_dir="${6:-$1/terminal-evidence}" evidence_identity holder identity lease_id \
    output="${5:-$1/cleanup-owner}" project repo_dir="$1" repo_root="$2" \
    version=4 worker_identity worktree="$3" wt_type="$4"

  identity="$(_repo_owner_identity "$repo_root" create)" || return 1
  worker_identity="$(_worker_checkout_identity "$worktree")" || return 1
  evidence_identity="$(_worker_evidence_identity "$evidence_dir")" || return 1
  project="$(_task_project_or_task_id)" || return 1
  holder=""
  lease_id=""
  if [[ "$wt_type" == "treehouse" ]]; then
    version=5
    holder="$(tr -d '\n' < "$repo_dir/wt_holder" 2>/dev/null || true)"
    lease_id="$(tr -d '\n' < "$repo_dir/wt_lease_id" 2>/dev/null || true)"
    [[ -n "$holder" && -n "$lease_id" && "$lease_id" != *$'\n'* ]] || return 1
  fi
  printf '%s\n%s\n%s\n%s\n%s\n%s\n%s\n%s\n%s\n%s\n' \
    "$version" "$project" "$repo_root" "$worktree" "$wt_type" "$identity" \
    "$worker_identity" "$evidence_identity" "$holder" "$lease_id" \
    > "$output"
}

_rollback_initial_cleanup() {
  local marker="$3" marker_preexisting="$4" repo_dir="$1" transaction="$2"

  _rollback_remove_path "$repo_dir/terminal-evidence" \
    "initial terminal evidence publication" initial-rollback-cleanup
  _rollback_remove_path "$repo_dir/cleanup-owner" \
    "initial cleanup owner publication" initial-rollback-cleanup
  _rollback_remove_path "$repo_dir/cleanup-phase" \
    "initial cleanup phase publication" initial-rollback-cleanup
  _rollback_remove_path "$transaction" "initial cleanup transaction" \
    initial-rollback-cleanup
  if [[ "$marker_preexisting" != true ]]; then
    _rollback_remove_path "$marker" "initial repository instance marker" \
      initial-marker-rollback-cleanup
  fi
}

_publish_initial_cleanup() {
  local evidence_identity="$5" layout_error marker marker_preexisting=false repo_dir="$1" \
    initial_phase=removing repo_root="$2" transaction worktree="$3" wt_type="$4"

  _require_same_filesystem_pair "$repo_dir" "$(basename "$repo_dir")" "$worktree"
  transaction="$repo_dir/cleanup-transaction.tmp.$$"
  marker="$(_repo_git_dir "$repo_root" common)/sergeant-instance" || return 1
  [[ -e "$marker" || -L "$marker" ]] && marker_preexisting=true
  [[ ! -e "$repo_dir/terminal-evidence" && ! -L "$repo_dir/terminal-evidence" && \
    ! -e "$repo_dir/cleanup-owner" && ! -L "$repo_dir/cleanup-owner" && \
    ! -e "$repo_dir/cleanup-phase" && ! -L "$repo_dir/cleanup-phase" && \
    ! -e "$transaction" && ! -L "$transaction" ]] || return 1
  mkdir "$transaction" || return 1

  if ! _stage_worker_evidence "$repo_dir" "$worktree" "$evidence_identity" \
    "$transaction/terminal-evidence"; then
    layout_error="$CLEANUP_LAYOUT_ERROR"
    _rollback_initial_cleanup "$repo_dir" "$transaction" "$marker" \
      "$marker_preexisting"
    [[ -z "$layout_error" ]] || _die "$layout_error"
    return 1
  fi
  [[ "$wt_type" != treehouse ]] || initial_phase=returning
  if ! _cleanup_fail_point stage-evidence || \
    ! _cleanup_fail_point record-owner || \
    ! _record_cleanup_owner "$repo_dir" "$repo_root" "$worktree" "$wt_type" \
      "$transaction/cleanup-owner" "$transaction/terminal-evidence" || \
    ! _cleanup_fail_point record-phase; then
    _rollback_initial_cleanup "$repo_dir" "$transaction" "$marker" \
      "$marker_preexisting"
    return 1
  fi
  if [[ "$wt_type" == treehouse ]]; then
    if ! printf '%s\n%s\n%s\n%s\n%s\n%s\nverified\n' \
      "$initial_phase" "$worktree" "$wt_type" "$repo_root" \
      "$(tr -d '\n' < "$repo_dir/wt_lease_id")" \
      "$(tr -d '\n' < "$repo_dir/wt_holder")" > "$transaction/cleanup-phase"; then
      _rollback_initial_cleanup "$repo_dir" "$transaction" "$marker" \
        "$marker_preexisting"
      return 1
    fi
  elif ! printf '%s\n%s\n%s\n%s\n' \
    "$initial_phase" "$worktree" "$wt_type" "$repo_root" \
    > "$transaction/cleanup-phase"; then
    _rollback_initial_cleanup "$repo_dir" "$transaction" "$marker" \
      "$marker_preexisting"
    return 1
  fi

  if ! _same_filesystem_pair "$repo_dir" "$(basename "$repo_dir")" "$worktree"; then
    layout_error="$CLEANUP_LAYOUT_ERROR"
    _rollback_initial_cleanup "$repo_dir" "$transaction" "$marker" \
      "$marker_preexisting"
    _die "$layout_error"
  fi
  if ! _cleanup_fail_point publish-evidence || \
    ! mv "$transaction/terminal-evidence" "$repo_dir/terminal-evidence" || \
    ! _cleanup_fail_point publish-owner || \
    ! mv "$transaction/cleanup-owner" "$repo_dir/cleanup-owner" || \
    ! _cleanup_fail_point publish-phase || \
    ! mv "$transaction/cleanup-phase" "$repo_dir/cleanup-phase"; then
    _rollback_initial_cleanup "$repo_dir" "$transaction" "$marker" \
      "$marker_preexisting"
    return 1
  fi
  rmdir "$transaction" || \
    _die "CRITICAL: failed to remove completed initial cleanup transaction: $transaction"
}

_validate_retry_owner() {
  local configured_root evidence_identity expected_holder expected_root holder identity \
    lease_id live_evidence_identity owner_evidence_identity owner_holder owner_identity owner_lease_id owner_project owner_version \
    owner_root owner_type owner_worker_identity owner_worktree project repo_dir="$1" \
    repo_name="$2" returned_mode="${6:-}" worker_identity worktree="$3" retry_type="$4" retry_root="$5"

  case "$retry_type" in
    git|treehouse) ;;
    *) _die "Unsupported retry removal type: $repo_name: $retry_type" ;;
  esac
  owner_version="$(sed -n '1p' "$repo_dir/cleanup-owner" 2>/dev/null || true)"
  [[ "$owner_version" == 4 || "$owner_version" == 5 ]] || \
    _die "Retry owner identity is missing: $repo_name"
  owner_project="$(sed -n '2p' "$repo_dir/cleanup-owner")"
  owner_root="$(sed -n '3p' "$repo_dir/cleanup-owner")"
  owner_worktree="$(sed -n '4p' "$repo_dir/cleanup-owner")"
  owner_type="$(sed -n '5p' "$repo_dir/cleanup-owner")"
  owner_identity="$(sed -n '6p' "$repo_dir/cleanup-owner")"
  owner_worker_identity="$(sed -n '7p' "$repo_dir/cleanup-owner")"
  owner_evidence_identity="$(sed -n '8p' "$repo_dir/cleanup-owner")"
  owner_holder="$(sed -n '9p' "$repo_dir/cleanup-owner")"
  owner_lease_id="$(sed -n '10p' "$repo_dir/cleanup-owner")"
  [[ "$retry_root" == "$owner_root" && "$worktree" == "$owner_worktree" && \
    "$retry_type" == "$owner_type" ]] || \
    _die "Retry cleanup state does not match its recorded owner: $repo_name"

  project="$(_task_project_or_task_id)" || _die "Cannot resolve retry owner project: $repo_name"
  [[ "$project" == "$owner_project" ]] || \
    _die "Retry owner project changed: $repo_name"
  if configured_root="$(_configured_repo_root "$repo_name" 2>/dev/null)"; then
    [[ "$configured_root" == "$owner_root" ]] || \
      _die "Configured retry owner changed: $repo_name"
  elif _task_project >/dev/null 2>&1; then
    _die "Cannot resolve configured retry owner: $repo_name"
  fi
  [[ -d "$owner_root" && ! -L "$owner_root" ]] || \
    _die "Retry owner repo is missing or aliased: $owner_root"
  expected_root="$(cd "$owner_root" && pwd -P)"
  [[ "$owner_root" == "$expected_root" ]] || \
    _die "Retry owner repo is symlink-aliased: $owner_root"
  if [[ -d "$worktree" && "$returned_mode" != returned ]]; then
    worker_identity="$(_worker_checkout_identity "$worktree")" || \
      _die "Retry worker worktree identity is unavailable: $repo_name"
    [[ "$worker_identity" == "$owner_worker_identity" ]] || \
      _die "Retry worker worktree identity changed: $repo_name"
  fi
  evidence_identity="$(_worker_evidence_identity "$repo_dir/terminal-evidence")" || \
    _die "Retry persisted terminal evidence is unavailable: $repo_name"
  [[ "$evidence_identity" == "$owner_evidence_identity" ]] || \
    _die "Retry persisted terminal evidence changed: $repo_name"
  if [[ -d "$worktree" && "$returned_mode" != returned ]] && \
    _worker_evidence_present "$worktree"; then
    live_evidence_identity="$(_worker_evidence_identity "$worktree")" || \
      _die "Retry worker lifecycle evidence is unavailable: $repo_name"
    [[ "$live_evidence_identity" == "$owner_evidence_identity" ]] || \
      _die "Retry worker lifecycle evidence changed: $repo_name"
  fi
  identity="$(_repo_owner_identity "$expected_root")" || \
    _die "Cannot identify retry owner repo: $repo_name"
  [[ "$identity" == "$owner_identity" ]] || \
    _die "Retry owner repo identity changed: $repo_name"

  if [[ "$retry_type" == "treehouse" ]]; then
    [[ "$owner_version" == 5 ]] || \
      _die "Retry treehouse lease identity is missing: $repo_name"
    expected_holder="sgt-${TASK_ID}-${repo_name}"
    holder="$(tr -d '\n' < "$repo_dir/wt_holder" 2>/dev/null || true)"
    lease_id="$(tr -d '\n' < "$repo_dir/wt_lease_id" 2>/dev/null || true)"
    [[ "$holder" == "$expected_holder" && "$owner_holder" == "$expected_holder" && \
      -n "$lease_id" && "$lease_id" == "$owner_lease_id" ]] || \
      _die "Retry treehouse lease does not match its owner: $repo_name"
  fi
  VALIDATED_RETRY_ROOT="$owner_root"
}

_canonical_registry_path() {
  local canonical_path canonical_parent leaf parent path="$1"

  [[ "$path" == /* && "$path" != */ ]] || return 1
  if [[ -e "$path" || -L "$path" ]]; then
    [[ -d "$path" && ! -L "$path" ]] || return 1
    canonical_path="$(cd "$path" && pwd -P)" || return 1
    [[ "$canonical_path" == "$path" ]] || return 1
    printf '%s\n' "$canonical_path"
    return 0
  fi
  parent="$(dirname "$path")"
  leaf="$(basename "$path")"
  [[ "$leaf" != "." && "$leaf" != ".." && -d "$parent" ]] || return 1
  canonical_parent="$(cd "$parent" && pwd -P)" || return 1
  if [[ "$canonical_parent" == "/" ]]; then
    printf '/%s\n' "$leaf"
  else
    printf '%s/%s\n' "$canonical_parent" "$leaf"
  fi
}

_git_worktree_removal_proven() {
  local branch_ref canonical field has_bare has_head has_kind has_locked \
    has_prunable head in_record path probe_file record_count target="$2" \
    target_count=0 valid validated_root="$1"
  local -a registered_paths=()

  canonical="$(_canonical_registry_path "$target")" || return 1
  [[ "$canonical" == "$target" ]] || return 1
  probe_file="$(mktemp)" || return 1
  if ! git -C "$validated_root" worktree list --porcelain -z > "$probe_file"; then
    rm -f "$probe_file"
    return 1
  fi

  field=""
  in_record=false
  record_count=0
  valid=true
  has_bare=false
  has_head=false
  has_kind=false
  has_locked=false
  has_prunable=false
  while IFS= read -r -d '' field; do
    if [[ -z "$field" ]]; then
      if [[ "$in_record" != true ]] || \
        ! { { [[ "$has_bare" == true && "$has_head" == false && \
          "$has_kind" == false ]]; } || \
          { [[ "$has_bare" == false && "$has_head" == true && \
            "$has_kind" == true ]]; }; }; then
        valid=false
        break
      fi
      in_record=false
      continue
    fi
    if [[ "$in_record" != true ]]; then
      if [[ "$field" != worktree\ * ]]; then
        valid=false
        break
      fi
      path="${field#worktree }"
      if ! canonical="$(_canonical_registry_path "$path")" || \
        [[ "$canonical" != "$path" ]]; then
        valid=false
        break
      fi
      for seen_path in "${registered_paths[@]}"; do
        if [[ "$seen_path" == "$path" ]]; then
          valid=false
          break
        fi
      done
      [[ "$valid" == true ]] || break
      registered_paths[${#registered_paths[@]}]="$path"
      ((record_count += 1))
      [[ "$path" != "$target" ]] || ((target_count += 1))
      has_bare=false
      has_head=false
      has_kind=false
      has_locked=false
      has_prunable=false
      in_record=true
    else
      case "$field" in
        HEAD\ *)
          head="${field#HEAD }"
          if [[ "$has_head" == true || "$has_bare" == true || \
            "$head" == *[!0-9a-f]* || \
            ( ${#head} -ne 40 && ${#head} -ne 64 ) ]]; then
            valid=false
            break
          fi
          has_head=true
          ;;
        branch\ refs/*)
          branch_ref="${field#branch }"
          if [[ "$has_kind" == true || "$has_bare" == true || \
            "$branch_ref" != refs/heads/* ]] || \
            ! git -C "$validated_root" check-ref-format "$branch_ref" \
              >/dev/null 2>&1; then
            valid=false
            break
          fi
          has_kind=true
          ;;
        detached)
          if [[ "$has_kind" == true || "$has_bare" == true ]]; then
            valid=false
            break
          fi
          has_kind=true
          ;;
        bare)
          if [[ "$has_bare" == true || "$has_head" == true || \
            "$has_kind" == true ]]; then
            valid=false
            break
          fi
          has_bare=true
          ;;
        locked|locked\ *)
          if [[ "$has_locked" == true ]]; then
            valid=false
            break
          fi
          has_locked=true
          ;;
        prunable|prunable\ *)
          if [[ "$has_prunable" == true ]]; then
            valid=false
            break
          fi
          has_prunable=true
          ;;
        *)
          valid=false
          break
          ;;
      esac
    fi
  done < "$probe_file"
  rm -f "$probe_file"

  [[ "$valid" == true && -z "$field" && "$in_record" == false && \
    "$record_count" -gt 0 && "$target_count" -eq 0 ]]
}

_require_completed_removal_proof() {
  local retry_root="$2" retry_type="$1" worktree="$3"

  [[ "$retry_type" != "treehouse" ]] || \
    _die "Cannot prove completed treehouse removal: $worktree"
  _git_worktree_removal_proven "$retry_root" "$worktree" || \
    _die "Cannot prove completed git worktree removal: $worktree"
}

# _validate_retry_validation_checkout — pre-flight ownership check for the
# validation checkout.  Must be called BEFORE any destructive step (pane kills,
# worktree removal) so that a rejected retry leaves the fleet state completely
# unchanged.  Distinct from _validate_retry_owner, which validates the worker
# worktree identity and sets VALIDATED_RETRY_ROOT.
_validate_retry_validation_checkout() {
  local repo_dir="$1" worktree="$2" task_id="$3"
  local repo_name validation_worktree validation_head validation_mode
  local validation_identity validation_git_dir validation_git_identity validation_owner

  repo_name="$(basename "$repo_dir")"
  task_id="$TASK_ID"
  validation_worktree="$(cat "$repo_dir/validation_worktree" 2>/dev/null || true)"
  [[ -n "$validation_worktree" && ( -e "$validation_worktree" || -L "$validation_worktree" ) ]] || \
    return 0

  [[ "$validation_worktree" == "${worktree}-validation-${task_id}" ]] || \
    _die "Validation worktree path is outside the recorded ownership boundary: $validation_worktree"

  validation_head="$(cat "$repo_dir/validation_head" 2>/dev/null || true)"
  validation_mode="$(_validation_checkout_provenance_mode "$repo_dir" "$validation_head")"
  case "$validation_mode" in
    exact)
      validation_identity="$(cat "$repo_dir/validation_worktree_identity" 2>/dev/null || true)"
      validation_git_dir="$(cat "$repo_dir/validation_worktree_git_dir" 2>/dev/null || true)"
      validation_git_identity="$(cat "$repo_dir/validation_worktree_git_identity" 2>/dev/null || true)"
      validation_owner="$(cat "$repo_dir/validation_worktree_owner" 2>/dev/null || true)"
      [[ -n "$validation_identity" && -n "$validation_git_dir" && \
        -n "$validation_git_identity" && -n "$validation_head" && -n "$validation_owner" ]] || \
        _die "Validation checkout ownership provenance is incomplete: $validation_worktree"
      [[ "$validation_owner" == "$task_id/$repo_name/validation-launch|"*"|$validation_head" ]] || \
        _die "Validation checkout owner provenance does not match: $validation_worktree"
      _validation_checkout_matches "$validation_worktree" "$validation_worktree" \
        "$validation_identity" "$validation_git_dir" "$validation_git_identity" \
        "$validation_head" "$validation_owner" || \
        _die "Validation checkout identity does not match recorded ownership: $validation_worktree"
      ;;
    legacy)
      _validation_legacy_checkout_matches "$validation_worktree" "$validation_worktree" \
        "$validation_head" || \
        _die "Validation checkout does not match retry-safe legacy state: $validation_worktree"
      ;;
    *)
      _die "Validation checkout ownership provenance is incomplete: $validation_worktree"
      ;;
  esac
}

_validation_object_identity() {
  [[ -e "$1" && ! -L "$1" ]] || return 1
  stat -c '%d:%i:%w' -- "$1" 2>/dev/null || stat -f '%d:%i:%B' "$1" 2>/dev/null
}

_validation_path_identity() {
  local identity
  identity="$(_validation_object_identity "$1")" || return 1
  if [[ -f "$1" ]]; then
    printf '%s:%s\n' "$identity" "$(cksum < "$1")"
  else
    printf '%s\n' "$identity"
  fi
}

_validation_checkout_matches() {
  local checkout="$1" expected_path="$2" expected_identity="$3" expected_git_dir="$4"
  local expected_git_identity="$5" expected_head="$6" expected_owner="$7"
  local git_dir owner_file
  [[ -d "$checkout" && ! -L "$checkout" ]] || return 1
  [[ "$(_validation_path_identity "$checkout" || true)" == "$expected_identity" ]] || return 1
  git_dir="$(git -C "$checkout" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || \
    return 1
  if [[ -n "$expected_path" ]]; then
    [[ "$git_dir" == "$expected_git_dir" ]] || return 1
  fi
  [[ "$(_validation_path_identity "$git_dir" || true)" == "$expected_git_identity" ]] || return 1
  [[ "$(git -C "$checkout" rev-parse HEAD 2>/dev/null || true)" == "$expected_head" ]] || \
    return 1
  owner_file="$git_dir/sergeant-validation-owner"
  [[ -f "$owner_file" && ! -L "$owner_file" && "$(cat "$owner_file")" == \
    "$expected_owner" ]] || return 1
}

_validation_checkout_provenance_mode() {
  local repo_dir="$1" head="$2" present=0 path
  for path in "$repo_dir/validation_worktree_identity" "$repo_dir/validation_worktree_git_dir" \
    "$repo_dir/validation_worktree_git_identity" "$repo_dir/validation_worktree_owner"; do
    [[ -e "$path" || -L "$path" ]] && present=$((present + 1))
  done
  if [[ "$present" -eq 4 ]]; then
    printf 'exact\n'
  elif [[ "$present" -eq 0 && -n "$head" ]]; then
    printf 'legacy\n'
  else
    printf 'invalid\n'
  fi
}

_validation_legacy_checkout_matches() {
  local checkout="$1" expected_path="$2" expected_head="$3"
  [[ -d "$checkout" && ! -L "$checkout" ]] || return 1
  [[ -z "$expected_path" || "$checkout" == "$expected_path" ]] || return 1
  git -C "$checkout" rev-parse --is-inside-work-tree >/dev/null 2>&1 || return 1
  [[ -n "$expected_head" && "$(git -C "$checkout" rev-parse HEAD 2>/dev/null || true)" == \
    "$expected_head" ]]
}

_require_same_filesystem_layout
_require_terminal_repos
_require_clean_worktrees

echo "=== sgt-cleanup: $TASK_ID ==="
echo ""

# Stop any registered background monitor before removing worktrees.
# _sgt_stop_background_monitor binds the stop to the stored InvocationID so
# cleanup cannot terminate a foreign unit that has assumed the same name.
# Skip when cleaning a single repo (monitor is task-scoped, not repo-scoped).
if [[ -z "$FILTER_REPO" ]]; then
  _sgt_stop_background_monitor "$TASK_DIR"
fi

for repo_dir in "$TASK_DIR"/*/; do
  [[ -d "$repo_dir" ]] || continue
  repo_dir="${repo_dir%/}"
  repo_name="$(basename "$repo_dir")"

  if [[ -n "$FILTER_REPO" && "$repo_name" != "$FILTER_REPO" ]]; then
    continue
  fi

  worktree="$(cat "$repo_dir/worktree" 2>/dev/null || echo "")"
  status="$(cat "$repo_dir/status" 2>/dev/null || echo "unknown")"
  wt_type="$(cat "$repo_dir/wt_type" 2>/dev/null || echo "git")"

  _sgt_worker_process_marker_preflight "$repo_dir" || \
    _die "Cleanup refused: worker process marker evidence is torn: $repo_name"
  _sgt_worker_process_marker_preflight "$repo_dir/validation-process" || \
    _die "Cleanup refused: validation process marker evidence is torn: $repo_name"

  _sgt_response_lock_acquire "$repo_dir"
  trap '_sgt_response_lock_release' EXIT
  _require_response_cleanup_safe "$repo_dir" "$worktree" publish

  echo "--- $repo_name (status: $status, type: $wt_type) ---"

  # Detect an interrupted-removal retry and validate the persisted owner BEFORE
  # any destructive step (pane kill, validation-worktree removal).  A rejected
  # retry has zero side effects on the live pane or fleet evidence.
  _preflight_retry_phase="$(sed -n '1p' "$repo_dir/cleanup-phase" 2>/dev/null || true)"
  _preflight_retry_type="$(sed -n '3p' "$repo_dir/cleanup-phase" 2>/dev/null || true)"
  _preflight_retry_root="$(sed -n '4p' "$repo_dir/cleanup-phase" 2>/dev/null || true)"
  if [[ -n "$worktree" && -d "$worktree" && \
    "$_preflight_retry_phase" == "removing" && "$_preflight_retry_type" == "$wt_type" && \
    -n "$_preflight_retry_root" ]]; then
    _validate_retry_owner "$repo_dir" "$repo_name" "$worktree" \
      "$_preflight_retry_type" "$_preflight_retry_root"
  fi

  # Validate the validation checkout's identity BEFORE any destructive step
  # (pane kills, worktree removal) so that a rejected validation checkout leaves
  # the live worker pane and fleet evidence completely unchanged.
  _validate_retry_validation_checkout "$repo_dir" "$worktree" "$TASK_ID"

  _stop_validation_pane "$repo_dir"
  if [[ -d "$repo_dir/validation-process" ]]; then
    _sgt_retire_worker_marker_holders "$repo_dir/validation-process" \
      "$repo_dir/validation-process/worker_recycle_phase" || \
      _die "Validation worker marker retirement is incomplete: $repo_dir"
  fi
  _stop_local_worker "$repo_dir" "$worktree"

  validation_worktree="$(cat "$repo_dir/validation_worktree" 2>/dev/null || true)"
  if [[ -n "$validation_worktree" && ( -e "$validation_worktree" || -L "$validation_worktree" ) ]]; then
    validation_head="$(cat "$repo_dir/validation_head" 2>/dev/null || true)"
    validation_mode="$(_validation_checkout_provenance_mode "$repo_dir" "$validation_head")"
    case "$validation_mode" in
      exact)
        validation_identity="$(cat "$repo_dir/validation_worktree_identity" 2>/dev/null || true)"
        validation_git_dir="$(cat "$repo_dir/validation_worktree_git_dir" 2>/dev/null || true)"
        validation_git_identity="$(cat "$repo_dir/validation_worktree_git_identity" 2>/dev/null || true)"
        validation_owner="$(cat "$repo_dir/validation_worktree_owner" 2>/dev/null || true)"
        ;;
      legacy)
        ;;
      *)
        _die "Validation checkout ownership provenance is incomplete: $validation_worktree"
        ;;
    esac
    validation_cwd_pids="$(_worktree_cwd_pids "$validation_worktree")"
    [[ -z "$validation_cwd_pids" ]] || \
      _die "Processes still have $validation_worktree as their current directory: $(tr '\n' ' ' <<< "$validation_cwd_pids")"
    validation_quarantine="${validation_worktree}.cleanup.$$.$RANDOM"
    [[ ! -e "$validation_quarantine" && ! -L "$validation_quarantine" ]] || \
      _die "Validation cleanup quarantine already exists: $validation_quarantine"
    mv "$validation_worktree" "$validation_quarantine" || \
      _die "Failed to stage validation checkout cleanup: $validation_worktree"
    case "$validation_mode" in
      exact)
        if ! _validation_checkout_matches "$validation_quarantine" "" "$validation_identity" \
          "$validation_git_dir" "$validation_git_identity" "$validation_head" "$validation_owner"; then
          if [[ ! -e "$validation_worktree" && ! -L "$validation_worktree" ]]; then
            mv "$validation_quarantine" "$validation_worktree" 2>/dev/null || true
          fi
          _die "Validation checkout changed during cleanup and was preserved: $validation_worktree"
        fi
        ;;
      legacy)
        if ! _validation_legacy_checkout_matches "$validation_quarantine" "" \
          "$validation_head"; then
          if [[ ! -e "$validation_worktree" && ! -L "$validation_worktree" ]]; then
            mv "$validation_quarantine" "$validation_worktree" 2>/dev/null || true
          fi
          _die "Validation checkout changed during cleanup and was preserved: $validation_worktree"
        fi
        ;;
    esac
    rm -rf "$validation_quarantine"
  fi

  # _stop_local_worker already verified no process has $worktree as cwd at the
  # end of its termination sequence; re-scanning here would be a duplicate lsof
  # call on the same path (issue #23).  The validation worktree cleanup above
  # only touches $validation_worktree, so no new process can have acquired
  # $worktree as its cwd between _stop_local_worker's check and this point.

  if [[ -z "$worktree" ]]; then
    echo "  no worktree recorded — skipping"
    echo ""
    _sgt_response_lock_release
    trap - EXIT
    continue
  fi

  if [[ ! -d "$worktree" ]]; then
    [[ ! -f "$repo_dir/validation_pane" && ! -L "$repo_dir/validation_pane" ]] || \
      _die "Validation pane must be stopped before absent-worktree cleanup: $repo_name"
    # Finding 1: a live pane after _stop_local_worker means the kill was skipped
    # (missing or mismatched pane_identity).  Fail closed rather than proceeding
    # with an unverified active worker.
    _abs_recorded_pane="$(cat "$repo_dir/pane" 2>/dev/null || true)"
    if [[ -n "$_abs_recorded_pane" ]]; then
      _abs_pane_info="$(_sgt_pane_identity "$_abs_recorded_pane" 2>/dev/null || true)"
      [[ -z "$_abs_pane_info" || "${_abs_pane_info%%|*}" != "0" ]] || \
        _die "Worker pane still active after stop; cannot proceed without verified ownership: $repo_name"
    fi
    retry_phase="$(sed -n '1p' "$repo_dir/cleanup-phase" 2>/dev/null || true)"
    retry_type="$(sed -n '3p' "$repo_dir/cleanup-phase" 2>/dev/null || true)"
    retry_root="$(sed -n '4p' "$repo_dir/cleanup-phase" 2>/dev/null || true)"
    if [[ -n "$retry_root" ]]; then
      if [[ "$retry_type" == treehouse && "$retry_phase" == returned ]]; then
        _validate_retry_owner "$repo_dir" "$repo_name" "$worktree" \
          "$retry_type" "$retry_root" returned
        echo "  treehouse lease return already completed: $worktree"
        echo ""
        continue
      fi
      _validate_retry_owner "$repo_dir" "$repo_name" "$worktree" \
        "$retry_type" "$retry_root"
      retry_root="$VALIDATED_RETRY_ROOT"
      if [[ "$retry_phase" == "removed" ]]; then
        if [[ "$retry_type" == treehouse ]]; then
          _treehouse_removed_phase_proven "$repo_dir" || \
            _die "Cannot prove completed treehouse removal: $worktree"
        fi
        [[ "$retry_type" == treehouse ]] || \
          _require_completed_removal_proof "$retry_type" "$retry_root" "$worktree"
        _record_cleanup_phase "$repo_dir" reconciled-absent "$worktree" || \
          _die "Failed to reconcile completed worktree removal: $repo_name"
        echo "  worktree removal already completed: $worktree"
        echo ""
        continue
      fi
      if [[ "$retry_type" == "treehouse" ]]; then
        _die "Cannot prove interrupted treehouse removal completed: $worktree"
      fi
      _git_worktree_removal_proven "$retry_root" "$worktree" || \
        _die "Cannot prove interrupted git worktree removal completed: $worktree"
      _record_cleanup_phase "$repo_dir" reconciled-absent "$worktree" || \
        _die "Failed to publish reconciled cleanup phase: $repo_name"
      echo "  worktree removal already completed: $worktree"
      echo ""
      continue
    fi
    echo "  worktree not found or already removed: $worktree"
    echo ""
    _sgt_response_lock_release
    trap - EXIT
    continue
  fi

  retry_phase="$(sed -n '1p' "$repo_dir/cleanup-phase" 2>/dev/null || true)"
  if [[ "$wt_type" == treehouse && "$retry_phase" == returned ]]; then
    retry_root="$(sed -n '4p' "$repo_dir/cleanup-phase" 2>/dev/null || true)"
    _validate_retry_owner "$repo_dir" "$repo_name" "$worktree" \
      treehouse "$retry_root" returned
    echo "  treehouse lease return already completed: $worktree"
    echo ""
    _sgt_response_lock_release
    trap - EXIT
    continue
  fi
  retrying_removal=false
  initial_marker=""
  initial_marker_preexisting=false
  if [[ "$retry_phase" == "removing" || \
    ( "$wt_type" == treehouse && "$retry_phase" == returning ) ]]; then
    retry_type="$(sed -n '3p' "$repo_dir/cleanup-phase" 2>/dev/null || true)"
    retry_root="$(sed -n '4p' "$repo_dir/cleanup-phase" 2>/dev/null || true)"
    [[ "$retry_type" == "$wt_type" ]] || \
      _die "Retry worktree type changed: $repo_name"
    if [[ "$wt_type" == treehouse && \
      "$(sed -n '7p' "$repo_dir/cleanup-phase" 2>/dev/null || true)" == verified ]]; then
      _validate_retry_owner "$repo_dir" "$repo_name" "$worktree" \
        "$retry_type" "$retry_root" returned
    else
      _validate_retry_owner "$repo_dir" "$repo_name" "$worktree" \
        "$retry_type" "$retry_root"
    fi
    retry_root="$VALIDATED_RETRY_ROOT"
    expected_evidence_identity="$(sed -n '8p' "$repo_dir/cleanup-owner")"
    retrying_removal=true
  else
    # First-pass cleanup requires the current project YAML; no path-derived fallback.
    # Fail closed when project config is missing or the configured repo was renamed.
    retry_root="$(_configured_repo_root "$repo_name" 2>/dev/null)" || \
      _die "Cannot resolve configured cleanup owner: $repo_name"
    _require_worktree_owner "$retry_root" "$worktree" || \
      _die "Worktree does not belong to configured cleanup owner: $repo_name"
  fi
  if [[ "$wt_type" == "treehouse" ]]; then
    treehouse_holder="$(tr -d '\n' < "$repo_dir/wt_holder" 2>/dev/null || true)"
    treehouse_lease_id="$(
      if [[ -f "$repo_dir/wt_lease_id" && ! -L "$repo_dir/wt_lease_id" ]]; then
        tr -d '\n' < "$repo_dir/wt_lease_id"
      fi
    )"
    [[ "$treehouse_holder" == "sgt-${TASK_ID}-${repo_name}" ]] || \
      _die "Treehouse lease identity does not match its fleet owner: $repo_name"
    if [[ -z "$treehouse_lease_id" ]]; then
      legacy_record="$repo_dir/treehouse-legacy-lease.json"
      [[ ! -L "$repo_dir/wt_lease_id" && ! -L "$legacy_record" ]] || \
        _die "Unsafe legacy Treehouse lease migration state: $repo_name"
      if ! "$SCRIPT_DIR/_sgt-treehouse-io.py" discover-lease \
        "$retry_root" "$repo_dir/treehouse-legacy-lease.raw" \
        "$repo_dir/treehouse-legacy-lease-receipt.json" "$legacy_record" \
        "$worktree" "$treehouse_holder"; then
        _die "Cannot discover legacy Treehouse lease identity: $repo_name"
      fi
      _cleanup_fail_point legacy-lease-discovered || \
        _die "Legacy Treehouse lease discovery interrupted: $repo_name"
      treehouse_lease_id="$(python3 -c \
        'import json,sys; print(json.load(open(sys.argv[1]))["lease_id"])' \
        "$legacy_record")"
      lease_temp="$repo_dir/wt_lease_id.tmp.$$"
      [[ ! -e "$repo_dir/wt_lease_id" && ! -L "$repo_dir/wt_lease_id" && \
        ! -e "$lease_temp" && ! -L "$lease_temp" ]] || \
        _die "Unsafe legacy Treehouse lease migration state: $repo_name"
      printf '%s\n' "$treehouse_lease_id" > "$lease_temp"
      mv "$lease_temp" "$repo_dir/wt_lease_id"
    fi
    [[ -n "$treehouse_lease_id" ]] || \
      _die "Treehouse lease identity does not match its fleet owner: $repo_name"
    git_file="$worktree/.git"
    [[ -f "$git_file" ]] || \
      _die "Cannot identify treehouse lease; fleet state preserved: $worktree"
    git_dir_line="$(cat "$git_file")"
    git_dir="${git_dir_line#gitdir: }"
    main_git="$(dirname "$(dirname "$git_dir")")"
    [[ "$(dirname "$main_git")" == "$retry_root" ]] || \
      _die "Treehouse lease does not match configured cleanup owner: $repo_name"
  fi

  if [[ "$retrying_removal" != true ]]; then
    if [[ "$wt_type" == treehouse ]]; then
      if ! _same_filesystem_pair "$repo_dir" "$repo_name" "$worktree"; then
        _die "$CLEANUP_LAYOUT_ERROR"
      fi
      if ! _treehouse_lease_state "$retry_root" "$worktree" \
        "$treehouse_lease_id" "$treehouse_holder" "$repo_dir"; then
        _die "Cannot verify current treehouse lease; fleet state preserved: $worktree"
      fi
      [[ "$TREEHOUSE_LEASE_STATE" == matched ]] || \
        _die "Treehouse lease identity does not match captured acquisition: $worktree"
    fi
    initial_marker="$(_repo_git_dir "$retry_root" common)/sergeant-instance" || \
      _die "Cannot identify cleanup owner marker: $repo_name"
    [[ ! -e "$initial_marker" && ! -L "$initial_marker" ]] || \
      initial_marker_preexisting=true
    worker_evidence_identity="$(_worker_evidence_identity "$worktree")" || \
      _die "Cannot bind worker lifecycle evidence before cleanup: $repo_name"
    if ! _publish_initial_cleanup "$repo_dir" "$retry_root" "$worktree" "$wt_type" \
      "$worker_evidence_identity"; then
      _die "Failed to publish cleanup state before worktree removal: $TASK_ID/$repo_name"
    fi
    expected_evidence_identity="$(sed -n '8p' "$repo_dir/cleanup-owner")"
  fi
  treehouse_returned=false
  if [[ "$wt_type" == treehouse ]]; then
    treehouse_owner_validation_mode=""
    if [[ "$retrying_removal" == true && \
      "$(sed -n '7p' "$repo_dir/cleanup-phase" 2>/dev/null || true)" == verified ]]; then
      treehouse_owner_validation_mode=returned
    fi
    _validate_retry_owner "$repo_dir" "$repo_name" "$worktree" \
      "$wt_type" "$retry_root" "$treehouse_owner_validation_mode"
  fi
  LIVE_EVIDENCE_BACKUP=""
  if ! _same_filesystem_pair "$repo_dir" "$repo_name" "$worktree"; then
    layout_error="$CLEANUP_LAYOUT_ERROR"
    [[ "$retrying_removal" == true ]] || \
      _rollback_cross_filesystem_initial "$repo_dir" "$initial_marker" \
        "$initial_marker_preexisting"
    _die "$layout_error"
  fi
  skip_worker_evidence_removal=false
  if [[ "$wt_type" == treehouse && "$retrying_removal" == true && \
    "$(sed -n '7p' "$repo_dir/cleanup-phase" 2>/dev/null || true)" == verified ]] && \
    ! _worker_evidence_present "$worktree"; then
    skip_worker_evidence_removal=true
  fi
  if [[ "$skip_worker_evidence_removal" != true ]] && \
    ! _remove_worker_evidence "$repo_dir" "$worktree" \
      "$expected_evidence_identity"; then
    if [[ -n "$CLEANUP_LAYOUT_ERROR" ]]; then
      layout_error="$CLEANUP_LAYOUT_ERROR"
      [[ "$retrying_removal" == true ]] || \
        _rollback_cross_filesystem_initial "$repo_dir" "$initial_marker" \
          "$initial_marker_preexisting"
      _die "$layout_error"
    fi
    _die "Failed to remove staged worker evidence before cleanup: $repo_name"
  fi

  if [[ "$wt_type" == "treehouse" ]]; then
    # A successful Treehouse return releases a verified lease; it does not
    # remove the reusable checkout from Treehouse's pool.  Bind the live lease
    # to the configured repository and Sergeant holder before invoking the
    # external return operation so a remaining directory cannot weaken the
    # ordinary git worktree removal contract below.
    echo "  returning treehouse lease: $worktree"
    _require_remover_same_filesystem "$repo_dir" "$repo_name" "$worktree" \
      "$LIVE_EVIDENCE_BACKUP" "$retrying_removal" "$initial_marker" \
      "$initial_marker_preexisting"
    if [[ "$treehouse_returned" != true ]] && ! \
      "$SCRIPT_DIR/_sgt-treehouse-io.py" return "$retry_root" \
        "$repo_dir/treehouse-return.raw" "$repo_dir/treehouse-return-receipt.json" \
        "$worktree" "$treehouse_lease_id" "$treehouse_holder"; then
      if [[ ! -d "$worktree" ]]; then
        _rollback_remove_path "$LIVE_EVIDENCE_BACKUP" \
          "removed treehouse live evidence backup" live-backup-cleanup
        _record_cleanup_phase "$repo_dir" partial-removal "$worktree" \
          "$wt_type" "$retry_root" || \
          _die "Failed to record partial treehouse removal: $repo_name"
        _die "Treehouse return failed after worktree removal; retry required: $worktree"
      fi
      _restore_removed_worker_evidence "$worktree" "$LIVE_EVIDENCE_BACKUP" || \
        _die "Failed to restore worker evidence after treehouse failure: $repo_name"
      _die "Conditional treehouse return did not confirm lease release; retry required; fleet state preserved: $worktree; receipt: $repo_dir/treehouse-return-receipt.json"
    fi
  else
    echo "  removing git worktree: $worktree"
    _require_remover_same_filesystem "$repo_dir" "$repo_name" "$worktree" \
      "$LIVE_EVIDENCE_BACKUP" "$retrying_removal" "$initial_marker" \
      "$initial_marker_preexisting"
    if ! git -C "$retry_root" worktree remove "$worktree" 2>&1 | sed 's/^/  /'; then
      if [[ ! -d "$worktree" ]]; then
        _rollback_remove_path "$LIVE_EVIDENCE_BACKUP" \
          "removed git live evidence backup" live-backup-cleanup
        _record_cleanup_phase "$repo_dir" partial-removal "$worktree" \
          "$wt_type" "$retry_root" || \
          _die "Failed to record partial git worktree removal: $repo_name"
        _die "Git worktree removal failed after removing the directory; retry required: $worktree"
      fi
      _restore_removed_worker_evidence "$worktree" "$LIVE_EVIDENCE_BACKUP" || \
        _die "Failed to restore worker evidence after git failure: $repo_name"
      _die "Failed to remove git worktree; fleet state preserved: $worktree"
    fi
  fi

  if [[ "$wt_type" != "treehouse" && -d "$worktree" ]]; then
    _restore_removed_worker_evidence "$worktree" "$LIVE_EVIDENCE_BACKUP" || \
      _die "Failed to restore worker evidence after incomplete removal: $repo_name"
    _die "Worktree removal reported success but the directory remains: $worktree"
  fi
  _rollback_remove_path "$LIVE_EVIDENCE_BACKUP" \
    "completed live evidence backup" live-backup-cleanup
  if [[ "$wt_type" == "treehouse" ]]; then
    _record_cleanup_phase "$repo_dir" returned "$worktree" "$wt_type" "$retry_root" \
      "$treehouse_lease_id" "$treehouse_holder" || \
      _die "Failed to publish completed treehouse lease return: $repo_name"
  else
    _record_cleanup_phase "$repo_dir" removed "$worktree" "$wt_type" "$retry_root" || \
      _die "Failed to publish completed worktree removal: $repo_name"
  fi
  if [[ "$wt_type" != "treehouse" ]]; then
    _validate_retry_owner "$repo_dir" "$repo_name" "$worktree" \
      "$wt_type" "$retry_root"
    _require_completed_removal_proof "$wt_type" "$retry_root" "$worktree"
  fi
  if [[ "$wt_type" != treehouse ]]; then
    _record_cleanup_phase "$repo_dir" reconciled-absent "$worktree" || \
      _die "Failed to publish reconciled cleanup phase: $repo_name"
  fi

  echo ""
  _sgt_response_lock_release
  trap - EXIT
done

# Only remove fleet state if cleaning all repos (no FILTER_REPO)
if [[ -z "$FILTER_REPO" ]]; then
  echo "Removing fleet state: $TASK_DIR"

  if [[ -e "$TASK_DIR/.callbacks/origin.json" || -L "$TASK_DIR/.callbacks/origin.json" ]]; then
    "$SCRIPT_DIR/sgt-callback" seal "$TASK_ID"
  fi

  # ── Wiki: log the cleanup event ─────────────────────────────────────────
  _result="$(cat "$TASK_DIR/"*"/.sergeant-result" 2>/dev/null | head -1 || true)"
  _status="$(cat "$TASK_DIR/"*"/.sergeant-status" 2>/dev/null | head -1 || true)"
  _sgt_wiki_write \
    "sgt-cleanup: $TASK_ID" \
    "activity" \
    "Cleaned up task $TASK_ID (${_status:-unknown})" \
    "sergeant,cleanup,$TASK_ID" \
    "## Cleanup

- **Task ID:** \`$TASK_ID\`
- **Final status:** ${_status:-unknown}
- **Result:** ${_result:-none}"

  rm -rf "$TASK_DIR"
fi

echo "Done."
