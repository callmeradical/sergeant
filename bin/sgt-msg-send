#!/usr/bin/env bash
# sgt-msg-send — Send a message to an agent inbox in a project
#
# Usage:
#   sgt-msg-send <project> --from <agent> --to <agent|broadcast> "<message>"
#
# Options:
#   --from <agent>    Sender agent name/id (required)
#   --to <agent>      Recipient agent name/id or "broadcast" (required)
#   --metadata <json> Optional JSON metadata blob
#
# Output: message ID on success
# Exit:   0 success, 1 error

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=bin/_sgt-msg-lib.sh
source "$SCRIPT_DIR/_sgt-msg-lib.sh"

_die() { echo "error: $*" >&2; exit 1; }

[[ $# -lt 1 ]] && _die "Usage: sgt-msg-send <project> --from <agent> --to <agent> \"<message>\""

PROJECT="$1"; shift

FROM_AGENT=""
TO_AGENT=""
BODY=""
METADATA=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --from)     FROM_AGENT="$2"; shift 2 ;;
    --to)       TO_AGENT="$2";   shift 2 ;;
    --metadata) METADATA="$2";   shift 2 ;;
    -*)         _die "Unknown flag: $1" ;;
    *)          BODY="$1";       shift ;;
  esac
done

[[ -z "$FROM_AGENT" ]] && _die "--from <agent> is required"
[[ -z "$TO_AGENT"   ]] && _die "--to <agent|broadcast> is required"
[[ -z "$BODY"       ]] && _die "message body is required"
[[ -z "$PROJECT"    ]] && _die "<project> is required"
_sgt_msg_valid_project "$PROJECT" || \
  _die "invalid project name: must match [A-Za-z0-9][A-Za-z0-9._-]* and contain no '..'"

DB_DIR="${SERGEANT_MSG_DB_DIR:-$HOME/.sergeant/messages}"
mkdir -p "$DB_DIR"
DB="$(_sgt_msg_db_path "$DB_DIR" "$PROJECT")"

_sgt_msg_schema | sqlite3 "$DB" > /dev/null

MSG_ID="$(date +%s%N 2>/dev/null || date +%s)$(echo $RANDOM | sha256sum 2>/dev/null | head -c 8 || echo $RANDOM)"
MSG_ID="$(printf '%s' "$MSG_ID" | sha256sum | head -c 16)"
SENT_AT="$(date -u +"%Y-%m-%dT%H:%M:%SZ")"

sqlite3 -cmd ".timeout 1000" "$DB" "INSERT INTO messages (id, project, from_agent, to_agent, body, sent_at, read_at)
  VALUES ('$(_sgt_msg_q "$MSG_ID")', '$(_sgt_msg_q "$PROJECT")', '$(_sgt_msg_q "$FROM_AGENT")',
          '$(_sgt_msg_q "$TO_AGENT")', '$(_sgt_msg_q "$BODY")', '$(_sgt_msg_q "$SENT_AT")', NULL);"

echo "$MSG_ID"
