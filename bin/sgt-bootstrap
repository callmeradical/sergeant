#!/usr/bin/env bash
# sgt-bootstrap — Install or verify the cross-platform Sergeant developer toolchain.
#
# Usage:
#   sgt-bootstrap                 Install everything that is missing
#   sgt-bootstrap --dry-run       Print the plan; change nothing
#   sgt-bootstrap --verify-only   Report what is missing; change nothing
#
# Environment:
#   SGT_INSTALL_DIR      Target directory for Sergeant command links and for the
#                        executables this command installs (default ~/.local/bin)
#   SGT_BOOTSTRAP_EUID   Override the effective UID used for sudo decisions
#
# Supported platforms: macOS with Homebrew, and Linux with apt-get. Any other
# platform, or a supported platform without its package manager, fails before
# making a change.
#
# --dry-run and --verify-only run no package manager, no installer, and no agent
# harness, so they cannot create state in a harness's configuration directory as
# a side effect of inspecting it. The single third-party command they do run is
# `yq --version`, which only reads a version string and is needed to tell Mike
# Farah's yq from the unrelated Python package of the same name.
#
# Safe to rerun. Every conflict is detected and reported BEFORE the first package
# manager or network call, so a run either declines up front or proceeds. A real
# file or a user-owned link where Sergeant wants its own entry is preserved and
# reported, never overwritten. Authentication is never automated.
#
# Per docs/repo-scoped-skills.md this command never writes to a user's global
# agent configuration. Sergeant's skills are discovered from the repository
# itself through opencode.json and .claude/skills, so no global skill or plugin
# installation is required or performed.

set -euo pipefail

# Resolved with parameter expansion rather than the repo's usual
# $(dirname "${BASH_SOURCE[0]}") idiom: this command runs before the toolchain
# exists and its tests exercise it on a deliberately minimal PATH, where an
# external dirname may be absent.
_self="${BASH_SOURCE[0]}"
case "$_self" in
  */*) SCRIPT_DIR="$(cd "${_self%/*}" && pwd)" ;;
  *) SCRIPT_DIR="$(pwd)" ;;
esac
# shellcheck source=_sgt-install-manifest.sh
source "$SCRIPT_DIR/_sgt-install-manifest.sh"

ROOT_DIR="$(_sgt_install_script_root "$_self")"
# One directory receives both the Sergeant command links and every executable
# this command installs, so the documented write set is a single path.
INSTALL_DIR="${SGT_INSTALL_DIR:-$HOME/.local/bin}"
export PATH="$INSTALL_DIR:$PATH"

usage() {
  cat <<'EOF'
Usage: sgt-bootstrap [--dry-run] [--verify-only]

  --dry-run       Print the installation plan without changing anything
  --verify-only   Report missing toolchain entries without changing anything
EOF
}

# System packages installed through the platform package manager, as
# `command:package` pairs. These are the entries README.md and
# docs/getting-started.md promise the bootstrap installs.
system_packages=('git:git' 'gh:gh' 'tmux:tmux' 'jq:jq' 'shellcheck:shellcheck' \
  'curl:curl' 'python3:python3' 'lsof:lsof')

# Tools installed and pinned through mise, as `command:mise-spec` pairs.
managed_tools=('go:go@latest' 'node:node@lts' 'uv:uv@latest' \
  'opencode:opencode@latest' 'claude:claude@latest' 'yq:yq@latest')

# Commands whose absence fails verification. This mirrors the required set of
# `mise run check`, which is the repository's other definition of "required".
required_commands=('git' 'gh' 'tmux' 'yq' 'python3' 'lsof' 'td')

# Commands the bootstrap installs or uses but whose absence is reported without
# failing verification, matching the optional set of `mise run check`.
optional_commands=('jq' 'shellcheck' 'curl' 'mise' 'go' 'node' 'uv' \
  'graphify' 'no-mistakes' 'treehouse')

# Exactly one interactive agent harness is required, matching
# docs/getting-started.md and `mise run check`.
agent_harnesses=('opencode' 'goose' 'claude')

# tool_available <command>
#
# True when <command> resolves on PATH to an executable and, for yq, is Mike
# Farah's Go implementation rather than the unrelated Python package.
tool_available() {
  local command_name="$1" version
  _sgt_command_available "$command_name" || return 1
  if [[ "$command_name" == 'yq' ]]; then
    version="$(yq --version 2>&1)"
    [[ "$version" == *'github.com/mikefarah/yq'* ]]
  fi
}

# missing_packages <command:package>...
#
# Print, one per line, the package name of every entry whose command is absent.
missing_packages() {
  local item
  for item in "$@"; do
    tool_available "${item%%:*}" || printf '%s\n' "${item#*:}"
  done
}


# report_manual_authentication <prefix>
#
# Authentication is never automated, and probing it is not free: `gh auth
# status` makes a network call and the agent harnesses initialise state in the
# user's configuration directory on first invocation, which this command
# promises never to touch. So the required logins are always reported rather
# than tested, and `opencode auth list` exits 0 even with no credentials, so the
# probe could not be trusted anyway.
report_manual_authentication() {
  local prefix="$1"
  printf '%s run gh auth login before using GitHub operations.\n' "$prefix"
  printf '%s run opencode auth login before launching OpenCode agents.\n' "$prefix"
  printf '%s run claude auth login before launching Claude Code agents (if you use Claude).\n' "$prefix"
}

dry_run=false
verify_only=false

while (($#)); do
  case "$1" in
    --dry-run) dry_run=true ;;
    --verify-only) verify_only=true ;;
    -h|--help) usage; exit 0 ;;
    *) printf 'sgt-bootstrap: unknown option: %s\n' "$1" >&2; usage >&2; exit 2 ;;
  esac
  shift
done

if "$dry_run" && "$verify_only"; then
  printf 'sgt-bootstrap: --dry-run and --verify-only cannot be combined\n' >&2
  exit 2
fi

# Resolve the manifest before anything else so a mis-resolved checkout fails
# here rather than reporting a complete installation over an empty plan.
sources="$(_sgt_install_sources "$ROOT_DIR")" || exit 1

# ── Platform ──────────────────────────────────────────────────────────────────

platform="$(uname -s)"
case "$platform" in
  Linux)
    tool_available apt-get || {
      printf 'sgt-bootstrap: Linux requires an apt-compatible package manager (apt-get)\n' >&2
      exit 1
    }
    platform_label='Linux (apt)'
    ;;
  Darwin)
    tool_available brew || {
      printf 'sgt-bootstrap: macOS requires Homebrew: https://brew.sh\n' >&2
      exit 1
    }
    platform_label='macOS (Homebrew)'
    ;;
  *)
    printf 'sgt-bootstrap: unsupported platform: %s\n' "$platform" >&2
    exit 1
    ;;
esac
printf 'Platform: %s\n' "$platform_label"

missing_package_list="$(missing_packages "${system_packages[@]}")"
packages=()
while IFS= read -r package_name; do
  [[ -n "$package_name" ]] || continue
  packages[${#packages[@]}]="$package_name"
done <<< "$missing_package_list"

# ── Plan: every conflict is discovered before any mutation ─────────────────────

# Collected here and reported by all three modes, so the dry-run plan names
# exactly the conflicts a real run would decline on.
conflicts=()

for item in "${managed_tools[@]}"; do
  command_name="${item%%:*}"
  tool_available "$command_name" && continue
  if [[ "$(_sgt_install_managed_state "$INSTALL_DIR/$command_name" '/mise/')" == 'conflict' ]]; then
    conflicts[${#conflicts[@]}]="$INSTALL_DIR/$command_name is not the required $command_name executable"
  fi
done

while IFS= read -r source_file; do
  [[ -n "$source_file" ]] || continue
  if [[ "$(_sgt_install_link_state "$source_file" "$INSTALL_DIR")" == 'conflict' ]]; then
    conflicts[${#conflicts[@]}]="$INSTALL_DIR/${source_file##*/} is not a Sergeant command link"
  fi
done <<< "$sources"

sudo_required=false
if [[ "$platform" == 'Linux' ]] && ((${#packages[@]})) && \
   [[ "${SGT_BOOTSTRAP_EUID:-$EUID}" -ne 0 ]]; then
  sudo_required=true
  tool_available sudo || \
    conflicts[${#conflicts[@]}]="package installation requires root or passwordless sudo; rerun as root or install: ${packages[*]}"
fi

# ── Mode: dry run ─────────────────────────────────────────────────────────────

if "$dry_run"; then
  if ((${#packages[@]})); then
    if [[ "$platform" == 'Linux' ]]; then
      apt_prefix='apt-get'
      "$sudo_required" && apt_prefix='sudo -n DEBIAN_FRONTEND=noninteractive apt-get'
      printf 'DRY-RUN: %s update\n' "$apt_prefix"
      printf 'DRY-RUN: %s install -y %s\n' "$apt_prefix" "${packages[*]}"
    else
      printf 'DRY-RUN: brew install %s\n' "${packages[*]}"
    fi
  else
    printf 'OK: platform packages already installed\n'
  fi

  tool_available mise || printf 'DRY-RUN: install mise from https://mise.run\n'
  tool_specs=()
  for item in "${managed_tools[@]}"; do
    tool_available "${item%%:*}" || tool_specs[${#tool_specs[@]}]="${item#*:}"
  done
  if ((${#tool_specs[@]})); then
    printf 'DRY-RUN: mise install %s\n' "${tool_specs[*]}"
    printf 'DRY-RUN: link managed executables into %s\n' "$INSTALL_DIR"
  fi
  tool_available td || printf 'DRY-RUN: go install github.com/marcus/td@latest\n'
  tool_available no-mistakes || \
    printf 'DRY-RUN: go install github.com/kunchenguid/no-mistakes/cmd/no-mistakes@latest\n'
  tool_available graphify || printf 'DRY-RUN: uv tool install graphifyy\n'
  printf 'DRY-RUN: mise install\n'
  printf 'DRY-RUN: mise run install\n'

  while IFS= read -r source_file; do
    [[ -n "$source_file" ]] || continue
    command_name="${source_file##*/}"
    case "$(_sgt_install_link_state "$source_file" "$INSTALL_DIR")" in
      linked) printf 'DRY-RUN: preserve Sergeant command %s\n' "$command_name" ;;
      stale) printf 'DRY-RUN: relink Sergeant command %s\n' "$command_name" ;;
      conflict) printf 'DRY-RUN: conflict at Sergeant command %s (manual resolution required)\n' \
        "$command_name" ;;
      *) printf 'DRY-RUN: link Sergeant command %s\n' "$command_name" ;;
    esac
  done <<< "$sources"

  for conflict in ${conflicts[@]+"${conflicts[@]}"}; do
    printf 'DRY-RUN: conflict would stop this run: %s\n' "$conflict"
  done
  report_manual_authentication 'DRY-RUN: manual action may be required —'
  exit 0
fi

# ── Mode: verify only ─────────────────────────────────────────────────────────

if "$verify_only"; then
  verify_failed=false

  for command_name in "${required_commands[@]}"; do
    if tool_available "$command_name"; then
      printf 'OK: %s\n' "$command_name"
    else
      printf 'MISSING: %s\n' "$command_name"
      verify_failed=true
    fi
  done

  harness_found=false
  for command_name in "${agent_harnesses[@]}"; do
    if tool_available "$command_name"; then
      printf 'OK: agent harness %s\n' "$command_name"
      harness_found=true
    fi
  done
  if ! "$harness_found"; then
    printf 'MISSING: an agent harness (one of %s)\n' "${agent_harnesses[*]}"
    verify_failed=true
  fi

  for command_name in "${optional_commands[@]}"; do
    if tool_available "$command_name"; then
      printf 'OK: %s\n' "$command_name"
    else
      printf 'OPTIONAL MISSING: %s\n' "$command_name"
    fi
  done

  while IFS= read -r source_file; do
    [[ -n "$source_file" ]] || continue
    command_name="${source_file##*/}"
    if [[ "$(_sgt_install_link_state "$source_file" "$INSTALL_DIR")" == 'linked' ]]; then
      printf 'OK: Sergeant command %s\n' "$command_name"
    else
      printf 'MISSING: Sergeant command %s\n' "$command_name"
      verify_failed=true
    fi
  done <<< "$sources"

  report_manual_authentication 'MANUAL:'

  "$verify_failed" && exit 1
  printf 'Verification complete: all required tools are available.\n'
  exit 0
fi

# ── Mode: install ─────────────────────────────────────────────────────────────

# Decline before mutating anything. Every conflict above was detected from state
# that is knowable without installing a package, so a run that cannot finish
# never starts.
if ((${#conflicts[@]})); then
  for conflict in "${conflicts[@]}"; do
    printf 'CONFLICT: %s; preserved for manual resolution.\n' "$conflict" >&2
  done
  printf 'sgt-bootstrap: resolve the %d conflict(s) above and rerun; nothing was changed.\n' \
    "${#conflicts[@]}" >&2
  exit 1
fi

mkdir -p "$INSTALL_DIR"

if ((${#packages[@]})); then
  printf 'INSTALLING: %s\n' "${packages[*]}"
  if [[ "$platform" == 'Linux' ]]; then
    apt_command=(apt-get)
    # The assignment must sit inside the elevated command: sudo's default
    # env_reset drops DEBIAN_FRONTEND, which is exactly the unattended run.
    "$sudo_required" && apt_command=(sudo -n DEBIAN_FRONTEND=noninteractive apt-get)
    DEBIAN_FRONTEND=noninteractive "${apt_command[@]}" update
    DEBIAN_FRONTEND=noninteractive "${apt_command[@]}" install -y "${packages[@]}"
  else
    brew install "${packages[@]}"
  fi
else
  printf 'OK: platform packages already installed\n'
fi

if tool_available mise; then
  printf 'OK: mise\n'
else
  printf 'INSTALLING: mise\n'
  # -f so an HTTP error page is never piped into sh, -L so a redirect is
  # followed rather than yielding an empty body that "succeeds".
  # Point the installer at the same directory as everything else, so the
  # documented write set stays a single path.
  MISE_INSTALL_PATH="$INSTALL_DIR/mise" curl -fsSL https://mise.run | sh || {
    printf 'sgt-bootstrap: mise installation failed; install it manually from https://mise.run\n' >&2
    exit 1
  }
  export PATH="$INSTALL_DIR:$PATH"
  tool_available mise || {
    printf 'sgt-bootstrap: the mise installer completed but mise is not on PATH; install it manually from https://mise.run\n' >&2
    exit 1
  }
fi

for item in "${managed_tools[@]}"; do
  command_name="${item%%:*}"
  tool_spec="${item#*:}"
  if tool_available "$command_name"; then
    printf 'OK: %s\n' "$command_name"
    continue
  fi
  printf 'INSTALLING: %s\n' "$command_name"
  managed_target="$INSTALL_DIR/$command_name"
  mise install "$tool_spec"
  # `command -v` inside the tool's own environment; the external `which` is not
  # POSIX and Debian is removing it.
  # Single quotes are required: $1 must be expanded by the inner shell that mise
  # runs, not by this one.
  # shellcheck disable=SC2016
  binary_path="$(mise exec "$tool_spec" -- sh -c 'command -v "$1"' _ "$command_name" 2>/dev/null || true)"
  [[ -n "$binary_path" ]] || {
    printf 'sgt-bootstrap: mise installed %s but did not expose %s\n' "$tool_spec" "$command_name" >&2
    exit 1
  }
  # Reclaiming a dangling or mise-owned link keeps a rerun able to repair the
  # link this command created after mise prunes the versioned path behind it.
  rm -f "$managed_target"
  ln -s "$binary_path" "$managed_target"
done

if tool_available td; then
  printf 'OK: td\n'
else
  printf 'INSTALLING: td\n'
  GOBIN="$INSTALL_DIR" go install github.com/marcus/td@latest
fi
if tool_available no-mistakes; then
  printf 'OK: no-mistakes\n'
else
  printf 'INSTALLING: no-mistakes\n'
  GOBIN="$INSTALL_DIR" go install github.com/kunchenguid/no-mistakes/cmd/no-mistakes@latest
fi
if tool_available graphify; then
  printf 'OK: graphify\n'
else
  printf 'INSTALLING: graphify\n'
  UV_TOOL_BIN_DIR="$INSTALL_DIR" uv tool install graphifyy
fi

# mise owns the repository's pinned tools and delegates the command links to
# bin/sgt-install, which exits non-zero if it could not install everything.
(cd "$ROOT_DIR" && mise install && mise run install)

# Reconcile what the install actually produced, distinguishing a link that was
# never created from one that something else occupies.
install_failed=false
while IFS= read -r source_file; do
  [[ -n "$source_file" ]] || continue
  target="$INSTALL_DIR/${source_file##*/}"
  case "$(_sgt_install_link_state "$source_file" "$INSTALL_DIR")" in
    linked) ;;
    absent)
      printf 'NOT INSTALLED: %s was not created; check the output of mise run install.\n' \
        "$target" >&2
      install_failed=true
      ;;
    *)
      printf 'CONFLICT: %s was preserved and does not point to Sergeant; manual resolution required.\n' \
        "$target" >&2
      install_failed=true
      ;;
  esac
done <<< "$sources"

report_manual_authentication 'MANUAL:'

"$install_failed" && exit 1
exit 0
