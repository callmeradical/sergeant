#!/usr/bin/env bash
# sgt-td-create — Create td tasks in project repos for a cross-repo brief
#
# Creates one td task per specified repo, with a shared title and per-repo
# description. Returns the created task IDs so sgt-dispatch can use them.
# Task creation is all-or-nothing: if any target repo cannot produce a task,
# previously created tasks are rolled back and the command fails.
#
# Usage:
#   sgt-td-create <project> "<title>" --repos repo1,repo2 [options]
#
# Options:
#   --repos repo1,repo2,...   Repos to create tasks in (required)
#   --description "<text>"    Shared description for all tasks
#   --type <type>             Task type: bug|feature|task|chore (default: task)
#   --priority <P0-P4>        Priority (default: P1)
#   --parent <id>             Parent epic ID (applies to all tasks)
#   --json                    Output created task IDs as JSON
#
# Output (default): one line per repo: "<repo>  <task-id>  <title>"
# Output (--json):  array of {repo, task_id, title, work_dir}
#
# Example:
#   ids=$(sgt-td-create smith "feat: add OAuth" --repos smith,smith-app --json)
#   # then pass each id to sgt-dispatch --td

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=bin/_sgt-lib.sh
source "$SCRIPT_DIR/_sgt-lib.sh"

[[ $# -ge 2 ]] || _die "Usage: sgt-td-create <project> \"<title>\" --repos <list> [options]"
PROJECT="$1"; shift
TITLE="$1";   shift

CONFIG_FILE="$SERGEANT_CONFIG/$PROJECT.yaml"
[[ -f "$CONFIG_FILE" ]] || _die "Project not found: $PROJECT"
_require_yq
_require_git
_require_marcus_td

REPOS_ARG=""
DESCRIPTION=""
TASK_TYPE="task"
PRIORITY="P1"
PARENT=""
JSON_OUT=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    --repos)       REPOS_ARG="$2";    shift 2 ;;
    --description) DESCRIPTION="$2";  shift 2 ;;
    --type)        TASK_TYPE="$2";    shift 2 ;;
    --priority)    PRIORITY="$2";     shift 2 ;;
    --parent)      PARENT="$2";       shift 2 ;;
    --json)        JSON_OUT=true;     shift   ;;
    *) _die "Unknown option: $1" ;;
  esac
done

[[ -n "$REPOS_ARG" ]] || _die "Must specify --repos"

TARGET_REPOS=()
IFS=',' read -ra TARGET_REPOS <<< "$REPOS_ARG"

repo_count="$(yq '.repos | length' "$CONFIG_FILE")"

for rname in "${TARGET_REPOS[@]}"; do
  found=false
  for ((i=0; i<repo_count; i++)); do
    n="$(yq ".repos[$i].name" "$CONFIG_FILE")"
    [[ "$n" == "$rname" ]] && found=true && break
  done
  $found || _die "Repo '$rname' not found in project $PROJECT"
done

STATE_FILE="${SGT_TD_STATE_FILE:-$(mktemp)}"
OWN_STATE_FILE=false
[[ -z "${SGT_TD_STATE_FILE:-}" ]] && OWN_STATE_FILE=true
: > "$STATE_FILE"

CREATE_STDERR_FILE="$(mktemp)"
CREATE_RESULT_FILE="$(mktemp)"
SUCCESS_FILE="${SGT_TD_SUCCESS_FILE:-}"
PENDING_REPO=""
PENDING_WORK_DIR=""
ROLLBACK_DONE=false

_record_created() {
  python3 - "$STATE_FILE" "$1" "$2" "$TITLE" "$3" <<'PY'
import json
import sys

path, repo, task_id, title, work_dir = sys.argv[1:]
with open(path, "a", encoding="utf-8") as handle:
    handle.write(json.dumps({
        "repo": repo,
        "task_id": task_id,
        "title": title,
        "work_dir": work_dir,
    }))
    handle.write("\n")
    handle.flush()
    import os
    os.fsync(handle.fileno())
PY
}

_state_has_task_id() {
  python3 - "$STATE_FILE" "$1" <<'PY'
import json
import sys

with open(sys.argv[1], encoding="utf-8") as handle:
    for line in handle:
        if line.strip() and json.loads(line).get("task_id") == sys.argv[2]:
            raise SystemExit(0)
raise SystemExit(1)
PY
}

_mark_create_success() {
  [[ -n "$SUCCESS_FILE" ]] || return 0
  python3 - "$SUCCESS_FILE" <<'PY'
import os
import sys

with open(sys.argv[1], "w", encoding="utf-8") as handle:
    handle.write("committed\n")
    handle.flush()
    os.fsync(handle.fileno())
PY
}

_emit_results() {
  if $JSON_OUT; then
    python3 - "$STATE_FILE" <<'PY'
import json
import sys

path = sys.argv[1]
items = []
with open(path, encoding="utf-8") as handle:
    for line in handle:
        line = line.strip()
        if line:
            items.append(json.loads(line))
print(json.dumps(items))
PY
  else
    python3 - "$STATE_FILE" <<'PY'
import json
import sys

path = sys.argv[1]
with open(path, encoding="utf-8") as handle:
    for line in handle:
        line = line.strip()
        if not line:
            continue
        item = json.loads(line)
        print(f"{item['repo']:<20}  {item['task_id']}  {item['title']}")
PY
  fi
}

_parse_task_id() {
  python3 -c '
import json
import sys

payload = json.load(sys.stdin)
if not isinstance(payload, dict):
    raise SystemExit(1)
task_id = payload.get("id")
if not isinstance(task_id, str):
    raise SystemExit(1)
print(task_id)
'
}

_rollback_or_die() {
  local message="$1"
  ROLLBACK_DONE=true
  if ! _sgt_td_rollback_state "$STATE_FILE"; then
    printf '%s\n%s\n' "$message" "$SGT_TD_ROLLBACK_ERRORS" >&2
  else
    printf '%s\n' "$message" >&2
  fi
  exit 1
}

_td_create_cleanup() {
  local status=$? pending_task_id=""
  trap - EXIT HUP INT TERM
  if [[ "$status" -ne 0 ]] && ! $ROLLBACK_DONE; then
    # If td returned a valid created ID but interruption arrived before the
    # normal journal append, recover that ID from its already-durable stdout.
    if [[ -n "$PENDING_REPO" && -s "$CREATE_RESULT_FILE" ]]; then
      pending_task_id="$(_parse_task_id < "$CREATE_RESULT_FILE" 2>/dev/null || true)"
      if [[ -n "$pending_task_id" ]] && ! _state_has_task_id "$pending_task_id"; then
        _record_created "$PENDING_REPO" "$pending_task_id" "$PENDING_WORK_DIR"
      fi
    fi
    if ! _sgt_td_rollback_state "$STATE_FILE"; then
      printf '%s\n' "$SGT_TD_ROLLBACK_ERRORS" >&2
    fi
  fi
  rm -f "$CREATE_STDERR_FILE" "$CREATE_RESULT_FILE"
  $OWN_STATE_FILE && rm -f "$STATE_FILE"
  exit "$status"
}
_td_create_signal() { exit "$1"; }
trap _td_create_cleanup EXIT
trap '_td_create_signal 129' HUP
trap '_td_create_signal 130' INT
trap '_td_create_signal 143' TERM

# Validate every target before creating any task so prerequisite failures do
# not require rollback.
for rname in "${TARGET_REPOS[@]}"; do
  for ((i=0; i<repo_count; i++)); do
    n="$(yq ".repos[$i].name" "$CONFIG_FILE")"
    [[ "$n" == "$rname" ]] && break
  done

  raw_path="$(yq ".repos[$i].path" "$CONFIG_FILE")"
  repo_path="$(_resolve_path "$raw_path")"

  _sgt_is_git_repo "$repo_path" || _rollback_or_die "repo '$rname' is not cloned at $repo_path"
  if ! td_check="$(td list --json --work-dir "$repo_path" --limit 1 2>&1)"; then
    if [[ "$td_check" == *"database not found: run 'td init' first"* ]]; then
      _rollback_or_die "td is not initialized in repo '$rname' ($repo_path). Run: td init --work-dir '$repo_path'"
    fi
    _rollback_or_die "td prerequisite check failed in repo '$rname' ($repo_path): $td_check"
  fi
done

for rname in "${TARGET_REPOS[@]}"; do
  for ((i=0; i<repo_count; i++)); do
    n="$(yq ".repos[$i].name" "$CONFIG_FILE")"
    [[ "$n" == "$rname" ]] && break
  done

  raw_path="$(yq ".repos[$i].path" "$CONFIG_FILE")"
  repo_path="$(_resolve_path "$raw_path")"

  repo_role="$(yq ".repos[$i].role // \"\"" "$CONFIG_FILE")"
  full_desc="${DESCRIPTION}"
  if [[ -n "$repo_role" && "$repo_role" != "null" ]]; then
    if [[ -n "$full_desc" ]]; then
      full_desc="$full_desc

Repo role: $repo_role"
    else
      full_desc="Repo role: $repo_role"
    fi
  fi

  td_args=(
    create "$TITLE"
    --type "$TASK_TYPE"
    --priority "$PRIORITY"
    --work-dir "$repo_path"
    --json
  )
  [[ -n "$full_desc" ]] && td_args+=(--description "$full_desc")
  [[ -n "$PARENT"    ]] && td_args+=(--parent "$PARENT")

  : > "$CREATE_STDERR_FILE"
  : > "$CREATE_RESULT_FILE"
  PENDING_REPO="$rname"
  PENDING_WORK_DIR="$repo_path"
  if ! td "${td_args[@]}" >"$CREATE_RESULT_FILE" 2>"$CREATE_STDERR_FILE"; then
    create_error="$(cat "$CREATE_STDERR_FILE")"
    [[ -n "$create_error" ]] || create_error="td create failed for $rname"
    _rollback_or_die "$create_error"
  fi

  if [[ "${SGT_TEST_HOOKS:-}" == 1 && \
        "${SGT_TD_CREATE_FAIL_POINT:-}" == after-create-success ]]; then
    kill -TERM "$$"
  fi

  if ! task_id="$(_parse_task_id < "$CREATE_RESULT_FILE" 2>/dev/null)"; then
    _rollback_or_die "td create returned invalid JSON for $rname"
  fi
  [[ -n "$task_id" ]] || _rollback_or_die "td create returned invalid JSON for $rname"

  _record_created "$rname" "$task_id" "$repo_path"
  PENDING_REPO=""
  PENDING_WORK_DIR=""
done

_mark_create_success
_emit_results
