#!/usr/bin/env bash
# sgt-interactive-worker - Own one persistent interactive agent pane.

set -uo pipefail

[[ $# -eq 3 ]] || {
  echo "Usage: sgt-interactive-worker <repo-state-dir> <worktree> <agent>" >&2
  exit 2
}

REPO_STATE="$1"
WORKTREE="$2"
AGENT="$3"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=bin/_sgt-lib.sh
source "$SCRIPT_DIR/_sgt-lib.sh"
# shellcheck source=bin/_sgt-drain.sh
# shellcheck disable=SC1091
source "$SCRIPT_DIR/_sgt-drain.sh"
# shellcheck source=bin/_sgt-response-lock.sh
source "$SCRIPT_DIR/_sgt-response-lock.sh"
# shellcheck source=bin/_sgt-harness.sh
source "$SCRIPT_DIR/_sgt-harness.sh"

[[ -d "$WORKTREE" ]] || {
  echo "ERROR: worktree unavailable: $WORKTREE" >&2
  exit 2
}
[[ -t 0 && -t 1 ]] || {
  echo "ERROR: interactive worker requires a terminal" >&2
  exit 2
}
# Capability gate, readiness probe, and launch invocation all come from the one
# registry in bin/_sgt-harness.sh.  Validation runs first, so a harness added to
# the accepted list without a readiness probe fails here instead of shipping and
# then hanging forever on an unsatisfiable readiness check.
harness="$(basename "$AGENT")"
# Registry check: validates the harness is in the accepted list before any
# model/variant work or state creation.
_sgt_harness_require_accepted "$harness" || exit 2

mkdir -p "$REPO_STATE"

# ── Pinned model tuple ────────────────────────────────────────────────────────
# The tuple lives in durable fleet state, so a worker resumed by sgt-respond,
# sgt-recover, or sgt-wake runs the same pinned model as the original dispatch.
# A tuple this harness cannot honor is a terminal failure: dropping the pin and
# inheriting the ambient default is exactly the defect this contract prevents.

AGENT_MODEL="$(cat "$REPO_STATE/agent_model" 2>/dev/null || true)"
AGENT_MODEL_SOURCE="$(cat "$REPO_STATE/agent_model_source" 2>/dev/null || true)"
[[ -n "$AGENT_MODEL" ]] || AGENT_MODEL="$SGT_AGENT_MODEL_UNPINNED"
# Normalise the recorded provenance instead of copying fleet state verbatim into
# evidence: a stale or hand-edited source must not appear in the launch record,
# and a pinned model with no recorded source is "unknown", never "unpinned".
case "$AGENT_MODEL_SOURCE" in
  flag|env|unpinned) ;;
  *)
    if [[ "$AGENT_MODEL" == "$SGT_AGENT_MODEL_UNPINNED" ]]; then
      AGENT_MODEL_SOURCE="unpinned"
    else
      AGENT_MODEL_SOURCE="unknown"
    fi
    ;;
esac
# Called directly, not in a command substitution: the resolved base argv, model
# argv, and model environment are out-parameters that a subshell would discard.
# $REPO_STATE is passed so a variant transport that needs a generated harness
# definition materialises it in fleet state, never in the worktree under review.
if ! _sgt_resolve_agent_launch "$harness" "$AGENT_MODEL" "$REPO_STATE"; then
  _reject_reason="$(_sgt_agent_launch_reject_message "$harness" "$AGENT_MODEL" \
    "$SGT_LAUNCH_REJECT")"
  printf '%s\n' "$_reject_reason" > "$REPO_STATE/diagnostic"
  printf 'failed: cannot honor pinned model tuple %s\n' "$AGENT_MODEL" \
    > "$REPO_STATE/status"
  printf 'failed: cannot honor pinned model tuple %s\n' "$AGENT_MODEL" \
    > "$WORKTREE/.sergeant-status"
  echo "ERROR: $_reject_reason" >&2
  exit 2
fi

# Record what this worker is about to run.  Every field is derived from the
# validated tuple and the shared harness contract, never from the ambient
# environment, so the evidence cannot carry a credential.
#
# launch_state distinguishes intent from proof.  It is written as "intended"
# before the harness is executed and promoted to "confirmed" only once the
# harness reports itself ready (see _promote_launch_record), so a harness that
# rejects the pin and exits never leaves evidence claiming the model ran.
#
# provider_verified and variant_verified say whether the launch invocation itself
# proves that axis.  Both pinned model transports carry the provider explicitly,
# so provider_verified is true whenever a model is pinned and false only when
# nothing is.  variant_verified is always false today: the variant transport is
# genuine, but no supported harness reports back which variant it resolved, so
# claiming otherwise would be exactly the unevidenced assertion this contract
# exists to prevent.
_write_launch_record() {
  local state="$1" tmp="$REPO_STATE/launch_record.tmp.$$"
  {
    printf 'harness=%s\n' "$harness"
    printf 'agent=%s\n' "$AGENT"
    printf 'launch_state=%s\n' "$state"
    printf 'model=%s\n' "$AGENT_MODEL"
    printf 'model_source=%s\n' "$AGENT_MODEL_SOURCE"
    printf 'provider=%s\n' "$SGT_AGENT_MODEL_PROVIDER"
    printf 'provider_verified=%s\n' "$SGT_LAUNCH_PROVIDER_VERIFIED"
    printf 'variant_verified=%s\n' "$SGT_LAUNCH_VARIANT_VERIFIED"
    printf 'model_id=%s\n' "$SGT_AGENT_MODEL_ID"
    printf 'variant=%s\n' "$SGT_AGENT_MODEL_VARIANT"
    printf 'model_transport=%s\n' "$SGT_LAUNCH_MODEL_TRANSPORT"
    printf 'variant_transport=%s\n' "$SGT_LAUNCH_VARIANT_TRANSPORT"
    printf 'definition=%s\n' "$SGT_LAUNCH_DEFINITION"
    printf 'base_argv=%s\n' \
      "${SGT_LAUNCH_BASE_ARGV[*]+${SGT_LAUNCH_BASE_ARGV[*]}}"
    printf 'model_argv=%s\n' \
      "${SGT_LAUNCH_MODEL_ARGV[*]+${SGT_LAUNCH_MODEL_ARGV[*]}}"
    printf 'model_env=%s\n' \
      "${SGT_LAUNCH_MODEL_ENV[*]+${SGT_LAUNCH_MODEL_ENV[*]}}"
  } > "$tmp" && mv "$tmp" "$REPO_STATE/launch_record"
}

# Promote the record once the harness is observably ready.  Called from the
# delivery loop, which already establishes readiness before it sends anything.
_promote_launch_record() {
  [[ -f "$REPO_STATE/launch_record" ]] || return 0
  grep -q '^launch_state=intended$' "$REPO_STATE/launch_record" 2>/dev/null || return 0
  _write_launch_record confirmed
}

# ── Cooperative drain ─────────────────────────────────────────────────────────
# Discover the project name from the fleet task brief.md (parent of REPO_STATE).
# Used to scope project-level drain checks.

_TASK_DIR="$(dirname "$REPO_STATE")"
_PROJECT_NAME=""
if [[ -f "$_TASK_DIR/brief.md" ]]; then
  _PROJECT_NAME="$(awk '/^Project:/{print $2; exit}' "$_TASK_DIR/brief.md" || true)"
fi

# _drain_is_active: returns 0 when an active global or project drain exists.
_drain_is_active() {
  _sgt_drain_is_drained "$(_sgt_drain_global_file)" && return 0
  [[ -n "$_PROJECT_NAME" ]] && \
    _sgt_drain_is_drained "$(_sgt_drain_project_file "$_PROJECT_NAME")" && return 0
  return 1
}

# _drain_terminate: stop the whole worker, then remove its pane.  Never returns.
#
# This runs inside the backgrounded _watch_drain subshell, which is why the
# previous `kill -TERM "$BASHPID"` never worked: BASHPID is the subshell, so only
# the watcher died while the worker shell, the agent, the notification loop and
# the progress loop all survived and the pane stayed open.
#
# Signal the whole process group instead.  We are in that group, so we ignore
# TERM for the rest of this function in order to outlive our own signal and
# guarantee the escalation and the pane removal happen.  SIGKILL cannot be
# trapped, so the final sweep also ends this subshell — by which point every
# durable artefact has been written and the pane is gone.
_drain_terminate() {
  local pgid attempts attempt
  trap '' TERM

  pgid="$(ps -o pgid= -p "$$" 2>/dev/null | tr -d ' ' || true)"
  if [[ ! "$pgid" =~ ^[1-9][0-9]*$ ]]; then
    pgid="$(cat "$REPO_STATE/worker_process_group" 2>/dev/null | tr -d ' \n' || true)"
  fi
  # Only signal the group when this worker actually leads it.  A tmux pane command
  # is its own group leader, so pgid == worker pid.  If it is not, the group
  # contains processes this worker does not own and must not signal; fall back to
  # terminating just the worker shell and let its own EXIT path clean up.
  if [[ "$pgid" =~ ^[1-9][0-9]*$ && "$pgid" != "$$" ]]; then
    printf 'drain terminated the worker shell only: pid %s does not lead process group %s\n' \
      "$$" "$pgid" > "$REPO_STATE/diagnostic" 2>/dev/null || true
    pgid=""
  fi

  attempts="${SGT_DRAIN_TERMINATE_ATTEMPTS:-100}"
  [[ "$attempts" =~ ^[1-9][0-9]*$ ]] || attempts=100

  if [[ -z "$pgid" ]]; then
    kill -TERM "$$" 2>/dev/null || true
    for attempt in $(seq 1 "$attempts"); do
      kill -0 "$$" 2>/dev/null || break
      sleep "${SGT_DRAIN_TERMINATE_INTERVAL:-0.05}"
    done
  fi

  if [[ "$pgid" =~ ^[1-9][0-9]*$ ]]; then
    # Graceful first: the agent gets a chance to exit and the worker shell runs
    # its EXIT trap with the drained status already published.
    kill -TERM -"$pgid" 2>/dev/null || true
    for attempt in $(seq 1 "$attempts"); do
      kill -0 "$$" 2>/dev/null || break
      sleep "${SGT_DRAIN_TERMINATE_INTERVAL:-0.05}"
    done
  fi

  # Remove the pane before the final sweep, so pane removal cannot be lost to it.
  if [[ -n "${TMUX_PANE:-}" ]] && command -v tmux >/dev/null 2>&1; then
    tmux kill-pane -t "$TMUX_PANE" 2>/dev/null || true
  fi

  # Sweep anything that ignored TERM, including this subshell.
  if [[ "$pgid" =~ ^[1-9][0-9]*$ ]]; then
    kill -KILL -"$pgid" 2>/dev/null || true
  else
    kill -KILL "$$" 2>/dev/null || true
  fi
  exit 0
}

# _do_drain: publish durable drained state, then terminate.  Never returns.
_do_drain() {
  "$SCRIPT_DIR/sgt-td-memory" handoff "$REPO_STATE" "$WORKTREE" || true
  # A durable handoff settles the accepted action lease: either it is finalized
  # from the agent's own completion proof, or the drain is recorded as the reason
  # it stays outstanding.  Without this a cooperatively drained worker left the
  # lease pending forever and could never be resumed.
  _sgt_finalize_action_lease "$REPO_STATE" "$WORKTREE" "drain_handoff" || true
  printf 'drained\n' > "$WORKTREE/.sergeant-drained"
  printf 'drained\n' > "$WORKTREE/.sergeant-status"
  printf 'drained\n' > "$REPO_STATE/status"
  # Drain is not a way to discard unfinished work: no result is invented, and the
  # status stays the honest nonterminal `drained`.
  rm -f "$REPO_STATE/result"
  # Everything durable is now published; only after that does the worker stop.
  _drain_terminate
}

# _watch_drain: background loop — calls _do_drain when an active drain is detected.
# Runs parallel to _watch_progress and _deliver_notifications.
_watch_drain() {
  local _drain_triggered=false
  while :; do
    sleep "${SGT_DRAIN_CHECK_INTERVAL:-2}"
    if ! $_drain_triggered && [[ ! -f "$WORKTREE/.sergeant-drained" ]] && _drain_is_active; then
      _drain_triggered=true
      _do_drain
    fi
  done
}

# Record worker identity in fleet state so sgt-cleanup can terminate escaped
# descendants even after this pane has exited.  Writes are atomic (tmp+mv) to
# prevent cleanup from reading a partial state.
_record_worker_identity() {
  local pid pgid sid start marker generation marker_identity marker_fd marker_path actual_marker tmp
  pid="$$"
  pgid="$(ps -o pgid= -p "$$" 2>/dev/null | tr -d ' ' || true)"
  sid="$(_sgt_process_session_id "$$" 2>/dev/null || true)"
  start="$(_sgt_process_identity "$$" 2>/dev/null || true)"
  marker="$(_sgt_read_owned_file "$REPO_STATE/worker_process_marker" 2>/dev/null || true)"
  if [[ -n "$marker" ]]; then
    IFS='|' read -r generation marker_identity marker_fd marker_path <<< "$marker"
    actual_marker="$(_sgt_fd_identity 198 2>/dev/null || true)"
    if [[ ! "$generation" =~ ^[0-9a-f]{32}$ || "$marker_fd" != 198 ||
      "$marker_identity" != "$actual_marker" || -e "$marker_path" ]]; then
      printf 'worker process marker conflicts with durable launch ownership\n' > "$REPO_STATE/diagnostic"
      return 1
    fi
  fi
  [[ -n "$pgid" && -n "$sid" && -n "$start" ]] || return 0
  tmp="$(mktemp "$REPO_STATE/worker_pid.XXXXXX")" && \
    printf '%s\n' "$pid" > "$tmp" && mv "$tmp" "$REPO_STATE/worker_pid" || return 0
  tmp="$(mktemp "$REPO_STATE/worker_process_group.XXXXXX")" && \
    printf '%s\n' "$pgid" > "$tmp" && mv "$tmp" "$REPO_STATE/worker_process_group" || return 0
  tmp="$(mktemp "$REPO_STATE/worker_process_start.XXXXXX")" && \
    printf '%s\n' "$start" > "$tmp" && mv "$tmp" "$REPO_STATE/worker_process_start" || return 0
  tmp="$(mktemp "$REPO_STATE/worker_session_id.XXXXXX")" && \
    printf '%s\n' "$sid" > "$tmp" && mv "$tmp" "$REPO_STATE/worker_session_id" || return 0
}
if ! _record_worker_identity; then
  printf 'failed: worker process marker validation failed\n' > "$REPO_STATE/status"
  printf 'failed: worker process marker validation failed\n' \
    > "$WORKTREE/.sergeant-status"
  exit 2
fi

_status() {
  tr -d '\n' < "$WORKTREE/.sergeant-status" 2>/dev/null || echo "in_progress"
}

_record_progress() {
  date +%s > "$REPO_STATE/progress_ts" 2>/dev/null || true
}

# _watch_progress: background loop that updates progress_ts.
#
# Previously progress_ts was only updated when .sergeant-status or
# .sergeant-message changed (sentinel change).  On tmux 3.7b+ #{pane_activity}
# can be empty, so the snapshot falls back to progress_ts — and a live worker
# running tool calls without changing sentinels would appear idle after the
# SERGEANT_SNAPSHOT_RECENT_SECONDS window (GH #206).
#
# Fix: record progress on every loop tick while the worker is in_progress.
# This keeps progress_ts current as long as the supervisor process is alive,
# regardless of sentinel activity.  The stall classifier still uses a longer
# window (SERGEANT_STALL_SECONDS) and still requires actual tool activity
# beyond just process liveness for that check.
#
# Also writes .sergeant-drain-signal when a drain becomes active so the agent
# can checkpoint cooperatively before exit.
_watch_progress() {
  local prev_sentinel curr_sentinel drain_tmp current_status
  prev_sentinel="$(cat "$WORKTREE/.sergeant-status" "$WORKTREE/.sergeant-message" 2>/dev/null || true)"
  while :; do
    sleep "${SGT_PROGRESS_INTERVAL:-30}"
    curr_sentinel="$(cat "$WORKTREE/.sergeant-status" "$WORKTREE/.sergeant-message" 2>/dev/null || true)"
    # Update progress_ts on every tick while in_progress, not only on sentinel
    # changes.  This keeps the snapshot active-witness window current when
    # #{pane_activity} is unavailable (tmux 3.7b, issue GH #206).
    current_status="$(tr -d '\n' < "$WORKTREE/.sergeant-status" 2>/dev/null || echo 'in_progress')"
    if [[ "$current_status" == "in_progress" ]]; then
      _record_progress
    elif [[ "$curr_sentinel" != "$prev_sentinel" ]]; then
      # For non-in_progress transitions (e.g. blocked, waiting) still record.
      _record_progress
    fi
    prev_sentinel="$curr_sentinel"
    # Drain signal: write .sergeant-drain-signal so the agent can react
    # cooperatively to an active global or project drain without requiring a
    # SIGTERM.  Idempotent: skip when the file already exists.
    if [[ ! -f "$WORKTREE/.sergeant-drain-signal" ]] && _drain_is_active; then
      drain_tmp="$WORKTREE/.sergeant-drain-signal.tmp.$$"
      printf 'scope=%s\n' "${_PROJECT_NAME:-global}" > "$drain_tmp" && \
        mv "$drain_tmp" "$WORKTREE/.sergeant-drain-signal" || rm -f "$drain_tmp" 2>/dev/null || true
    fi
  done
}

_sync_state() {
  local status
  status="$(_status)"
  printf '%s\n' "$status" > "$REPO_STATE/status"
  _record_progress
  if [[ "$status" == "done" && -s "$WORKTREE/.sergeant-result" ]]; then
    cp "$WORKTREE/.sergeant-result" "$REPO_STATE/result"
  else
    rm -f "$REPO_STATE/result"
  fi
}

# Readiness is also the moment the launch record stops being a claim about
# intent and becomes evidence that this harness really came up, so promote the
# record here rather than asserting a confirmed launch before the fact.
_harness_ready() {
  [[ -n "${TMUX_PANE:-}" ]] || return 1
  _sgt_harness_ready "$harness" "$TMUX_PANE"
}

# ── Bounded readiness ─────────────────────────────────────────────────────────
# Readiness used to be an unbounded gate: `_harness_ready || { sleep; continue; }`
# spun forever when readiness could not be satisfied, and the eventual exit was
# recorded as a misleading `orphaned`.  The gate below waits at most
# SGT_HARNESS_READY_TIMEOUT seconds per notification target, then reports the
# unreachable state exactly once as durable nonce-scoped evidence plus a
# recoverable needs_input gate.  It never fabricates acknowledgement,
# acceptance, delivery, completion, or an action lease.

_SGT_READY_GATE_KEY=""
_SGT_READY_GATE_SINCE=""
_SGT_READY_GATE_REPORTED=""

_harness_ready_timeout() {
  local timeout="${SGT_HARNESS_READY_TIMEOUT-300}"
  [[ "$timeout" =~ ^[0-9]+$ ]] || timeout=300
  printf '%s\n' "$timeout"
}

# _publish_readiness_failure: record an unreachable readiness state once.
_publish_readiness_failure() {
  local notification_id="$1" nonce="$2" target_dir="$3" waited="$4"
  local generation reason temporary
  reason="interactive $harness harness never reached a deliverable prompt: notification $notification_id readiness unmet after ${waited}s"
  temporary="$target_dir/readiness_failed.tmp.$$"
  {
    printf 'notification_id=%s\n' "$notification_id"
    printf 'target_nonce=%s\n' "$nonce"
    printf 'harness=%s\n' "$harness"
    printf 'waited_seconds=%s\n' "$waited"
    printf 'reason=%s\n' "$reason"
  } > "$temporary" || { rm -f "$temporary"; return 1; }
  mv "$temporary" "$target_dir/readiness_failed" || { rm -f "$temporary"; return 1; }
  printf '%s\n' "$reason" > "$REPO_STATE/diagnostic"
  generation="$(tr -d '\n' < "$WORKTREE/.sergeant-gate-generation" 2>/dev/null || true)"
  [[ "$generation" =~ ^[0-9]+$ ]] || generation=0
  generation=$((generation + 1))
  printf '%s\n' "$generation" > "$WORKTREE/.sergeant-gate-generation"
  {
    printf '%s\n' "$reason"
    printf '\n'
    printf 'evidence: %s\n' "$target_dir/readiness_failed"
    printf 'No acknowledgement, acceptance, delivery, or action lease was fabricated; the notification is still pending.\n'
    printf 'Confirm the harness can render an interactive prompt, then resume with sgt-respond.\n'
  } > "$WORKTREE/.sergeant-message"
  cp "$WORKTREE/.sergeant-message" "$REPO_STATE/message" 2>/dev/null || true
  printf 'needs_input\n' > "$WORKTREE/.sergeant-status"
  printf 'needs_input\n' > "$REPO_STATE/status"
}

# _harness_ready_gate: 0 when the pane can receive the nudge; 1 otherwise.
# Reports once when the readiness bound for this notification target elapses.
_harness_ready_gate() {
  local notification_id="$1" nonce="$2" target_dir="$3"
  local key now timeout waited
  _harness_ready && return 0
  key="$notification_id|$nonce"
  now="$(date +%s)"
  [[ "$now" =~ ^[0-9]+$ ]] || return 1
  if [[ "$_SGT_READY_GATE_KEY" != "$key" ]]; then
    _SGT_READY_GATE_KEY="$key"
    _SGT_READY_GATE_SINCE="$now"
    _SGT_READY_GATE_REPORTED=""
  fi
  # Already reported for this target: stay unready without re-reporting.
  [[ -z "$_SGT_READY_GATE_REPORTED" ]] || return 1
  [[ "$_SGT_READY_GATE_SINCE" =~ ^[0-9]+$ ]] || return 1
  (( now >= _SGT_READY_GATE_SINCE )) || return 1
  timeout="$(_harness_ready_timeout)"
  waited=$(( now - _SGT_READY_GATE_SINCE ))
  (( waited >= timeout )) || return 1
  if [[ -f "$target_dir/readiness_failed" ]]; then
    _SGT_READY_GATE_REPORTED="$key"
    return 1
  fi
  _publish_readiness_failure "$notification_id" "$nonce" "$target_dir" "$waited" || return 1
  _SGT_READY_GATE_REPORTED="$key"
  return 1
}

_finish() {
  local exit_code="$1" status
  trap - EXIT
  [[ -z "${notification_pid:-}" ]] || kill "$notification_pid" 2>/dev/null || true
  [[ -z "${watch_progress_pid:-}" ]] || kill "$watch_progress_pid" 2>/dev/null || true
  [[ -z "${watch_drain_pid:-}" ]] || kill "$watch_drain_pid" 2>/dev/null || true
  # A background loop may have been killed mid-critical-section, leaving a
  # response lock recorded against this still-live PID.  Every loop is dead now,
  # so reclaiming our own lock is safe — and necessary, because acquiring it
  # would otherwise wait on our own liveness forever.
  _sgt_response_lock_reclaim "$REPO_STATE"
  status="$(_status)"
  # Settle the accepted action lease at the exit boundary, before any branch can
  # return.  This covers done, failed, drained, needs_input, blocked, waiting and
  # orphaned alike: the lease is either finalized from the agent's own completion
  # proof or explicitly recorded as pending with the exit reason.  No branch may
  # exit leaving it silently outstanding.  The background loops are already dead,
  # so there is no competing writer.
  _sgt_finalize_action_lease "$REPO_STATE" "$WORKTREE" "worker_exit:$status" || true
  case "$status" in
    done)
      if [[ ! -s "$WORKTREE/.sergeant-result" ]]; then
        status="orphaned"
      fi
      ;;
    drained)
      # Worker checkpointed cooperatively in response to a drain signal.
      # .sergeant-drained and td handoff were already written by _do_drain.
      _sync_state
      rm -f "$REPO_STATE/diagnostic"
      exit 0
      ;;
    needs_input|blocked|waiting)
      _sync_state
      rm -f "$REPO_STATE/diagnostic"
      "$SCRIPT_DIR/sgt-td-memory" handoff "$REPO_STATE" "$WORKTREE" || true
      exit "$exit_code"
      ;;
    failed:*) ;;
    *) status="orphaned" ;;
  esac
  if [[ "$status" == "orphaned" ]]; then
    printf 'orphaned\n' > "$WORKTREE/.sergeant-status"
    printf 'orphaned\n' > "$REPO_STATE/status"
    # Check for committed work above the dispatch base so the coordinator can
    # distinguish a clean orphan (nothing committed) from an interrupted fallback
    # that has real work.  Uses initial_sha written by sgt-dispatch at dispatch
    # time; falls back to checking for commits not on any remote.
    local _initial_sha _committed_log
    _initial_sha="$(cat "$REPO_STATE/initial_sha" 2>/dev/null || true)"
    _committed_log=""
    if command -v git >/dev/null 2>&1 && [[ -d "$WORKTREE" ]]; then
      if [[ -n "$_initial_sha" ]]; then
        _committed_log="$(git -C "$WORKTREE" log --oneline "${_initial_sha}..HEAD" 2>/dev/null || true)"
      else
        # Fallback for fleet states predating initial_sha: show commits not in
        # the upstream tracking branch (if configured).
        _committed_log="$(git -C "$WORKTREE" log --oneline HEAD --not "@{u}" 2>/dev/null || true)"
      fi
    fi
    {
      printf 'reason: interactive %s session exited before terminal completion\n' "$harness"
      printf 'exit code: %s\n' "$exit_code"
      if [[ -n "$_committed_log" ]]; then
        printf 'committed-work-present: %d commit(s) above base; reconcile before re-dispatch\n' \
          "$(printf '%s\n' "$_committed_log" | wc -l | tr -d ' ')"
        printf '%s\n' "$_committed_log"
      fi
    } > "$REPO_STATE/diagnostic"
    "$SCRIPT_DIR/sgt-td-memory" handoff "$REPO_STATE" "$WORKTREE" || true
  else
    _sync_state
    rm -f "$REPO_STATE/diagnostic"
  fi
  exit "$exit_code"
}

_deliver_notifications() {
  local notification_file="$WORKTREE/.sergeant-notification"
  local accept_path ack_path ack_token complete_path delivered expected_id lease notification_id
  local nonce pane_identity pending target_dir target_identity
  while :; do
    # Retry a previously failed release before reacquiring; see the shared
    # _sgt_response_lock_release contract in bin/_sgt-response-lock.sh.
    if [[ -n "${_SGT_RESPONSE_LOCK_DIR:-}" ]]; then
      _sgt_response_lock_release || { sleep "${SGT_NOTIFICATION_RETRY_INTERVAL:-1}"; continue; }
    fi
    notification_id="$(sed -n 's/^notification_id=//p' "$notification_file" 2>/dev/null || true)"
    expected_id="$(cat "$REPO_STATE/notification_id" 2>/dev/null || true)"
    pane_identity="$(_sgt_pane_identity "${TMUX_PANE:-}")" || pane_identity=""
    nonce="$(cat "$REPO_STATE/notification_target" 2>/dev/null || true)"
    target_dir="$REPO_STATE/notifications/$notification_id/targets/$nonce"
    target_identity="$(cat "$target_dir/pane_identity" 2>/dev/null || true)"
    ack_token="$notification_id|$nonce"
    ack_path="$WORKTREE/.sergeant-notification-acks/$nonce"
    accept_path="$WORKTREE/.sergeant-notification-accepts/$nonce"
    complete_path="$WORKTREE/.sergeant-notification-complete/$nonce"
    delivered="$(cat "$target_dir/delivered" 2>/dev/null || true)"
    if [[ -n "$notification_id" && "$notification_id" == "$expected_id" &&
          "$nonce" =~ ^[a-f0-9]{32}$ && -n "$pane_identity" &&
          "$target_identity" == "$pane_identity" ]]; then
      if [[ "$(cat "$ack_path" 2>/dev/null || true)" != "$ack_token" &&
            "$(cat "$complete_path" 2>/dev/null || true)" != "$ack_token" ]]; then
        _harness_ready_gate "$notification_id" "$nonce" "$target_dir" || {
          sleep "${SGT_NOTIFICATION_RETRY_INTERVAL:-1}"
          continue
        }
      fi
      mkdir -p "$(dirname "$ack_path")" "$(dirname "$accept_path")" \
        "$(dirname "$complete_path")"
      # The agent published its own completion proof for this turn.  Settle the
      # lease through the one shared finalizer rather than a second inline
      # implementation; it takes the response lock, re-verifies identity, lease
      # and proof under it, and records the outcome either way.
      if [[ "$(cat "$complete_path" 2>/dev/null || true)" == "$ack_token" &&
            ! -f "$target_dir/completed" ]]; then
        _sgt_finalize_action_lease "$REPO_STATE" "$WORKTREE" "notification_complete" || true
      fi
      # Once acceptance delivery is durable, execution belongs to the agent.
      # Keep publishing completion evidence silently without replaying the nudge.
      if [[ "$delivered" == "$ack_token" ]]; then
        sleep "${SGT_NOTIFICATION_RETRY_INTERVAL:-1}"
        continue
      fi
      if [[ "$delivered" != "$ack_token" && "$(cat "$ack_path" 2>/dev/null || true)" == "$ack_token" ]]; then
        if ! _sgt_response_lock_acquire "$REPO_STATE"; then
          sleep "${SGT_NOTIFICATION_RETRY_INTERVAL:-1}"
          continue
        fi
        pane_identity="$(_sgt_pane_identity "${TMUX_PANE:-}")" || pane_identity=""
        if [[ "$(cat "$REPO_STATE/notification_id" 2>/dev/null || true)" != "$notification_id" ||
              "$(cat "$REPO_STATE/notification_target" 2>/dev/null || true)" != "$nonce" ||
              "$(cat "$target_dir/pane_identity" 2>/dev/null || true)" != "$pane_identity" ]]; then
          _sgt_response_lock_release || { sleep "${SGT_NOTIFICATION_RETRY_INTERVAL:-1}"; continue; }
          sleep "${SGT_NOTIFICATION_RETRY_INTERVAL:-1}"
          continue
        fi
        lease="$(cat "$REPO_STATE/notifications/$notification_id/action_lease" 2>/dev/null || true)"
        if [[ -n "$lease" && "$lease" != "$nonce" ]]; then
          _sgt_response_lock_release || { sleep "${SGT_NOTIFICATION_RETRY_INTERVAL:-1}"; continue; }
          sleep "${SGT_NOTIFICATION_RETRY_INTERVAL:-1}"
          continue
        fi
        if [[ -z "$lease" ]]; then
          pending="$(mktemp "$REPO_STATE/notifications/$notification_id/action_lease.tmp.XXXXXX")" || {
            _sgt_response_lock_release || { sleep "${SGT_NOTIFICATION_RETRY_INTERVAL:-1}"; continue; }
            continue
          }
          if ! printf '%s\n' "$nonce" > "$pending" ||
             ! mv "$pending" "$REPO_STATE/notifications/$notification_id/action_lease"; then
            rm -f "$pending"
            _sgt_response_lock_release || { sleep "${SGT_NOTIFICATION_RETRY_INTERVAL:-1}"; continue; }
            continue
          fi
        fi
        [[ "$(cat "$REPO_STATE/notifications/$notification_id/action_lease" 2>/dev/null || true)" == "$nonce" ]] || {
          _sgt_response_lock_release || { sleep "${SGT_NOTIFICATION_RETRY_INTERVAL:-1}"; continue; }
          continue
        }
        pending="$target_dir/acknowledged.tmp.$$"
        printf '%s\n' "$ack_token" > "$pending"
        if ! mv "$pending" "$target_dir/acknowledged"; then
          rm -f "$pending"
          _sgt_response_lock_release || { sleep "${SGT_NOTIFICATION_RETRY_INTERVAL:-1}"; continue; }
          sleep "${SGT_NOTIFICATION_RETRY_INTERVAL:-1}"
          continue
        fi
        pane_identity="$(_sgt_pane_identity "${TMUX_PANE:-}")" || pane_identity=""
        [[ "$(cat "$REPO_STATE/notification_target" 2>/dev/null || true)" == "$nonce" &&
           "$(cat "$target_dir/pane_identity" 2>/dev/null || true)" == "$pane_identity" ]] || {
          _sgt_response_lock_release || { sleep "${SGT_NOTIFICATION_RETRY_INTERVAL:-1}"; continue; }
          continue
        }
        pending="$accept_path.tmp.$$"
        printf '%s\n' "$ack_token" > "$pending"
        if ! mv "$pending" "$accept_path"; then
          rm -f "$pending"
          _sgt_response_lock_release || { sleep "${SGT_NOTIFICATION_RETRY_INTERVAL:-1}"; continue; }
          continue
        fi
        pending="$target_dir/accepted.tmp.$$"
        printf '%s\n' "$ack_token" > "$pending"
        if ! mv "$pending" "$target_dir/accepted"; then
          rm -f "$pending"
          rm -f "$accept_path"
          _sgt_response_lock_release || { sleep "${SGT_NOTIFICATION_RETRY_INTERVAL:-1}"; continue; }
          continue
        fi
        tmux send-keys -t "$TMUX_PANE" -l -- \
          "Sergeant accepted $ack_token. Wait for it in $accept_path, follow the notification exactly once, then write it to $complete_path." 2>/dev/null || {
          _sgt_response_lock_release || { sleep "${SGT_NOTIFICATION_RETRY_INTERVAL:-1}"; continue; }
          continue
        }
        pane_identity="$(_sgt_pane_identity "${TMUX_PANE:-}")" || pane_identity=""
        [[ "$(cat "$REPO_STATE/notification_target" 2>/dev/null || true)" == "$nonce" &&
           "$(cat "$target_dir/pane_identity" 2>/dev/null || true)" == "$pane_identity" ]] || {
          _sgt_response_lock_release || { sleep "${SGT_NOTIFICATION_RETRY_INTERVAL:-1}"; continue; }
          continue
        }
        tmux send-keys -t "$TMUX_PANE" Enter 2>/dev/null || {
          _sgt_response_lock_release || { sleep "${SGT_NOTIFICATION_RETRY_INTERVAL:-1}"; continue; }
          continue
        }
        pane_identity="$(_sgt_pane_identity "${TMUX_PANE:-}")" || pane_identity=""
        [[ "$(cat "$REPO_STATE/notification_target" 2>/dev/null || true)" == "$nonce" &&
           "$(cat "$target_dir/pane_identity" 2>/dev/null || true)" == "$pane_identity" ]] || {
          _sgt_response_lock_release || { sleep "${SGT_NOTIFICATION_RETRY_INTERVAL:-1}"; continue; }
          continue
        }
        pending="$target_dir/delivered.tmp.$$"
        printf '%s\n' "$ack_token" > "$pending"
        if ! mv "$pending" "$target_dir/delivered"; then
          rm -f "$pending"
          _sgt_response_lock_release || { sleep "${SGT_NOTIFICATION_RETRY_INTERVAL:-1}"; continue; }
          sleep "${SGT_NOTIFICATION_RETRY_INTERVAL:-1}"
          continue
        fi
        _sgt_response_lock_release || { sleep "${SGT_NOTIFICATION_RETRY_INTERVAL:-1}"; continue; }
      elif [[ -n "${TMUX_PANE:-}" ]]; then
        pane_identity="$(_sgt_pane_identity "${TMUX_PANE:-}")" || pane_identity=""
        [[ "$(cat "$REPO_STATE/notification_target" 2>/dev/null || true)" == "$nonce" &&
           "$(cat "$target_dir/pane_identity" 2>/dev/null || true)" == "$pane_identity" ]] || continue
        tmux send-keys -t "$TMUX_PANE" -l -- \
          "Sergeant notification $notification_id is available in .sergeant-notification. Read it, write $ack_token to $ack_path, and do not act until this supervisor sends acceptance and $accept_path contains that token." 2>/dev/null || continue
        pane_identity="$(_sgt_pane_identity "${TMUX_PANE:-}")" || pane_identity=""
        [[ "$(cat "$REPO_STATE/notification_target" 2>/dev/null || true)" == "$nonce" &&
           "$(cat "$target_dir/pane_identity" 2>/dev/null || true)" == "$pane_identity" ]] || continue
        tmux send-keys -t "$TMUX_PANE" Enter 2>/dev/null || true
      fi
    fi
    sleep "${SGT_NOTIFICATION_RETRY_INTERVAL:-1}"
  done
}

[[ -f "$WORKTREE/.sergeant-status" ]] || printf 'in_progress\n' > "$WORKTREE/.sergeant-status"
_sync_state
printf 'interactive\n' > "$REPO_STATE/worker_mode"
trap '_finish $?' EXIT

cd "$WORKTREE" || exit 2
_deliver_notifications &
notification_pid=$!
_watch_progress &
watch_progress_pid=$!
_watch_drain &
watch_drain_pid=$!

# Build launch argv from the resolved harness contract.  SGT_LAUNCH_BASE_ARGV
# was populated by _sgt_resolve_agent_launch from the same registry that gated
# acceptance and supplies the readiness probe, so base args, model pin, and
# readiness cannot diverge.
set --
if [[ "${#SGT_LAUNCH_BASE_ARGV[@]}" -gt 0 ]]; then
  set -- "${SGT_LAUNCH_BASE_ARGV[@]}"
fi
if [[ "${#SGT_LAUNCH_MODEL_ARGV[@]}" -gt 0 ]]; then
  set -- "$@" "${SGT_LAUNCH_MODEL_ARGV[@]}"
fi
if [[ "${#SGT_LAUNCH_MODEL_ENV[@]}" -gt 0 ]]; then
  for _launch_pair in "${SGT_LAUNCH_MODEL_ENV[@]}"; do
    [[ "$_launch_pair" == ?*=* ]] || {
      echo "ERROR: malformed launch environment pair: $_launch_pair" >&2
      exit 2
    }
    # shellcheck disable=SC2163  # Deliberate: the word is a NAME=VALUE assignment.
    export "$_launch_pair"
  done
fi
rm -f "$REPO_STATE/launch_record"
if ! _write_launch_record intended; then
  printf 'launch evidence unwritable at %s/launch_record\n' "$REPO_STATE" \
    > "$REPO_STATE/diagnostic"
  printf 'failed: cannot record launch evidence\n' > "$REPO_STATE/status"
  printf 'failed: cannot record launch evidence\n' > "$WORKTREE/.sergeant-status"
  echo "ERROR: cannot record launch evidence; refusing to launch unprovable worker" >&2
  exit 2
fi
"$AGENT" "$@"
