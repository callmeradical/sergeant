#!/usr/bin/env bash
# sgt-drain — Set or remove a persistent drain on a Sergeant project or globally.
#
# When drained, new pane starts from response-driven relaunches and stall
# recovery are refused for matching projects.  Responses are stored
# generation-safely for later delivery.
#
# Usage:
#   sgt-drain [<project>] [--reason <text>] [--wait [--timeout <s>]]
#   sgt-drain --global    [--reason <text>] [--wait [--timeout <s>]]
#   sgt-drain --undrain   <project>            # undrain a project
#   sgt-drain --undrain   --global             # undrain globally
#   sgt-drain --status    [<project>|--global] # show active drain state
#
# Options:
#   --reason <text>   Human-readable explanation recorded with the drain state.
#   --undrain         Remove an active drain (undrain-only; does not reevaluate).
#   --global          Target the global drain that covers all projects.
#   --status          Print active drain state for the given scope (or all scopes).
#   --wait            After activating the drain, wait for live workers in scope
#                     to finish their current turn and exit.  The drain is always
#                     activated BEFORE waiting, so no new work is admitted while
#                     waiting.  Exits nonzero on timeout with the drain still
#                     active and the unresolved workers named; workers are never
#                     terminated.
#   --timeout <s>     Bound for --wait, in seconds
#                     (default: $SERGEANT_DRAIN_WAIT_TIMEOUT_SECS, else 300).
#
# Environment:
#   SERGEANT_DRAIN_WAIT_TIMEOUT_SECS    default --wait bound (default 300)
#   SERGEANT_DRAIN_WAIT_INTERVAL_SECS   --wait poll interval (default 2)
#   SERGEANT_DRAIN_LOCK_TIMEOUT_SECS    admission lock bound (default 10)

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=bin/_sgt-lib.sh
source "$SCRIPT_DIR/_sgt-lib.sh"
# shellcheck source=bin/_sgt-drain.sh
source "$SCRIPT_DIR/_sgt-drain.sh"

_die() { echo "ERROR: $*" >&2; exit 1; }

# _is_lock_artifact <name>
#
# True for any file the admission lock owns, plus the temp files _sgt_drain_write
# creates.  These share the drain directory with drain files but are not drains.
_is_lock_artifact() {
  local name="$1" lock_base
  lock_base="$(basename "$(_sgt_drain_lock_file)")"
  case "$name" in
    "$lock_base"|"$lock_base".*) return 0 ;;
    *.tmp.*)                     return 0 ;;
  esac
  return 1
}

# ── Parse arguments ───────────────────────────────────────────────────────────

MODE="drain"          # drain | undrain | status
SCOPE=""              # "global" | <project-name> | "" (all, for status)
PROJECT=""            # explicit project name, if one was given
GLOBAL=false          # whether --global was given
REASON=""
WAIT=false
TIMEOUT=""

# _require_uint <name> <value>
#
# Rejects anything that is not a whole number of seconds.  Unvalidated values
# would silently become 0 inside arithmetic, turning a bounded wait into an
# immediate timeout, or abort `sleep` midway with the drain already active.
_require_uint() {
  case "$2" in
    ''|*[!0-9]*) _die "$1 must be a non-negative whole number of seconds: $2" ;;
  esac
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --undrain)
      MODE="undrain"
      shift
      ;;
    --wait)
      WAIT=true
      shift
      ;;
    --timeout)
      [[ $# -ge 2 ]] || _die "--timeout requires a value"
      TIMEOUT="$2"
      _require_uint "--timeout" "$TIMEOUT"
      shift 2
      ;;
    --global)
      GLOBAL=true
      shift
      ;;
    --status)
      MODE="status"
      shift
      ;;
    --reason)
      [[ $# -ge 2 ]] || _die "--reason requires a value"
      REASON="$2"
      shift 2
      ;;
    --*)
      _die "Unknown option: $1"
      ;;
    *)
      [[ -z "$PROJECT" ]] || _die "Unexpected argument: $1 (project already set to '$PROJECT')"
      [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || \
        _die "Invalid project name: $1 (must match [A-Za-z0-9][A-Za-z0-9._-]*)"
      # A project whose drain file would collide with an admission-lock artifact
      # is refused, so no drain or undrain can ever target the live lock.
      ! _is_lock_artifact "$1" || \
        _die "Invalid project name: $1 (reserved for drain admission lock state)"
      PROJECT="$1"
      shift
      ;;
  esac
done

# A project name and --global are contradictory scopes.  Silently letting
# --global win would escalate a one-project pause into blocking every project.
if $GLOBAL && [[ -n "$PROJECT" ]]; then
  _die "--global cannot be combined with the project name '$PROJECT'; choose one scope"
fi
if $GLOBAL; then
  SCOPE="global"
else
  SCOPE="$PROJECT"
fi

# Waiting only means something while setting a drain: there is nothing to wait
# for when reporting state or removing a drain.
if $WAIT && [[ "$MODE" != "drain" ]]; then
  _die "--wait is only valid when setting a drain (not with --undrain or --status)"
fi
if [[ -n "$TIMEOUT" ]] && ! $WAIT; then
  _die "--timeout requires --wait"
fi

# ── Bounded drain wait ────────────────────────────────────────────────────────
#
# A cooperative drain asks live workers to finish the current turn and exit.  A
# worker is unresolved when its recorded status is not terminal AND its exit
# cannot be proven.  Absence of identity is NOT proof of exit: a worker whose
# pane is running but whose identity was never recorded — sgt-interactive-worker
# skips _record_worker_identity when ps cannot report a pgid or start time —
# must block the wait rather than be silently counted as finished.
#
# Only a worker whose recorded process is PROVABLY gone is treated as resolved.
# That covers the durable-handoff cases (waiting, needs_input, blocked after the
# pane exited), which genuinely have nothing left to drain.

# _fleet_read <file>
#
# Prints a single-line fleet state value, or nothing when the file is absent.
# Guarded with -f rather than a redirect suppression, because `< missing` is
# reported by the shell before any command redirection can silence it.
_fleet_read() {
  [[ -f "$1" ]] || return 0
  tr -d '\n' < "$1" 2>/dev/null || true
}

# _worker_liveness <repo_dir>
#
# Publishes _WORKER_PID and _WORKER_LIVENESS, which is one of:
#   live          the recorded process is running
#   gone          the recorded process provably exited (or its PID was reused)
#   unverifiable  no usable identity, so exit cannot be proven
#
# Results are published in globals rather than on stdout: a command
# substitution would evaluate this in a subshell, and the pid would never reach
# the caller.
_worker_liveness() {
  local repo_dir="$1" pid recorded_start actual_start alive_rc
  _WORKER_PID="$(_fleet_read "$repo_dir/worker_pid")"
  _WORKER_LIVENESS="unverifiable"
  case "$_WORKER_PID" in
    ''|*[!0-9]*)
      _WORKER_PID="unknown"
      return 0
      ;;
  esac
  pid="$_WORKER_PID"

  alive_rc=0
  _sgt_drain_process_alive "$pid" || alive_rc=$?
  if [[ $alive_rc -eq 1 ]]; then
    _WORKER_LIVENESS="gone"
    return 0
  fi
  [[ $alive_rc -eq 0 ]] || return 0

  # The pid exists: a changed start token means it is a different process now.
  # sgt-interactive-worker records worker_process_start with `ps -o lstart=`, so
  # the comparison must use the same producer.  When ps cannot report it, the
  # tokens are incomparable and the worker stays unresolved rather than being
  # declared gone.
  recorded_start="$(_fleet_read "$repo_dir/worker_process_start")"
  actual_start="$(ps -o lstart= -p "$pid" 2>/dev/null | sed 's/^ *//;s/ *$//' || true)"
  if [[ -n "$recorded_start" && -n "$actual_start" && "$actual_start" != "$recorded_start" ]]; then
    _WORKER_LIVENESS="gone"
    return 0
  fi
  _WORKER_LIVENESS="live"
  return 0
}

# _unresolved_workers <scope>
#
# Prints one "<task>/<repo> status=<s> pid=<p> liveness=<l>" line per worker in
# scope whose exit is not proven.  Prints nothing when the scope is fully
# drained.  A nonterminal worker with no recorded project cannot be attributed
# to a scope, so it is reported rather than skipped.
_unresolved_workers() {
  local scope="$1" task_dir repo_dir task repo status project
  [[ -d "$FLEET_DIR" ]] || return 0
  for task_dir in "$FLEET_DIR"/*/; do
    [[ -d "$task_dir" ]] || continue
    task="$(basename "$task_dir")"
    for repo_dir in "$task_dir"*/; do
      [[ -d "$repo_dir" ]] || continue
      repo="$(basename "$repo_dir")"
      status="$(_fleet_read "$repo_dir/status")"
      # Statuses a cooperative drain can never resolve by waiting, so liveness
      # is irrelevant for them.  This list is intentionally narrower than
      # sgt-drain-force's: force decides whom to kill, whereas --wait decides
      # whether everyone has exited.  `done` and `drained` are deliberately NOT
      # here:
      # sgt-interactive-worker writes `drained` BEFORE killing its pane and
      # before its exit-path handoff runs, so a worker claiming to be finished
      # can still be executing.  Those statuses are checked against liveness
      # below instead.
      case "$status" in
        force-stopped|orphaned|failed*) continue ;;
      esac
      project="$(_fleet_read "$repo_dir/project")"
      if [[ "$scope" != "global" && -n "$project" ]]; then
        [[ "$project" == "$scope" ]] || continue
      fi
      _worker_liveness "$repo_dir"
      [[ "$_WORKER_LIVENESS" != "gone" ]] || continue
      # A worker whose status already claims completion, and whose exit simply
      # cannot be verified, is accepted at its word: blocking every drain
      # forever on long-finished workers that predate identity recording would
      # be worse than trusting a terminal claim.  A claim contradicted by a LIVE
      # process is not accepted.
      if [[ "$_WORKER_LIVENESS" == "unverifiable" ]]; then
        case "$status" in
          done|drained) continue ;;
        esac
      fi
      printf '%s/%s status=%s pid=%s liveness=%s project=%s\n' \
        "$task" "$repo" "${status:-unknown}" "$_WORKER_PID" "$_WORKER_LIVENESS" \
        "${project:-unknown}"
    done
  done
}

# _await_drained <scope>
#
# Waits for every live worker in scope to exit.  Returns 0 when the scope is
# clear; on timeout it names the unresolved workers and returns 1, leaving the
# drain active and every worker running.
_await_drained() {
  local scope="$1" unresolved deadline timeout interval count
  timeout="${TIMEOUT:-${SERGEANT_DRAIN_WAIT_TIMEOUT_SECS:-300}}"
  interval="${SERGEANT_DRAIN_WAIT_INTERVAL_SECS:-2}"
  _require_uint "SERGEANT_DRAIN_WAIT_TIMEOUT_SECS" "$timeout"
  _require_uint "SERGEANT_DRAIN_WAIT_INTERVAL_SECS" "$interval"
  deadline=$(( $(date +%s) + timeout ))
  while :; do
    unresolved="$(_unresolved_workers "$scope")"
    if [[ -z "$unresolved" ]]; then
      echo "sgt-drain: ${scope} drained; no live workers remain."
      return 0
    fi
    if [[ $(date +%s) -ge $deadline ]]; then
      count="$(printf '%s\n' "$unresolved" | wc -l | tr -d ' ')"
      {
        printf 'ERROR: drain for %s is ACTIVE, but %s worker(s) did not finish within %ss:\n' \
          "$scope" "$count" "$timeout"
        printf '%s\n' "$unresolved" | sed 's/^/  /'
        printf 'ERROR: they were left running and were NOT terminated; rerun with --wait or resolve them individually.\n'
      } >&2
      return 1
    fi
    sleep "$interval"
  done
}

# ── Execute ───────────────────────────────────────────────────────────────────

drain_dir="$(_sgt_drain_state_dir)"

if [[ "$MODE" == "status" ]]; then
  # Show active drain state.  With no scope, report global and all project drains.
  found=0
  global_file="$(_sgt_drain_global_file)"
  if [[ -z "$SCOPE" || "$SCOPE" == "global" ]]; then
    if [[ -f "$global_file" ]]; then
      echo "global drain: active"
      grep -E "^reason=|^created_at=|^created=" "$global_file" 2>/dev/null | sed 's/^/  /' || true
      found=1
    elif [[ "$SCOPE" == "global" ]]; then
      echo "global drain: none"
    fi
  fi
  if [[ -n "$SCOPE" && "$SCOPE" != "global" ]]; then
    scope_file="$(_sgt_drain_project_file "$SCOPE")"
    if [[ -f "$scope_file" ]]; then
      echo "${SCOPE} drain: active"
      grep -E "^reason=|^created_at=|^created=" "$scope_file" 2>/dev/null | sed 's/^/  /' || true
      found=1
    else
      echo "${SCOPE} drain: none"
    fi
  elif [[ -z "$SCOPE" ]]; then
    # Scan all project drains
    if [[ -d "$drain_dir" ]]; then
      while IFS= read -r -d '' drain_file; do
        name="$(basename "$drain_file")"
        [[ "$name" == "global" ]] && continue
        # Lock records, their staging copies, their quarantine copies, and
        # in-flight drain temp files all live in this directory and are NOT
        # drains.  Reporting them would invent drains that nobody set — and the
        # obvious response, `sgt-drain --undrain <that name>`, would delete a
        # lock a live dispatch is holding.
        _is_lock_artifact "$name" && continue
        echo "${name} drain: active"
        grep -E "^reason=|^created_at=|^created=" "$drain_file" 2>/dev/null | sed 's/^/  /' || true
        found=1
      done < <(find "$drain_dir" -maxdepth 1 -type f -print0 2>/dev/null)
    fi
    [[ $found -eq 1 ]] || echo "no active drain"
  fi
  exit 0
fi

[[ -n "$SCOPE" ]] || _die "Must specify a project name or --global"

if [[ "$SCOPE" == "global" ]]; then
  drain_file="$(_sgt_drain_global_file)"
else
  drain_file="$(_sgt_drain_project_file "$SCOPE")"
fi

# Locked mutations pass argv, never a shell string: --reason is caller-supplied
# text and must not be re-parsed by the shell.
if [[ "$MODE" == "undrain" ]]; then
  _sgt_drain_run_locked _sgt_drain_clear "$drain_file"
  echo "sgt-drain: undrained ${SCOPE}."
else
  _sgt_drain_run_locked _sgt_drain_write "$drain_file" "${REASON:-}" ""
  echo "sgt-drain: drained ${SCOPE}."
  # The drain is active from here on, so waiting never admits new work.
  if $WAIT; then
    _await_drained "$SCOPE"
  fi
fi
