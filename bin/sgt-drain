#!/usr/bin/env bash
# sgt-drain — Set or remove a persistent drain on a Sergeant project or globally.
#
# When drained, new pane starts from response-driven relaunches and stall
# recovery are refused for matching projects.  Responses are stored
# generation-safely for later delivery.
#
# Usage:
#   sgt-drain [<project>] [--reason <text>]    # drain a project
#   sgt-drain --global    [--reason <text>]    # drain all projects
#   sgt-drain --undrain   <project>            # undrain a project
#   sgt-drain --undrain   --global             # undrain globally
#   sgt-drain --status    [<project>|--global] # show active drain state
#
# Options:
#   --reason <text>   Human-readable explanation recorded with the drain state.
#   --undrain         Remove an active drain (undrain-only; does not reevaluate).
#   --global          Target the global drain that covers all projects.
#   --status          Print active drain state for the given scope (or all scopes).

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=bin/_sgt-lib.sh
source "$SCRIPT_DIR/_sgt-lib.sh"
# shellcheck source=bin/_sgt-drain.sh
source "$SCRIPT_DIR/_sgt-drain.sh"

_die() { echo "ERROR: $*" >&2; exit 1; }

# ── Parse arguments ───────────────────────────────────────────────────────────

MODE="drain"          # drain | undrain | status
SCOPE=""              # "global" | <project-name> | "" (all, for status)
REASON=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --undrain)
      MODE="undrain"
      shift
      ;;
    --global)
      SCOPE="global"
      shift
      ;;
    --status)
      MODE="status"
      shift
      ;;
    --reason)
      [[ $# -ge 2 ]] || _die "--reason requires a value"
      REASON="$2"
      shift 2
      ;;
    --*)
      _die "Unknown option: $1"
      ;;
    *)
      [[ -z "$SCOPE" ]] || _die "Unexpected argument: $1 (scope already set to '$SCOPE')"
      [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || \
        _die "Invalid project name: $1 (must match [A-Za-z0-9][A-Za-z0-9._-]*)"
      SCOPE="$1"
      shift
      ;;
  esac
done

# ── Execute ───────────────────────────────────────────────────────────────────

drain_dir="$(_sgt_drain_state_dir)"

if [[ "$MODE" == "status" ]]; then
  # Show active drain state.  With no scope, report global and all project drains.
  found=0
  global_file="$(_sgt_drain_global_file)"
  if [[ -z "$SCOPE" || "$SCOPE" == "global" ]]; then
    if [[ -f "$global_file" ]]; then
      echo "global drain: active"
      grep -E "^reason=|^created_at=|^created=" "$global_file" 2>/dev/null | sed 's/^/  /' || true
      found=1
    elif [[ "$SCOPE" == "global" ]]; then
      echo "global drain: none"
    fi
  fi
  if [[ -n "$SCOPE" && "$SCOPE" != "global" ]]; then
    scope_file="$(_sgt_drain_project_file "$SCOPE")"
    if [[ -f "$scope_file" ]]; then
      echo "${SCOPE} drain: active"
      grep -E "^reason=|^created_at=|^created=" "$scope_file" 2>/dev/null | sed 's/^/  /' || true
      found=1
    else
      echo "${SCOPE} drain: none"
    fi
  elif [[ -z "$SCOPE" ]]; then
    # Scan all project drains
    if [[ -d "$drain_dir" ]]; then
      while IFS= read -r -d '' drain_file; do
        name="$(basename "$drain_file")"
        [[ "$name" == "global" || "$name" == "admission.lock" ]] && continue
        echo "${name} drain: active"
        grep -E "^reason=|^created_at=|^created=" "$drain_file" 2>/dev/null | sed 's/^/  /' || true
        found=1
      done < <(find "$drain_dir" -maxdepth 1 -type f -print0 2>/dev/null)
    fi
    [[ $found -eq 1 ]] || echo "no active drain"
  fi
  exit 0
fi

[[ -n "$SCOPE" ]] || _die "Must specify a project name or --global"

if [[ "$SCOPE" == "global" ]]; then
  drain_file="$(_sgt_drain_global_file)"
else
  drain_file="$(_sgt_drain_project_file "$SCOPE")"
fi

if [[ "$MODE" == "undrain" ]]; then
  _sgt_drain_with_lock "_sgt_drain_clear \"$drain_file\""
  echo "sgt-drain: undrained ${SCOPE}."
else
  _sgt_drain_with_lock "_sgt_drain_write \"$drain_file\" \"${REASON:-}\" \"\""
  echo "sgt-drain: drained ${SCOPE}."
fi
