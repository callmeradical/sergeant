#!/usr/bin/env bash
# sgt-recover - Attempt one bounded stall recovery for a stalled in-progress worker.
#
# Kills the stalled pane, relaunches a fresh sgt-interactive-worker, atomically
# updates fleet pane/identity metadata, and delivers a recovery notification.
#
# Recovery is gated on stall proof: status must be in_progress and the fleet
# diagnostic must begin with "live worker stalled:" (written by sgt-watch stall
# classification).  A second invocation escalates to needs_input instead of
# retrying — guaranteeing exactly one bounded relaunch attempt.
#
# Kill ordering: the stalled pane is only killed AFTER the replacement pane is
# successfully launched and its identity validated.  If any part of the relaunch
# sequence fails, the original stalled pane is preserved so the failure can be
# investigated without losing the supervisor entirely.
#
# Note: sgt-respond refuses in_progress workers, so there is no pending
# response generation to consume for a stalled worker.  AC2 "consumes the
# intended response generation" is not applicable to this path.
#
# Usage:
#   sgt-recover <task-id> <repo>

set -euo pipefail

_sgt_recover_real_dir() {
  local src="$1" target dir _link _i=0
  target="$src"
  while [[ -L "$target" && $_i -lt 20 ]]; do
    _link="$(readlink "$target" 2>/dev/null || true)"
    [[ -n "$_link" ]] || break
    if [[ "$_link" == /* ]]; then target="$_link"; else target="$(dirname "$target")/$_link"; fi
    _i=$(( _i + 1 ))
  done
  dir="$(dirname "$target")"
  (cd "$dir" && pwd -P)
}
SCRIPT_DIR="$(_sgt_recover_real_dir "${BASH_SOURCE[0]}")"
unset -f _sgt_recover_real_dir
# shellcheck source=bin/_sgt-lib.sh
source "$SCRIPT_DIR/_sgt-lib.sh"
# shellcheck source=bin/_sgt-response-lock.sh
source "$SCRIPT_DIR/_sgt-response-lock.sh"
# shellcheck source=bin/_sgt-drain.sh
source "$SCRIPT_DIR/_sgt-drain.sh"

[[ $# -eq 2 ]] || _die "Usage: sgt-recover <task-id> <repo>"

TASK_ID="$1"
REPO="$2"
[[ "$TASK_ID" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || _die "Invalid task ID: $TASK_ID"
[[ "$REPO" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || _die "Invalid repo: $REPO"

REPO_DIR="$FLEET_DIR/$TASK_ID/$REPO"
[[ -d "$FLEET_DIR/$TASK_ID" ]] || _die "Task not found: $TASK_ID"
[[ -d "$REPO_DIR" ]] || _die "Repo not found in task $TASK_ID: $REPO"

worktree="$(cat "$REPO_DIR/worktree" 2>/dev/null || true)"
[[ -n "$worktree" && -d "$worktree" ]] || _die "Worktree unavailable for $TASK_ID/$REPO"
_sgt_worker_process_marker_preflight "$REPO_DIR" || \
  _die "Recovery refused: worker process marker evidence is torn"

# ── 1. Verify stall proof (pre-lock fast path) ───────────────────────────────

status="$(cat "$REPO_DIR/status" 2>/dev/null || true)"
if [[ "$status" == "orphaned" ]]; then
  _die "Recovery is unavailable for an orphaned worker; resume its preserved work and adjudicate any dead-owner lease with: sgt-respond $TASK_ID $REPO"
fi
[[ "$status" == "in_progress" ]] || \
  _die "Recovery is unavailable: worker status is '$status' (must be in_progress)"

diagnostic="$(cat "$REPO_DIR/diagnostic" 2>/dev/null || true)"
gate_generation="$(cat "$worktree/.sergeant-gate-generation" 2>/dev/null || true)"
[[ "$gate_generation" =~ ^[1-9][0-9]*$ ]] || gate_generation=1
[[ "$diagnostic" == "live worker stalled:"* ]] || \
  _die "Recovery is unavailable: no stall classification proof in diagnostic"
initial_pane="$(cat "$REPO_DIR/pane" 2>/dev/null || true)"
initial_pane_identity="$(_sgt_read_owned_file \
  "$REPO_DIR/pane_identity" 2>/dev/null || true)"

# ── 2. Acquire lock ──────────────────────────────────────────────────────────

_SGT_RECOVER_LAUNCH_FD=9
_sgt_drain_lock_acquire_fd "$_SGT_RECOVER_LAUNCH_FD" worker-launch \
  "$REPO_DIR/worker-launch.lock" || _die "Could not acquire exact worker-launch ownership"
_sgt_worker_launch_transaction_begin "$REPO_DIR" "$_SGT_RECOVER_LAUNCH_FD" || \
  _die "Could not snapshot worker generation before recovery"
if [[ "$SGT_DRAIN_LOCK_CONTENDED_LIVE" == true ]] && \
  _sgt_worker_launch_observed_completion_matches "$REPO_DIR"; then
  printf 'sgt-recover: verified peer worker-launch transaction completed for %s/%s.\n' \
    "$TASK_ID" "$REPO"
  _sgt_drain_lock_release_fd "$_SGT_RECOVER_LAUNCH_FD"
  exit 0
fi
_sgt_response_lock_acquire "$REPO_DIR"
_cleanup_recover() {
  local cleanup_status=0
  _sgt_response_lock_release || cleanup_status=1
  _sgt_drain_lock_release_fd "$_SGT_RECOVER_LAUNCH_FD" || cleanup_status=1
  return "$cleanup_status"
}
trap '_cleanup_recover' EXIT

# ── 3. Re-verify under lock and define helpers ───────────────────────────────

status="$(cat "$REPO_DIR/status" 2>/dev/null || true)"
diagnostic="$(cat "$REPO_DIR/diagnostic" 2>/dev/null || true)"
_sgt_worker_process_marker_preflight "$REPO_DIR" || \
  _die "Recovery refused: worker process marker evidence changed while waiting for ownership"
current_pane="$(cat "$REPO_DIR/pane" 2>/dev/null || true)"
current_pane_identity="$(_sgt_read_owned_file \
  "$REPO_DIR/pane_identity" 2>/dev/null || true)"
if [[ "$current_pane" != "$initial_pane" || \
  "$current_pane_identity" != "$initial_pane_identity" ]]; then
  _die "Recovery refused: worker pane changed without completion from the exact observed launch owner"
fi

_next_gate_generation() {
  local current=""
  # Handle an absent generation file explicitly.  Redirecting stdin from a missing
  # path fails before `tr` ever runs, so `tr ... 2>/dev/null` silences the wrong
  # process and bash reports the redirect failure on the real stderr.
  if [[ -f "$worktree/.sergeant-gate-generation" ]]; then
    current="$(tr -d '\n' < "$worktree/.sergeant-gate-generation" 2>/dev/null || true)"
  fi
  if [[ ! "$current" =~ ^[0-9]+$ ]]; then
    current=0
  fi
  printf '%s\n' "$((current + 1))"
}

# _escalate: set needs_input with evidence; always write diagnostic before
# status so sgt-watch never observes needs_input with a stale stall diagnostic.
_escalate() {
  local reason="$1"
  local generation
  generation="$(_next_gate_generation)"
  printf '%s\n' "$generation" > "$worktree/.sergeant-gate-generation"
  {
    printf 'stall recovery for %s/%s: %s\n' "$TASK_ID" "$REPO" "$reason"
    if [[ -f "$REPO_DIR/stall_recovery_attempted" ]]; then
      printf 'recovery attempted at: %s\n' "$(cat "$REPO_DIR/stall_recovery_attempted" || true)"
    fi
  } > "$worktree/.sergeant-message"
  cp "$worktree/.sergeant-message" "$REPO_DIR/message" 2>/dev/null || true
  # Write diagnostic before status: prevents sgt-watch observing needs_input
  # with a stale stall diagnostic before we overwrite it.
  printf '%s\n' "$reason" > "$REPO_DIR/diagnostic"
  printf 'needs_input\n' > "$worktree/.sergeant-status"
  printf 'needs_input\n' > "$REPO_DIR/status"
  "$SCRIPT_DIR/sgt-td-memory" handoff "$REPO_DIR" "$worktree" || true
  "$SCRIPT_DIR/sgt-notify" "$TASK_ID" \
    "needs_input [$REPO]: stall recovery: $reason" 2>/dev/null || true
}

# _recover_die: release lock, clear trap, and exit with an error message.
_recover_die() {
  _sgt_response_lock_release
  _sgt_drain_lock_release_fd "$_SGT_RECOVER_LAUNCH_FD"
  trap - EXIT
  _die "$@"
}

# ── 4. One-shot gate: refuse second attempt ──────────────────────────────────

# A completed prior transaction is evidence, not the binding for a later stall.
# Retire it exactly before starting a new attempt whose marker was explicitly
# cleared by reconciliation.
if [[ ! -e "$REPO_DIR/stall_recovery_attempted" ]] &&
    _sgt_transfer_journal_read "$REPO_DIR/response_relaunch_transaction" &&
    [[ "$_SGT_TRANSFER_PHASE" == acked ]]; then
  prior_transfer_archive="$REPO_DIR/transfer_archive/$_SGT_TRANSFER_NOTIFICATION_ID"
  mkdir -p "$prior_transfer_archive" || _recover_die "Could not archive completed recovery transaction"
  for prior_transfer_file in response_relaunch_transaction recovery_successor_notification; do
    [[ -e "$REPO_DIR/$prior_transfer_file" ]] || continue
    if [[ -e "$prior_transfer_archive/$prior_transfer_file" ]]; then
      cmp -s "$REPO_DIR/$prior_transfer_file" "$prior_transfer_archive/$prior_transfer_file" || \
        _recover_die "Completed recovery archive conflicts with preserved evidence"
      rm -f "$REPO_DIR/$prior_transfer_file"
    else
      mv "$REPO_DIR/$prior_transfer_file" "$prior_transfer_archive/$prior_transfer_file" || \
        _recover_die "Could not archive completed recovery evidence"
    fi
  done
fi

if [[ -f "$REPO_DIR/stall_recovery_attempted" ]]; then
  attempted_generation="$(sed -n 's/^gate_generation=//p' "$REPO_DIR/stall_recovery_attempted")"
  attempted_notification="$(sed -n 's/^notification_id=//p' "$REPO_DIR/stall_recovery_attempted")"
  if _sgt_transfer_journal_read "$REPO_DIR/response_relaunch_transaction" &&
      [[ -z "$_SGT_TRANSFER_RESPONSE_ID" &&
         "$_SGT_TRANSFER_GATE_GENERATION" == "$attempted_generation" &&
         "$_SGT_TRANSFER_NOTIFICATION_ID" == "$attempted_notification" &&
         "$attempted_generation" == "$gate_generation" ]]; then
    : # Join the exact generation-bound transaction below.
  else
    _escalate "recovery already attempted; no exact transfer journal can be joined"
    _recover_die "Recovery already attempted for $TASK_ID/$REPO; escalated to needs_input"
  fi
fi

[[ "$status" == "in_progress" ]] || \
  _recover_die "Recovery is unavailable: worker status changed to '$status' under lock"
[[ "$diagnostic" == "live worker stalled:"* ]] || \
  _recover_die "Recovery is unavailable: stall diagnostic no longer present"

# ── 5. Pre-flight: converge or refuse an unfinished notification action_lease ─
# An in-flight action_lease means the prior supervisor accepted a notification
# but died before writing 'completed'.  Replacing notification state now would
# destroy the exact-once delivery evidence.
#
# Refusing unconditionally, as this used to, is what made such a worker
# permanently unrecoverable: no supported command could settle the lease.  Try
# convergence first through the one shared finalizer, which publishes completion
# only from the agent's own exact proof for this turn.  A mismatched identity or
# nonce, or a turn that never produced a proof, still fails closed and is still
# refused — the td-6da427 guard against overwriting an in-flight lease is
# preserved, not reverted.  The response lock is already held, so the finalizer
# reuses it.

delivery_notification_id=""
replacement_spawn_token=""
dead_owner_fenced=false
fenced_owner_pane=""
current_notification_id="$(cat "$REPO_DIR/notification_id" 2>/dev/null || true)"
if [[ -n "$current_notification_id" ]]; then
  current_action_lease="$(cat \
    "$REPO_DIR/notifications/$current_notification_id/action_lease" 2>/dev/null || true)"
  if [[ -n "$current_action_lease" &&
        ! -f "$REPO_DIR/notifications/$current_notification_id/targets/$current_action_lease/completed" ]]; then
    _sgt_finalize_action_lease "$REPO_DIR" "$worktree" "recover_convergence" || true
  fi
  if [[ -n "$current_action_lease" &&
        ! -f "$REPO_DIR/notifications/$current_notification_id/targets/$current_action_lease/completed" ]]; then
    # Completion could not be proven.  Before refusing outright — which is what
    # made a worker holding a dead supervisor's lease permanently unrecoverable —
    # adjudicate the lease owner's liveness.  A provably dead owner cannot be
    # mid-action, so recovery may proceed; the delivery evidence is preserved and
    # the adjudication is recorded.
    recovery_generation="$gate_generation"
    recovery_successor="$(_sgt_bind_action_lease_successor \
      "$REPO_DIR" "$recovery_generation")" || \
      _recover_die "Stall recovery refused: action lease successor binding is malformed or conflicting"
    delivery_notification_id="${recovery_successor%%|*}"
    replacement_spawn_token="${recovery_successor#*|}"
    if _sgt_fence_dead_action_lease "$REPO_DIR" "$worktree" \
        "$delivery_notification_id" "$recovery_generation" \
        "dead action lease ownership transfer"; then
      dead_owner_fenced=true
      fenced_owner_identity="$(cat \
        "$REPO_DIR/notifications/$current_notification_id/targets/$current_action_lease/pane_identity" \
        2>/dev/null || true)"
      fenced_owner_pane="${fenced_owner_identity#*|}"
      fenced_owner_pane="${fenced_owner_pane%%|*}"
      if [[ "${SGT_TEST_HOOKS:-}" == 1 &&
            "${SGT_TEST_INTERRUPT_RECOVER_AT:-}" == fenced ]]; then
        kill -KILL "$$"
      fi
    else
      _escalate "pending notification action lease blocks recovery; prior delivery evidence must be preserved: notification $current_notification_id lease target $current_action_lease has no agent completion proof and its owner is not provably dead; resolve with sgt-respond $TASK_ID $REPO after inspecting that turn"
      _recover_die "Stall recovery refused: unfinished notification action lease for $TASK_ID/$REPO (notification $current_notification_id, lease target $current_action_lease); the agent never published .sergeant-notification-complete/$current_action_lease and the lease owner is not provably dead, so completion cannot be proven. Resolve with: sgt-respond $TASK_ID $REPO"
    fi
  fi
fi

# ── 6. Drain admission check ─────────────────────────────────────────────────
# Global or project drain prevents new pane starts.  Escalate without stamping
# stall_recovery_attempted so that recovery can be retried after undrain.

_sgt_drain_read_project_from_brief "$FLEET_DIR/$TASK_ID"
if _sgt_is_drained "$SGT_PROJECT"; then
  _escalate "stall recovery held by drain [project: ${SGT_PROJECT:-global}]; retry after undrain"
  _recover_die "Stall recovery refused by drain for $TASK_ID/$REPO"
fi

# ── 7. Pre-flight: verify relaunch metadata ──────────────────────────────────
# All prerequisites are validated BEFORE stamping the recovery attempt and
# BEFORE killing anything, so that a validation failure leaves the stalled
# worker alive and untouched.

tmux_session="$(cat "$REPO_DIR/tmux_session" 2>/dev/null || true)"
window_name="$(cat "$REPO_DIR/window_name" 2>/dev/null || true)"
agent="$(cat "$REPO_DIR/agent" 2>/dev/null || true)"

if ! command -v tmux >/dev/null 2>&1 || \
   [[ -z "$tmux_session" || -z "$window_name" || -z "$agent" ]]; then
  _escalate "relaunch metadata is incomplete"
  _recover_die "Stall recovery failed: relaunch metadata is incomplete for $TASK_ID/$REPO"
fi

# ── 8. Pre-flight: verify old pane identity ──────────────────────────────────
# Save the old pane reference for the deferred kill and for potential restore
# on failure.  The identity check is done here (under lock, before any state
# mutation) so a mismatch refuses recovery without killing anything.

old_pane="$(cat "$REPO_DIR/pane" 2>/dev/null || true)"
old_pane_live=false
if [[ -n "$old_pane" ]] && command -v tmux >/dev/null 2>&1; then
  if _sgt_pane_identity_matches "$old_pane" "$REPO_DIR"; then
    old_pane_live=true
  elif $dead_owner_fenced && [[ "$old_pane" == "$fenced_owner_pane" ]]; then
    # The shared fence already proved this exact recorded pane and process gone
    # twice under the response lock. There is no old pane left to kill.
    old_pane_live=false
  else
    _escalate "pane identity mismatch for pane $old_pane; refusing to kill"
    _recover_die "Stall recovery refused: pane identity mismatch for $TASK_ID/$REPO"
  fi
fi

# ── 10. Preserve superseded notification target evidence ──────────────────────
# Mirror sgt-respond's evidence preservation before clearing notification state.

current_target_nonce="$(cat "$REPO_DIR/notification_target" 2>/dev/null || true)"
current_target_identity=""
if [[ -n "$current_notification_id" && "$current_target_nonce" =~ ^[a-f0-9]{32}$ ]]; then
  current_target_identity="$(cat \
    "$REPO_DIR/notifications/$current_notification_id/targets/$current_target_nonce/pane_identity" \
    2>/dev/null || true)"
fi
if [[ -n "$current_notification_id" && -n "$current_target_identity" ]]; then
  superseded_dir="$REPO_DIR/notifications/$current_notification_id"
  mkdir -p "$superseded_dir"
  superseded_tmp="$superseded_dir/superseded_target_pane_identity.tmp.$$"
  printf '%s\n' "$current_target_identity" > "$superseded_tmp"
  if [[ -e "$superseded_dir/superseded_target_pane_identity" ]]; then
    cmp -s "$superseded_tmp" "$superseded_dir/superseded_target_pane_identity" || {
      rm -f "$superseded_tmp"
      _escalate "pending notification target evidence conflicts with recovery relaunch"
      _recover_die "Stall recovery refused: notification target evidence conflict for $TASK_ID/$REPO"
    }
    rm -f "$superseded_tmp"
  else
    mv "$superseded_tmp" "$superseded_dir/superseded_target_pane_identity" || {
      rm -f "$superseded_tmp"
      _escalate "could not preserve superseded notification target evidence"
      _recover_die "Stall recovery failed: evidence preservation failed for $TASK_ID/$REPO"
    }
  fi
fi
rm -f "$REPO_DIR/notification_target"

# ── 11. Publish recovery notification ────────────────────────────────────────

recovery_binding_file="$REPO_DIR/recovery_successor_notification"
recovery_binding="$(cat "$recovery_binding_file" 2>/dev/null || true)"
if [[ -n "$recovery_binding" ]]; then
  IFS='|' read -r bound_successor bound_token <<< "$recovery_binding"
  [[ "$bound_successor" =~ ^[a-f0-9]{32}$ && "$bound_token" =~ ^[a-f0-9]{32}$ ]] || \
    _recover_die "Stall recovery refused: malformed recovery successor binding"
  if [[ -n "$delivery_notification_id" ]]; then
    [[ "$delivery_notification_id" == "$bound_successor" &&
       "$replacement_spawn_token" == "$bound_token" ]] || \
      _recover_die "Stall recovery refused: recovery successor binding conflicts with fenced transfer"
  else
    delivery_notification_id="$bound_successor"
    replacement_spawn_token="$bound_token"
  fi
else
  if [[ -z "$delivery_notification_id" ]]; then
    delivery_notification_id="$(dd if=/dev/urandom bs=16 count=1 2>/dev/null | \
      od -An -tx1 | tr -d ' \n')"
    replacement_spawn_token="$(dd if=/dev/urandom bs=16 count=1 2>/dev/null | \
      od -An -tx1 | tr -d ' \n')"
  fi
  _sgt_replace_owned_file "$recovery_binding_file" \
    "$delivery_notification_id|$replacement_spawn_token" || \
    _recover_die "Stall recovery failed: could not publish recovery successor binding"
fi
_sgt_publish_worker_notification "$REPO_DIR" "$worktree" \
  "$delivery_notification_id" recovery \
  "Resume the mission after stall recovery. Read the current worktree and td state, check the latest td handoff, and continue from where you left off."

# ── 12. Launch new worker pane ───────────────────────────────────────────────
# Launch the new pane BEFORE killing the old one.  If the launch fails, the
# original stalled pane remains alive and the worker is escalated to
# needs_input for investigation.

_sgt_prepare_worker_process_marker "$REPO_DIR" || \
  _recover_die "Stall recovery failed: worker process marker could not be prepared"
worker_role="worker:$(basename "$agent")"
worker_command="$(_sgt_replacement_worker_command "$replacement_spawn_token" "$worker_role" \
  "$(_sgt_worker_command "$SCRIPT_DIR/sgt-interactive-worker" "$REPO_DIR" "$worktree" "$agent")")" || \
  _recover_die "Stall recovery failed: could not construct canonical replacement worker command"

relaunch_transaction="$REPO_DIR/response_relaunch_transaction"
replacement_window_name="${window_name}-resume-${delivery_notification_id:0:12}"
_write_recovery_transaction() {
  local phase="$1" candidate_pane="${2:-}" candidate_identity="${3:-}"
  _sgt_transfer_journal_write "$relaunch_transaction" "" \
    "$delivery_notification_id" "$replacement_spawn_token" "$gate_generation" \
    "$tmux_session" "$replacement_window_name" "$worker_role" "$worker_command" "$phase" \
    "$candidate_pane" "$candidate_identity"
}
if [[ -e "$relaunch_transaction" ]]; then
  _sgt_transfer_journal_read "$relaunch_transaction" || \
    _recover_die "Stall recovery refused: relaunch journal is malformed"
  [[ -z "$_SGT_TRANSFER_RESPONSE_ID" &&
     "$_SGT_TRANSFER_NOTIFICATION_ID" == "$delivery_notification_id" &&
     "$_SGT_TRANSFER_SPAWN_TOKEN" == "$replacement_spawn_token" &&
     "$_SGT_TRANSFER_GATE_GENERATION" == "$gate_generation" &&
     "$_SGT_TRANSFER_TMUX_SESSION" == "$tmux_session" &&
     "$_SGT_TRANSFER_WINDOW_NAME" == "$replacement_window_name" &&
     "$_SGT_TRANSFER_WORKER_ROLE" == "$worker_role" &&
     "$_SGT_TRANSFER_WORKER_COMMAND" == "$worker_command" ]] || \
    _recover_die "Stall recovery refused: relaunch journal conflicts with this transfer"
else
  _write_recovery_transaction bound || \
    _recover_die "Stall recovery failed: could not publish relaunch intent"
fi
attempt_record="$(printf 'gate_generation=%s\nnotification_id=%s\nspawn_token=%s\n' \
  "$gate_generation" "$delivery_notification_id" "$replacement_spawn_token")"
if [[ -e "$REPO_DIR/stall_recovery_attempted" ]]; then
  [[ "$(cat "$REPO_DIR/stall_recovery_attempted")" == "$attempt_record" ]] || \
    _recover_die "Stall recovery refused: attempted-generation record conflicts with transfer journal"
else
  _sgt_replace_owned_file "$REPO_DIR/stall_recovery_attempted" "$attempt_record" || \
    _recover_die "Stall recovery failed: could not bind attempted generation"
fi

new_pane=""
matching_panes=0
window_panes=0
while IFS='|' read -r candidate candidate_window; do
  [[ "$candidate_window" == "$replacement_window_name" ]] || continue
  window_panes=$((window_panes + 1))
  candidate_identity="$(_sgt_pane_identity "$candidate" 2>/dev/null || true)"
  if _sgt_replacement_pane_identity_matches "$candidate_identity" "$candidate" \
      "$replacement_spawn_token" "$worker_role"; then
    matching_panes=$((matching_panes + 1))
    new_pane="$candidate"
  fi
done < <(tmux list-panes -a -F '#{pane_id}|#{window_name}' 2>/dev/null || true)
(( matching_panes <= 1 )) || \
  _recover_die "Stall recovery refused: relaunch journal resolves to multiple authenticated panes"
if (( matching_panes == 0 && window_panes > 0 )); then
  _recover_die "Stall recovery refused: replacement window is owned by a foreign pane"
fi
if [[ -z "$new_pane" ]]; then
  _write_recovery_transaction spawning || \
    _recover_die "Stall recovery failed: could not publish relaunch spawning state"
  if ! new_pane="$(tmux new-window -P -F '#{pane_id}' -t "$tmux_session:" \
      -n "$replacement_window_name" -c "$worktree" "$worker_command")"; then
    _escalate "tmux failed to relaunch worker supervisor"
    _recover_die "Stall recovery failed: worker relaunch failed for $TASK_ID/$REPO"
  fi
fi

if [[ -z "$new_pane" ]]; then
  _escalate "tmux returned no pane for relaunched worker supervisor"
  _recover_die "Stall recovery failed: worker relaunch returned no pane for $TASK_ID/$REPO"
fi
if [[ "${SGT_TEST_HOOKS:-}" == 1 &&
      "${SGT_TEST_INTERRUPT_RECOVER_AT:-}" == spawned ]]; then
  kill -KILL "$$"
fi

# ── 13. Atomically install new pane/identity metadata ───────────────────────
# On any failure here: kill the new pane, restore the pane file to the old
# pane so fleet state stays consistent, and escalate.

printf '%s\n' "$new_pane" > "$REPO_DIR/pane"

_abort_replacement() {
  local reason="$1"
  tmux kill-pane -t "$new_pane" 2>/dev/null || true
  if [[ -n "$old_pane" ]]; then
    printf '%s\n' "$old_pane" > "$REPO_DIR/pane" || true
  fi
  _escalate "$reason"
  _recover_die "Stall recovery failed: $reason for $TASK_ID/$REPO"
}

pane_identity=""
if pane_identity="$(_sgt_pane_identity "$new_pane")" && \
    _sgt_replacement_pane_identity_matches "$pane_identity" "$new_pane" \
      "$replacement_spawn_token" "$worker_role"; then
  recovery_install_phase=spawned
  if _sgt_transfer_journal_read "$relaunch_transaction" &&
      [[ "$_SGT_TRANSFER_PHASE" == acked ]]; then
    recovery_install_phase=acked
  fi
  _write_recovery_transaction "$recovery_install_phase" "$new_pane" "$pane_identity" || \
    _abort_replacement "could not publish spawned worker ownership transaction"
  _sgt_replace_owned_file "$REPO_DIR/pane_identity" "$pane_identity" || \
    _abort_replacement "could not publish new worker pane identity"
  _sgt_notification_target_create "$REPO_DIR" "$delivery_notification_id" \
      "$pane_identity" >/dev/null || \
    _abort_replacement "notification target race detected during stall recovery relaunch"
  _sgt_worker_launch_completion_publish "$REPO_DIR" "$_SGT_RECOVER_LAUNCH_FD" || \
    _abort_replacement "could not publish completed worker-launch transaction"
else
  _abort_replacement "tmux failed to capture relaunched worker pane identity"
fi

# ── 14. Kill old pane (AFTER new pane is fully validated) ────────────────────
# Only reached when the replacement pane is alive, identity-confirmed, and has
# an active notification target.  Prefix-safe: identity was verified in step 7.

if $old_pane_live && [[ -n "$old_pane" ]]; then
  tmux kill-pane -t "$old_pane" 2>/dev/null || true
fi

# ── 15. Wait for recovery notification acknowledgement ──────────────────────

if ! _sgt_wait_worker_notification "$new_pane" "$REPO_DIR" \
    "$delivery_notification_id"; then
  tmux kill-pane -t "$new_pane" 2>/dev/null || true
  _escalate "relaunched worker did not acknowledge recovery notification"
  _recover_die "Stall recovery failed: notification timed out for $TASK_ID/$REPO"
fi
_write_recovery_transaction acked "$new_pane" "$pane_identity" || \
  _recover_die "Stall recovery failed: could not publish acknowledged ownership transaction"

# ── 16. Clear stall evidence now that recovery succeeded ────────────────────
# Preserve evidence through all failure paths above so _escalate can write an
# accurate failure diagnostic instead of an empty file.

rm -f "$REPO_DIR/diagnostic" "$REPO_DIR/message" "$worktree/.sergeant-message"

_sgt_response_lock_release
_sgt_drain_lock_release_fd "$_SGT_RECOVER_LAUNCH_FD"
trap - EXIT
printf 'sgt-recover: stall recovery complete for %s/%s, new pane %s.\n' \
  "$TASK_ID" "$REPO" "$new_pane"
