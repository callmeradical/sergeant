#!/usr/bin/env bash
# sgt-td-memory - Record non-secret worker recovery pointers in td.

set -uo pipefail

[[ $# -eq 3 ]] || {
  echo "Usage: sgt-td-memory <handoff|response> <repo-state-dir> <worktree>" >&2
  exit 2
}

ACTION="$1"
REPO_STATE="$2"
WORKTREE="$3"
TD_TASK="$(cat "$REPO_STATE/td_task" 2>/dev/null || true)"
[[ -n "$TD_TASK" ]] || exit 0

_diagnose() {
  printf 'td-memory: %s\n' "$1" >> "$REPO_STATE/diagnostic"
}

if ! command -v td >/dev/null 2>&1; then
  _diagnose "td unavailable for $ACTION on $TD_TASK"
  exit 1
fi

# ── Verify the worktree before recording anything ─────────────────────────────
# Callers reach this helper from the supervisor's own directory, not from the
# worktree: sgt-watch and sgt-respond both invoke it that way.  An absent, wrong,
# or non-git path must abort rather than attach misleading git identity to a real
# td task.
#
# "Is a git worktree" is not sufficient on its own: the supervisor's own checkout,
# any subdirectory of it, and any unrelated repository all satisfy that test, and
# because td binds its capture to the working directory (see below) such a path
# would produce internally consistent but wrong handoff evidence.  So the path
# must also be the ROOT of the worktree this fleet record actually owns.

if [[ ! -d "$WORKTREE" ]]; then
  _diagnose "unverified worktree for $ACTION on $TD_TASK: $WORKTREE does not exist"
  exit 1
fi
_realpath() {
  # No coreutils realpath dependency: cd resolves symlinks the same way git does.
  ( cd "$1" 2>/dev/null && pwd -P )
}
# Bind to the worktree this fleet record owns.  A missing record cannot be
# reconciled, so it fails closed rather than trusting the argument.
owned_worktree="$(cat "$REPO_STATE/worktree" 2>/dev/null || true)"
if [[ -z "$owned_worktree" ]]; then
  _diagnose "unverified worktree for $ACTION on $TD_TASK: $REPO_STATE records no owned worktree"
  exit 1
fi
if [[ "$(_realpath "$owned_worktree")" != "$(_realpath "$WORKTREE")" ]]; then
  _diagnose "unverified worktree for $ACTION on $TD_TASK: $WORKTREE is not the owned worktree $owned_worktree"
  exit 1
fi

# td resolves its database from --work-dir but binds its automatically captured
# git metadata to the process working directory.  Measured against td v0.55.0
# with two linked worktrees, and asserted by the controls in Part B of
# tests/sgt-td-memory-worktree-test.sh: invoking from another checkout records
# that checkout's branch and commit, and invoking from a non-repository directory
# records no git state at all.  Those controls fail loudly if a future td honors
# --work-dir, so this comment cannot outlive its evidence.
#
# Workaround, therefore: every td call below runs with its working directory
# inside the verified worktree, and the branch and head are additionally captured
# explicitly.  Upstream defect tracked in td-80f9f5 (blocked-on-external: the
# report is drafted and scrubbed but Sergeant cannot file in another repository,
# so it never gates Sergeant delivery).
_td_in_worktree() {
  ( cd "$WORKTREE" && td "$@" )
}

case "$ACTION" in
  handoff)
    # Only this action records git identity, so only this action requires the
    # path to be a git worktree ROOT.  Response provenance records no branch or
    # head, so it must not be blocked by a checkout that has lost its git dir.
    if ! worktree_root="$(git -C "$WORKTREE" rev-parse --show-toplevel 2>/dev/null)" || \
       [[ -z "$worktree_root" ]]; then
      _diagnose "unverified worktree for $ACTION on $TD_TASK: $WORKTREE is not a git worktree"
      exit 1
    fi
    if [[ "$(_realpath "$worktree_root")" != "$(_realpath "$WORKTREE")" ]]; then
      _diagnose "unverified worktree for $ACTION on $TD_TASK: $WORKTREE is not a worktree root (its root is $worktree_root)"
      exit 1
    fi
    status="$(cat "$WORKTREE/.sergeant-status" 2>/dev/null || echo unknown)"
    # session_id: no writer exists for REPO_STATE/session_id; omitted from the
    # handoff message rather than always recording "unavailable".
    # Fail closed: a handoff whose git identity cannot be read is worse than no
    # handoff, because the recorded evidence would not match any real checkout.
    if ! head="$(git -C "$WORKTREE" rev-parse HEAD 2>/dev/null)" || [[ -z "$head" ]]; then
      _diagnose "git capture failed for $TD_TASK: cannot resolve HEAD in $WORKTREE"
      exit 1
    fi
    if ! branch="$(git -C "$WORKTREE" branch --show-current 2>/dev/null)"; then
      _diagnose "git capture failed for $TD_TASK: cannot resolve the branch in $WORKTREE"
      exit 1
    fi
    # A detached HEAD is a real state, not a capture failure, so it must not
    # abort.  git reports it as an empty branch; the summary is a human-readable
    # line, so the empty value is rendered as the literal "detached" rather than
    # left blank.  The head above is the authoritative identity either way.
    [[ -n "$branch" ]] || branch="detached"
    if ! _td_in_worktree handoff "$TD_TASK" --work-dir "$WORKTREE" \
      --done "Worker checkpoint: status=$status, branch=$branch, head=$head" \
      --remaining "Read fleet state at $REPO_STATE, including message, diagnostic, and worker.log; reconcile with current git state before resuming" \
      --decision "Raw escalation and response text stay out of td; .sergeant-response is the atomic transport" \
      >/dev/null 2>&1; then
      _diagnose "td handoff failed for $TD_TASK"
      exit 1
    fi
    ;;
  response)
    response_id="$(cat)"
    if [[ ! "$response_id" =~ ^[a-f0-9]{32}$ ]]; then
      _diagnose "invalid response ID for $TD_TASK"
      exit 1
    fi
    decision="Human response received via Sergeant (response-id=$response_id). Exact text is intentionally excluded from td and delivered through atomic .sergeant-response; read the updated handoff and fleet/git state before resuming."
    if ! _td_in_worktree log "$TD_TASK" "$decision" --decision --work-dir "$WORKTREE" \
      >/dev/null 2>&1; then
      _diagnose "td decision log failed for $TD_TASK; response delivery must continue"
      exit 1
    fi
    ;;
  *)
    _diagnose "unknown action: $ACTION"
    exit 2
    ;;
esac
