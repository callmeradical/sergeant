#!/usr/bin/env bash
# sgt-drain-force — Force-stop workers that failed cooperative drain (td-fa4fed).
#
# Requires an active drain. Displays exact project/task/repo/pane/process
# identity before stopping. Never runs automatically; requires --yes or
# --dry-run.
#
# Usage:
#   sgt-drain-force --global [--dry-run] [--yes]
#   sgt-drain-force --project <project> [--dry-run] [--yes]
#
# Environment:
#   SERGEANT_DRAIN_DIR   Override drain state directory
#   SERGEANT_FLEET       Override fleet state directory

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=bin/_sgt-lib.sh
source "$SCRIPT_DIR/_sgt-lib.sh"

_die()  { printf 'ERROR: %s\n' "$*" >&2; exit 1; }
_info() { printf '  %s\n' "$*"; }

# ── Parse args ────────────────────────────────────────────────────────────────

GLOBAL=false
PROJECT=""
DRY_RUN=false
CONFIRMED=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    --global)   GLOBAL=true;              shift ;;
    --project)
      [[ -n "${2:-}" ]] || _die "--project requires a value"
      PROJECT="$2"; shift 2
      ;;
    --dry-run)  DRY_RUN=true;             shift ;;
    --yes)      CONFIRMED=true;           shift ;;
    *) _die "Unknown option: $1" ;;
  esac
done

$GLOBAL || [[ -n "$PROJECT" ]] || \
  _die "sgt-drain-force requires --global or --project <name>"

# ── Verify a matching drain is active ─────────────────────────────────────────

if $GLOBAL; then
  _sgt_drain_is_drained "$(_sgt_drain_global_file)" || \
    _die "no drain is active globally; force requires an active drain"
else
  _sgt_drain_is_drained "$(_sgt_drain_project_file "$PROJECT")" || \
    _die "no drain is active for project '$PROJECT'; force requires an active drain"
fi

# ── Require confirmation ───────────────────────────────────────────────────────

if ! $DRY_RUN && ! $CONFIRMED; then
  _die "force requires --yes to confirm or --dry-run to preview targets"
fi

# ── Collect eligible workers ──────────────────────────────────────────────────

fleet_dir="${SERGEANT_FLEET:-$HOME/.local/share/sergeant/fleet}"
declare -a eligible_tasks=()
declare -a eligible_repos=()
declare -a eligible_worktrees=()
declare -a eligible_pids=()

if [[ -d "$fleet_dir" ]]; then
  for task_dir in "$fleet_dir"/*/; do
    [[ -d "$task_dir" ]] || continue
    task_id="$(basename "$task_dir")"
    for repo_dir in "$task_dir"*/; do
      [[ -d "$repo_dir" ]] || continue
      repo_name="$(basename "$repo_dir")"
      status="$(tr -d '\n' < "$repo_dir/status" 2>/dev/null || echo "")"
      case "$status" in
        done|"failed:"*|drained|force-stopped|orphaned) continue ;;
      esac
      if [[ -n "$PROJECT" ]]; then
        worker_project=""
        [[ -f "$repo_dir/project" ]] && \
          worker_project="$(tr -d '\n' < "$repo_dir/project" 2>/dev/null || true)"
        [[ "$worker_project" == "$PROJECT" ]] || continue
      fi
      worktree_path="$(tr -d '\n' < "$repo_dir/worktree" 2>/dev/null || echo "")"
      worker_pid=""
      [[ -f "$repo_dir/worker_pid" ]] && \
        worker_pid="$(tr -d '\n' < "$repo_dir/worker_pid" 2>/dev/null || true)"
      eligible_tasks+=("$task_id")
      eligible_repos+=("$repo_name")
      eligible_worktrees+=("$worktree_path")
      eligible_pids+=("$worker_pid")
    done
  done
fi

count="${#eligible_tasks[@]}"
if [[ "$count" -eq 0 ]]; then
  _info "no eligible workers to force-stop"
  exit 0
fi

# ── Display targets ───────────────────────────────────────────────────────────

printf 'Eligible workers for force-stop (%s):\n' "$count"
for ((i=0; i<count; i++)); do
  printf '  task: %s  repo: %s  worktree: %s' \
    "${eligible_tasks[$i]}" "${eligible_repos[$i]}" "${eligible_worktrees[$i]:-unknown}"
  [[ -n "${eligible_pids[$i]:-}" ]] && printf '  pid: %s' "${eligible_pids[$i]}"
  printf '\n'
done

if $DRY_RUN; then
  _info "dry-run: no workers terminated"
  exit 0
fi

# ── Execute force-stop ────────────────────────────────────────────────────────

any_failed=false
_record_force_retirement() {
  local repo_dir="$1" process_marker="$2" history_digest="$3"
  local pane identity process_group stamp temporary
  pane="$(tr -d '\n' < "$repo_dir/pane" 2>/dev/null || true)"
  identity="$(_sgt_read_owned_file "$repo_dir/pane_identity" 2>/dev/null || true)"
  process_group="$(tr -d '\n' < "$repo_dir/worker_process_group" 2>/dev/null || true)"
  [[ -n "$pane" && -n "$identity" && "$process_group" =~ ^[1-9][0-9]*$ && \
    -f "$repo_dir/pane_identity" && ! -L "$repo_dir/pane_identity" ]] || return 1
  stamp="$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || true)"
  temporary="$repo_dir/worker_recycled.tmp.$$.$RANDOM"
  (umask 077; {
    printf 'pane=%s\n' "$pane"
    printf 'identity=%s\n' "$identity"
    printf 'process_group=%s\n' "$process_group"
    printf 'outcome=marker_holders_retired\n'
    printf 'process_marker=%s\n' "$process_marker"
    printf 'marker_history_sha256=%s\n' "$history_digest"
    printf 'recycled_at=%s\n' "$stamp"
  } > "$temporary") || return 1
  mv "$temporary" "$repo_dir/worker_recycled" || return 1
  printf '%s\t%s\t%s\t%s\n' "$stamp" "$pane" "$identity" "$process_group" \
    >> "$repo_dir/worker_recycled_log" 2>/dev/null || true
}

for ((i=0; i<count; i++)); do
  task_id="${eligible_tasks[$i]}"
  repo_name="${eligible_repos[$i]}"
  wt="${eligible_worktrees[$i]}"
  pid="${eligible_pids[$i]:-}"
  repo_dir="$fleet_dir/$task_id/$repo_name"
  direct_signal_allowed=true
  root_identity_unproven=false
  marker_evidence_present=false
  process_marker=""
  marker_history=""
  marker_history_digest=""
  if [[ -e "$repo_dir/worker_process_markers" || \
    -L "$repo_dir/worker_process_markers" ]]; then
    marker_evidence_present=true
  fi
  if $marker_evidence_present; then
    process_marker="$(_sgt_read_owned_file \
      "$repo_dir/worker_process_marker" 2>/dev/null || true)"
    marker_history="$(_sgt_read_owned_file \
      "$repo_dir/worker_process_markers" 2>/dev/null || true)"
    marker_history_digest="$(printf '%s' "$marker_history" | \
      _sgt_sha256_text 2>/dev/null || true)"
    if [[ ! "$process_marker" =~ ^[0-9a-f]{32}\|[0-9]+:[0-9]+\|198\|.+$ || \
      -z "$marker_history" || ! "$marker_history_digest" =~ ^[0-9a-f]{64}$ ]]; then
      printf '  WARN: marker retirement evidence is malformed (%s/%s); prior state preserved\n' \
        "$task_id" "$repo_name" >&2
      any_failed=true
      continue
    fi
    if ! _sgt_marker_record_in_history "$process_marker" "$marker_history"; then
      printf '  WARN: current marker generation is absent from durable history (%s/%s); prior state preserved\n' \
        "$task_id" "$repo_name" >&2
      any_failed=true
      continue
    fi
  fi

  if [[ -n "$pid" && "$pid" =~ ^[0-9]+$ ]]; then
    if kill -0 "$pid" 2>/dev/null; then
      # Verify identity: recorded start time must match actual process start time
      # to prevent killing a PID-reusing unrelated process.
      recorded_start=""
      [[ -f "$repo_dir/worker_process_start" ]] && \
        recorded_start="$(tr -d '\n' < "$repo_dir/worker_process_start" 2>/dev/null || true)"
      actual_start="$(_sgt_process_identity "$pid" 2>/dev/null || true)"
      if [[ -z "$recorded_start" || -z "$actual_start" || \
        "$actual_start" != "$recorded_start" ]]; then
          printf '  INFO: pid %s has no matching exact start identity for %s/%s; direct signal skipped\n' \
            "$pid" "$task_id" "$repo_name" >&2
          # The root is gone, but detached marker holders may remain. Never
          # publish force-stopped until their shared capability is retired.
          direct_signal_allowed=false
          root_identity_unproven=true
      fi

      # Marker-owning workers are retired exclusively through the pidfd holder
      # boundary below. This removes the check-then-kill PID reuse window and
      # prevents TERM handlers from forking new descendants during force-stop.
      $marker_evidence_present && direct_signal_allowed=false

      if $direct_signal_allowed && ! kill -TERM "$pid" 2>/dev/null; then
        printf '  WARN: SIGTERM failed for pid %s (%s/%s)\n' "$pid" "$task_id" "$repo_name" >&2
        any_failed=true
        continue
      fi
      if $direct_signal_allowed; then
        waited=0
        while [[ "$waited" -lt 50 ]]; do
          kill -0 "$pid" 2>/dev/null || break
          sleep 0.1
          waited=$((waited + 1))
        done
        if kill -0 "$pid" 2>/dev/null; then
          kill -KILL "$pid" 2>/dev/null || true
        fi
      fi
    fi
  fi

  if $root_identity_unproven && ! $marker_evidence_present; then
    printf '  WARN: recorded PID ownership is unproven and no marker evidence exists (%s/%s); prior state preserved\n' \
      "$task_id" "$repo_name" >&2
    any_failed=true
    continue
  fi

  if ! _sgt_retire_worker_marker_holders "$repo_dir" \
    "$repo_dir/worker_recycle_phase"; then
    printf '  WARN: owned descendants could not be retired (%s/%s); fleet state preserved\n' \
      "$task_id" "$repo_name" >&2
    any_failed=true
    continue
  fi

  if [[ -e "$repo_dir/worker_process_markers" || \
    -L "$repo_dir/worker_process_markers" ]]; then
    if ! _record_force_retirement "$repo_dir" "$process_marker" \
      "$marker_history_digest"; then
      printf '  WARN: marker retirement completed but durable recycle evidence could not be published (%s/%s)\n' \
        "$task_id" "$repo_name" >&2
      any_failed=true
      continue
    fi
  fi

  if [[ -n "$wt" && -d "$wt" ]]; then
    printf 'force-stopped\n' > "$wt/.sergeant-status" || true
  fi
  printf 'force-stopped\n' > "$repo_dir/status" || true
  _info "force-stopped: $task_id/$repo_name"
done

if $any_failed; then
  _die "some workers could not be terminated; state preserved for manual recovery"
fi
