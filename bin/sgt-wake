#!/usr/bin/env bash
# sgt-wake — Evaluate a durable wake condition and resume a waiting worker.
#
# Usage: sgt-wake <task-id> <repo>
#
# Reads .sergeant-wake-condition from the worktree, evaluates the condition
# using read-only adapters, and either resumes the worker via sgt-respond or
# records an attempt (with backoff/jitter) and exits non-zero.
#
# Supported condition kinds:
#   not_before        not_before=<unix_timestamp>
#   github_check      run_id=<id> check_name=<name>
#   fleet_dependency  task_id=<id> repo=<repo>
#   td_dependency     td_task_id=<id>
#   deployment        app=<name> env=<name>
#   human_response    (sets needs_input immediately; cannot be auto-evaluated)
#
# Optional fields (any kind):
#   deadline=<unix_timestamp>   fails with terminal "failed: deadline exceeded"
#   max_attempts=<int>          becomes needs_input when exceeded
#   backoff_base=<seconds>      base sleep between attempts (default 30)
#
# Allowlisted field names (strict; unknown fields cause rejection):
#   kind, generation, not_before, deadline, max_attempts, backoff_base,
#   run_id, check_name, task_id, repo, td_task_id, app, env
#
# Allowlisted field value pattern: [A-Za-z0-9._/:-]*, never starting with '-'
# check_name is opaque UTF-8 because GitHub check names are human-authored. It
# is validated separately and is only ever passed as quoted data, never shell
# source. Newlines and control characters remain invalid for line storage.

set -euo pipefail

_sgt_wake_real_dir() {
  local src="$1" target dir _link _i=0
  target="$src"
  while [[ -L "$target" && $_i -lt 20 ]]; do
    _link="$(readlink "$target" 2>/dev/null || true)"
    [[ -n "$_link" ]] || break
    if [[ "$_link" == /* ]]; then target="$_link"; else target="$(dirname "$target")/$_link"; fi
    _i=$(( _i + 1 ))
  done
  dir="$(dirname "$target")"
  (cd "$dir" && pwd -P)
}
SCRIPT_DIR="$(_sgt_wake_real_dir "${BASH_SOURCE[0]}")"
unset -f _sgt_wake_real_dir
FLEET_DIR="${SERGEANT_FLEET:-$HOME/.local/share/sergeant/fleet}"

_die() { printf 'ERROR: %s\n' "$*" >&2; exit 1; }

[[ $# -eq 2 ]] || _die "Usage: sgt-wake <task-id> <repo>"

TASK_ID="$1"
REPO="$2"
[[ "$TASK_ID" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || _die "Invalid task ID: $TASK_ID"
[[ "$REPO"    =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || _die "Invalid repo: $REPO"

REPO_DIR="$FLEET_DIR/$TASK_ID/$REPO"
[[ -d "$REPO_DIR" ]] || _die "Repo not found in task $TASK_ID: $REPO"

worktree="$(cat "$REPO_DIR/worktree" 2>/dev/null || true)"
[[ -n "$worktree" && -d "$worktree" ]] || _die "Worktree unavailable for $TASK_ID/$REPO"

# ── Verify waiting status ────────────────────────────────────────────────────

current_status="$(tr -d '\n' < "$worktree/.sergeant-status" 2>/dev/null || \
                  cat "$REPO_DIR/status" 2>/dev/null || true)"
[[ "$current_status" == "waiting" ]] || \
  _die "Worker $TASK_ID/$REPO is not in waiting state (status: $current_status)"

condition_file="$worktree/.sergeant-wake-condition"
[[ -f "$condition_file" ]] || \
  _die "No wake condition file at $condition_file"

# ── Parse and validate wake condition ───────────────────────────────────────
# Allowlisted field names only; allowlisted value characters only.
# Secrets (token, password, key, secret, auth, credential) are rejected.

_ALLOWED_FIELDS="kind generation not_before deadline max_attempts backoff_base run_id check_name task_id repo td_task_id app env"
_SECRET_PATTERN='(token|password|key|secret|auth|credential|passwd|apikey|api_key)'
# Strict values do not admit a leading '-': those values can become arguments
# to gh(1) or td(1), where a dash-leading value could be read as an option.
_STRICT_VALUE_PATTERN='^([A-Za-z0-9._/:][A-Za-z0-9._/:-]*)?$'
# GitHub check names are human-authored and may contain any printable Unicode
# character that GitHub allows (e.g. "Build · test" with U+00B7 middle dot,
# matrix names with parentheses, shell punctuation, and accented characters).
# Python gives validation locale-independent Unicode semantics; quoted argv
# keeps every accepted byte sequence inert. C0/C1 controls and Unicode line or
# paragraph separators remain invalid in this line-oriented file format.
_valid_check_name() {
  command -v python3 >/dev/null 2>&1 || return 1
  python3 -c '
import sys, unicodedata

value = sys.argv[1]
try:
    value.encode("utf-8")
except UnicodeEncodeError:
    raise SystemExit(1)
if any(unicodedata.category(char) in ("Cc", "Zl", "Zp") for char in value):
    raise SystemExit(1)
' "$1"
}

_valid_condition_storage() {
  command -v python3 >/dev/null 2>&1 || return 1
  python3 -c '
import sys, unicodedata

with open(sys.argv[1], "rb") as condition_file:
    raw = condition_file.read()
try:
    decoded = raw.decode("utf-8")
except UnicodeDecodeError:
    raise SystemExit(1)
for char in decoded:
    if char == "\n":
        continue
    if unicodedata.category(char) in ("Cc", "Zl", "Zp"):
        raise SystemExit(1)
' "$1"
}

# Bash 3.2-compatible key-value store for wake condition fields.
# Uses two parallel arrays: _COND_KEYS and _COND_VALS.
# Use _cond_get <field> to look up a value.
_COND_KEYS=()
_COND_VALS=()

_cond_set() {
  local k="$1" v="$2" i
  for i in "${!_COND_KEYS[@]}"; do
    if [[ "${_COND_KEYS[$i]}" == "$k" ]]; then
      return 1
    fi
  done
  _COND_KEYS+=("$k")
  _COND_VALS+=("$v")
}

_cond_get() {
  local k="$1" i
  for i in "${!_COND_KEYS[@]}"; do
    if [[ "${_COND_KEYS[$i]}" == "$k" ]]; then
      printf '%s' "${_COND_VALS[$i]}"
      return
    fi
  done
  # return empty string when key absent
}

# Bash variables cannot retain NUL bytes. Reject raw control bytes before read(1)
# can discard or normalize them and turn an unsafe field name into an allowed
# one. grep sees records without their newline delimiters, so [[:cntrl:]] here
# rejects embedded controls without rejecting the file's structural newlines.
if LC_ALL=C grep -aEq '[[:cntrl:]]' "$condition_file"; then
  _die "invalid control characters in wake-condition storage"
fi

# Python is already required by github_check. When available, validate the
# entire file before Bash tokenizes it: malformed UTF-8 in a field name must not
# be hidden by locale-dependent shell parsing. Other condition kinds retain
# their no-Python path; their existing ASCII field/value allowlists still apply.
if command -v python3 >/dev/null 2>&1; then
  if ! _valid_condition_storage "$condition_file"; then
    _die "invalid UTF-8 or control characters in wake-condition storage"
  fi
elif LC_ALL=C grep -aEq '^[[:space:]]*check_name[[:space:]]*=' "$condition_file"; then
  _die "python3 not available to validate check_name"
fi

# read returns nonzero at EOF even when it populated an unterminated final
# record. Process that record as well so a duplicate cannot hide after the last
# newline. The value bytes remain exactly as read.
field=""
value=""
while IFS='=' read -r field value || [[ -n "$field" || -n "$value" ]]; do
  # Strip whitespace from structural fields. A GitHub check name is opaque:
  # spaces after its '=' belong to the provider name and must be preserved.
  raw_value="$value"
  field="${field#"${field%%[![:space:]]*}"}"
  field="${field%"${field##*[![:space:]]}"}"
  if [[ "$field" != "check_name" ]]; then
    value="${value#"${value%%[![:space:]]*}"}"
    value="${value%"${value##*[![:space:]]}"}"
  else
    value="$raw_value"
  fi
  [[ -n "$field" ]] || continue
  # Skip comment lines.
  [[ "$field" != \#* ]] || continue

  # Reject unknown fields.
  found=0
  for allowed in $_ALLOWED_FIELDS; do
    [[ "$field" == "$allowed" ]] && found=1 && break
  done
  [[ "$found" == 1 ]] || {
    printf 'ERROR: unknown wake-condition field: %s\n' "$field" >&2
    exit 1
  }

  # Reject secret-like field names (double-check; belt-and-suspenders).
  if printf '%s\n' "$field" | grep -qiE "$_SECRET_PATTERN"; then
    printf 'ERROR: secret-like field rejected: %s\n' "$field" >&2
    exit 1
  fi

  # A present-but-empty field is a distinct mistake from a malformed one; saying
  # "invalid characters" for an empty value sends the reader looking for a
  # character that is not there.
  if [[ -z "$value" ]]; then
    printf 'ERROR: empty value for wake-condition field: %s\n' "$field" >&2
    exit 1
  fi

  # GitHub check names are opaque UTF-8. Passing the quoted value as argv keeps
  # shell punctuation inert while the validator rejects malformed UTF-8 and
  # control characters that are unsafe in line-oriented storage.
  if [[ "$field" == "check_name" ]]; then
    if ! _valid_check_name "$value"; then
      printf 'ERROR: invalid UTF-8 or control characters in field value for %s\n' "$field" >&2
      exit 1
    fi
  elif ! [[ "$value" =~ $_STRICT_VALUE_PATTERN ]]; then
    printf 'ERROR: invalid characters in field value for %s\n' "$field" >&2
    exit 1
  fi

  if ! _cond_set "$field" "$value"; then
    printf 'ERROR: duplicate wake-condition field: %s\n' "$field" >&2
    exit 1
  fi
done < "$condition_file"

kind="$(_cond_get kind)"
generation="$(_cond_get generation)"
deadline="$(_cond_get deadline)"
max_attempts="$(_cond_get max_attempts)"
backoff_base="${backoff_base:-30}"
backoff_base_raw="$(_cond_get backoff_base)"
[[ -n "$backoff_base_raw" ]] && backoff_base="$backoff_base_raw"

[[ -n "$kind" ]]       || _die "Wake condition is missing required field: kind"
[[ -n "$generation" ]] || _die "Wake condition is missing required field: generation"

# ── Helpers: atomic status/message writers ──────────────────────────────────

_write_fleet_file() {
  local path="$1" content="$2" tmp
  tmp="$(mktemp "${path}.XXXXXX")"
  printf '%s\n' "$content" > "$tmp"
  mv "$tmp" "$path"
}

_set_terminal_state() {
  local status="$1" message="$2"
  _write_fleet_file "$REPO_DIR/status"                "$status"
  _write_fleet_file "$worktree/.sergeant-status"      "$status"
  _write_fleet_file "$worktree/.sergeant-message"     "$message"
}

_set_needs_input_state() {
  local message="$1"
  _set_terminal_state "needs_input" "$message"
}

# ── Deduplication lock ───────────────────────────────────────────────────────
# One sgt-wake evaluation per (task, repo) at a time.

lock_dir="$REPO_DIR/wake.lock"
_acquire_lock() {
  if ! mkdir "$lock_dir" 2>/dev/null; then
    # Lock dir exists — check if owner is still alive.
    local pid
    pid="$(cat "$lock_dir/pid" 2>/dev/null || true)"
    if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
      printf 'sgt-wake: another scheduler is active for %s/%s\n' \
        "$TASK_ID" "$REPO" >&2
      exit 1
    fi
    # Stale lock — reclaim.
    rm -rf "$lock_dir"
    mkdir "$lock_dir" 2>/dev/null || {
      printf 'sgt-wake: lock contention for %s/%s\n' "$TASK_ID" "$REPO" >&2
      exit 1
    }
  fi
  printf '%s\n' "$$" > "$lock_dir/pid"
}
_release_lock() {
  rm -rf "$lock_dir" 2>/dev/null || true
}
trap '_release_lock' EXIT

_acquire_lock

# ── Check deadline ───────────────────────────────────────────────────────────

now="$(date +%s)"
if [[ -n "$deadline" && "$deadline" =~ ^[0-9]+$ ]]; then
  if (( now > deadline )); then
    _set_terminal_state "failed: deadline exceeded" \
      "Wake condition deadline exceeded at $deadline (kind=$kind, generation=$generation)"
    printf 'sgt-wake: deadline exceeded for %s/%s\n' "$TASK_ID" "$REPO" >&2
    exit 1
  fi
fi

# ── Check max_attempts ───────────────────────────────────────────────────────

attempts_file="$REPO_DIR/wake_attempts"
current_attempts=0
if [[ -f "$attempts_file" ]]; then
  current_attempts="$(cat "$attempts_file" 2>/dev/null || echo 0)"
  [[ "$current_attempts" =~ ^[0-9]+$ ]] || current_attempts=0
fi

if [[ -n "$max_attempts" && "$max_attempts" =~ ^[0-9]+$ ]]; then
  if (( current_attempts >= max_attempts )); then
    _set_needs_input_state \
      "Wake condition max_attempts ($max_attempts) reached for kind=$kind generation=$generation; manual intervention required"
    printf 'sgt-wake: max_attempts exceeded for %s/%s\n' "$TASK_ID" "$REPO" >&2
    exit 1
  fi
fi

# ── Record attempt with backoff/jitter ──────────────────────────────────────
# Writes attempt count, timestamp, next_not_before (backoff), and jitter.

_record_attempt() {
  local attempt_num="$1" attempt_ts="$2"
  local jitter next_backoff_ts
  # Jitter: pseudorandom 0-9 seconds added to backoff.
  jitter=$(( RANDOM % 10 ))
  next_backoff_ts=$(( attempt_ts + backoff_base + jitter ))
  _write_fleet_file "$attempts_file"                    "$attempt_num"
  _write_fleet_file "$REPO_DIR/wake_last_attempt_ts"    "$attempt_ts"
  _write_fleet_file "$REPO_DIR/wake_backoff_jitter"     "$jitter"
  _write_fleet_file "$REPO_DIR/wake_next_not_before"    "$next_backoff_ts"
}

# ── Evaluate condition ───────────────────────────────────────────────────────
# condition_result: "met:<evidence>" | "unmet" | "error:<reason>"
#                 | "escalate:<reason>" | "unsupported"
#
# "unmet" means the condition may still be met on a later attempt.  "escalate"
# means the condition has become permanently unsatisfiable, so retrying until
# the attempt budget or deadline expires would be dishonest and wasteful.

condition_result=""

_result_met()         { condition_result="met:$1"; }
_result_unmet()       { condition_result="unmet"; }
_result_error()       { condition_result="error:$1"; }
_result_escalate()    { condition_result="escalate:$1"; }
_result_unsupported() { condition_result="unsupported"; }

# ── GitHub query helpers ─────────────────────────────────────────────────────
# gh(1) resolves its base repository from the current directory's git remote.
# sgt-wake runs from wherever the scheduler was invoked, which is normally NOT
# inside the worker's repository, so every gh query must be bound explicitly to
# the worker's recorded worktree.  Otherwise gh fails with "failed to determine
# base repo" and a resolution failure becomes indistinguishable from a pending
# run.

# _gh_repo_slug <dir>
#
# Prints the owner/name slug of <dir>'s `origin` remote when it is a GitHub
# remote.  Returns 1 when the slug cannot be determined (no git, no remote, or
# a non-GitHub host), in which case the caller falls back to letting gh resolve
# the repository from the worktree cwd.
_gh_repo_slug() {
  local dir="$1" url slug host_pattern
  command -v git >/dev/null 2>&1 || return 1
  url="$(git -C "$dir" remote get-url origin 2>/dev/null || true)"
  [[ -n "$url" ]] || return 1
  # The host is anchored: a remote on a host that merely ENDS in github.com
  # (mygithub.com) must not be rewritten into a github.com slug and queried as
  # the wrong repository.
  host_pattern='^(https?://([^@/]+@)?|git@|ssh://([^@/]+@)?)github\.com[:/]+'
  [[ "$url" =~ $host_pattern ]] || return 1
  slug="${url%.git}"
  slug="${slug#*github.com}"
  slug="${slug#"${slug%%[^:/]*}"}"
  [[ "$slug" =~ ^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$ ]] || return 1
  printf '%s\n' "$slug"
}

# _gh_run_view <repo_dir> <run_id> <json_fields>
#
# Queries a workflow run bound to <repo_dir>, the worker's recorded worktree.
# On success sets _GH_JSON and returns 0.  On failure sets _GH_ERROR to the
# sanitised gh diagnostic and returns 1, so an unresolvable repository, an auth
# failure, and a genuinely pending run stay distinguishable.
_gh_run_view() {
  local repo_dir="$1" run_id="$2" fields="$3" rc=0 slug work out err
  local -a args
  _GH_JSON=""
  _GH_ERROR=""
  args=(run view "$run_id" --json "$fields")
  slug="$(_gh_repo_slug "$repo_dir" || true)"
  [[ -z "$slug" ]] || args+=(--repo "$slug")

  if ! work="$(mktemp -d)"; then
    _GH_ERROR="cannot create a temporary directory for the gh query"
    return 1
  fi
  out="$work/stdout"
  err="$work/stderr"
  ( cd "$repo_dir" && gh "${args[@]}" ) >"$out" 2>"$err" || rc=$?
  _GH_JSON="$(cat "$out" 2>/dev/null || true)"
  # Collapse the diagnostic to one sanitised, bounded line — it is persisted to
  # fleet state, so it must never carry newlines or unbounded output.
  _GH_ERROR="$(tr -c '[:print:]' ' ' < "$err" 2>/dev/null | \
    sed -e 's/  */ /g' -e 's/^ //' -e 's/ $//' | cut -c1-300)"
  rm -rf "$work"

  if (( rc != 0 )); then
    [[ -n "$_GH_ERROR" ]] || _GH_ERROR="gh exited $rc without a diagnostic"
    return 1
  fi
  if [[ -z "$_GH_JSON" ]]; then
    _GH_ERROR="gh returned empty output"
    return 1
  fi
  return 0
}

# _gh_select_check <run_json> <check_name>
#
# Selects the checks (workflow-run jobs) whose name is exactly <check_name> and
# publishes the outcome in _GH_RUN_STATUS, _GH_MATCH_COUNT, _GH_JOB_STATUS, and
# _GH_JOB_CONCLUSION.  Returns 1 when the run JSON cannot be parsed, so an
# unparseable response never masquerades as an absent or satisfied check.
_gh_select_check() {
  local run_json="$1" name="$2" parsed key value
  _GH_RUN_STATUS=""
  _GH_MATCH_COUNT=""
  _GH_JOB_STATUS=""
  _GH_JOB_CONCLUSION=""

  parsed="$(printf '%s\n' "$run_json" | python3 -c '
import json, sys

name = sys.argv[1]
data = json.load(sys.stdin)
jobs = data.get("jobs") or []
matches = [j for j in jobs if (j.get("name") or "") == name]
print("run_status=%s" % (data.get("status") or ""))
print("match_count=%d" % len(matches))
if len(matches) == 1:
    print("job_status=%s" % (matches[0].get("status") or ""))
    print("job_conclusion=%s" % (matches[0].get("conclusion") or ""))
' "$name" 2>/dev/null)" || return 1

  while IFS='=' read -r key value; do
    # GitHub-supplied values are only ever compared against literals and
    # embedded in evidence text, but keep them constrained anyway.
    [[ "$value" =~ ^[A-Za-z0-9_-]*$ ]] || return 1
    case "$key" in
      run_status)      _GH_RUN_STATUS="$value" ;;
      match_count)     _GH_MATCH_COUNT="$value" ;;
      job_status)      _GH_JOB_STATUS="$value" ;;
      job_conclusion)  _GH_JOB_CONCLUSION="$value" ;;
    esac
  done <<< "$parsed"

  [[ "$_GH_MATCH_COUNT" =~ ^[0-9]+$ ]] || return 1
  return 0
}

case "$kind" in

  not_before)
    not_before="$(_cond_get not_before)"
    if [[ -z "$not_before" || ! "$not_before" =~ ^[0-9]+$ ]]; then
      _result_error "not_before field missing or invalid"
    elif (( now >= not_before )); then
      _result_met "not_before condition met: now=$now >= not_before=$not_before"
    else
      _result_unmet
    fi
    ;;

  fleet_dependency)
    dep_task="$(_cond_get task_id)"
    dep_repo="$(_cond_get repo)"
    if [[ -z "$dep_task" || -z "$dep_repo" ]]; then
      _result_error "fleet_dependency requires task_id and repo fields"
    else
      dep_status="$(cat "$FLEET_DIR/$dep_task/$dep_repo/status" 2>/dev/null || true)"
      if [[ "$dep_status" == "done" ]]; then
        _result_met "fleet_dependency met: $dep_task/$dep_repo is done"
      else
        _result_unmet
      fi
    fi
    ;;

  td_dependency)
    td_task="$(_cond_get td_task_id)"
    if [[ -z "$td_task" ]]; then
      _result_error "td_dependency requires td_task_id field"
    elif ! command -v td >/dev/null 2>&1; then
      _result_error "td command not available for td_dependency adapter"
    else
      td_status="$(td status "$td_task" 2>/dev/null || true)"
      case "${td_status:-}" in
        done|closed|complete|completed)
          _result_met "td_dependency met: $td_task status=$td_status"
          ;;
        "")
          _result_error "td status returned empty for $td_task"
          ;;
        *)
          _result_unmet
          ;;
      esac
    fi
    ;;

  github_check)
    # The condition is met only when the ONE check named by check_name has
    # concluded successfully.  Both run_id and check_name are required: without
    # a selected check there is nothing to evaluate, and accepting any completed
    # run would wake a worker on a failed check.
    run_id="$(_cond_get run_id)"
    check_name="$(_cond_get check_name)"
    if [[ -z "$run_id" || ! "$run_id" =~ ^[0-9]+$ ]]; then
      # A malformed condition cannot become well-formed by waiting.
      _result_escalate "github_check requires a numeric run_id field; add it to .sergeant-wake-condition and resume with sgt-respond"
    elif [[ -z "$check_name" ]]; then
      # Conditions written before check_name was required land here: retrying
      # would strand the worker in waiting forever, so escalate with the remedy.
      _result_escalate "github_check requires a check_name field naming the exact check to wait for; add check_name=<name> to .sergeant-wake-condition and resume with sgt-respond"
    elif ! command -v gh >/dev/null 2>&1; then
      _result_error "gh CLI not available for github_check adapter"
    elif ! command -v python3 >/dev/null 2>&1; then
      _result_error "python3 not available for github_check adapter"
    elif ! _gh_run_view "$worktree" "$run_id" status,conclusion,jobs; then
      _result_error "gh run view failed for run_id=$run_id: $_GH_ERROR"
    else
      if ! _gh_select_check "$_GH_JSON" "$check_name"; then
        _result_error "could not parse gh run JSON for run_id=$run_id"
      else
        case "$_GH_MATCH_COUNT" in
          0)
            if [[ "$_GH_RUN_STATUS" == "completed" ]]; then
              # The run is finished, so the named check will never appear.
              _result_escalate "github_check not found: no check named '$check_name' in completed run_id=$run_id; correct check_name or choose another run, then resume with sgt-respond"
            else
              # The run is still going; the named check may not have started.
              _result_unmet
            fi
            ;;
          1)
            if [[ "$_GH_JOB_STATUS" != "completed" ]]; then
              _result_unmet
            elif [[ "$_GH_JOB_CONCLUSION" == "success" ]]; then
              _result_met "github_check succeeded: run_id=$run_id check_name='$check_name' conclusion=success"
            else
              # A concluded non-success check can never become success, so this
              # is terminal for the condition — escalate instead of retrying.
              _result_escalate "github_check concluded '$_GH_JOB_CONCLUSION' (not success) for run_id=$run_id check_name='$check_name'; the wake condition can no longer be met"
            fi
            ;;
          *)
            # Which of the duplicates gates the wake cannot be decided here, and
            # the run's job names will not change.
            _result_escalate "github_check ambiguous: $_GH_MATCH_COUNT checks named '$check_name' in run_id=$run_id; disambiguate check_name and resume with sgt-respond"
            ;;
        esac
      fi
    fi
    ;;

  deployment)
    # Deployment terminal-state detection requires environment-specific tooling
    # not yet configured in this Sergeant installation.  Set needs_input so the
    # coordinator can wire up the deployment adapter or resolve manually.
    _result_unsupported
    ;;

  human_response)
    # Human response conditions cannot be auto-evaluated; escalate immediately.
    _result_unsupported
    ;;

  *)
    _result_unsupported
    ;;

esac

# ── Route on result ──────────────────────────────────────────────────────────

case "$condition_result" in

  unsupported)
    _set_needs_input_state \
      "Wake condition kind=$kind (generation=$generation) cannot be auto-evaluated; manual response required"
    printf 'sgt-wake: unsupported condition kind=%s for %s/%s\n' \
      "$kind" "$TASK_ID" "$REPO" >&2
    exit 1
    ;;

  escalate:*)
    escalate_reason="${condition_result#escalate:}"
    _write_fleet_file "$REPO_DIR/diagnostic" \
      "sgt-wake condition unsatisfiable: $escalate_reason (kind=$kind generation=$generation)"
    _set_needs_input_state \
      "Wake condition kind=$kind (generation=$generation) can no longer be met: $escalate_reason. Decide how to proceed and resume with sgt-respond."
    printf 'sgt-wake: condition unsatisfiable for %s/%s: %s\n' \
      "$TASK_ID" "$REPO" "$escalate_reason" >&2
    exit 1
    ;;

  error:*)
    error_reason="${condition_result#error:}"
    _write_fleet_file "$REPO_DIR/diagnostic" \
      "sgt-wake adapter error: $error_reason (kind=$kind generation=$generation)"
    new_attempts=$(( current_attempts + 1 ))
    _record_attempt "$new_attempts" "$now"
    printf 'sgt-wake: adapter error for %s/%s: %s\n' \
      "$TASK_ID" "$REPO" "$error_reason" >&2
    exit 1
    ;;

  unmet)
    new_attempts=$(( current_attempts + 1 ))
    _record_attempt "$new_attempts" "$now"
    printf 'sgt-wake: condition not yet met for %s/%s (kind=%s attempt=%s)\n' \
      "$TASK_ID" "$REPO" "$kind" "$new_attempts" >&2
    exit 1
    ;;

  met:*)
    evidence="${condition_result#met:}"
    ;;

  *)
    _die "internal error: unexpected condition_result='$condition_result'"
    ;;

esac

# ── Gate-generation pre-flight (GH #202) ────────────────────────────────────
# The wake condition's `generation` field records the gate generation when the
# condition was written.  The worker's current gate generation is stored in
# .sergeant-gate-generation.  If the two differ, the condition belongs to a
# previous wait cycle — the gate has advanced since the condition was set, so
# sgt-respond will reject it anyway.  Failing here with an actionable message
# is safer than discovering the mismatch mid-resume when sgt-respond has
# already mutated state.
#
# We only check when the condition carries a numeric generation (all conditions
# written since this contract was added will).  A missing or non-numeric
# generation in the condition is allowed through and will be validated by
# sgt-respond, which has the definitive gate-generation check.

current_gate_generation="$(tr -d '\n' < "$worktree/.sergeant-gate-generation" 2>/dev/null || true)"
if [[ "$generation" =~ ^[1-9][0-9]*$ && -n "$current_gate_generation" ]]; then
  if [[ "$current_gate_generation" != "$generation" ]]; then
    _die "Gate generation mismatch: wake condition was written at generation $generation but the worker is now at generation $current_gate_generation. The condition belongs to a prior wait cycle and cannot resume this gate. Inspect the worker state with: sgt-watch $TASK_ID --snapshot --repo $REPO"
  fi
fi

# ── Condition met — resume via sgt-respond ───────────────────────────────────

resume_msg="Wake condition met (kind=$kind generation=$generation): $evidence. Resume the mission from the durable worker state and apply the wake evidence."

if ! command -v sgt-respond >/dev/null 2>&1; then
  sgt_respond="$SCRIPT_DIR/sgt-respond"
else
  sgt_respond="sgt-respond"
fi

printf '%s\n' "$resume_msg" | \
  SERGEANT_FLEET="$FLEET_DIR" "$sgt_respond" "$TASK_ID" "$REPO"

printf 'sgt-wake: resumed %s/%s (kind=%s generation=%s)\n' \
  "$TASK_ID" "$REPO" "$kind" "$generation"
