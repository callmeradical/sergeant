#!/usr/bin/env bash
# sgt-notify — Inject a worker update into the primary sergeant session.
#
# Called by workers for escalations and terminal outcomes. The default transport
# records a metadata-only wake marker for the durable fleet watcher. Raw tmux
# injection remains an explicit compatibility option.
#
# Usage:
#   sgt-notify <task-id> "<message>"
#
# Examples:
#   sgt-notify fix-argocd-adopt-orphan-0bd2da "done: PR https://github.com/.../pull/217"
#   sgt-notify feat-api-design-123abc "needs_input [api]: choose pagination contract"
#   sgt-notify fix-flaky-test-456def "blocked [app]: fixture unavailable"
#   sgt-notify feat-gitops-post-promoti-5f5be4 "failed: helm lint error in values.yaml"

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=bin/_sgt-lib.sh
source "$SCRIPT_DIR/_sgt-lib.sh"

[[ $# -ge 2 ]] || _die "Usage: sgt-notify <task-id> \"<message>\""

TASK_ID="$1"
MESSAGE="$2"

TASK_DIR="$FLEET_DIR/$TASK_ID"
[[ -d "$TASK_DIR" ]] || _die "Task not found: $TASK_ID"

# ── Classify durable event ────────────────────────────────────────────────────
case "$MESSAGE" in
  done*|failed*) _event="completion"; _heading="Agent Completion" ;;
  needs_input*|blocked*) _event="escalation"; _heading="Agent Escalation" ;;
  *) _event="update"; _heading="Agent Update" ;;
esac

# Durable callbacks are derived from authoritative task state, never this
# conversational summary. Delivery failure remains queued for a later drain.
_callback_origin=0
_callback_error=0
if [[ -e "$TASK_DIR/.callbacks/origin.json" || -L "$TASK_DIR/.callbacks/origin.json" ]]; then
  if "$SCRIPT_DIR/sgt-callback" sync "$TASK_ID"; then
    _callback_origin=1
  else
    echo "sgt-notify: durable callback sync failed" >&2
    _callback_error=1
  fi
fi

(
  umask 077
  notify_tmp="$(mktemp "$TASK_DIR/notify.tmp.XXXXXX")"
  {
    printf 'event=%s\n' "$_event"
    printf 'updated=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  } > "$notify_tmp"
  chmod 600 "$notify_tmp"
  mv "$notify_tmp" "$TASK_DIR/notify"
)

# ── Optional compatibility transport ─────────────────────────────────────────
NOTIFY_TRANSPORT="${SERGEANT_NOTIFY_TRANSPORT:-durable}"
_notify_done=0
case "$NOTIFY_TRANSPORT" in
  durable)
    echo "sgt-notify: recorded durable $_event update." >&2
    ;;
  tmux)
  INJECT="Agent task $TASK_ID update: $MESSAGE"
  PRIMARY_PANE_FILE="$TASK_DIR/primary_pane"

  if [[ ! -f "$PRIMARY_PANE_FILE" ]]; then
    if [[ "$_callback_origin" -eq 1 ]]; then
      echo "sgt-notify: no coordinator target; durable callback is queued." >&2
      _notify_done=1
    else
      echo "sgt-notify: no primary_pane recorded — cannot notify" >&2
      exit 1
    fi
  fi

  PRIMARY_PANE=""
  [[ ! -f "$PRIMARY_PANE_FILE" ]] || PRIMARY_PANE="$(cat "$PRIMARY_PANE_FILE")"

  if [[ "$_notify_done" -eq 0 && -z "$PRIMARY_PANE" ]]; then
    echo "sgt-notify: primary_pane file empty — cannot notify" >&2
    exit 1
  fi

  if [[ "$_notify_done" -eq 0 ]] && ! tmux has-session -t "${PRIMARY_PANE%%.*}" 2>/dev/null; then
    if [[ "$_callback_origin" -eq 1 ]]; then
      echo "sgt-notify: coordinator session gone; durable callback is queued." >&2
      _notify_done=1
    else
      echo "sgt-notify: tmux session gone — cannot notify" >&2
      exit 1
    fi
  fi

  if [[ "$_notify_done" -eq 0 ]]; then
    echo "sgt-notify: injecting via tmux into pane $PRIMARY_PANE" >&2
    tmux send-keys -t "$PRIMARY_PANE" "$INJECT" Enter
    echo "sgt-notify: sent via tmux." >&2
  fi
    ;;
  *) _die "unsupported SERGEANT_NOTIFY_TRANSPORT: $NOTIFY_TRANSPORT" ;;
esac

# ── Wiki: classify terminal outcomes separately from escalations ─────────────
_pr_url=$(echo "$MESSAGE" | grep -oE 'https://github\.com/[^ ]+' | head -1 || true)
_wiki_body="## $_heading

- **Task ID:** \`$TASK_ID\`
- **Event:** $_event
- **Result:** $MESSAGE
- **PR:** ${_pr_url:+[$_pr_url]($_pr_url)}${_pr_url:-none}"

_sgt_wiki_write \
  "sgt-notify: $TASK_ID $_event" \
  "activity" \
  "Agent $TASK_ID: $MESSAGE" \
  "sergeant,notify,$TASK_ID" \
  "$_wiki_body"

[[ "$_callback_error" -eq 0 ]] || exit 1
