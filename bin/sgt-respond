#!/usr/bin/env bash
# sgt-respond - Deliver a response and resume a dead waiting worker when needed.

set -euo pipefail

_sgt_respond_real_dir() {
  local src="$1" target dir _link _i=0
  target="$src"
  while [[ -L "$target" && $_i -lt 20 ]]; do
    _link="$(readlink "$target" 2>/dev/null || true)"
    [[ -n "$_link" ]] || break
    if [[ "$_link" == /* ]]; then target="$_link"; else target="$(dirname "$target")/$_link"; fi
    _i=$(( _i + 1 ))
  done
  dir="$(dirname "$target")"
  (cd "$dir" && pwd -P)
}
SCRIPT_DIR="$(_sgt_respond_real_dir "${BASH_SOURCE[0]}")"
unset -f _sgt_respond_real_dir
# shellcheck source=bin/_sgt-lib.sh
source "$SCRIPT_DIR/_sgt-lib.sh"
# shellcheck source=bin/_sgt-intent.sh
source "$SCRIPT_DIR/_sgt-intent.sh"
# shellcheck source=bin/_sgt-response-lock.sh
source "$SCRIPT_DIR/_sgt-response-lock.sh"
# shellcheck source=bin/_sgt-drain.sh
source "$SCRIPT_DIR/_sgt-drain.sh"

[[ $# -eq 2 ]] || _die "Usage: sgt-respond <task-id> <repo>; reads the response from standard input"

TASK_ID="$1"
REPO="$2"
[[ "$TASK_ID" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || _die "Invalid task ID: $TASK_ID"
[[ "$REPO" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || _die "Invalid repo: $REPO"
RESPONSE_INPUT=""
new_pane=""
replacement_committed=false
_cleanup_response_input() {
  [[ -z "$RESPONSE_INPUT" ]] || rm -f "$RESPONSE_INPUT"
}
trap '_cleanup_response_input' EXIT
umask 077
RESPONSE_INPUT="$(mktemp "${TMPDIR:-/tmp}/sgt-response.XXXXXX")" || \
  _die "Could not create private response input"
chmod 600 "$RESPONSE_INPUT"
if [[ -t 0 ]]; then
  printf 'Response (Ctrl-D to submit): ' >&2
fi
cat > "$RESPONSE_INPUT"
[[ -s "$RESPONSE_INPUT" ]] || _die "Response must not be empty"

REPO_DIR="$FLEET_DIR/$TASK_ID/$REPO"
[[ -d "$FLEET_DIR/$TASK_ID" ]] || _die "Task not found: $TASK_ID"
[[ -d "$REPO_DIR" ]] || _die "Repo not found in task $TASK_ID: $REPO"
_sgt_worker_process_marker_preflight "$REPO_DIR" || \
  _die "Response refused: worker process marker evidence is torn"

# Read project name from brief.md for drain admission checks.
_sgt_drain_read_project_from_brief "$FLEET_DIR/$TASK_ID"

worktree="$(cat "$REPO_DIR/worktree" 2>/dev/null || true)"

_SGT_RESPOND_LAUNCH_FD=7
_sgt_drain_lock_acquire_fd "$_SGT_RESPOND_LAUNCH_FD" worker-launch \
  "$REPO_DIR/worker-launch.lock" || _die "Could not acquire exact worker-launch ownership"
_sgt_worker_launch_transaction_begin "$REPO_DIR" "$_SGT_RESPOND_LAUNCH_FD" || \
  _die "Could not snapshot worker generation before response relaunch"
respond_worker_launch_before=""
eval "respond_worker_launch_before=\${_SGT_WORKER_LAUNCH_BEFORE_${_SGT_RESPOND_LAUNCH_FD}:-}"
respond_peer_launch_contended="$SGT_DRAIN_LOCK_CONTENDED_LIVE"
respond_peer_launch_nonce="$SGT_DRAIN_LOCK_CONTENDED_NONCE"
_sgt_response_lock_acquire "$REPO_DIR"

# The interactive worker publishes accepted/delivered while holding this same
# response lock.  Keep the worker-launch lock across the wait so another public
# relaunch/response operation cannot replace the durable target, but release the
# narrower response lock after the notification and target are fully published.
# Reacquire it before the caller adjudicates timeout evidence or retires any
# delivery state.
_wait_worker_notification_with_response_lock_released() {
  local pane="$1" notification_id="$2" wait_status
  _sgt_response_lock_release || return 2
  if _sgt_wait_worker_notification "$pane" "$REPO_DIR" "$notification_id"; then
    wait_status=0
  else
    wait_status=1
  fi
  _sgt_response_lock_acquire "$REPO_DIR" || return 2
  return "$wait_status"
}

_cleanup_respond() {
  local status=$?
  local marker marker_path
  if [[ -n "$new_pane" && "$replacement_committed" != true ]]; then
    tmux kill-pane -t "$new_pane" 2>/dev/null || true
    marker="$(_sgt_read_owned_file "$REPO_DIR/worker_process_marker" 2>/dev/null || true)"
    marker_path="${marker##*|}"
    if [[ -z "$marker_path" || ! -e "$marker_path" ]]; then
      rm -f "$REPO_DIR/response_relaunch_transaction" \
        "$REPO_DIR/response_relaunch_worker_before"
    fi
  fi
  _sgt_response_lock_release || status=1
  _sgt_drain_lock_release_fd "$_SGT_RESPOND_LAUNCH_FD" || status=1
  _cleanup_response_input || status=1
  return "$status"
}
trap '_cleanup_respond' EXIT
_sgt_worker_process_marker_preflight "$REPO_DIR" || \
  _die "Response refused: worker process marker evidence changed while waiting for ownership"

_install_legacy_file() {
  local source_file="$1" target="$2" temporary
  temporary="${target}.tmp.$$"
  if ! cp "$source_file" "$temporary" || ! mv "$temporary" "$target"; then
    rm -f "$temporary"
    return 1
  fi
}

_migrate_legacy_response_state() {
  local actual_branch actual_git_dir actual_pointer branch canonical common_dir
  local config_file configured_common configured_path evidence project raw_path repo_count revision
  local task_dir="$FLEET_DIR/$TASK_ID" repo_index task_brief
  local brief="$worktree/.sergeant-brief.md"

  [[ -n "$worktree" && "$worktree" == /* && -d "$worktree" ]] || return 1
  ! _sgt_intent_path_has_symlink "$worktree" || return 1
  canonical="$(cd "$worktree" 2>/dev/null && pwd -P)" || return 1
  [[ "$canonical" == "${worktree%/}" && -f "$canonical/.git" && ! -L "$canonical/.git" ]] || return 1
  actual_pointer="$(cat "$canonical/.git")"
  [[ "$actual_pointer" == "gitdir: "* ]] || return 1
  actual_git_dir="${actual_pointer#gitdir: }"
  [[ "$actual_git_dir" == /* ]] || actual_git_dir="$canonical/$actual_git_dir"
  actual_git_dir="$(cd "$actual_git_dir" 2>/dev/null && pwd -P)" || return 1
  common_dir="$(git -C "$canonical" rev-parse --git-common-dir 2>/dev/null)" || return 1
  [[ "$common_dir" == /* ]] || common_dir="$canonical/$common_dir"
  common_dir="$(cd "$common_dir" 2>/dev/null && pwd -P)" || return 1
  [[ "$actual_git_dir" == "$common_dir/worktrees/"* ]] || return 1
  branch="$(cat "$REPO_DIR/branch" 2>/dev/null || true)"
  [[ "$branch" =~ ^[A-Za-z0-9][A-Za-z0-9._/-]*$ ]] || return 1
  actual_branch="$(git -C "$canonical" symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
  [[ "$actual_branch" == "$branch" ]] || return 1
  [[ -f "$brief" && ! -L "$brief" ]] || return 1
  task_brief="$task_dir/brief.md"
  [[ -f "$task_brief" && ! -L "$task_brief" ]] || return 1
  project="$(sed -n 's/^Project:[[:space:]]*//p' "$task_brief")"
  [[ "$project" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || return 1
  grep -Fxq "**Task ID:** $TASK_ID" "$brief" &&
    grep -Fxq "**Project:** $project" "$brief" &&
    grep -Fxq "**Repo:** $REPO" "$brief" &&
    grep -Fxq "**Branch:** $branch" "$brief" &&
    grep -Fxq "**Worktree:** $worktree" "$brief" &&
    grep -Fxq "**Fleet state:** $REPO_DIR/" "$brief" || return 1

  config_file="$SERGEANT_CONFIG/$project.yaml"
  [[ -f "$config_file" && ! -L "$config_file" ]] || return 1
  command -v yq >/dev/null 2>&1 || return 1
  repo_count="$(yq '.repos | length' "$config_file" 2>/dev/null || true)"
  [[ "$repo_count" =~ ^[1-9][0-9]*$ ]] || return 1
  configured_path=""
  for repo_index in $(seq 0 $((repo_count - 1))); do
    if [[ "$(yq ".repos[$repo_index].name" "$config_file" 2>/dev/null || true)" == "$REPO" ]]; then
      raw_path="$(yq ".repos[$repo_index].path" "$config_file" 2>/dev/null || true)"
      configured_path="$(_resolve_path "$raw_path")"
      break
    fi
  done
  [[ -n "$configured_path" && -d "$configured_path" ]] || return 1
  configured_path="$(cd "$configured_path" 2>/dev/null && pwd -P)" || return 1
  configured_common="$(git -C "$configured_path" rev-parse --git-common-dir 2>/dev/null)" || return 1
  [[ "$configured_common" == /* ]] || configured_common="$configured_path/$configured_common"
  configured_common="$(cd "$configured_common" 2>/dev/null && pwd -P)" || return 1
  [[ "$common_dir" == "$configured_common" ]] || return 1

  [[ -f "$task_dir/.sergeant-intent.md" && ! -L "$task_dir/.sergeant-intent.md" &&
     -f "$task_dir/intent_revision" && ! -L "$task_dir/intent_revision" ]] || return 1
  revision="$(cat "$task_dir/intent_revision")"
  [[ -n "$revision" && "$revision" == "$(_sgt_intent_revision "$task_dir/.sergeant-intent.md")" ]] || return 1
  [[ ! -e "$REPO_DIR/worktree_git_pointer" ||
     "$(cat "$REPO_DIR/worktree_git_pointer" 2>/dev/null || true)" == "$actual_pointer" ]] || return 1
  [[ ! -e "$REPO_DIR/worktree_git_dir" ||
     "$(cat "$REPO_DIR/worktree_git_dir" 2>/dev/null || true)" == "$actual_git_dir" ]] || return 1
  if [[ -e "$REPO_DIR/.sergeant-intent.md" ]]; then
    cmp -s "$task_dir/.sergeant-intent.md" "$REPO_DIR/.sergeant-intent.md" || return 1
  fi
  if [[ -e "$worktree/.sergeant-intent.md" ]]; then
    cmp -s "$task_dir/.sergeant-intent.md" "$worktree/.sergeant-intent.md" || return 1
  fi
  [[ ! -e "$REPO_DIR/intent_revision" ||
     "$(cat "$REPO_DIR/intent_revision" 2>/dev/null || true)" == "$revision" ]] || return 1

  evidence="$REPO_DIR/legacy-response-migration.tmp.$$"
  {
    printf 'worktree=%s\n' "$canonical"
    printf 'branch=%s\n' "$branch"
    printf 'git_pointer=%s\n' "$actual_pointer"
    printf 'git_dir=%s\n' "$actual_git_dir"
    printf 'configured_repo=%s\n' "$configured_path"
    printf 'configured_common_dir=%s\n' "$configured_common"
    printf 'intent_revision=%s\n' "$revision"
  } > "$evidence" || return 1
  if [[ -e "$REPO_DIR/legacy-response-migration" ]]; then
    cmp -s "$evidence" "$REPO_DIR/legacy-response-migration" || {
      rm -f "$evidence"
      return 1
    }
    rm -f "$evidence"
  else
    mv "$evidence" "$REPO_DIR/legacy-response-migration" || return 1
  fi
  [[ -e "$REPO_DIR/worktree_git_pointer" ]] || printf '%s\n' "$actual_pointer" > "$REPO_DIR/worktree_git_pointer"
  [[ -e "$REPO_DIR/worktree_git_dir" ]] || printf '%s\n' "$actual_git_dir" > "$REPO_DIR/worktree_git_dir"
  [[ -e "$REPO_DIR/.sergeant-intent.md" ]] ||
    _install_legacy_file "$task_dir/.sergeant-intent.md" "$REPO_DIR/.sergeant-intent.md"
  [[ -e "$worktree/.sergeant-intent.md" ]] ||
    _install_legacy_file "$task_dir/.sergeant-intent.md" "$worktree/.sergeant-intent.md"
  [[ -e "$REPO_DIR/intent_revision" ]] || printf '%s\n' "$revision" > "$REPO_DIR/intent_revision"
}

_worktree_is_owned_checkout() {
  local canonical expected_pointer actual_pointer expected_git_dir actual_git_dir
  [[ -n "$worktree" && "$worktree" == /* && -d "$worktree" ]] || return 1
  ! _sgt_intent_path_has_symlink "$worktree" || return 1
  canonical="$(cd "$worktree" 2>/dev/null && pwd -P)" || return 1
  [[ "$canonical" == "${worktree%/}" ]] || return 1
  [[ -f "$canonical/.git" && ! -L "$canonical/.git" ]] || return 1
  expected_pointer="$(cat "$REPO_DIR/worktree_git_pointer" 2>/dev/null || true)"
  expected_git_dir="$(cat "$REPO_DIR/worktree_git_dir" 2>/dev/null || true)"
  actual_pointer="$(cat "$canonical/.git")"
  [[ -n "$expected_pointer" && "$actual_pointer" == "$expected_pointer" ]] || return 1
  [[ "$actual_pointer" == "gitdir: "* ]] || return 1
  actual_git_dir="${actual_pointer#gitdir: }"
  if [[ "$actual_git_dir" != /* ]]; then
    actual_git_dir="$canonical/$actual_git_dir"
  fi
  actual_git_dir="$(cd "$actual_git_dir" 2>/dev/null && pwd -P)" || return 1
  [[ -n "$expected_git_dir" && "$actual_git_dir" == "$expected_git_dir" ]]
}

if ! _worktree_is_owned_checkout; then
  if ! _migrate_legacy_response_state || ! _worktree_is_owned_checkout; then
    _die "Recorded worktree is missing, stale, or not an owned checkout; response was not published"
  fi
fi

if ! _sgt_intent_revision_matches "$FLEET_DIR/$TASK_ID" "$REPO_DIR" "$worktree"; then
  if ! _migrate_legacy_response_state || \
     ! _sgt_intent_revision_matches "$FLEET_DIR/$TASK_ID" "$REPO_DIR" "$worktree"; then
    _die "canonical intent revision mismatch; audited human decision/new revision required"
  fi
fi

if [[ -n "$worktree" && -d "$worktree" && -f "$worktree/.sergeant-status" ]]; then
  status="$(tr -d '\n' < "$worktree/.sergeant-status")"
else
  status="$(cat "$REPO_DIR/status" 2>/dev/null || true)"
fi
joining_recovery_response=false
case "$status" in
  needs_input|blocked|waiting|orphaned) ;;
  in_progress)
    if [[ "$respond_peer_launch_contended" == true ]]; then
      :
    elif _sgt_transfer_journal_read "$REPO_DIR/response_relaunch_transaction" &&
        [[ -z "$_SGT_TRANSFER_RESPONSE_ID" ]]; then
      joining_recovery_response=true
    else
      _die "Worker status 'in_progress' has no exact recovery transfer journal to join"
    fi
    ;;
  *) _die "Worker status '$status' is not waiting or resumable; response was not published" ;;
esac

_atomic_write() {
  local target="$1"
  local value="$2"
  local temporary
  temporary="$(mktemp "${target}.tmp.XXXXXX")"
  if _sgt_transfer_io_failpoint "$target" write; then
    rm -f "$temporary"
    return 1
  fi
  printf '%s\n' "$value" > "$temporary"
  if _sgt_transfer_io_failpoint "$target" rename; then
    rm -f "$temporary"
    return 1
  fi
  if ! mv "$temporary" "$target"; then
    rm -f "$temporary"
    return 1
  fi
}

_atomic_write_file() {
  local target="$1"
  local source_file="$2"
  local temporary
  temporary="$(mktemp "${target}.tmp.XXXXXX")"
  if _sgt_transfer_io_failpoint "$target" write; then
    rm -f "$temporary"
    return 1
  fi
  if ! cat "$source_file" > "$temporary"; then
    rm -f "$temporary"
    return 1
  fi
  if _sgt_transfer_io_failpoint "$target" rename || ! mv "$temporary" "$target"; then
    rm -f "$temporary"
    return 1
  fi
}

_create_exact_once() {
  local target="$1" value="$2" temporary="${1}.tmp.$$.$RANDOM"
  _sgt_transfer_io_failpoint "$target" write && return 1
  printf '%s\n' "$value" > "$temporary" || return 1
  if [[ -e "$target" ]]; then
    cmp -s "$temporary" "$target" || { rm -f "$temporary"; return 1; }
    rm -f "$temporary"
    return 0
  fi
  _sgt_transfer_io_failpoint "$target" rename && { rm -f "$temporary"; return 1; }
  if ! ln "$temporary" "$target" 2>/dev/null; then
    if [[ ! -e "$target" ]] || ! cmp -s "$temporary" "$target"; then
      rm -f "$temporary"
      return 1
    fi
  fi
  rm -f "$temporary"
}

_publish_local_response_transport() {
  local response_file="$1"
  local response_id="$2"
  local gate_generation="$3"
  _atomic_write "$REPO_DIR/response_generation" "$gate_generation"
  _atomic_write "$REPO_DIR/response_id" "$response_id"
  rm -f "$worktree/.sergeant-response-ack"
  _atomic_write "$worktree/.sergeant-response-generation" "$gate_generation"
  _atomic_write "$worktree/.sergeant-response-id" "$response_id"
  _atomic_write_file "$REPO_DIR/response" "$response_file"
  _atomic_write_file "$worktree/.sergeant-response" "$response_file"
}

# ── Bounded delivery recovery ─────────────────────────────────────────────────
# Delivering to a live, identity-verified pane is bounded by
# SGT_NOTIFICATION_ACK_TIMEOUT.  When that bound elapses the response is stored
# but unconsumed.  Previously this dead-ended: the error said the response
# "remains pending" and every retry was refused with "already pending
# consumption", leaving no supported next action.
#
# The timeout now records a generation-bound escalation marker.  Rerunning the
# same command is the documented recovery path: it skips redelivery to the
# unresponsive pane and performs exactly one bounded worker relaunch.
#
# _delivery_escalation_armed: 0 when an escalation is recorded for this exact
# response id and gate generation.
_delivery_escalation_armed() {
  local marker="$REPO_DIR/response_delivery_unacked"
  [[ -f "$marker" ]] || return 1
  [[ "$(sed -n 's/^response_id=//p' "$marker" 2>/dev/null || true)" == "$response_id" ]] || return 1
  [[ "$(sed -n 's/^gate_generation=//p' "$marker" 2>/dev/null || true)" == "$gate_generation" ]]
}

_arm_delivery_escalation() {
  local reason="$1" identity="$2"
  {
    printf 'response_id=%s\n' "$response_id"
    printf 'gate_generation=%s\n' "$gate_generation"
    printf 'pane=%s\n' "${pane:-}"
    printf 'pane_identity=%s\n' "$identity"
    printf 'reason=%s\n' "$reason"
    printf 'recorded_at=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || true)"
  } > "$REPO_DIR/response_delivery_unacked.tmp.$$" || return 1
  if ! mv "$REPO_DIR/response_delivery_unacked.tmp.$$" \
      "$REPO_DIR/response_delivery_unacked"; then
    rm -f "$REPO_DIR/response_delivery_unacked.tmp.$$"
    return 1
  fi
}

pending_response_file=""
gate_generation="$(cat "$worktree/.sergeant-gate-generation" 2>/dev/null || true)"
if [[ "$status" == "orphaned" && ! "$gate_generation" =~ ^[1-9][0-9]*$ ]]; then
  gate_generation=1
  _atomic_write "$worktree/.sergeant-gate-generation" "$gate_generation"
fi
[[ "$gate_generation" =~ ^[1-9][0-9]*$ ]] || \
  _die "Worker gate generation is missing or invalid; response was not published"

peer_launch_completed=false
SGT_DRAIN_LOCK_CONTENDED_NONCE="$respond_peer_launch_nonce"
if [[ "$respond_peer_launch_contended" == true ]] && \
  _sgt_worker_launch_observed_completion_matches "$REPO_DIR"; then
  peer_launch_completed=true
fi

_queue_supplied_response_for_peer() {
  local queued_response_id queued_dir pane pane_identity target_nonce
  queued_response_id="$(dd if=/dev/urandom bs=16 count=1 2>/dev/null | \
    od -An -tx1 | tr -d ' \n')"
  [[ "$queued_response_id" =~ ^[0-9a-f]{32}$ ]] || \
    _die "Could not allocate canonical queued response identity"
  queued_dir="$REPO_DIR/queued_responses/$queued_response_id"
  mkdir -p "$queued_dir" || _die "Could not allocate queued response evidence"
  _atomic_write_file "$queued_dir/body" "$RESPONSE_INPUT" || \
    _die "Could not preserve queued response body"
  _atomic_write "$queued_dir/gate_generation" "$gate_generation" || \
    _die "Could not preserve queued response generation"
  pane="$(cat "$REPO_DIR/pane" 2>/dev/null || true)"
  pane_identity="$(_sgt_read_owned_file \
    "$REPO_DIR/pane_identity" 2>/dev/null || true)"
  [[ -n "$pane" && -n "$pane_identity" ]] || \
    _die "Could not bind queued response to the peer-launched worker pane"
  _sgt_pane_identity_matches "$pane" "$REPO_DIR" || \
    _die "Could not verify the peer-launched worker pane for queued response delivery"
  target_nonce="$(_sgt_notification_target_create \
    "$REPO_DIR" "$queued_response_id" "$pane_identity")" || \
    _die "Could not create queued response notification target"
  [[ "$target_nonce" =~ ^[a-f0-9]{32}$ ]] || \
    _die "Could not create canonical queued response notification target"
  _sgt_publish_worker_notification "$REPO_DIR" "$worktree" "$queued_response_id" \
    response "Apply queued response $queued_response_id from fleet state exactly once." || \
    _die "Could not bind queued response notification"
  _sgt_response_lock_release || \
    _die "Could not release response ownership for queued notification delivery"
  if ! _sgt_wait_worker_notification "$pane" "$REPO_DIR" "$queued_response_id"; then
    _die "Queued response $queued_response_id is stored and targeted to pane $pane, but the worker did not accept and deliver its notification within the delivery bound; inspect with: sgt-watch $TASK_ID --snapshot"
  fi
  printf 'sgt-respond: queued response delivered to pane %s (%s).\n' \
    "$pane" "$queued_response_id"
}

if [[ -f "$REPO_DIR/response" ]]; then
  pending_response_file="$REPO_DIR/response"
elif [[ -n "$worktree" && -d "$worktree" && -f "$worktree/.sergeant-response" ]]; then
  pending_response_file="$worktree/.sergeant-response"
fi

response_id="$(cat "$REPO_DIR/response_id" 2>/dev/null || true)"
if $peer_launch_completed && [[ -z "$pending_response_file" ]]; then
  _queue_supplied_response_for_peer
  exit 0
fi
if [[ -n "$pending_response_file" ]]; then
  [[ "$(cat "$REPO_DIR/response_generation" 2>/dev/null || true)" == "$gate_generation" && \
     "$(cat "$worktree/.sergeant-response-generation" 2>/dev/null || true)" == "$gate_generation" && \
     -n "$response_id" && \
     "$(cat "$worktree/.sergeant-response-id" 2>/dev/null || true)" == "$response_id" ]] || \
    _die "Pending response generation does not match the worker gate"
  if ! cmp -s "$RESPONSE_INPUT" "$pending_response_file" && \
    $peer_launch_completed; then
    _queue_supplied_response_for_peer
    exit 0
  fi
  if [[ -f "$worktree/.sergeant-response" && "$status" != "orphaned" ]]; then
    # A drain_held marker matching the current gate generation means the prior
    # delivery was held by drain admission.  Allow relaunch now that drain may
    # have been lifted; the marker is cleared on successful relaunch below.
    _sgt_drain_held_gen="$(cat "$REPO_DIR/drain_held" 2>/dev/null || true)"
    # An unacknowledged-delivery marker for this exact response and gate means a
    # previous invocation delivered to a live pane that never acknowledged.  This
    # used to dead-end the operator with "already pending consumption" and no
    # supported next action.  Rerunning the same command is now the bounded
    # recovery path: it escalates from delivery to one worker relaunch.
    if [[ "$_sgt_drain_held_gen" != "$gate_generation" ]] && \
       ! _delivery_escalation_armed; then
      _die "$(printf 'A Sergeant response is already pending consumption for %s/%s.\n  response: %s (gate %s)\n  The worker has not consumed it and no delivery escalation is recorded.\n  If the worker is live, let it finish consuming. If it is stuck, run: sgt-recover %s %s' \
        "$TASK_ID" "$REPO" "$response_id" "$gate_generation" "$TASK_ID" "$REPO")"
    fi
  fi
  if ! cmp -s "$RESPONSE_INPUT" "$pending_response_file"; then
    printf 'sgt-respond: reusing stored recovery response for orphaned worker %s/%s; supplied text was ignored.\n' "$TASK_ID" "$REPO" >&2
  fi
  if [[ ! -f "$worktree/.sergeant-response" ]]; then
    _atomic_write_file "$worktree/.sergeant-response" "$pending_response_file"
  fi
else
  response_id="$(dd if=/dev/urandom bs=16 count=1 2>/dev/null | od -An -tx1 | tr -d ' \n')"
  if [[ -n "$worktree" && -d "$worktree" ]]; then
    printf '%s' "$response_id" | "$SCRIPT_DIR/sgt-td-memory" response "$REPO_DIR" "$worktree" || \
      _die "Failed to record response provenance in td; response was not published"
  fi
  _publish_local_response_transport "$RESPONSE_INPUT" "$response_id" "$gate_generation"
fi

if [[ "${SGT_TEST_HOOKS:-}" == 1 && \
  "${SGT_TEST_RESPOND_LAUNCH_BARRIER:-}" == 1 ]]; then
  : > "$REPO_DIR/respond-launch-ready"
  while [[ ! -e "$REPO_DIR/respond-launch-release" ]]; do
    sleep 0.01
  done
fi

# A concurrent/retried exact invocation joins an already acknowledged immutable
# replacement journal instead of creating or delivering another notification.
existing_relaunch_transaction="$REPO_DIR/response_relaunch_transaction"
recovered_successor=""
recovered_spawn_token=""
_notification_has_one_complete_handshake() {
  local notification_id="$1" target nonce count=0
  for target in "$REPO_DIR/notifications/$notification_id/targets/"*; do
    [[ -d "$target" && ! -L "$target" ]] || continue
    nonce="${target##*/}"
    [[ "$nonce" =~ ^[a-f0-9]{32}$ ]] || continue
    if [[ "$(cat "$target/handshake_complete" 2>/dev/null || true)" == \
          "$notification_id|$nonce" ]]; then
      count=$((count + 1))
    fi
  done
  [[ "$count" == 1 ]]
}
if [[ -f "$existing_relaunch_transaction" ]]; then
  set +e
  _sgt_transfer_journal_ack_completed_handshake "$REPO_DIR" \
    "$existing_relaunch_transaction" "$response_id"
  completed_handshake_status=$?
  set -e
  [[ "$completed_handshake_status" -ne 2 ]] || \
    _die "Pending worker relaunch transaction is malformed"
fi
if [[ -f "$existing_relaunch_transaction" ]] &&
    _sgt_transfer_journal_read "$existing_relaunch_transaction" &&
    [[ "$_SGT_TRANSFER_PHASE" == acked ]]; then
  joined_response_id="$_SGT_TRANSFER_RESPONSE_ID"
  joined_notification="$_SGT_TRANSFER_NOTIFICATION_ID"
  joined_pane="$_SGT_TRANSFER_PANE"
  joined_pane_auth="$_SGT_TRANSFER_PANE_AUTH"
  joined_nonce="$(cat "$REPO_DIR/notification_target" 2>/dev/null || true)"
  joined_action_lease="$(cat "$REPO_DIR/notifications/$joined_notification/action_lease" 2>/dev/null || true)"
  joined_action_identity="$(cat \
    "$REPO_DIR/notifications/$joined_notification/targets/$joined_action_lease/pane_identity" \
    2>/dev/null || true)"
  joined_current_identity="$(_sgt_read_owned_file \
    "$REPO_DIR/pane_identity" 2>/dev/null || true)"
  joined_live_auth="$(_sgt_replacement_pane_auth "$joined_pane" \
    "$_SGT_TRANSFER_SPAWN_TOKEN" "$_SGT_TRANSFER_WORKER_ROLE" "$REPO_DIR" \
    2>/dev/null || true)"
  joined_identity_matches=false
  _sgt_pane_identity_matches "$joined_pane" "$REPO_DIR" && joined_identity_matches=true
  if [[ "$joined_response_id" == "$response_id" &&
        "$(cat "$REPO_DIR/notification_id" 2>/dev/null || true)" == "$joined_notification" &&
        "$(cat "$REPO_DIR/pane" 2>/dev/null || true)" == "$joined_pane" &&
        "$joined_identity_matches" == true && "$joined_live_auth" == "$joined_pane_auth" &&
        "$joined_nonce" =~ ^[a-f0-9]{32}$ &&
        ( -z "$joined_action_lease" ||
          -f "$REPO_DIR/notifications/$joined_notification/targets/$joined_action_lease/completed" ||
          ( "$joined_action_lease" == "$joined_nonce" &&
            "$joined_action_identity" == "$joined_current_identity" ) ) &&
        "$(cat "$REPO_DIR/notifications/$joined_notification/targets/$joined_nonce/handshake_complete" 2>/dev/null || true)" == "$joined_notification|$joined_nonce" ]]; then
    _sgt_response_lock_release
    _cleanup_response_input
    trap - EXIT
    echo "sgt-respond: joined acknowledged worker relaunch in pane $(cat "$REPO_DIR/pane")."
    exit 0
  fi
  # An unfinished action lease must pass through the normal dead-owner fence;
  # an acknowledged journal is not permission to bypass newer lease evidence.
  active_notification="$(cat "$REPO_DIR/notification_id" 2>/dev/null || true)"
  joined_stale_handshake=false
  _notification_has_one_complete_handshake "$joined_notification" && \
    joined_stale_handshake=true
  [[ ( "$active_notification" == "$joined_notification" &&
       ( "$joined_response_id" != "$response_id" ||
         ( "$joined_nonce" =~ ^[a-f0-9]{32}$ &&
           "$(cat "$REPO_DIR/notifications/$joined_notification/targets/$joined_nonce/handshake_complete" 2>/dev/null || true)" == "$joined_notification|$joined_nonce" ) ) ) ||
     ( "$active_notification" != "$joined_notification" &&
       "$joined_response_id" != "$response_id" &&
       "$joined_stale_handshake" == true ) ]] || \
      _die "Acknowledged worker relaunch journal conflicts with current notification evidence"
  stale_transfer_archive="$REPO_DIR/transfer_archive/$joined_notification"
  mkdir -p "$stale_transfer_archive" || _die "Could not archive stale acknowledged transfer"
  for stale_transfer_file in response_relaunch_transaction response_successor_notification; do
    [[ -e "$REPO_DIR/$stale_transfer_file" ]] || continue
    if [[ -e "$stale_transfer_archive/$stale_transfer_file" ]]; then
      cmp -s "$REPO_DIR/$stale_transfer_file" "$stale_transfer_archive/$stale_transfer_file" || \
        _die "Stale transfer archive conflicts with preserved evidence"
      rm -f "$REPO_DIR/$stale_transfer_file"
    else
      mv "$REPO_DIR/$stale_transfer_file" "$stale_transfer_archive/$stale_transfer_file" || \
        _die "Could not archive stale acknowledged transfer evidence"
    fi
  done
fi
if [[ -f "$existing_relaunch_transaction" ]] &&
    _sgt_transfer_journal_read "$existing_relaunch_transaction" &&
    [[ -z "$_SGT_TRANSFER_RESPONSE_ID" ]]; then
  recovered_successor="$_SGT_TRANSFER_NOTIFICATION_ID"
  recovered_spawn_token="$_SGT_TRANSFER_SPAWN_TOKEN"
  [[ "$recovered_successor" =~ ^[a-f0-9]{32}$ &&
     "$recovered_spawn_token" =~ ^[a-f0-9]{32}$ ]] || \
    _die "Pending cross-CLI relaunch journal is malformed"
fi

if $peer_launch_completed; then
  printf 'sgt-respond: response stored; verified peer worker-launch transaction completed for %s/%s.\n' \
    "$TASK_ID" "$REPO"
  exit 0
fi

_transfer_interrupt_hook() {
  local boundary="$1"
  if [[ "${SGT_TEST_HOOKS:-}" == "1" &&
        "${SGT_TEST_KILL_TRANSFER_AT:-}" == "$boundary" ]]; then
    kill -KILL "$$"
  fi
  if [[ "${SGT_TEST_HOOKS:-}" == "1" &&
        "${SGT_TEST_INTERRUPT_TRANSFER_AT:-}" == "$boundary" ]]; then
    _die "test interruption at ownership-transfer boundary: $boundary"
  fi
}

delivery_notification_id=""
replacement_spawn_token=""
_ensure_successor_binding() {
  local successor_binding bound_response bound_successor bound_token
  successor_binding="$(cat "$REPO_DIR/response_successor_notification" 2>/dev/null || true)"
  IFS='|' read -r bound_response bound_successor bound_token <<< "$successor_binding"
  if [[ "$bound_response" == "$response_id" && "$bound_successor" =~ ^[a-f0-9]{32}$ &&
        "$bound_token" =~ ^[a-f0-9]{32}$ ]]; then
    delivery_notification_id="$bound_successor"
    replacement_spawn_token="$bound_token"
    return 0
  fi
  [[ -z "$successor_binding" ]] || return 1
  if [[ -n "$recovered_successor" ]]; then
    delivery_notification_id="$recovered_successor"
    replacement_spawn_token="$recovered_spawn_token"
  else
    delivery_notification_id="$(dd if=/dev/urandom bs=16 count=1 2>/dev/null | \
      od -An -tx1 | tr -d ' \n')"
    replacement_spawn_token="$(dd if=/dev/urandom bs=16 count=1 2>/dev/null | \
      od -An -tx1 | tr -d ' \n')"
  fi
  _create_exact_once "$REPO_DIR/response_successor_notification" \
    "$response_id|$delivery_notification_id|$replacement_spawn_token"
}

# An unfinished accepted action must be adjudicated before every delivery or
# fallback path. In particular, absence of tmux or relaunch metadata must not
# bypass the old generation's ownership proof by publishing a successor first.
current_notification_id="$(cat "$REPO_DIR/notification_id" 2>/dev/null || true)"
current_target_nonce="$(cat "$REPO_DIR/notification_target" 2>/dev/null || true)"
current_target_identity=""
if [[ -n "$current_notification_id" && "$current_target_nonce" =~ ^[a-f0-9]{32}$ ]]; then
  current_target_identity="$(cat "$REPO_DIR/notifications/$current_notification_id/targets/$current_target_nonce/pane_identity" 2>/dev/null || true)"
fi
current_action_lease="$(cat "$REPO_DIR/notifications/$current_notification_id/action_lease" 2>/dev/null || true)"
if [[ -n "$current_action_lease" &&
      ! -f "$REPO_DIR/notifications/$current_notification_id/targets/$current_action_lease/completed" ]]; then
  _sgt_finalize_action_lease "$REPO_DIR" "$worktree" "respond_relaunch_convergence" || true
  if [[ ! -f "$REPO_DIR/notifications/$current_notification_id/targets/$current_action_lease/completed" ]]; then
    command -v tmux >/dev/null 2>&1 || \
      _die "Pending notification action lease ownership is ambiguous because tmux is unavailable; relaunch refused closed"
    shared_successor="$(_sgt_bind_action_lease_successor "$REPO_DIR" "$gate_generation")" || \
      _die "Action lease successor binding is malformed or conflicts with this generation"
    delivery_notification_id="${shared_successor%%|*}"
    replacement_spawn_token="${shared_successor#*|}"
    if [[ "$status" != "orphaned" && "$joining_recovery_response" != true ]] || ! _sgt_fence_dead_action_lease \
        "$REPO_DIR" "$worktree" "$delivery_notification_id" "$gate_generation" \
        "dead action lease ownership transfer"; then
      _die "$(printf 'Pending notification action lease ownership is live, reused, or ambiguous; relaunch refused closed.\n  notification: %s\n  lease target: %s\n  evidence: %s\n  Completion was not fabricated and the preserved worktree was not changed.\n  Inspect the recorded pane/process identities, reconcile the worker, then rerun: sgt-respond %s %s' \
        "$current_notification_id" "$current_action_lease" \
        "$REPO_DIR/notifications/$current_notification_id/action_lease_pending" \
        "$TASK_ID" "$REPO")"
    fi
    response_successor_binding="$response_id|$delivery_notification_id|$replacement_spawn_token"
    existing_response_successor="$(cat "$REPO_DIR/response_successor_notification" 2>/dev/null || true)"
    if [[ -n "$existing_response_successor" ]]; then
      [[ "$existing_response_successor" == "$response_successor_binding" ]] || \
        _die "Response successor binding conflicts with the action lease transfer"
    else
      _create_exact_once "$REPO_DIR/response_successor_notification" "$response_successor_binding" || \
        _die "Could not publish the response successor notification binding"
    fi
    _transfer_interrupt_hook lease_archived
  fi
fi

pane="$(cat "$REPO_DIR/pane" 2>/dev/null || true)"
_pane_is_supervisor() {
  local target="$1"
  _sgt_pane_identity_matches "$target" "$REPO_DIR"
}

superseded_live_pane=""
if [[ -n "$pane" ]] && command -v tmux >/dev/null 2>&1 && _pane_is_supervisor "$pane"; then
  if _delivery_escalation_armed; then
    # One prior delivery to this live pane went unacknowledged within the bound.
    # Escalate to the bounded relaunch below instead of redelivering forever.
    # The pane is killed only after the replacement is fully validated.
    superseded_live_pane="$pane"
    echo "sgt-respond: prior delivery to pane $pane was not acknowledged; escalating to one bounded worker relaunch." >&2
  else
    live_notification_id="${delivery_notification_id:-$response_id}"
    _sgt_publish_worker_notification "$REPO_DIR" "$worktree" "$live_notification_id" response \
      "Apply the response in .sergeant-response exactly once using the acknowledgement protocol in .sergeant-brief.md."
    _sgt_notification_target_create "$REPO_DIR" "$live_notification_id" \
      "$(cat "$REPO_DIR/pane_identity")" >/dev/null || \
      _die "notification target race detected; response not delivered to local pane"
    set +e
    _wait_worker_notification_with_response_lock_released \
      "$pane" "$live_notification_id"
    delivery_wait_status=$?
    set -e
    [[ "$delivery_wait_status" -ne 2 ]] || \
      _die "Could not reacquire response ownership after local worker delivery"
    if [[ "$delivery_wait_status" -ne 0 ]]; then
      _arm_delivery_escalation "live pane did not acknowledge within SGT_NOTIFICATION_ACK_TIMEOUT" \
        "$(cat "$REPO_DIR/pane_identity" 2>/dev/null || true)" || true
      _die "$(printf 'Worker did not acknowledge its durable response notification within the delivery bound; the response is stored and recoverable.\n  response: %s (gate %s)\n  pane: %s\n  Rerun the same command to perform one bounded worker relaunch: sgt-respond %s %s' \
        "$response_id" "$gate_generation" "$pane" "$TASK_ID" "$REPO")"
    fi
    rm -f "$REPO_DIR/response_delivery_unacked" \
      "$REPO_DIR/response_successor_notification"
    _sgt_response_lock_release
    _cleanup_response_input
    _sgt_drain_lock_release_fd "$_SGT_RESPOND_LAUNCH_FD"
    trap - EXIT
    echo "sgt-respond: notified local pane $pane."
    exit 0
  fi
fi

tmux_session="$(cat "$REPO_DIR/tmux_session" 2>/dev/null || true)"
window_name="$(cat "$REPO_DIR/window_name" 2>/dev/null || true)"
agent="$(cat "$REPO_DIR/agent" 2>/dev/null || true)"
if ! command -v tmux >/dev/null 2>&1 || [[ -z "$tmux_session" || -z "$window_name" || -z "$agent" ]]; then
  fallback_notification_id="${delivery_notification_id:-$response_id}"
  _sgt_publish_worker_notification "$REPO_DIR" "$worktree" "$fallback_notification_id" response \
    "Apply the response in .sergeant-response exactly once using the acknowledgement protocol in .sergeant-brief.md."
  _die "No live local pane and relaunch metadata is incomplete; the durable response and notification are preserved but the worker was not resumed. Restore exact tmux_session, window_name, and agent evidence, then rerun: sgt-respond $TASK_ID $REPO"
fi

# ── Drain admission check for worker relaunch ─────────────────────────────────
# Drain blocks relaunch (new pane/process) but never blocks response storage or
# delivery to an already-live pane (handled above). The response was already
# stored above; on drain, retain a generation-bound drain_held marker so an
# explicit undrain can reevaluate this waiting worker exactly once.
#
# The drain admission lock is held from the check through the new-window call so
# a concurrent drain set either waits until the pane is spawned (and the new
# worker will receive the drain signal on its first poll) or wins the lock first
# and blocks this relaunch.  The response lock is already held; nested locking
# is safe because drain set never acquires the response lock.
_SGT_RESPOND_DRAIN_FD=9
_sgt_respond_drain_project="${SGT_PROJECT:-}"
[[ -f "$REPO_DIR/project" ]] && \
  _sgt_respond_drain_project="$(tr -d '\n' < "$REPO_DIR/project" 2>/dev/null || true)"
if ! _sgt_drain_lock_acquire_fd "$_SGT_RESPOND_DRAIN_FD" 2>/dev/null; then
  _sgt_response_lock_release 2>/dev/null || true
  _sgt_drain_lock_release_fd "$_SGT_RESPOND_LAUNCH_FD" 2>/dev/null || true
  trap - EXIT
  _die "cannot acquire drain admission lock"
fi
if ! _sgt_drain_check_admission_locked "${_sgt_respond_drain_project:-}"; then
  # Drain is active: response has been stored generation-safely above.
  # Write drain_held so that an explicit undrain can reevaluate this waiting
  # worker exactly once (consistent with the direct _sgt_is_drained path below).
  _atomic_write "$REPO_DIR/drain_held" "$gate_generation" 2>/dev/null || true
  _sgt_drain_lock_release_fd "$_SGT_RESPOND_DRAIN_FD"
  _sgt_response_lock_release 2>/dev/null || true
  _sgt_drain_lock_release_fd "$_SGT_RESPOND_LAUNCH_FD" 2>/dev/null || true
  _cleanup_response_input
  trap - EXIT
  echo "sgt-respond: response stored; worker relaunch held by drain [project: ${_sgt_respond_drain_project:-global}]."
  exit 0
fi
# Drain admission lock remains held until after new-window (see release below).
if [[ -z "$delivery_notification_id" ]]; then
  _ensure_successor_binding || \
    _die "Could not publish the response successor notification binding"
fi
if [[ -n "$current_notification_id" && -n "$current_target_identity" ]]; then
  superseded_dir="$REPO_DIR/notifications/$current_notification_id"
  mkdir -p "$superseded_dir"
  superseded_tmp="$superseded_dir/superseded_target_pane_identity.tmp.$$"
  printf '%s\n' "$current_target_identity" > "$superseded_tmp"
  if [[ -e "$superseded_dir/superseded_target_pane_identity" ]]; then
    cmp -s "$superseded_tmp" "$superseded_dir/superseded_target_pane_identity" || \
      _die "Pending notification target evidence conflicts with relaunch"
    rm -f "$superseded_tmp"
  else
    mv "$superseded_tmp" "$superseded_dir/superseded_target_pane_identity"
  fi
fi
rm -f "$worktree/.sergeant-notification-ack" "$worktree/.sergeant-notification-accept" \
  "$REPO_DIR/notification_delivered" \
  "$REPO_DIR/notification_delivered_pane_identity" \
  "$REPO_DIR/notification_target"
_sgt_publish_worker_notification "$REPO_DIR" "$worktree" "$delivery_notification_id" response \
  "Apply the response in .sergeant-response exactly once using the acknowledgement protocol in .sergeant-brief.md."
_transfer_interrupt_hook successor_published

worker_role="worker:$(basename "$agent")"
relaunch_transaction="$REPO_DIR/response_relaunch_transaction"
relaunch_worker_before_file="$REPO_DIR/response_relaunch_worker_before"
replacement_window_name="${window_name}-resume-${delivery_notification_id:0:12}"
journal_response_id="$response_id"
[[ -z "$recovered_successor" ]] || journal_response_id=""

_worker_marker_capability_exists() {
  local marker marker_path
  marker="$(_sgt_read_owned_file "$REPO_DIR/worker_process_marker" 2>/dev/null || true)"
  marker_path="${marker##*|}"
  [[ -n "$marker_path" && -f "$marker_path" && ! -L "$marker_path" ]]
}

_prepare_relaunch_worker_command() {
  local worker_marker
  _sgt_prepare_worker_process_marker "$REPO_DIR" || return 1
  worker_marker="$(_sgt_read_owned_file "$REPO_DIR/worker_process_marker")" || return 1
  worker_command="$(_sgt_replacement_worker_command "$replacement_spawn_token" "$worker_role" \
    "$worker_marker" \
    "$(_sgt_worker_command "$SCRIPT_DIR/sgt-interactive-worker" "$REPO_DIR" "$worktree" "$agent")")" || \
    return 1
  _sgt_replace_owned_file "$relaunch_worker_before_file" \
    "$respond_worker_launch_before"
}

_write_relaunch_transaction() {
  local phase="$1" candidate_pane="${2:-}" candidate_identity="${3:-}"
  _sgt_transfer_journal_write "$relaunch_transaction" "$journal_response_id" \
    "$delivery_notification_id" "$replacement_spawn_token" "$gate_generation" \
    "$tmux_session" "$replacement_window_name" "$worker_role" "$worker_command" "$phase" \
    "$candidate_pane" "$candidate_identity"
}

_relaunch_transaction_matches() {
  _sgt_transfer_journal_read "$relaunch_transaction" &&
    [[ -z "$_SGT_TRANSFER_RESPONSE_ID" || "$_SGT_TRANSFER_RESPONSE_ID" == "$response_id" ]] &&
    [[ "$_SGT_TRANSFER_NOTIFICATION_ID" == "$delivery_notification_id" &&
       "$_SGT_TRANSFER_SPAWN_TOKEN" == "$replacement_spawn_token" &&
       "$_SGT_TRANSFER_GATE_GENERATION" == "$gate_generation" &&
       "$_SGT_TRANSFER_TMUX_SESSION" == "$tmux_session" &&
       "$_SGT_TRANSFER_WINDOW_NAME" == "$replacement_window_name" &&
       "$_SGT_TRANSFER_WORKER_ROLE" == "$worker_role" &&
       "$_SGT_TRANSFER_WORKER_COMMAND" == "$worker_command" ]]
}

_record_relaunch_orphan() {
  local reason="$1"
  rm -f "$relaunch_transaction" "$relaunch_worker_before_file"
  printf 'orphaned\n' > "$worktree/.sergeant-status"
  printf 'orphaned\n' > "$REPO_DIR/status"
  printf '%s\n' "$reason" >> "$REPO_DIR/diagnostic"
  "$SCRIPT_DIR/sgt-td-memory" handoff "$REPO_DIR" "$worktree" || true
}

if [[ -e "$relaunch_transaction" ]]; then
  _sgt_transfer_journal_read "$relaunch_transaction" || \
    _die "Worker relaunch transaction conflicts with this response generation"
  worker_command="$_SGT_TRANSFER_WORKER_COMMAND"
  relaunch_worker_before="$(_sgt_read_owned_file \
    "$relaunch_worker_before_file" 2>/dev/null || true)"
  [[ "$relaunch_worker_before" == absent || \
     "$relaunch_worker_before" =~ ^[0-9a-f]{64}$ ]] || \
    _die "Worker relaunch transaction is missing its worker-generation snapshot"
  _relaunch_transaction_matches || \
    _die "Worker relaunch transaction conflicts with this response generation"
else
  _prepare_relaunch_worker_command || \
    _die "Could not prepare canonical replacement worker command"
  relaunch_worker_before="$respond_worker_launch_before"
  _write_relaunch_transaction bound || \
    _die "Could not publish worker relaunch intent"
fi

set +e
new_pane="$(_sgt_replacement_discover_pane "$replacement_window_name" \
  "$replacement_spawn_token" "$worker_role" "$_SGT_TRANSFER_PHASE" \
  "$_SGT_TRANSFER_PANE" "$_SGT_TRANSFER_PANE_AUTH" "$REPO_DIR" 2>/dev/null)"
discovery_status=$?
set -e
[[ "$discovery_status" -ne 2 ]] || \
  _die "Could not enumerate tmux panes for a pending worker relaunch transaction"
[[ "$discovery_status" -ne 3 ]] || \
  _die "Pending worker relaunch transaction resolves to multiple panes; refusing closed"
[[ "$discovery_status" -ne 4 ]] || \
  _die "Pending worker relaunch window is owned by a foreign pane; refusing closed"
if [[ -z "$new_pane" ]]; then
  if ! _worker_marker_capability_exists; then
    rm -f "$relaunch_transaction" "$relaunch_worker_before_file"
    _prepare_relaunch_worker_command || \
      _die "Could not renew canonical replacement worker command"
    relaunch_worker_before="$respond_worker_launch_before"
    _write_relaunch_transaction bound || \
      _die "Could not republish renewed worker relaunch intent"
  fi
  _write_relaunch_transaction spawning || \
    _die "Could not publish worker relaunch spawning state"
  if ! new_pane="$(tmux new-window -P -F '#{pane_id}' -t "$tmux_session:" \
      -n "$replacement_window_name" -c "$worktree" "$worker_command")"; then
    # Release drain admission lock before reporting failure.
    _sgt_drain_lock_release_fd "$_SGT_RESPOND_DRAIN_FD"
    _record_relaunch_orphan "tmux failed to relaunch worker supervisor"
    _die "Worker relaunch failed for $TASK_ID/$REPO"
  fi
fi
# Worker pane is now live — release drain admission lock.
_sgt_drain_lock_release_fd "$_SGT_RESPOND_DRAIN_FD"
if [[ -z "$new_pane" ]]; then
  _record_relaunch_orphan "tmux returned no pane for relaunched worker supervisor"
  _die "Worker relaunch returned no pane for $TASK_ID/$REPO"
fi
_transfer_interrupt_hook replacement_spawned
if pane_identity="$(_sgt_pane_identity "$new_pane")" && \
    pane_auth="$(_sgt_replacement_pane_identity_matches "$pane_identity" "$new_pane" \
      "$replacement_spawn_token" "$worker_role" "$REPO_DIR")"; then
  _write_relaunch_transaction spawned "$new_pane" "$pane_auth" || \
    _die "Could not publish spawned worker ownership transaction"
  printf '%s\n' "$new_pane" > "$REPO_DIR/pane"
  _sgt_replace_owned_file "$REPO_DIR/pane_identity" "$pane_identity" || \
    _die "Could not publish worker pane identity"
  if ! _sgt_notification_target_create "$REPO_DIR" "$delivery_notification_id" \
      "$pane_identity" >/dev/null; then
    tmux kill-pane -t "$new_pane" 2>/dev/null || true
    _record_relaunch_orphan "notification target race detected during relaunch"
    _die "notification target race detected for $TASK_ID/$REPO; relaunched worker orphaned"
  fi
  _transfer_interrupt_hook replacement_owned
  eval "_SGT_WORKER_LAUNCH_BEFORE_${_SGT_RESPOND_LAUNCH_FD}=\$relaunch_worker_before"
  _sgt_worker_launch_completion_publish "$REPO_DIR" "$_SGT_RESPOND_LAUNCH_FD" || \
    _die "Could not publish completed worker-launch transaction"
  if [[ "${SGT_TEST_HOOKS:-}" == 1 && \
    "${SGT_TEST_RESPOND_AFTER_COMPLETION_BARRIER:-}" == 1 ]]; then
    : > "$REPO_DIR/respond-after-completion-ready"
    while [[ ! -e "$REPO_DIR/respond-after-completion-release" ]]; do
      sleep 0.01
    done
  fi
else
  tmux kill-pane -t "$new_pane" 2>/dev/null || true
  _record_relaunch_orphan "tmux failed to capture exact relaunched worker pane identity"
  _die "Worker relaunch identity capture failed for $TASK_ID/$REPO"
fi
# Retire the superseded pane only now that the replacement is live, its identity
# is published, and its notification target exists — the same ordering
# sgt-recover uses.  A failure before this point leaves the original supervisor
# untouched.
if [[ -n "$superseded_live_pane" && "$superseded_live_pane" != "$new_pane" ]]; then
  tmux kill-pane -t "$superseded_live_pane" 2>/dev/null || true
fi
set +e
_wait_worker_notification_with_response_lock_released \
  "$new_pane" "$delivery_notification_id"
delivery_wait_status=$?
set -e
[[ "$delivery_wait_status" -ne 2 ]] || \
  _die "Could not reacquire response ownership after replacement worker delivery"
if [[ "$delivery_wait_status" -ne 0 ]]; then
  tmux kill-pane -t "$new_pane" 2>/dev/null || true
  _record_relaunch_orphan "relaunched interactive worker did not acknowledge its durable response notification"
  _die "Worker relaunch notification acknowledgement timed out for $TASK_ID/$REPO"
fi
_transfer_interrupt_hook handshake_complete
_write_relaunch_transaction acked "$new_pane" "$pane_auth" || \
  _die "Could not publish acknowledged worker ownership transaction"
rm -f "$REPO_DIR/drain_held" "$REPO_DIR/response_delivery_unacked"
rm -f "$relaunch_worker_before_file"
replacement_committed=true
_sgt_response_lock_release
_cleanup_response_input
_sgt_drain_lock_release_fd "$_SGT_RESPOND_LAUNCH_FD"
trap - EXIT
echo "sgt-respond: relaunched worker in pane $new_pane."
