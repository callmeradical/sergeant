#!/usr/bin/env bash
# sgt-install — Symlink this checkout's commands into a directory on PATH.
#
# Usage:
#   sgt-install [--hooks-only]
#
#   --hooks-only   Install only this repository's git hooks, skipping the
#                  command links. Used by `mise run install:hooks` so the hook
#                  rules live here and nowhere else.
#
# Environment:
#   SGT_INSTALL_DIR   Target directory for command links (default ~/.local/bin)
#
# Invoked by `mise run install` and by `sgt-bootstrap`. Safe to rerun.
#
# Link policy, decided by _sgt_install_link_state so the bootstrap's plan and
# this installer can never disagree:
#
#   absent    create the link
#   linked    already correct; leave it alone
#   stale     a Sergeant-owned or dangling link; replace it in place
#   conflict  a real file, a directory, or a link to something the user owns;
#             preserve it, report it, and exit non-zero
#
# Exits non-zero when any command could not be installed, so `mise run install`
# cannot report success over a knowingly incomplete installation.
#
# Writes only to the target directory and to the git hooks directory of this
# checkout. Per docs/repo-scoped-skills.md it never writes to a user's global
# agent configuration; it only removes an oc-inject link this checkout created
# before that injection path was deprecated.

set -euo pipefail

# Resolved with parameter expansion rather than the repo's usual
# $(dirname "${BASH_SOURCE[0]}") idiom: this command runs before the toolchain
# exists and its tests exercise it on a deliberately minimal PATH, where an
# external dirname may be absent.
_self="${BASH_SOURCE[0]}"
case "$_self" in
  */*) SCRIPT_DIR="$(cd "${_self%/*}" && pwd)" ;;
  *) SCRIPT_DIR="$(pwd)" ;;
esac
# shellcheck source=_sgt-install-manifest.sh
source "$SCRIPT_DIR/_sgt-install-manifest.sh"

ROOT_DIR="$(_sgt_install_script_root "$_self")"
TARGET_DIR="$(_sgt_install_target_dir)"

hooks_only=false
while (($#)); do
  case "$1" in
    --hooks-only) hooks_only=true ;;
    *) printf 'sgt-install: unknown option: %s\nUsage: sgt-install [--hooks-only]\n' "$1" >&2; exit 2 ;;
  esac
  shift
done

# Resolve the manifest before mutating anything, and fail loudly on an empty
# result rather than reporting a vacuous success.
if "$hooks_only"; then
  sources=''
else
  sources="$(_sgt_install_sources "$ROOT_DIR")" || exit 1
fi

linked=0
conflicts=0
removed=0

"$hooks_only" || mkdir -p "$TARGET_DIR"

# publish_link <source-file> <target>
#
# Replace <target> with a link to <source-file>, atomically. The link is created
# under a temporary name and renamed into place: `rename` over an existing
# symlink is atomic, so a concurrent run never observes the target missing and
# never races an `rm` against an `ln`. Renaming also never follows a symlink that
# points at a directory, which is how `ln -sf` would write inside it instead.
publish_link() {
  local source_file="$1" target="$2" staged
  # Staged inside a pattern this checkout claims (see _sgt_install_managed_globs),
  # so an interrupted publish leaves nothing the sweep cannot reclaim.
  staged="${2%/*}/sgt-publish.$$.${2##*/}"
  rm -f "$staged"
  ln -s "$source_file" "$staged" || return 1
  mv -f "$staged" "$target" || { rm -f "$staged"; return 1; }
  # Only that a link now exists is asserted, not where it points: a concurrent
  # install from another checkout may legitimately have won the rename, and both
  # runs converge because each publishes atomically. mv's exit status already
  # proves this run's link was put in place.
  [[ -L "$target" ]] || {
    printf 'sgt-install: %s is not a link after publishing %s\n' "$target" "$source_file" >&2
    return 1
  }
}

while IFS= read -r source_file; do
  [[ -n "$source_file" ]] || continue
  target="$TARGET_DIR/${source_file##*/}"
  case "$(_sgt_install_link_state "$source_file" "$TARGET_DIR")" in
    linked)
      printf '  linked: %s -> %s\n' "$target" "$source_file"
      linked=$((linked + 1))
      ;;
    absent|stale)
      publish_link "$source_file" "$target"
      printf '  linked: %s -> %s\n' "$target" "$source_file"
      linked=$((linked + 1))
      ;;
    conflict)
      printf '  preserved existing: %s (not installed)\n' "$target"
      conflicts=$((conflicts + 1))
      ;;
  esac
done <<< "$sources"

managed_globs="$(_sgt_install_managed_globs)" || exit 1
deprecated_links="$(_sgt_install_owned_deprecated_links "$ROOT_DIR" "$TARGET_DIR")" || exit 1

if ! "$hooks_only"; then
  # Sweep links this checkout owns that the manifest no longer names, so renaming
  # or removing a command does not leave a dangling entry on the user's PATH.
  while IFS= read -r pattern; do
    [[ -n "$pattern" ]] || continue
    for stale_target in "$TARGET_DIR"/$pattern; do
      _sgt_install_link_points_into "$stale_target" "$ROOT_DIR" || continue
      stale_source="$(_sgt_install_resolve_link "$stale_target")"
      # A leftover staged link is always reclaimed, even when its source exists.
      # Both shapes are matched: the current staged name and the one an earlier
      # version wrote.
      case "${stale_target##*/}" in
        sgt-publish.*|*.sgt-publish.*) ;;
        *) [[ -f "$stale_source" ]] && continue ;;
      esac
      rm -f "$stale_target"
      printf '  removed stale Sergeant link: %s\n' "$stale_target"
      removed=$((removed + 1))
    done
  done <<< "$managed_globs"

  # Remove only the deprecated links this checkout previously created. The source
  # of bin/oc-inject remains for one compatibility window, but it is no longer
  # installed or activated.
  while IFS= read -r deprecated_link; do
    [[ -n "$deprecated_link" ]] || continue
    rm "$deprecated_link"
    printf '  removed deprecated Sergeant link: %s\n' "$deprecated_link"
    removed=$((removed + 1))
  done <<< "$deprecated_links"
fi

# Install this repository's git hooks. The directory is resolved by
# _sgt_install_hooks_dir, which returns an absolute path: the plain --git-dir
# form prints the relative string ".git" for a normal clone, which would resolve
# against the caller's working directory and install Sergeant's pre-push hook
# into whatever unrelated repository the user happens to be in.
hooks_src="$ROOT_DIR/scripts/hooks"
hooks_dst="$(_sgt_install_hooks_dir "$ROOT_DIR" || true)"
hooks_unresolved=false
if [[ -d "$hooks_src" && -z "$hooks_dst" ]]; then
  hooks_unresolved=true
  printf '  skipped hooks: %s\n' "$(_sgt_install_hooks_refusal_advice "$ROOT_DIR")" >&2
elif [[ -d "$hooks_src" && ! -d "$hooks_dst" ]]; then
  mkdir -p "$hooks_dst"
fi
if [[ -d "$hooks_src" && -n "$hooks_dst" && -d "$hooks_dst" ]]; then
  for hook in "$hooks_src"/*; do
    [[ -f "$hook" ]] || continue
    hook_target="$hooks_dst/${hook##*/}"
    case "$(_sgt_install_hook_state "$hook" "$hooks_dst")" in
      linked)
        printf '  linked hook: %s -> %s\n' "$hook_target" "$hook"
        linked=$((linked + 1))
        ;;
      absent|stale)
        # A hook installed by another Sergeant checkout, or a broken one, is
        # Sergeant's to repoint. Worktrees share their primary's hooks directory.
        publish_link "$hook" "$hook_target"
        printf '  linked hook: %s -> %s\n' "$hook_target" "$hook"
        linked=$((linked + 1))
        ;;
      conflict)
        # A hook the user wrote is theirs; never replace it silently.
        printf '  preserved existing hook: %s (not installed)\n' "$hook_target"
        conflicts=$((conflicts + 1))
        ;;
    esac
  done
fi

printf '\nInstalled %d entries\n' "$linked"
printf 'Removed %d stale or deprecated links\n' "$removed"
printf 'Preserved %d existing entries\n' "$conflicts"

if ! "$hooks_only" && [[ ":$PATH:" != *":$TARGET_DIR:"* ]]; then
  printf '\nWARNING: %s is not on your PATH.\n' "$TARGET_DIR"
  printf 'Add this to your shell config (~/.zshrc or ~/.bashrc):\n'
  # Print a literal snippet for the user to copy; do not expand $PATH here.
  # shellcheck disable=SC2016
  printf '  export PATH="%s:$PATH"\n' "$TARGET_DIR"
fi

if ((conflicts > 0)); then
  printf '\nsgt-install: %d entries were preserved and are NOT installed; resolve them by hand.\n' \
    "$conflicts" >&2
  exit 1
fi

# When hooks are the requested work, failing to resolve their directory is the
# whole outcome, not a detail to skip past.
if "$hooks_only" && "$hooks_unresolved"; then
  printf 'sgt-install: no git hooks were installed: %s.\n' \
    "$(_sgt_install_hooks_refusal_advice "$ROOT_DIR")" >&2
  exit 1
fi
