# Dockerfile.test — Minimal image for running the Sergeant drain test suite.
#
# Provides a clean, reproducible environment with system Bash (5.x on Debian
# bookworm-slim).  The Bash 3.2 regression pass runs in a separate Alpine-based
# image (bash:3.2); see run-drain-tests.sh and the mise task test:docker:drain
# for the two-stage orchestration.
#
# Build:
#   docker build -f Dockerfile.test -t sergeant-test .
#
# Run drain suite (system-Bash pass only):
#   docker run --rm -v "$PWD:/repo:ro" sergeant-test
#
# Run a single test file:
#   docker run --rm -v "$PWD:/repo:ro" sergeant-test bash /repo/tests/sgt-drain-test.sh

FROM debian:bookworm-slim

# Install runtime dependencies required by the drain test suite.
RUN apt-get update -qq && \
    apt-get install -y --no-install-recommends \
      bash \
      git \
      tmux \
      lsof \
      procps \
      python3 \
      util-linux \
      sqlite3 \
      curl \
      ca-certificates \
      # zsh and dash are test subjects, not conveniences.  tmux runs a
      # new-window command through the pane's default-shell, which follows the
      # user's $SHELL -- /bin/zsh on any default macOS install since Catalina.
      # A bash-only construct in the worker launch command therefore killed every
      # dispatched worker on macOS (GH #228), and CI could not see it because the
      # image had no non-bash shell to run it under.  dash is Debian's /bin/sh and
      # covers POSIX-only parsing.
      zsh \
      dash \
      && rm -rf /var/lib/apt/lists/*

# yq parses project YAML in sgt-context, which sgt-dispatch calls during
# preflight.  Without it every dispatch-driving suite fails in this image with
# "yq is required: brew install yq" — a missing dependency reported as a test
# failure.  The Bash suite is not in CI (CONTRIBUTING.md:124-126), so that gap
# was only visible to whoever ran Docker locally.
#
# Installed from the mikefarah/yq release, NOT Debian's `yq` package.  Debian
# ships python-yq, a jq wrapper with different output semantics: for
# `yq '.name' file` it prints `"test"` where mikefarah v4 prints `test`.  Since
# sgt-context assigns that output straight into project names and repo paths, the
# wrong yq would corrupt every resolved path silently instead of failing — worse
# than having no yq at all.
#
# Pinned by version and verified by checksum, matching how test:docker:drain pins
# the bash:3.2 image by digest.
ARG YQ_VERSION=v4.44.3
ARG YQ_SHA256_AMD64=a2c097180dd884a8d50c956ee16a9cec070f30a7947cf4ebf87d5f36213e9ed7
ARG YQ_SHA256_ARM64=0e7e1524f68d91b3ff9b089872d185940ab0fa020a5a9052046ef10547023156
RUN set -eux; \
    arch="$(dpkg --print-architecture)"; \
    case "$arch" in \
      amd64) yq_arch=amd64; yq_sha="$YQ_SHA256_AMD64" ;; \
      arm64) yq_arch=arm64; yq_sha="$YQ_SHA256_ARM64" ;; \
      *) printf 'unsupported architecture for yq: %s\n' "$arch" >&2; exit 1 ;; \
    esac; \
    curl -fsSL -o /usr/local/bin/yq \
      "https://github.com/mikefarah/yq/releases/download/${YQ_VERSION}/yq_linux_${yq_arch}"; \
    printf '%s  /usr/local/bin/yq\n' "$yq_sha" | sha256sum -c -; \
    chmod +x /usr/local/bin/yq; \
    yq --version | grep -Fq "$YQ_VERSION"

# Verify Bash is present.
RUN bash --version | head -1

WORKDIR /repo

# Default: run the drain suite with BASH32="" to skip the Bash 3.2 pass.
# The mise task test:docker:drain runs the Bash 3.2 pass separately in the
# bash:3.2 Alpine image.
CMD ["bash", "-c", "BASH32='' bash /repo/tests/run-drain-tests.sh"]
